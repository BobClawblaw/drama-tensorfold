@@ -0,0 +1,75 @@
+"""The encoder seam: tensorfold-native when present, else the reference's encoder; either way a sourced voice file."""
+import contextlib
+import io
+import json
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+import drama_voice
+
+ROWS = [[book * 7 + frame for frame in range(3)] for book in range(drama_voice.NUM_CODEBOOKS)]
+
+
+def no_reference_encoder(*_):
+    raise AssertionError("the reference encoder ran")
+
+
+class EncodeTests(unittest.TestCase):
+    def setUp(self):
+        self.folder = Path(self.enterContext(tempfile.TemporaryDirectory()))
+        self.audio, self.text, self.out = self.folder / "me.wav", self.folder / "me.txt", self.folder / "me.json"
+        self.audio.write_bytes(b"RIFF")
+        self.text.write_text(" Hello there. \n", encoding="utf-8")
+
+    def run_main(self, *words: str, text: Path | None = None, native: str | None = None) -> dict:
+        argv = ["drama_voice.py", "--checkpoint", "ckpt", "--audio", str(self.audio), "--text", str(text or self.text), "--out", str(self.out), *words]
+        with patch("sys.argv", argv), patch.object(drama_voice.shutil, "which", lambda _: native), contextlib.redirect_stdout(io.StringIO()):
+            drama_voice.main()
+        return json.loads(self.out.read_text(encoding="utf-8"))
+
+    def test_native_cli_encodes_when_present_and_the_tool_adds_the_source(self):
+        ran = []
+
+        def native(command):
+            ran.append(command)
+            voice = {"format": drama_voice.FORMAT, "text": "Hello there.", "codes_sha256": "c0de", "vq_codes": ROWS}
+            Path(command[command.index("--out") + 1]).write_text(json.dumps(voice), encoding="utf-8")
+            return subprocess.CompletedProcess(command, 0)
+
+        with patch.object(drama_voice.subprocess, "run", native), patch.object(drama_voice, "encode", no_reference_encoder):
+            voice = self.run_main("--source-kind", "owner", "--source-note", " my own voice ", native="/opt/tf/tensorfold-native")
+        command = ["/opt/tf/tensorfold-native", "voice", "encode", str(self.audio), "--model", "ckpt", "--text", "Hello there.", "--name", "me", "--out", str(self.out)]
+        self.assertEqual(ran, [command])
+        self.assertEqual(voice["codes_sha256"], "c0de")
+        self.assertEqual(voice["source"], {"kind": "owner", "note": "my own voice"})
+
+    def test_reference_encoder_without_native_writes_the_digest_the_loader_checks(self):
+        with patch.object(drama_voice, "encode", lambda *_: (ROWS, {"device": "cpu"})):
+            voice = self.run_main("--reference", "sglang-omni", "--source-kind", "model-invented", "--source-note", "the model's built-in voice")
+        self.assertEqual(voice["text"], "Hello there.")
+        self.assertEqual(voice["frames"], 3)
+        self.assertEqual(voice["codes_sha256"], drama_voice.codes_sha256(ROWS))
+        self.assertEqual(voice["audio_sha256"], drama_voice.sha256(b"RIFF"))
+        self.assertEqual(voice["source"], {"kind": "model-invented", "note": "the model's built-in voice"})
+
+    def test_drafts_missing_consent_and_missing_encoders_are_refused_before_encoding(self):
+        draft = self.folder / "me.draft.txt"
+        draft.write_text("Hello there.\n", encoding="utf-8")
+        with patch.object(drama_voice, "encode", no_reference_encoder):
+            with self.assertRaisesRegex(SystemExit, "Whisper draft: correct it against the clip and save it as me.txt"):
+                self.run_main("--reference", "r", "--source-kind", "owner", "--source-note", "mine", text=draft)
+            with self.assertRaisesRegex(SystemExit, "--source-note must say"):
+                self.run_main("--reference", "r", "--source-kind", "owner", "--source-note", "  ")
+            with self.assertRaisesRegex(SystemExit, "tensorfold-native is not on PATH"):
+                self.run_main("--source-kind", "owner", "--source-note", "mine")
+            for consent in (["--source-kind", "celebrity", "--source-note", "a film"], ["--source-note", "mine"]):
+                with self.assertRaises(SystemExit), contextlib.redirect_stderr(io.StringIO()):
+                    self.run_main("--reference", "r", *consent)
+        self.assertFalse(self.out.exists())
+
+
+if __name__ == "__main__":
+    unittest.main()
