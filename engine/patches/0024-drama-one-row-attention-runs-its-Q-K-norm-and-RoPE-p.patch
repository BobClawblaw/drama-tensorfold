From 3af6ce942e3cbea851e3e57c72a1472d1a4b5f4e Mon Sep 17 00:00:00 2001
From: plotarmordev <299844489+plotarmordev@users.noreply.github.com>
Date: Fri, 16 Oct 2026 11:13:20 +0800
Subject: [PATCH 24/30] drama: one-row attention runs its Q/K norm and RoPE
 prologue in the same launch

For a single row, the attention launch also does drama_attn_prep's norm, RoPE and cache append, taking the new
key and value from registers, with the same roundings as the separate launch.
---
 zig/kernels/cuda/drama_backbone.cu          | 132 +++++++++++++-------
 zig/src/families/drama/backbone_kernels.zig |  37 +++---
 2 files changed, 110 insertions(+), 59 deletions(-)

diff --git a/zig/kernels/cuda/drama_backbone.cu b/zig/kernels/cuda/drama_backbone.cu
index 60398bf4..565b8951 100644
--- a/zig/kernels/cuda/drama_backbone.cu
+++ b/zig/kernels/cuda/drama_backbone.cu
@@ -351,22 +351,10 @@ extern "C" __global__ void __launch_bounds__(128) drama_gdn_recur(const __nv_bfl
 // bf16(v * rsqrt(mean(v^2) + eps) * (1 + w)) (the reference rounds the norm to bf16 before RoPE), then NeoX
 // RoPE in fp32 on the leading 64 dims (pairs d, d + 32) with fp32 cos/sin of pos * inv_freq[d % 32] (SGLang
 // keeps the cos/sin cache in fp32 on CUDA) and a second bf16 rounding at the store; the other dims round once.
-// qkv rows: [per q head: q (256) | gate (256)] x H, then k (HK x 256), then v (HK x 256), ld_qkv apart.
-// q goes to q_out [rows][H][256]; k and v to the caches [context][HK][256] at pos0 + row.
-// Grid: (rows, H + HK); block 32 (a lane owns 8 dims).
-extern "C" __global__ void __launch_bounds__(32) drama_attn_prep(const __nv_bfloat16* qkv, int ld_qkv,
-                                                                const __nv_bfloat16* qn_w, const __nv_bfloat16* kn_w,
-                                                                const float* inv_freq, __nv_bfloat16* q_out,
-                                                                __nv_bfloat16* kc, __nv_bfloat16* vc, int pos0, int H,
-                                                                int HK, float eps) {
+// One head in a warp, a lane owning dims lane * 8 .. lane * 8 + 7; o is the value before the store's rounding.
+__device__ __forceinline__ void qk_norm_rope(const __nv_bfloat16* src, const __nv_bfloat16* w, const float* inv_freq,
+                                             int pos, float eps, int lane, float (&o)[8]) {
     constexpr int D = 256, ROT = 64, HALF = 32;
-    const int r = blockIdx.x, h = blockIdx.y, lane = threadIdx.x;
-    const int pos = pos0 + r;
-    const __nv_bfloat16* row = qkv + static_cast<size_t>(r) * ld_qkv;
-    const bool is_q = h < H;
-    const int kh = h - H;
-    const __nv_bfloat16* src = is_q ? row + h * 2 * D : row + H * 2 * D + kh * D;
-    const __nv_bfloat16* w = is_q ? qn_w : kn_w;
     float v[8];
     float ss = 0.f;
 #pragma unroll
@@ -379,7 +367,6 @@ extern "C" __global__ void __launch_bounds__(32) drama_attn_prep(const __nv_bflo
 #pragma unroll
     for (int i = 0; i < 8; ++i) v[i] = round_bf(v[i] * rcp * (1.0f + bf(w[lane * 8 + i])));
     // lanes 0..3 hold dims 0..31, lanes 4..7 dims 32..63: partner lane ^ 4
-    float o[8];
 #pragma unroll
     for (int i = 0; i < 8; ++i) {
         const float other = __shfl_xor_sync(0xffffffffu, v[i], 4);
@@ -392,6 +379,25 @@ extern "C" __global__ void __launch_bounds__(32) drama_attn_prep(const __nv_bflo
             o[i] = v[i];
         }
     }
+}
+
+// qkv rows: [per q head: q (256) | gate (256)] x H, then k (HK x 256), then v (HK x 256), ld_qkv apart.
+// q goes to q_out [rows][H][256]; k and v to the caches [context][HK][256] at pos0 + row.
+// Grid: (rows, H + HK); block 32 (a lane owns 8 dims).
+extern "C" __global__ void __launch_bounds__(32) drama_attn_prep(const __nv_bfloat16* qkv, int ld_qkv,
+                                                                const __nv_bfloat16* qn_w, const __nv_bfloat16* kn_w,
+                                                                const float* inv_freq, __nv_bfloat16* q_out,
+                                                                __nv_bfloat16* kc, __nv_bfloat16* vc, int pos0, int H,
+                                                                int HK, float eps) {
+    constexpr int D = 256;
+    const int r = blockIdx.x, h = blockIdx.y, lane = threadIdx.x;
+    const int pos = pos0 + r;
+    const __nv_bfloat16* row = qkv + static_cast<size_t>(r) * ld_qkv;
+    const bool is_q = h < H;
+    const int kh = h - H;
+    const __nv_bfloat16* src = is_q ? row + h * 2 * D : row + H * 2 * D + kh * D;
+    float o[8];
+    qk_norm_rope(src, is_q ? qn_w : kn_w, inv_freq, pos, eps, lane, o);
     __nv_bfloat16* dst = is_q ? q_out + (static_cast<size_t>(r) * H + h) * D
                               : kc + (static_cast<size_t>(pos) * HK + kh) * D;
 #pragma unroll
@@ -410,11 +416,16 @@ extern "C" __global__ void __launch_bounds__(32) drama_attn_prep(const __nv_bflo
 // denominator sums the fp32 p.
 // Row r (absolute position pos0 + r) sees keys 0..pos0 + r; query head h reads kv head h / (H / HK).
 // gate: per row at qkv + h * 512 + 256 (ld_qkv apart). out: bf16 [rows][H * 256].
+// With qn_w (one row only) the launch also does drama_attn_prep's work: each block runs the prologue for its q head
+// and, in the warp that owns key pos0, for the row's k head, whose k and v it takes from registers rather than the
+// cache; the first q head of each kv head appends them to the caches. q is then unused.
 // Grid: (rows, H); block 256: 8 warps take keys round-robin, a lane owns 8 dims.
-extern "C" __global__ void __launch_bounds__(256) drama_attention(const __nv_bfloat16* q, const __nv_bfloat16* kc,
-                                                                 const __nv_bfloat16* vc, const __nv_bfloat16* qkv,
+extern "C" __global__ void __launch_bounds__(256) drama_attention(const __nv_bfloat16* q, __nv_bfloat16* kc,
+                                                                 __nv_bfloat16* vc, const __nv_bfloat16* qkv,
                                                                  int ld_qkv, __nv_bfloat16* out, int pos0, int H,
-                                                                 int HK, float scale) {
+                                                                 int HK, float scale, const __nv_bfloat16* qn_w,
+                                                                 const __nv_bfloat16* kn_w, const float* inv_freq,
+                                                                 float eps) {
     constexpr int D = 256, NW = 8, U = 8;
     __shared__ float sm_m[NW], sm_l[NW];
     __shared__ float sm_o[NW][D];
@@ -422,26 +433,65 @@ extern "C" __global__ void __launch_bounds__(256) drama_attention(const __nv_bfl
     const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
     const int kh = h / (H / HK);
     const int last = pos0 + r;
-    float qv[8], o[8];
-    const __nv_bfloat16* qr = q + (static_cast<size_t>(r) * H + h) * D + lane * 8;
-#pragma unroll
-    for (int i = 0; i < 8; ++i) {
-        qv[i] = bf(qr[i]);
-        o[i] = 0.f;
-    }
-    float m = -INFINITY, l = 0.f;
-    // A warp's keys go U at a time with the next batch's loads in flight: loads and scores do not depend on the
-    // running softmax, whose update stays in key order. Keys past `last` load key `last` instead of branching.
+    const bool prologue = qn_w != nullptr;
+    const __nv_bfloat16* row = qkv + static_cast<size_t>(r) * ld_qkv;
+    // A warp's cached keys go U at a time with the next batch's loads in flight: loads and scores do not depend on
+    // the running softmax, whose update stays in key order. Loads past `cached` reload key `cached` instead of
+    // branching; with no cached key (the fused row at position 0) nothing is loaded, since row 0 is being appended.
+    const int cached = prologue ? last - 1 : last;
     const __nv_bfloat16* kp = kc + kh * D + lane * 8;
     const __nv_bfloat16* vp = vc + kh * D + lane * 8;
     uint4 kw[U], vw[U];
+    if (cached >= 0) {
 #pragma unroll
-    for (int u = 0; u < U; ++u) {
-        const size_t at = static_cast<size_t>(min(warp + u * NW, last)) * HK * D;
-        kw[u] = *reinterpret_cast<const uint4*>(kp + at);
-        vw[u] = *reinterpret_cast<const uint4*>(vp + at);
+        for (int u = 0; u < U; ++u) {
+            const size_t at = static_cast<size_t>(min(warp + u * NW, cached)) * HK * D;
+            kw[u] = *reinterpret_cast<const uint4*>(kp + at);
+            vw[u] = *reinterpret_cast<const uint4*>(vp + at);
+        }
+    }
+    float qv[8], o[8];
+    if (prologue) {
+        qk_norm_rope(row + h * 2 * D, qn_w, inv_freq, last, eps, lane, qv);
+#pragma unroll
+        for (int i = 0; i < 8; ++i) qv[i] = round_bf(qv[i]);
+    } else {
+        const __nv_bfloat16* qr = q + (static_cast<size_t>(r) * H + h) * D + lane * 8;
+#pragma unroll
+        for (int i = 0; i < 8; ++i) qv[i] = bf(qr[i]);
+    }
+    // The row's own key is the last key of warp last % NW; scored now, while the first loads are in flight.
+    const bool own = prologue && warp == last % NW;
+    float own_score = 0.f;
+    uint4 own_value{};
+    if (own) {
+        float kv[8];
+        qk_norm_rope(row + H * 2 * D + kh * D, kn_w, inv_freq, last, eps, lane, kv);
+        own_value = *reinterpret_cast<const uint4*>(row + H * 2 * D + HK * D + kh * D + lane * 8);
+        float dot = 0.f;
+#pragma unroll
+        for (int i = 0; i < 8; ++i) dot += qv[i] * round_bf(kv[i]);
+        own_score = warp_sum(dot) * scale;
+        if (h % (H / HK) == 0) {
+            const size_t at = (static_cast<size_t>(last) * HK + kh) * D + lane * 8;
+            store8(kc + at, kv);
+            *reinterpret_cast<uint4*>(vc + at) = own_value;
+        }
     }
-    for (int j0 = warp; j0 <= last; j0 += NW * U) {
+#pragma unroll
+    for (int i = 0; i < 8; ++i) o[i] = 0.f;
+    float m = -INFINITY, l = 0.f;
+    const auto step = [&](float score, const uint4& value) {
+        const float mn = fmaxf(m, score);
+        const float corr = expf(m - mn);  // m = -inf on the first key: 0
+        const float p = expf(score - mn);
+        l = l * corr + p;
+        const __nv_bfloat16* v = reinterpret_cast<const __nv_bfloat16*>(&value);
+#pragma unroll
+        for (int i = 0; i < 8; ++i) o[i] = o[i] * corr + round_bf(p) * bf(v[i]);
+        m = mn;
+    };
+    for (int j0 = warp; j0 <= cached; j0 += NW * U) {
         float sc[U];
         uint4 vb[U];
 #pragma unroll
@@ -452,26 +502,20 @@ extern "C" __global__ void __launch_bounds__(256) drama_attention(const __nv_bfl
             for (int i = 0; i < 8; ++i) dot += qv[i] * bf(k[i]);
             sc[u] = dot;
             vb[u] = vw[u];
-            const size_t at = static_cast<size_t>(min(j0 + (U + u) * NW, last)) * HK * D;
+            const size_t at = static_cast<size_t>(min(j0 + (U + u) * NW, cached)) * HK * D;
             kw[u] = *reinterpret_cast<const uint4*>(kp + at);
             vw[u] = *reinterpret_cast<const uint4*>(vp + at);
         }
 #pragma unroll
         for (int u = 0; u < U; ++u) sc[u] = warp_sum(sc[u]) * scale;
-        const int n = min(U, (last - j0) / NW + 1);
+        const int n = min(U, (cached - j0) / NW + 1);
 #pragma unroll
         for (int u = 0; u < U; ++u) {
             if (u >= n) break;
-            const float mn = fmaxf(m, sc[u]);
-            const float corr = expf(m - mn);  // m = -inf on the first key: 0
-            const float p = expf(sc[u] - mn);
-            l = l * corr + p;
-            const __nv_bfloat16* v = reinterpret_cast<const __nv_bfloat16*>(&vb[u]);
-#pragma unroll
-            for (int i = 0; i < 8; ++i) o[i] = o[i] * corr + round_bf(p) * bf(v[i]);
-            m = mn;
+            step(sc[u], vb[u]);
         }
     }
+    if (own) step(own_score, own_value);
     if (lane == 0) {
         sm_m[warp] = m;
         sm_l[warp] = l;
diff --git a/zig/src/families/drama/backbone_kernels.zig b/zig/src/families/drama/backbone_kernels.zig
