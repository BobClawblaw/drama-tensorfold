+            a.add(t.eps);
+            try go(s, k.attn_prep_fn, .{ t.rows, t.heads + t.kv_heads, 1 }, 32, &a);
+        }
         var b: cuda.Args = .{};
         b.add(t.q);
         b.add(t.kc);
@@ -300,6 +303,10 @@ pub const Kernels = struct {
         b.add(int(t.heads));
         b.add(int(t.kv_heads));
         b.add(t.scale);
+        b.add(if (one) t.q_norm else 0);
+        b.add(if (one) t.k_norm else 0);
