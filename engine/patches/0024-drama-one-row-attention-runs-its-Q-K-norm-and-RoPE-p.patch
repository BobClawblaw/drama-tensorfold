+        const one = t.rows == 1;
+        if (!one) {
+            var a: cuda.Args = .{};
+            a.add(t.qkv);
+            a.add(int(t.ld_qkv));
+            a.add(t.q_norm);
+            a.add(t.k_norm);
+            a.add(t.inv_freq);
+            a.add(t.q);
+            a.add(t.kc);
+            a.add(t.vc);
