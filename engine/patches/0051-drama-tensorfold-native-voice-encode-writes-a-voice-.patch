--- /dev/null
+++ b/zig/src/families/drama/clip.zig
@@ -0,0 +1,199 @@
+//! A clip's samples as FishReferenceEncodeHook hands them to the codec: WAV to FP32, channels averaged, 44.1 kHz.
+
+const std = @import("std");
+
+const Allocator = std.mem.Allocator;
+
+/// DAC.sample_rate.
+pub const sample_rate = 44100;
+/// drama_voice.py's max_reference_audio_seconds: the hook refuses longer clips.
+pub const max_seconds = 60;
+pub const max_samples = max_seconds * sample_rate;
+
+pub const Wav = struct { rate: u32, samples: []f32 };
+
+/// The clip's mono samples at 44.1 kHz, or null with `problem` set.
+pub fn prepare(a: Allocator, bytes: []const u8, problem: *[]const u8) Allocator.Error!?[]f32 {
+    const wav = try decode(a, bytes, problem) orelse return null;
+    const samples = if (wav.rate == sample_rate) wav.samples else try resample(a, wav.samples, wav.rate, sample_rate);
+    if (samples.len == 0) {
+        problem.* = "the clip holds no samples";
+        return null;
+    }
+    if (samples.len > max_samples) {
+        const seconds = @as(f64, @floatFromInt(samples.len)) / sample_rate;
+        problem.* = try std.fmt.allocPrint(a, "reference audio lasts {d:.1} s, longer than the {d} s limit; shorten it", .{ seconds, max_seconds });
+        return null;
+    }
+    for (samples) |*s| s.* = std.math.clamp(s.*, -1.0, 1.0);
+    return samples;
+}
+
+/// A PCM (8, 16, 24 or 32 bit) or IEEE float (32 or 64 bit) WAV file's channels averaged, or null with `problem` set.
+pub fn decode(a: Allocator, bytes: []const u8, problem: *[]const u8) Allocator.Error!?Wav {
+    if (bytes.len < 12 or !std.mem.eql(u8, bytes[0..4], "RIFF") or !std.mem.eql(u8, bytes[8..12], "WAVE")) {
+        problem.* = "the clip is not a RIFF/WAVE file";
+        return null;
+    }
+    var format: ?struct { tag: u16, channels: u16, rate: u32, block: u16, bits: u16 } = null;
+    var at: usize = 12;
+    while (at + 8 <= bytes.len) {
+        const id = bytes[at..][0..4];
+        const size = std.mem.readInt(u32, bytes[at + 4 ..][0..4], .little);
+        const body = bytes[at + 8 ..][0..@min(size, bytes.len - at - 8)];
+        if (std.mem.eql(u8, id, "fmt ") and body.len >= 16) {
+            var tag = std.mem.readInt(u16, body[0..2], .little);
+            // WAVE_FORMAT_EXTENSIBLE carries the real tag in its subformat GUID's first two bytes
+            if (tag == 0xFFFE and body.len >= 26) tag = std.mem.readInt(u16, body[24..26], .little);
+            format = .{
+                .tag = tag,
+                .channels = std.mem.readInt(u16, body[2..4], .little),
+                .rate = std.mem.readInt(u32, body[4..8], .little),
+                .block = std.mem.readInt(u16, body[12..14], .little),
+                .bits = std.mem.readInt(u16, body[14..16], .little),
+            };
+        } else if (std.mem.eql(u8, id, "data")) {
+            const f = format orelse break;
+            const width: usize = f.bits / 8;
+            const supported = (f.tag == 1 and (f.bits == 8 or f.bits == 16 or f.bits == 24 or f.bits == 32)) or (f.tag == 3 and (f.bits == 32 or f.bits == 64));
+            if (!supported or f.channels == 0 or f.rate == 0 or f.block != f.channels * width) {
+                problem.* = try std.fmt.allocPrint(a, "unsupported WAV encoding: format tag {d}, {d} bits; use PCM or IEEE float", .{ f.tag, f.bits });
+                return null;
+            }
+            const frames = body.len / f.block;
+            const out = try a.alloc(f32, frames);
+            for (out, 0..) |*o, i| {
+                var sum: f32 = 0;
+                for (0..f.channels) |c| sum += sample(body[(i * f.channels + c) * width ..][0..width], f.tag == 3);
+                o.* = sum / @as(f32, @floatFromInt(f.channels));
+            }
+            return .{ .rate = f.rate, .samples = out };
+        }
+        at += 8 + size + (size & 1);
+    }
+    problem.* = "the WAV file has no fmt chunk before its data chunk";
+    return null;
+}
+
+/// One sample as libsndfile reads it to float: integers scaled by 2^-(bits-1) (8-bit unsigned around 128).
+fn sample(b: []const u8, float: bool) f32 {
+    return switch (b.len) {
+        1 => @as(f32, @floatFromInt(@as(i32, b[0]) - 128)) / 128.0,
+        2 => @as(f32, @floatFromInt(std.mem.readInt(i16, b[0..2], .little))) / 32768.0,
+        3 => @as(f32, @floatFromInt(std.mem.readInt(i24, b[0..3], .little))) / 8388608.0,
+        4 => if (float) @bitCast(std.mem.readInt(u32, b[0..4], .little)) else @as(f32, @floatFromInt(std.mem.readInt(i32, b[0..4], .little))) / 2147483648.0,
+        8 => @floatCast(@as(f64, @bitCast(std.mem.readInt(u64, b[0..8], .little)))),
+        else => unreachable,
+    };
+}
+
+/// torchaudio.functional.resample at its defaults: the sinc_interp_hann kernel built in FP32, then the strided conv.
+pub fn resample(a: Allocator, x: []const f32, from: u32, to: u32) Allocator.Error![]f32 {
+    const zeros = 6;
+    const g = std.math.gcd(from, to);
+    const orig: usize = from / g;
+    const new: usize = to / g;
+    const base: f64 = @as(f64, @floatFromInt(@min(orig, new))) * 0.99;
+    const width: usize = @intFromFloat(@ceil(zeros * @as(f64, @floatFromInt(orig)) / base));
+    const taps = 2 * width + orig;
+    const kernel = try a.alloc(f32, new * taps);
+    defer a.free(kernel);
+    const pi: f32 = std.math.pi;
+    const scale: f32 = @floatCast(base / @as(f64, @floatFromInt(orig)));
+    for (0..new) |j| {
+        for (0..taps) |i| {
+            const idx = @as(f32, @floatFromInt(@as(isize, @intCast(i)) - @as(isize, @intCast(width)))) / @as(f32, @floatFromInt(orig));
+            var t = -@as(f32, @floatFromInt(j)) / @as(f32, @floatFromInt(new)) + idx;
+            t = std.math.clamp(t * @as(f32, @floatCast(base)), -zeros, zeros);
+            const c = @cos(t * pi / zeros / 2);
+            const window = c * c;
+            t *= pi;
+            const sinc: f32 = if (t == 0) 1 else @sin(t) / t;
+            kernel[j * taps + i] = sinc * (window * scale);
+        }
+    }
+    const target = (new * x.len + orig - 1) / orig;
+    const out = try a.alloc(f32, target);
+    for (out, 0..) |*o, n| {
+        const frame = n / new;
+        const j = n % new;
+        var acc: f32 = 0;
+        for (kernel[j * taps ..][0..taps], 0..) |k, i| {
+            const at = @as(isize, @intCast(frame * orig + i)) - @as(isize, @intCast(width));
+            if (at >= 0 and at < x.len) acc += x[@intCast(at)] * k;
+        }
+        o.* = acc;
+    }
+    return out;
+}
+
+fn testWav(a: Allocator, tag: u16, channels: u16, rate: u32, bits: u16, data: []const u8) ![]u8 {
+    const out = try a.alloc(u8, 44 + data.len);
+    @memcpy(out[0..4], "RIFF");
+    std.mem.writeInt(u32, out[4..8], @intCast(36 + data.len), .little);
+    @memcpy(out[8..16], "WAVEfmt ");
+    std.mem.writeInt(u32, out[16..20], 16, .little);
+    std.mem.writeInt(u16, out[20..22], tag, .little);
+    std.mem.writeInt(u16, out[22..24], channels, .little);
+    std.mem.writeInt(u32, out[24..28], rate, .little);
+    std.mem.writeInt(u32, out[28..32], rate * channels * bits / 8, .little);
+    std.mem.writeInt(u16, out[32..34], channels * bits / 8, .little);
+    std.mem.writeInt(u16, out[34..36], bits, .little);
+    @memcpy(out[36..40], "data");
+    std.mem.writeInt(u32, out[40..44], @intCast(data.len), .little);
+    @memcpy(out[44..], data);
+    return out;
+}
+
+test "WAV samples read as soundfile reads them, channels averaged, clamped" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var problem: []const u8 = "";
+    // stereo 16-bit: (1 + 2) / 32768 / 2 and (-32768 + 32767) / 32768 / 2
+    const pcm16 = try testWav(a, 1, 2, sample_rate, 16, &.{ 1, 0, 2, 0, 0x00, 0x80, 0xff, 0x7f });
+    try std.testing.expectEqualSlices(f32, &.{ 3.0 / 65536.0, -1.0 / 65536.0 }, (try prepare(a, pcm16, &problem)).?);
+    // 24-bit -2^23 is -1; 8-bit 255 is 127 / 128
+    const pcm24 = try testWav(a, 1, 1, sample_rate, 24, &.{ 0, 0, 0x80, 0xff, 0xff, 0x7f });
+    try std.testing.expectEqualSlices(f32, &.{ -1.0, 8388607.0 / 8388608.0 }, (try prepare(a, pcm24, &problem)).?);
+    const pcm8 = try testWav(a, 1, 1, sample_rate, 8, &.{ 255, 128 });
+    try std.testing.expectEqualSlices(f32, &.{ 127.0 / 128.0, 0 }, (try prepare(a, pcm8, &problem)).?);
+    // float beyond full scale is clamped as the hook clamps it under autocast
+    const float = try testWav(a, 3, 1, sample_rate, 32, std.mem.asBytes(&[_]f32{ 1.5, -0.25 }));
+    try std.testing.expectEqualSlices(f32, &.{ 1.0, -0.25 }, (try prepare(a, float, &problem)).?);
+}
+
+test "unreadable and over-long clips are refused" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var problem: []const u8 = "";
+    try std.testing.expect(try prepare(a, "ID3\x04 not a wav", &problem) == null);
+    try std.testing.expectEqualStrings("the clip is not a RIFF/WAVE file", problem);
+    const mp3 = try testWav(a, 0x55, 1, sample_rate, 16, &.{ 0, 0 });
+    try std.testing.expect(try prepare(a, mp3, &problem) == null);
+    try std.testing.expectEqualStrings("unsupported WAV encoding: format tag 85, 16 bits; use PCM or IEEE float", problem);
+    const silence = try a.alloc(u8, max_samples + 1);
+    @memset(silence, 128);
+    try std.testing.expect(try prepare(a, try testWav(a, 1, 1, sample_rate, 8, silence), &problem) == null);
+    try std.testing.expectEqualStrings("reference audio lasts 60.0 s, longer than the 60 s limit; shorten it", problem);
+    const exact = try testWav(a, 1, 1, sample_rate, 8, silence[0..max_samples]);
+    try std.testing.expectEqual(@as(usize, max_samples), (try prepare(a, exact, &problem)).?.len);
+}
+
+test "resampling matches torchaudio's sinc_interp_hann kernel" {
+    // torchaudio 2.11 resample of x[i] = ((37 i) mod 101 - 50) / 64, i < 200, from 48 and 22.05 kHz to 44.1 kHz
+    var x: [200]f32 = undefined;
+    for (&x, 0..) |*v, i| v.* = @as(f32, @floatFromInt(@as(isize, @intCast(i * 37 % 101)) - 50)) / 64.0;
+    const cases = .{
+        .{ 48000, 184, [_]usize{ 0, 1, 2, 5, 50, 91, 150, 182, 183 }, [_]u32{ 0xbf467ca1, 0xbdb199cf, 0x3e6fc71f, 0x3dd1dff0, 0x3d4ac4dc, 0xbe877cf1, 0x3e1dedf1, 0x3e2774ee, 0x3f0f4c8c } },
+        .{ 22050, 400, [_]usize{ 0, 1, 2, 3, 100, 201, 398, 399 }, [_]u32{ 0xbf47e3d1, 0xbf3a092a, 0xbe4efb70, 0x3eabd58c, 0xbe8a8bb7, 0xbe1fc8a7, 0x3f2411b7, 0x3ea99231 } },
+    };
+    inline for (cases) |c| {
+        const y = try resample(std.testing.allocator, &x, c[0], sample_rate);
+        defer std.testing.allocator.free(y);
+        try std.testing.expectEqual(@as(usize, c[1]), y.len);
+        // torch's vectorised sin/cos and convolution order differ from these in the last bits only
+        for (c[2], c[3]) |i, bits| try std.testing.expectApproxEqAbs(@as(f32, @bitCast(bits)), y[i], 1e-6);
+    }
+}
