diff --git a/zig/kernels/cuda/drama_codec.cuh b/zig/kernels/cuda/drama_codec.cuh
new file mode 100644
index 00000000..058d044e
--- /dev/null
+++ b/zig/kernels/cuda/drama_codec.cuh
@@ -0,0 +1,285 @@
+// Codec kernel bodies for the FP16 decode and BF16 encode, each rounded to T where the reference holds a T tensor.
+#pragma once
+
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+#include <mma.h>
+#include <stdint.h>
+
+namespace drama_codec {
+
+__device__ __forceinline__ float to_f(__half v) { return __half2float(v); }
+__device__ __forceinline__ float to_f(__nv_bfloat16 v) { return __bfloat162float(v); }
+__device__ __forceinline__ float to_f(float v) { return v; }
+
+template <typename T> __device__ __forceinline__ T from_f(float v);
+template <> __device__ __forceinline__ __half from_f<__half>(float v) { return __float2half_rn(v); }
+template <> __device__ __forceinline__ __nv_bfloat16 from_f<__nv_bfloat16>(float v) { return __float2bfloat16_rn(v); }
+template <> __device__ __forceinline__ float from_f<float>(float v) { return v; }
+
+// The FP32 value a T tensor would hold.
+template <typename T> __device__ __forceinline__ float round_to(float v) { return to_f(from_f<T>(v)); }
+
+constexpr int kHeadDim = 64;
+
+__device__ __forceinline__ float warp_sum(float v) {
+#pragma unroll
+  for (int o = 16; o > 0; o >>= 1) v += __shfl_xor_sync(0xffffffffu, v, o);
+  return v;
+}
+
+__device__ __forceinline__ float warp_max(float v) {
+#pragma unroll
+  for (int o = 16; o > 0; o >>= 1) v = fmaxf(v, __shfl_xor_sync(0xffffffffu, v, o));
+  return v;
+}
+
+// Sum over the block (blockDim.x a multiple of 32, at most 1024); every thread gets the total.
+__device__ __forceinline__ float block_sum(float v, float* part) {
+  v = warp_sum(v);
+  const int w = threadIdx.x >> 5, l = threadIdx.x & 31, n = blockDim.x >> 5;
+  __syncthreads();
+  if (l == 0) part[w] = v;
+  __syncthreads();
+  return warp_sum(l < n ? part[l] : 0.f);
+}
+
+__device__ __forceinline__ float block_max(float v, float* part) {
+  v = warp_max(v);
+  const int w = threadIdx.x >> 5, l = threadIdx.x & 31, n = blockDim.x >> 5;
+  __syncthreads();
+  if (l == 0) part[w] = v;
+  __syncthreads();
+  return warp_max(l < n ? part[l] : -__int_as_float(0x7f800000));
+}
+
+// RMSNorm: Out(round_to<In>(x * rsqrt(mean(x*x) + eps)) * w), FP32 statistics, type_as(x) before w. Grid rows; 256.
+template <typename In, typename W, typename Out>
+__device__ __forceinline__ void rms_norm(const In* __restrict__ x, const W* __restrict__ w, Out* __restrict__ y, int width,
+                                         float eps) {
+  __shared__ float part[32];
+  const In* xr = x + (size_t)blockIdx.x * width;
+  Out* yr = y + (size_t)blockIdx.x * width;
+  float s = 0.f;
+  for (int c = threadIdx.x; c < width; c += blockDim.x) {
+    const float v = to_f(xr[c]);
+    s += __fmul_rn(v, v);
+  }
+  s = block_sum(s, part);
+  const float r = rsqrtf(__fadd_rn(s / (float)width, eps));
+  for (int c = threadIdx.x; c < width; c += blockDim.x)
+    yr[c] = from_f<Out>(__fmul_rn(round_to<In>(__fmul_rn(to_f(xr[c]), r)), to_f(w[c])));
+}
+
+// apply_rotary_emb on q, k of [q | k | v] rows: x0*c - x1*s, x1*c + x0*s in FP32, table [rows][32][2]. Grid rows; 256.
+template <typename T>
+__device__ __forceinline__ void rope(T* __restrict__ qkv, const T* __restrict__ table, int width, int ld) {
+  T* row = qkv + (size_t)blockIdx.x * ld;
+  const T* tab = table + (size_t)blockIdx.x * kHeadDim;
+  const int pairs = width / 2;
+  for (int p = threadIdx.x; p < 2 * pairs; p += blockDim.x) {
+    const int which = p / pairs, pp = p % pairs, i = pp % (kHeadDim / 2);
+    T* e = row + which * width + pp * 2;
+    const float x0 = to_f(e[0]), x1 = to_f(e[1]);
+    const float c = to_f(tab[2 * i]), s = to_f(tab[2 * i + 1]);
+    e[0] = from_f<T>(__fsub_rn(__fmul_rn(x0, c), __fmul_rn(x1, s)));
+    e[1] = from_f<T>(__fadd_rn(__fmul_rn(x1, c), __fmul_rn(x0, s)));
+  }
+}
+
+// Causal window attention as Torch's efficient path: 64-key tiles, exp2, T probabilities, FP32 sums. Grid (q, h); 128.
+template <typename T>
+__device__ __forceinline__ void window_attention(const T* __restrict__ qkv, T* __restrict__ out, int t0, int heads,
+                                                 int window, float scale) {
+  constexpr int tile = 64;
+  __shared__ float q[kHeadDim], p[tile], part[32];
+  const int t = t0 + blockIdx.x, h = blockIdx.y, j = threadIdx.x;
+  const size_t ld = (size_t)3 * heads * kHeadDim;
+  if (j < kHeadDim) q[j] = to_f(qkv[(size_t)t * ld + h * kHeadDim + j]);
+  __syncthreads();
+  const int first = max(0, t - window + 1);
+  float maximum = -__int_as_float(0x7f800000), denominator = 0.f, numerator = 0.f;
+  for (int start = first / tile * tile; start <= t; start += tile) {
+    const int key = start + j;
+    const bool valid = j < tile && key >= first && key <= t;
+    float score = -__int_as_float(0x7f800000);
+    if (valid) {
+      const T* k = qkv + (size_t)key * ld + (size_t)heads * kHeadDim + h * kHeadDim;
+      float dot = 0.f;
+#pragma unroll 16
+      for (int d = 0; d < kHeadDim; ++d) dot = fmaf(q[d], to_f(k[d]), dot);
+      score = (dot * scale) * 1.4426950408889634074f;
+    }
+    const float next_maximum = fmaxf(maximum, block_max(score, part));
+    const float rescale = exp2f(maximum - next_maximum);
+    const float probability = valid ? exp2f(score - next_maximum) : 0.f;
+    if (j < tile) p[j] = round_to<T>(probability);
+    const float mass = block_sum(probability, part);  // also publishes p[]
+    denominator = denominator * rescale + mass;
+    if (j < kHeadDim) {
+      numerator *= rescale;
+      for (int i = 0; i < tile && start + i <= t; ++i) {
+        if (start + i < first) continue;
+        const T v = qkv[(size_t)(start + i) * ld + (size_t)2 * heads * kHeadDim + h * kHeadDim + j];
+        numerator = fmaf(p[i], to_f(v), numerator);
+      }
+    }
+    maximum = next_maximum;
+    __syncthreads();
+  }
+  if (j < kHeadDim) out[(size_t)t * heads * kHeadDim + h * kHeadDim + j] = from_f<T>(numerator / denominator);
+}
+
+// F.silu(w1(x)) * w3(x) over [rows][2 * width] (w1 | w3): silu rounded, then the product. Grid ceil(rows*width/256).
+template <typename T>
+__device__ __forceinline__ void silu_mul(const T* __restrict__ gu, T* __restrict__ out, long long rows, int width) {
+  const long long i = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+  if (i >= rows * width) return;
+  const long long r = i / width, c = i % width;
+  const float a = to_f(gu[r * 2 * width + c]);
+  const float b = to_f(gu[r * 2 * width + width + c]);
+  out[i] = from_f<T>(round_to<T>(a / (1.0f + expf(-a))) * b);
+}
+
+// nn.LayerNorm (eps 1e-6): FP32 mean and biased variance, Out(gamma * (rstd * (x - mean)) + beta). Grid rows; 256.
+template <typename In, typename W, typename Out>
+__device__ __forceinline__ void layer_norm(const In* __restrict__ x, const W* __restrict__ w, const W* __restrict__ b,
+                                           Out* __restrict__ y, int width, float eps) {
+  __shared__ float part[32];
+  const In* xr = x + (size_t)blockIdx.x * width;
+  Out* yr = y + (size_t)blockIdx.x * width;
+  float s = 0.f;
+  for (int c = threadIdx.x; c < width; c += blockDim.x) s += to_f(xr[c]);
+  const float mean = block_sum(s, part) / (float)width;
+  float v = 0.f;
+  for (int c = threadIdx.x; c < width; c += blockDim.x) {
+    const float d = to_f(xr[c]) - mean;
+    v = fmaf(d, d, v);
+  }
+  const float rstd = rsqrtf(block_sum(v, part) / (float)width + eps);
+  for (int c = threadIdx.x; c < width; c += blockDim.x)
+    yr[c] = from_f<Out>(fmaf(to_f(w[c]), rstd * (to_f(xr[c]) - mean), to_f(b[c])));
+}
+
+// ConvNeXt's causal depthwise conv 7, then the bias add_: rows t0.. of [..][width], w [width][7]. Grid over elements.
+template <typename T>
+__device__ __forceinline__ void dwconv7(const T* __restrict__ x, const T* __restrict__ w, const T* __restrict__ b,
+                                        T* __restrict__ y, long long t0, long long rows, int width) {
+  const long long i = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+  if (i >= rows * width) return;
+  const long long t = t0 + i / width;
+  const int c = (int)(i % width);
+  float acc = 0.f;
+#pragma unroll
+  for (int k = 0; k < 7; ++k) {
+    const long long r = t - 6 + k;
+    if (r >= 0) acc = fmaf(to_f(x[r * width + c]), to_f(w[c * 7 + k]), acc);
+  }
+  y[t * width + c] = from_f<T>(round_to<T>(acc) + to_f(b[c]));
+}
+
+// Implicit GEMM, 128x128 tiles: acc[m][n] = sum over tap, ci of x[m - (taps-1-tap) * d][ci] * w[n][tap*cin + ci].
+constexpr int BM = 128, BN = 128, BK = 32, LDS = BK + 8;
+
+// stride: the encode's; its Blocked convs read row m * stride + (tap - taps + 1) * dilation + stride - 1.
+struct GemmShape {
+  long long m, m_begin;
+  int n, cin, taps, dilation, ldx, stride;
+};
+
+// Blocked: K over 32-channel blocks, then taps, then channels, as cuDNN sums a BF16 conv (weights laid out alike).
+template <typename T, bool Blocked = false, typename Store>
+__device__ __forceinline__ void conv_gemm(const T* __restrict__ x, const T* __restrict__ w, const GemmShape& g,
+                                          Store store) {
+  using namespace nvcuda;
+  __shared__ __align__(128) T as[BM * LDS];
+  __shared__ __align__(128) T bs[BN * LDS];
+  __shared__ __align__(128) float cs[8][16 * 16];
+  const int tid = threadIdx.x, warp = tid >> 5, lane = tid & 31;
+  const int wm = warp >> 2, wn = warp & 3;
+  const long long m0 = (g.m_begin / BM + blockIdx.x) * BM;
+  const int n0 = blockIdx.y * BN;
+  const int ktot = g.taps * g.cin;
+
+  wmma::fragment<wmma::accumulator, 16, 16, 16, float> acc[4][2];
+#pragma unroll
+  for (int i = 0; i < 4; ++i)
+#pragma unroll
+    for (int j = 0; j < 2; ++j) wmma::fill_fragment(acc[i][j], 0.f);
+
+  uint4 ra[2], rb[2];
+  auto fetch = [&](int k0) {
+#pragma unroll
+    for (int i = 0; i < 2; ++i) {
+      const int v = tid + i * 256;
+      const int r = v >> 2, c = (v & 3) * 8;
+      const int kk = k0 + c;
+      uint4 a = make_uint4(0u, 0u, 0u, 0u), b = make_uint4(0u, 0u, 0u, 0u);
+      const long long m = m0 + r;
+      if (m >= g.m_begin && m < g.m && kk < ktot) {
+        int tap, ci;
+        long long rin;
+        if constexpr (Blocked) {
+          const int block = kk / (32 * g.taps), within = kk % (32 * g.taps);
+          tap = within / 32;
+          ci = block * 32 + within % 32;
+          rin = m * g.stride + (long long)(tap - g.taps + 1) * g.dilation + g.stride - 1;
+        } else {
+          tap = kk / g.cin;
+          ci = kk - tap * g.cin;
+          rin = m - (long long)(g.taps - 1 - tap) * g.dilation;
+        }
+        if (rin >= 0) a = *reinterpret_cast<const uint4*>(x + rin * g.ldx + ci);
+      }
+      const int n = n0 + r;
+      if (n < g.n && kk < ktot) b = *reinterpret_cast<const uint4*>(w + (size_t)n * ktot + kk);
+      ra[i] = a;
+      rb[i] = b;
+    }
+  };
+
+  fetch(0);
+  for (int k0 = 0; k0 < ktot; k0 += BK) {
+    __syncthreads();
+#pragma unroll
+    for (int i = 0; i < 2; ++i) {
+      const int v = tid + i * 256;
+      const int r = v >> 2, c = (v & 3) * 8;
+      *reinterpret_cast<uint4*>(&as[r * LDS + c]) = ra[i];
+      *reinterpret_cast<uint4*>(&bs[r * LDS + c]) = rb[i];
+    }
+    __syncthreads();
+    if (k0 + BK < ktot) fetch(k0 + BK);
+#pragma unroll
+    for (int kk = 0; kk < BK; kk += 16) {
+      wmma::fragment<wmma::matrix_a, 16, 16, 16, T, wmma::row_major> af[4];
+      wmma::fragment<wmma::matrix_b, 16, 16, 16, T, wmma::col_major> bf[2];
+#pragma unroll
+      for (int i = 0; i < 4; ++i) wmma::load_matrix_sync(af[i], as + (wm * 64 + i * 16) * LDS + kk, LDS);
+#pragma unroll
+      for (int j = 0; j < 2; ++j) wmma::load_matrix_sync(bf[j], bs + (wn * 32 + j * 16) * LDS + kk, LDS);
+#pragma unroll
+      for (int i = 0; i < 4; ++i)
+#pragma unroll
+        for (int j = 0; j < 2; ++j) wmma::mma_sync(acc[i][j], af[i], bf[j], acc[i][j]);
+    }
+  }
+
+  float* c = cs[warp];
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+#pragma unroll
+    for (int j = 0; j < 2; ++j) {
+      wmma::store_matrix_sync(c, acc[i][j], 16, wmma::mem_row_major);
+      __syncwarp();
+      for (int e = lane; e < 256; e += 32) {
+        const long long m = m0 + wm * 64 + i * 16 + (e >> 4);
+        const int n = n0 + wn * 32 + j * 16 + (e & 15);
+        if (m >= g.m_begin && m < g.m && n < g.n) store(m, n, c[e]);
+      }
+      __syncwarp();
+    }
+  }
+}
+
+}  // namespace drama_codec
diff --git a/zig/kernels/cuda/drama_codec_encode.cu b/zig/kernels/cuda/drama_codec_encode.cu
new file mode 100644
index 00000000..bd6f92e1
--- /dev/null
+++ b/zig/kernels/cuda/drama_codec_encode.cu
@@ -0,0 +1,261 @@
+// Drama 3 codec encode (DAC encoder, downsampler, pre_module, RVQ) as FishReferenceEncodeHook runs it in BF16 autocast.
+
+// Convs and linears round to BF16 (b()); Snake, norms, gamma and residual sums stay FP32; activations are [rows][ch].
+
+#include "drama_codec.cuh"
+
+using namespace drama_codec;
+using bf16 = __nv_bfloat16;
+
+namespace {
+constexpr int kLatent = 1024;
+constexpr int kCodebookDim = 8;
+constexpr int kBooks = 10;
+constexpr int kSemanticSize = 4096;
+constexpr int kResidualSize = 1024;
+constexpr int kInChannels = 64;
+// The VQ distance tile: 16 frames by 16 codes, the codebook dimension zero-padded from 8 to the MMA's 16.
+constexpr int kTile = 16;
+constexpr int kVqWarps = 4;
+
+__device__ __forceinline__ float rb(float v) { return round_to<bf16>(v); }
+}  // namespace
+
+// encoder.block[0], conv 1 -> 64 kernel 7 over the clip cast to BF16: [rows] -> [rows][64] = b(b(acc) + bias).
+extern "C" __global__ void __launch_bounds__(256) drama_encode_conv_in(const float* __restrict__ audio,
+                                                                       const bf16* __restrict__ w,
+                                                                       const bf16* __restrict__ b,
+                                                                       bf16* __restrict__ y, long long rows) {
+  const long long i = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+  if (i >= rows * kInChannels) return;
+  const long long t = i / kInChannels;
+  const int c = (int)(i % kInChannels);
+  float acc = 0.f;
+#pragma unroll
+  for (int k = 0; k < 7; ++k) {
+    const long long r = t - 6 + k;
+    if (r >= 0) acc = fmaf(rb(audio[r]), to_f(w[c * 7 + k]), acc);
+  }
+  y[i] = from_f<bf16>(rb(acc) + to_f(b[c]));
+}
+
+// Snake1d in FP32 to BF16; `fused`: TorchScript's fused kernel (last multiply-add one FMA), else op by op. In place ok.
+template <typename In>
+__device__ __forceinline__ void snake(const In* x, const float* __restrict__ alpha, const float* __restrict__ inv_alpha,
+                                      bf16* y, long long n, int width, int fused) {
+  const long long i = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+  if (i >= n) return;
+  const int c = (int)(i % width);
+  const float v = to_f(x[i]);
+  const float s = sinf(__fmul_rn(alpha[c], v));
+  const float s2 = __fmul_rn(s, s);
+  y[i] = from_f<bf16>(fused ? fmaf(inv_alpha[c], s2, v) : __fadd_rn(v, __fmul_rn(inv_alpha[c], s2)));
+}
+
+extern "C" __global__ void __launch_bounds__(256) drama_encode_snake(const bf16* x, const float* alpha,
+                                                                     const float* inv_alpha, bf16* y, long long n,
+                                                                     int width, int fused) {
+  snake(x, alpha, inv_alpha, y, n, width, fused);
+}
+
+extern "C" __global__ void __launch_bounds__(256) drama_encode_snake_f32(const float* x, const float* alpha,
+                                                                         const float* inv_alpha, bf16* y, long long n,
+                                                                         int width, int fused) {
+  snake(x, alpha, inv_alpha, y, n, width, fused);
+}
+
+// RMSNorm over BF16 or FP32 rows with its FP32 weight, into the BF16 a linear reads or the FP32 the next op keeps.
+extern "C" __global__ void __launch_bounds__(256) drama_encode_rms_norm(const bf16* x, const float* w, bf16* y,
+                                                                        int width, float eps) {
+  rms_norm(x, w, y, width, eps);
+}
+
+extern "C" __global__ void __launch_bounds__(256) drama_encode_rms_norm_to_f32(const bf16* x, const float* w,
+                                                                               float* y, int width, float eps) {
+  rms_norm(x, w, y, width, eps);
+}
+
+extern "C" __global__ void __launch_bounds__(256) drama_encode_rms_norm_f32(const float* x, const float* w, bf16* y,
+                                                                            int width, float eps) {
+  rms_norm(x, w, y, width, eps);
+}
+
+extern "C" __global__ void __launch_bounds__(256) drama_encode_rms_norm_f32_to_f32(const float* x, const float* w,
+                                                                                   float* y, int width, float eps) {
+  rms_norm(x, w, y, width, eps);
+}
+
+extern "C" __global__ void __launch_bounds__(256) drama_encode_rope(bf16* qkv, const bf16* table, int width, int ld) {
+  rope(qkv, table, width, ld);
+}
+
+extern "C" __global__ void __launch_bounds__(128) drama_encode_window_attention(const bf16* qkv, bf16* out, int t0,
+                                                                                int heads, int window, float scale) {
+  window_attention(qkv, out, t0, heads, window, scale);
+}
+
+extern "C" __global__ void __launch_bounds__(256) drama_encode_silu_mul(const bf16* gu, bf16* out, long long rows,
+                                                                        int width) {
+  silu_mul(gu, out, rows, width);
+}
+
+// ConvNeXtBlock.norm: autocast runs layer_norm in FP32 with its FP32 weights; pwconv1 reads the result as BF16.
+extern "C" __global__ void __launch_bounds__(256) drama_encode_layer_norm(const bf16* x, const float* w, const float* b,
+                                                                          bf16* y, int width, float eps) {
+  layer_norm(x, w, b, y, width, eps);
+}
+
+extern "C" __global__ void __launch_bounds__(256) drama_encode_dwconv7(const bf16* x, const bf16* w, const bf16* b,
+                                                                       bf16* y, long long rows, int width) {
+  dwconv7(x, w, b, y, 0, rows, width);
+}
+
+// Every encode conv and linear: K in cuDNN's order (32-channel blocks, taps, channels); conv row m * s - (k - s) + tap.
+struct EncodeGemmParams {
+  const bf16* x;
+  const bf16* w;
+  const bf16* bias;        // [n] or null
+  const float* scale;      // [n] or null
+  const void* residual;    // [m][ldr] or null (may alias y)
+  void* y;
+  long long m;
+  int n, cin, taps, dilation, stride, ldx, ldy, ldr, bias_mode, act, flags;
+};
+
+enum : int { kRoundScaled = 1, kResidualF32 = 2, kOutF32 = 4 };
+
+// Epilogue in the reference's order: bias, GELU, FP32 scale (rounded for LayerScale's mul_), FP32 residual sum.
+extern "C" __global__ void __launch_bounds__(256) drama_encode_gemm(const EncodeGemmParams p) {
+  const GemmShape g = {p.m, 0, p.n, p.cin, p.taps, p.dilation, p.ldx, p.stride};
+  conv_gemm<bf16, true>(p.x, p.w, g, [&](long long m, int n, float acc) {
+    float v;
+    if (p.bias_mode == 1) {
+      v = rb(acc + to_f(p.bias[n]));
+    } else {
+      v = rb(acc);
+      if (p.bias_mode == 2) v = rb(v + to_f(p.bias[n]));
+    }
+    if (p.act == 1) v = rb(v * 0.5f * (1.0f + erff(v * 0.70710678118654752440f)));
+    if (p.scale != nullptr) {
+      v = v * p.scale[n];
+      if (p.flags & kRoundScaled) v = rb(v);
+    }
+    if (p.residual != nullptr) {
+      const long long at = m * p.ldr + n;
+      v = (p.flags & kResidualF32 ? static_cast<const float*>(p.residual)[at]
+                                  : to_f(static_cast<const bf16*>(p.residual)[at])) + v;
+    }
+    const long long at = m * p.ldy + n;
+    if (p.flags & kOutF32) static_cast<float*>(p.y)[at] = v;
+    else static_cast<bf16*>(p.y)[at] = from_f<bf16>(v);
+  });
+}
+
+// dac RVQ, 16 frames a block: per book the first argmin of (sum x^2 - 2 x . c) + sum c^2, then r -= out_proj(z_q).
+extern "C" __global__ void __launch_bounds__(kVqWarps * 32) drama_encode_rvq(
+    float* __restrict__ z, uint32_t* __restrict__ codes, const bf16* __restrict__ in_w, const bf16* __restrict__ in_b,
+    const bf16* __restrict__ books, const float* __restrict__ books_sq, const float* __restrict__ books_raw,
+    const bf16* __restrict__ out_w, const bf16* __restrict__ out_b, int frames) {
+  using namespace nvcuda;
+  __shared__ float ze[kTile][kCodebookDim], x_sq[kTile];
+  __shared__ __align__(32) bf16 x[kTile * kTile];
+  __shared__ __align__(32) float tile[kVqWarps][kTile * kTile];
+  __shared__ float best_dist[kVqWarps * 32];
+  __shared__ int best_code[kVqWarps * 32];
+  __shared__ bf16 zq[kTile][kCodebookDim];
+  const int tid = threadIdx.x, warp = tid >> 5, lane = tid & 31;
+  const int f0 = blockIdx.x * kTile;
+  const int rows = min(kTile, frames - f0);
+  int book_start = 0;
+  for (int book = 0; book < kBooks; ++book) {
+    const int size = book == 0 ? kSemanticSize : kResidualSize;
+    {  // in_proj: one thread per (frame, output)
+      const int f = tid / kCodebookDim, j = tid % kCodebookDim;
+      float v = 0.f;
+      if (f < rows) {
+        const float* r = z + (size_t)(f0 + f) * kLatent;
+        const bf16* wr = in_w + ((size_t)book * kCodebookDim + j) * kLatent;
+        float acc = 0.f;
+        for (int c = 0; c < kLatent; ++c) acc = fmaf(rb(r[c]), to_f(wr[c]), acc);
+        v = rb(rb(acc) + to_f(in_b[book * kCodebookDim + j]));
+      }
+      ze[f][j] = v;
+    }
+    __syncthreads();
+    if (tid < kTile) {  // F.normalize and sum of squares over the strided [frames, 8] view
+      float acc[4];
+#pragma unroll
+      for (int j = 0; j < 4; ++j) acc[j] = __fadd_rn(__fmul_rn(ze[tid][j], ze[tid][j]), __fmul_rn(ze[tid][j + 4], ze[tid][j + 4]));
+      const float norm = fmaxf(sqrtf(__fadd_rn(__fadd_rn(__fadd_rn(acc[0], acc[1]), acc[2]), acc[3])), 1e-12f);
+      float xn[kCodebookDim];
+#pragma unroll
+      for (int j = 0; j < kCodebookDim; ++j) xn[j] = __fdiv_rn(ze[tid][j], norm);
+#pragma unroll
+      for (int j = 0; j < 4; ++j) acc[j] = __fadd_rn(__fmul_rn(xn[j], xn[j]), __fmul_rn(xn[j + 4], xn[j + 4]));
+      x_sq[tid] = __fadd_rn(__fadd_rn(__fadd_rn(acc[0], acc[1]), acc[2]), acc[3]);
+      // 2 * x in BF16: the reference scales x before the matmul; doubling commutes with every rounding
+#pragma unroll
+      for (int j = 0; j < kTile; ++j) x[tid * kTile + j] = from_f<bf16>(j < kCodebookDim ? 2.f * xn[j] : 0.f);
+    }
+    __syncthreads();
+    {  // distances to every code of the book, 16 x 16 per MMA; each lane keeps one frame's best over its codes
+      wmma::fragment<wmma::matrix_a, kTile, kTile, kTile, bf16, wmma::row_major> a;
+      wmma::load_matrix_sync(a, x, kTile);
+      const int f = lane % kTile, half = lane / kTile;
+      float best = __int_as_float(0x7f800000);
+      int arg = 0;
+      for (int k0 = warp * kTile; k0 < size; k0 += kVqWarps * kTile) {
+        wmma::fragment<wmma::matrix_b, kTile, kTile, kTile, bf16, wmma::col_major> b;
+        wmma::fragment<wmma::accumulator, kTile, kTile, kTile, float> d;
+        wmma::fill_fragment(d, 0.f);
+        wmma::load_matrix_sync(b, books + (size_t)(book_start + k0) * kTile, kTile);
+        wmma::mma_sync(d, a, b, d);
+        wmma::store_matrix_sync(tile[warp], d, kTile, wmma::mem_row_major);
+        __syncwarp();
+        for (int i = half * 8; i < half * 8 + 8; ++i) {
+          const int code = k0 + i;
+          const float dist = __fadd_rn(__fsub_rn(x_sq[f], rb(tile[warp][f * kTile + i])), books_sq[book_start + code]);
+          if (dist < best) {
+            best = dist;
+            arg = code;
+          }
+        }
+        __syncwarp();
+      }
+      best_dist[tid] = best;
+      best_code[tid] = arg;
+    }
+    __syncthreads();
+    {  // first argmin over the lanes holding each frame, then the straight-through z_q
+      const int f = tid / kCodebookDim, j = tid % kCodebookDim;
+      float best = __int_as_float(0x7f800000);
+      int arg = 0;
+      for (int w = 0; w < kVqWarps; ++w) {
+        for (int half = 0; half < 2; ++half) {
+          const int at = w * 32 + half * kTile + f;
+          if (best_dist[at] < best || (best_dist[at] == best && best_code[at] < arg)) {
+            best = best_dist[at];
+            arg = best_code[at];
+          }
+        }
+      }
+      if (f < rows && j == 0) codes[(size_t)(f0 + f) * kBooks + book] = arg;
+      const float e = ze[f][j];
+      zq[f][j] = from_f<bf16>(__fadd_rn(e, __fsub_rn(books_raw[(size_t)(book_start + arg) * kCodebookDim + j], e)));
+    }
+    __syncthreads();
+    for (int c = tid; c < kLatent; c += blockDim.x) {  // out_proj, subtracted from the FP32 residual
+      const bf16* wr = out_w + ((size_t)book * kLatent + c) * kCodebookDim;
+      const float bias = to_f(out_b[book * kLatent + c]);
+      for (int f = 0; f < rows; ++f) {
+        float acc = 0.f;
+#pragma unroll
+        for (int j = 0; j < kCodebookDim; ++j) acc = fmaf(to_f(zq[f][j]), to_f(wr[j]), acc);
+        float* r = z + (size_t)(f0 + f) * kLatent + c;
+        *r = __fsub_rn(*r, rb(rb(acc) + bias));
+      }
+    }
+    __syncthreads();
+    book_start += size;
+  }
+}
