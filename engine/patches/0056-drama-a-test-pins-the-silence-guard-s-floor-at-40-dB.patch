From 9beeb409db4b528f9e03d7c62847d129dba00c9d Mon Sep 17 00:00:00 2001
From: plotarmordev <299844489+plotarmordev@users.noreply.github.com>
Date: Sat, 17 Oct 2026 12:19:11 +0800
Subject: [PATCH 56/57] drama: a test pins the silence guard's floor at -40
 dBFS on both cadences

10 s just under the floor (-40.09 dBFS) must end the reply at the frame that completes it; 10 s just over it
(-39.91 dBFS), or frames on both sides of it within every decode chunk, must not. The test fails with the floor at
-60 dBFS, at 0.96e-4 and at 1.04e-4 (about 0.2 dB either side of 1e-4).
---
 zig/src/native/drama_generate.zig | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/zig/src/native/drama_generate.zig b/zig/src/native/drama_generate.zig
index 623ee470..af9d2a80 100644
--- a/zig/src/native/drama_generate.zig
+++ b/zig/src/native/drama_generate.zig
@@ -228,3 +228,18 @@ test "quiet speech above -40 dBFS is not silence, nor are its pauses at its voic
     @memset(&levels, 0.011);
     try std.testing.expectEqual(Ending{ .frames = levels.len, .reason = .stop }, (try ends(&levels, 4096, whole))[0]);
 }
+
+test "the floor is -40 dBFS: 10 s just under it trips; just over it, or straddling it within each chunk, does not" {
+    const under: f32 = 0.0099; // -40.09 dBFS
+    const over: f32 = 0.0101; // -39.91 dBFS
+    var levels: [28 + 300]f32 = undefined; // 1.3 s of speech, then 13.9 s at the floor
+    @memset(levels[0..28], speech);
+    for ([_]Cadence{ stream, whole }) |cadence| {
+        @memset(levels[28..], under);
+        try std.testing.expectEqual(Ending{ .frames = 28 + 216, .reason = .silence }, (try ends(&levels, 4096, cadence))[0]);
+        @memset(levels[28..], over);
+        try std.testing.expectEqual(Ending{ .frames = levels.len, .reason = .stop }, (try ends(&levels, 4096, cadence))[0]);
+        for (levels[28..], 0..) |*level, i| level.* = if (i % 3 == 2) over else under; // both sides in every chunk
+        try std.testing.expectEqual(Ending{ .frames = levels.len, .reason = .stop }, (try ends(&levels, 4096, cadence))[0]);
+    }
+}
