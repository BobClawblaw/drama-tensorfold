             const x: cuda.DeviceBuffer = .{ .d = self.d, .ptr = self.s.x, .len = bytes, .borrowed = true };
             try x.downloadAsync(0, output[at..][0..bytes], stream.handle);
@@ -440,6 +444,7 @@ pub const Model = struct {
 
     /// Qwen2MoeSparseMoeBlock with bsgemm-moe experts: softmax top-8 renormalized routing, W8A8 block-FP8 experts
     /// (dynamic 1 x 128 activation scales), SwiGLU, routed-weighted down, plus the sigmoid-gated shared expert.
+    /// Input: Scratch.normed and its FP8 groups in xq / xs (the post-attention addNorm writes both).
     fn moe(self: *Model, s: cuda.Stream, l: *const weights.Layer, n: usize) !void {
         const k = &self.k;
         const sc = &self.s;
@@ -448,7 +453,6 @@ pub const Model = struct {
         const I = config.expert_inner;
         try k.gemm(s, sc.normed, H, n, l.moe_in, ld, H, sc.moe_in, ld);
