+    defer gpa.free(path);
+    const image = try std.Io.Dir.cwd().readFileAllocOptions(io, path, gpa, .limited(1 << 26), .@"16", null);
+    defer gpa.free(image);
+    return cuda.Module.load(d, image);
+}
