+    fn gemvRow(p: *Impl, stream: cuda.Stream, kind: usize, x: Buffer, w: Buffer, out: Buffer) !void {
+        comptime for (projections) |shape| std.debug.assert(shape[0] % 8 == 0 and shape[1] % 256 == 0);
