+// Programmatic dependent launch: the wait returns once the previous kernel in the stream has completed and its writes
+// are visible (at once if it has); the trigger lets the next PDL launch start. Every kernel here calls it before any
+// other global access, except that the one-row GEMV first queues its leading weight stages (weights are never written
+// while the backbone runs). sm_90+ only, where drama_pdl marks the image.
+__device__ __forceinline__ void grid_dependency() {
+#if __CUDA_ARCH__ >= 900
+    asm volatile("griddepcontrol.wait;\n" ::: "memory");
+    asm volatile("griddepcontrol.launch_dependents;\n" ::: "memory");
+#endif
+}
+
