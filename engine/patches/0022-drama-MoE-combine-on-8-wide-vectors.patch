From 6e02fd6d6a6c42d808b4726956eefb5bcf30d9bb Mon Sep 17 00:00:00 2001
From: plotarmordev <299844489+plotarmordev@users.noreply.github.com>
Date: Fri, 16 Oct 2026 11:13:19 +0800
Subject: [PATCH 22/30] drama: MoE combine on 8-wide vectors

Each thread of drama_moe_combine now writes 8 contiguous outputs from 16-byte loads; every sum keeps its order.
---
 zig/kernels/cuda/drama_backbone.cu          | 22 +++++++++++++++------
 zig/src/families/drama/backbone_kernels.zig |  1 +
 2 files changed, 17 insertions(+), 6 deletions(-)

diff --git a/zig/kernels/cuda/drama_backbone.cu b/zig/kernels/cuda/drama_backbone.cu
index 4d54b002..954b3457 100644
--- a/zig/kernels/cuda/drama_backbone.cu
+++ b/zig/kernels/cuda/drama_backbone.cu
@@ -603,7 +603,8 @@ extern "C" __global__ void __launch_bounds__(128) drama_silu_mul(const __nv_bflo
 
 // MoE output: routed = bf16(sum over the top slots of float(down[row * top + s])) (moe_sum_reduce, scaling 1),
 // then fused_gate_sigmoid_mul_add: out = bf16(sigmoid(sum_i float(x[i]) float(wg[i])) * float(shared) + routed).
-// x: the MoE input row (post-attention norm); wg: shared_expert_gate.weight [width]. Grid: rows; block 256.
+// x: the MoE input row (post-attention norm); wg: shared_expert_gate.weight [width]. width % 8 == 0.
+// Grid: rows; block 256 (a thread 8 contiguous outputs).
 extern "C" __global__ void __launch_bounds__(256) drama_moe_combine(const __nv_bfloat16* down, int top,
                                                                    const __nv_bfloat16* x, const __nv_bfloat16* wg,
                                                                    const __nv_bfloat16* shared, __nv_bfloat16* out,
@@ -613,10 +614,19 @@ extern "C" __global__ void __launch_bounds__(256) drama_moe_combine(const __nv_b
     float part = 0.f;
     for (int i = threadIdx.x; i < width; i += 256) part += bf(x[r * width + i]) * bf(wg[i]);
     const float gate = sigmoid(block_sum(part, scratch, 8));
-    for (int i = threadIdx.x; i < width; i += 256) {
-        float acc = 0.f;
-        for (int s = 0; s < top; ++s) acc += bf(down[(r * top + s) * width + i]);
-        const float routed = round_bf(acc);
-        out[r * width + i] = tobf(gate * bf(shared[r * width + i]) + routed);
+    for (int c = 8 * threadIdx.x; c < width; c += 8 * 256) {
+        float acc[8], value[8];
+#pragma unroll
+        for (int i = 0; i < 8; ++i) acc[i] = 0.f;
+#pragma unroll 8
+        for (int s = 0; s < top; ++s) {
+            load8(down + (r * top + s) * width + c, value);
+#pragma unroll
+            for (int i = 0; i < 8; ++i) acc[i] += value[i];
+        }
+        load8(shared + r * width + c, value);
+#pragma unroll
+        for (int i = 0; i < 8; ++i) value[i] = gate * value[i] + round_bf(acc[i]);
+        store8(out + r * width + c, value);
     }
 }
diff --git a/zig/src/families/drama/backbone_kernels.zig b/zig/src/families/drama/backbone_kernels.zig
index f7aa40a7..d9effca7 100644
--- a/zig/src/families/drama/backbone_kernels.zig
+++ b/zig/src/families/drama/backbone_kernels.zig
@@ -343,6 +343,7 @@ pub const Kernels = struct {
     }
 
     pub fn combine(k: *const Kernels, s: cuda.Stream, down: u64, top: usize, x: u64, wg: u64, shared: u64, out: u64, rows: usize, width: usize) !void {
+        if (width % 8 != 0 or (down | shared | out) % 16 != 0) return error.DramaRowShape;
         var a: cuda.Args = .{};
         a.add(down);
         a.add(int(top));
