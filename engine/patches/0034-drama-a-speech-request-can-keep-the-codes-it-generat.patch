From 8e55ffeea611c999c40b80efa22e7938cbd4c21b Mon Sep 17 00:00:00 2001
From: plotarmordev <299844489+plotarmordev@users.noreply.github.com>
Date: Fri, 16 Oct 2026 17:54:45 +0800
Subject: [PATCH 34/39] drama: a speech request can keep the codes it generated

SpeechRequest.generated is caller storage the host writes each generated
frame's codes into (code 0 first, end of speech excluded), in the form a
reference's frames take. The host writes them there in place of its own
buffer, so neither path copies them; a request without it uses the host's
buffer as before.
---
 zig/src/core/engine_api.zig   |  2 ++
 zig/src/native/drama_host.zig | 16 ++++++++++------
 2 files changed, 12 insertions(+), 6 deletions(-)

diff --git a/zig/src/core/engine_api.zig b/zig/src/core/engine_api.zig
index 6d966f5f..46d3486c 100644
--- a/zig/src/core/engine_api.zig
+++ b/zig/src/core/engine_api.zig
@@ -98,6 +98,8 @@ pub const SpeechRequest = struct {
     prompt: []const u32,
     /// Each prompt row's codebook codes, zero on text rows (a voice reference's audio rows); empty: a plain prompt.
     codes: []const [10]u32 = &.{},
+    /// Caller storage (len >= max_frames) for each generated frame's codes, code 0 first; empty: none kept.
+    generated: [][10]u32 = &.{},
     pcm: []f32,
     result: *SpeechResult,
     seed: u64,
diff --git a/zig/src/native/drama_host.zig b/zig/src/native/drama_host.zig
index 5b493ac3..d977abf3 100644
--- a/zig/src/native/drama_host.zig
+++ b/zig/src/native/drama_host.zig
@@ -137,6 +137,7 @@ const Host = struct {
         if (!std.math.isFinite(r.top_p) or r.top_p <= 0 or r.top_p > 1) return false;
         if (r.top_k == 0 or r.top_k > std.math.maxInt(i32)) return false;
         if (r.codes.len != 0 and r.codes.len != r.prompt.len) return false;
+        if (r.generated.len != 0 and r.generated.len < r.max_frames) return false;
         for (r.prompt, 0..) |t, i| {
             if (t >= drama.backbone.config.vocab) return false;
             const audio = t >= h.semantic_start and t <= h.semantic_end;
@@ -296,6 +297,8 @@ const Host = struct {
         const sampling: drama.tower.Sampling = .{ .temperature = r.temperature, .top_p = r.top_p, .top_k = r.top_k };
         var hidden = try lastRow(last.hidden, last.rows, b.hidden * 2);
         var logits = try lastRow(last.semantic_logits, 1, logit_cols * 4);
+        // a caller's generated buffer takes the codes in place of the host's own: nothing is copied either way
+        const codes: []Codes = if (r.generated.len > 0) r.generated else &h.codes;
         var count: usize = 0;
         var truncated = false;
         var published: usize = 0; // frames a streamed request's caller owns
@@ -306,14 +309,14 @@ const Host = struct {
             stats.rounds += 1;
             if (frame[0] == h.eos) break;
             if (frame[0] < h.semantic_start or frame[0] > h.semantic_end) return error.BadSpeechFrame;
-            h.codes[count] = frame[1..11].*;
+            codes[count] = frame[1..11].*;
             count += 1;
             h.noteFrames(count);
             if (count == r.max_frames) {
                 truncated = true;
                 break;
             }
-            if (r.stream and (published == 0 or count - published == stream_chunk_frames)) published = try h.publish(job, count);
+            if (r.stream and (published == 0 or count - published == stream_chunk_frames)) published = try h.publish(job, codes[0..count]);
             h.frames[0] = frame;
             const extra = try t.setInput(s, h.frames[0..1]);
             const rows = try b.run(s, .decode, h.frames[0][0..1], extra);
@@ -325,11 +328,11 @@ const Host = struct {
 
         try h.check();
         if (r.stream) {
-            if (count > published) _ = try h.publish(job, count);
+            if (count > published) _ = try h.publish(job, codes[0..count]);
             return .{ .samples = count * frame_length, .truncated = truncated };
         }
         const want = count * frame_length;
-        const samples = try h.codec.decode(s, h.codes[0..count], r.pcm);
+        const samples = try h.codec.decode(s, codes[0..count], r.pcm);
         if (samples != want) return error.CodecSampleCount;
         for (r.pcm[0..samples]) |x| if (!std.math.isFinite(x)) return error.NonFiniteAudio;
         try h.check();
@@ -340,11 +343,12 @@ const Host = struct {
     const Done = struct { samples: usize, truncated: bool };
 
     /// Decodes the frames not yet decoded, checks them, then hands pcm[0..frames * 2048] over with an `audio` event.
-    fn publish(h: *Host, job: Job, frames: usize) !usize {
+    fn publish(h: *Host, job: Job, codes: []const Codes) !usize {
         try h.check();
         const r = job.request;
         const from = h.codec.decoded * frame_length;
-        const samples = try h.codec.advance(h.stream, h.codes[0..frames], r.pcm);
+        const samples = try h.codec.advance(h.stream, codes, r.pcm);
+        const frames = codes.len;
         if (samples != frames * frame_length) return error.CodecSampleCount;
         for (r.pcm[from..samples]) |x| if (!std.math.isFinite(x)) return error.NonFiniteAudio;
         try h.check();
