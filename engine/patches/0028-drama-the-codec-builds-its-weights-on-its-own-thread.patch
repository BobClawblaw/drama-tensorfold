From 02919215e0e83eef0eaa4b7c371733d278fb3d74 Mon Sep 17 00:00:00 2001
From: plotarmordev <299844489+plotarmordev@users.noreply.github.com>
Date: Fri, 16 Oct 2026 11:13:28 +0800
Subject: [PATCH 28/30] drama: the codec builds its weights on its own thread
 while the backbone loads

The codec's host-side weight image is CPU work that the backbone and tower reads leave room for; it now runs on
its own thread with the context current there, and the host joins it before it finishes opening.
---
 CHANGELOG.md                  |  1 +
 zig/src/native/drama_host.zig | 26 +++++++++++++++++++++++++-
 2 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/CHANGELOG.md b/CHANGELOG.md
index 4e66e244..95dc5dc7 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -6,6 +6,7 @@ Each release's page on GitHub has its notes and measurements. See [the 1.0.0 rel
 
 - speech: `stream: true` with `response_format: pcm` streams HTTP/1.1 chunks while Drama 3 generates; incremental codec decode bit-identical to the whole decode (oracle-gated)
 - speech: a Drama 3 reply that reaches `max_frames` without an end of speech returns its clipped audio with HTTP 200, as the reference returns its capped replies, instead of a 500 without audio. A whole reply carries `X-Finish-Reason: stop` or `length`; a stream declares the trailer, and only a clipped stream ends with `X-Finish-Reason: length`, a normally finished one with the plain last chunk.
+- Drama 3 loads in about 6 s instead of 53 s on a GB10: weights are read with direct I/O into staging pieces that never span two device allocations, and the codec initializes on its own thread while the backbone loads.
 
 ## 1.0.11
 
diff --git a/zig/src/native/drama_host.zig b/zig/src/native/drama_host.zig
index 1c8f5d3e..f679993d 100644
--- a/zig/src/native/drama_host.zig
+++ b/zig/src/native/drama_host.zig
@@ -387,6 +387,20 @@ fn words(err: anyerror) []const u8 {
     };
 }
 
+/// codec.Model.init run on its own thread (it makes the context current there); `model` is set before the thread ends.
+const CodecInit = struct {
+    gpa: Allocator,
+    io: std.Io,
+    ctx: *cuda.Context,
+    checkpoint_dir: []const u8,
+    kernel_dir: []const u8,
+    model: anyerror!drama.codec.Model = undefined,
+
+    fn run(c: *CodecInit) void {
+        c.model = drama.codec.Model.init(c.gpa, c.io, c.ctx, c.checkpoint_dir, c.kernel_dir, .{ .max_frames = max_frames });
+    }
+};
+
 /// Drama 3 at `checkpoint_dir` with kernels from `kernel_dir`, served on its own worker thread; `close` joins it.
 pub fn open(gpa: Allocator, io: std.Io, checkpoint_dir: []const u8, kernel_dir: []const u8, options: Options) !api.Opened {
     if (options.context < min_context or options.context > max_context) return error.BadDramaContext;
@@ -415,11 +429,21 @@ pub fn open(gpa: Allocator, io: std.Io, checkpoint_dir: []const u8, kernel_dir:
     errdefer _ = cuda.setAllocationLimit(h.previous_allocation_limit) catch unreachable;
 
     const held0 = cuda.usage(false).device;
+    // The codec builds its weight image from codec.pth on the CPU; on its own thread that overlaps the backbone and
+    // tower reads, which leave the CPU idle.
+    var codec: CodecInit = .{ .gpa = gpa, .io = io, .ctx = &h.ctx, .checkpoint_dir = checkpoint_dir, .kernel_dir = kernel_dir };
+    var codec_thread: ?std.Thread = try std.Thread.spawn(.{}, CodecInit.run, .{&codec});
+    errdefer if (codec_thread) |t| {
+        t.join();
+        if (codec.model) |*m| m.deinit() else |_| {}
+    };
     h.backbone = try drama.backbone.Model.init(gpa, io, &h.ctx, checkpoint_dir, kernel_dir, .{ .context = options.context, .max_rows = chunk_rows });
     errdefer h.backbone.deinit();
     h.tower = try drama.tower.Model.init(gpa, io, &h.ctx, checkpoint_dir, kernel_dir, .{ .context = options.context, .max_rows = chunk_rows });
     errdefer h.tower.deinit();
-    h.codec = try drama.codec.Model.init(gpa, io, &h.ctx, checkpoint_dir, kernel_dir, .{ .max_frames = max_frames });
+    codec_thread.?.join();
+    codec_thread = null;
+    h.codec = try codec.model;
     errdefer h.codec.deinit();
     const model_bytes = cuda.usage(false).device -| held0;
 
