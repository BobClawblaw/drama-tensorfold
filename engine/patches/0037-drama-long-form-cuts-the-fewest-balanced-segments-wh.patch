+    const cuts = try a.alloc(usize, n + 1);
+    cuts[n] = k;
+    var m = n;
+    while (m > 0) : (m -= 1) cuts[m - 1] = from[m * (k + 1) + cuts[m]];
+    for (cuts[0..n], cuts[1..]) |head, next| try out.append(a, span(sentences[head], sentences[next - 1]));
