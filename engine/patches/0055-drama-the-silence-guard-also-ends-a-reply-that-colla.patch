+/// A voice's noise floor: frames at -62 and -48 dBFS by turns, straddling -60 dBFS as a collapse into a hum can.
+fn hum(levels: []f32) void {
+    for (levels, 0..) |*level, i| level.* = if (i % 2 == 0) 8e-4 else 4e-3;
+}
