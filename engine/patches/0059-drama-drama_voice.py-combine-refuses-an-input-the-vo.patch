From e862c785da68a778fb60037a94c67e536b17a2da Mon Sep 17 00:00:00 2001
From: plotarmordev <299844489+plotarmordev@users.noreply.github.com>
Date: Sat, 17 Oct 2026 18:22:02 +0800
Subject: [PATCH 59/59] drama: drama_voice.py combine refuses an input the
 voice loader would refuse

Every input needs a source with a known kind and a non-blank note, and each reference an audio_sha256 of 64 lowercase hex digits, as --voices checks them; before, combine checked the kind only and the digest's length.
---
 docs/drama-voices.md          |  2 +-
 tools/zig/drama_voice.py      | 12 ++++++++----
 tools/zig/drama_voice_test.py | 22 ++++++++++++++++++++++
 3 files changed, 31 insertions(+), 5 deletions(-)

diff --git a/docs/drama-voices.md b/docs/drama-voices.md
index b38b482c..4e7db353 100644
--- a/docs/drama-voices.md
+++ b/docs/drama-voices.md
@@ -95,7 +95,7 @@ python3 tools/zig/drama_voice.py combine voices/A.json voices/B.json voices/C.js
 ```
 
 - The result is `format` `drama3-voice/2`: `source` once, and `references`, a list of entries that each hold a passage's `text`, `vq_codes`, `codes_sha256`, `frames`, `audio_sha256` and `encoder`, copied unchanged from the files named.
-- A `drama3-voice/2` input adds all its references, in order. Every input must have a `source` of the same `kind`; the combined file gets that kind and the note given. Codes that do not match their digest, a reference with no `audio_sha256`, or fewer than two references in all are refused.
+- A `drama3-voice/2` input adds all its references, in order. Every input must carry a `source` the loader accepts, with a known `kind` and a non-blank `note`, and all of one `kind`; the combined file gets that kind and the note given. Codes that do not match their digest, an `audio_sha256` that is not 64 lowercase hex digits, or fewer than two references in all are refused.
 - The prompt is the one a request builds when it sends the first passages as `references` and names a voice holding the last: `drama3-voice/2` with A, B, C equals a request with references A and B for the voice C, row for row.
 - A single-reference file stays `drama3-voice/1` and builds the prompt it built before. `/2` is a new format so that a server that reads only `/1` refuses the file instead of using one of its passages.
 - The loader checks each entry as it checks a `/1` file, plus a 64-hex `audio_sha256`; its refusals name the entry (`references.1: codes_sha256 does not match vq_codes`).
diff --git a/tools/zig/drama_voice.py b/tools/zig/drama_voice.py
index 694226a6..fcd11a6e 100644
--- a/tools/zig/drama_voice.py
+++ b/tools/zig/drama_voice.py
@@ -4,6 +4,7 @@ from __future__ import annotations
 import argparse
 import hashlib
 import json
+import re
 import shutil
 import subprocess
 import string
@@ -94,19 +95,22 @@ def encode_reference(reference: Path, checkpoint: Path, audio: Path, transcript:
 
 
 def references(path: Path) -> tuple[list[dict], str]:
-    """A voice file's references, in order, each checked against its digests, and its source kind."""
+    """A voice file's references and source kind, refused where --voices would refuse its source or digests."""
     voice = json.loads(path.read_text(encoding="utf-8"))
     if voice.get("format") not in (FORMAT, SEVERAL):
         raise SystemExit(f"{path}: format is not {FORMAT} or {SEVERAL}")
-    kind = (voice.get("source") or {}).get("kind")
+    source = voice.get("source") if isinstance(voice.get("source"), dict) else {}
+    kind, note = source.get("kind"), source.get("note")
     if kind not in KINDS:
         raise SystemExit(f"{path} does not say whose voice it holds (source.kind); a combined file can only carry one source")
+    if not isinstance(note, str) or not note.strip(string.whitespace):
+        raise SystemExit(f"{path} does not say where its voice comes from (source.note), so --voices would refuse it")
     found = (voice.get("references") or []) if voice["format"] == SEVERAL else [voice]
     for i, reference in enumerate(found):
         if codes_sha256(reference.get("vq_codes", [])) != reference.get("codes_sha256"):
             raise SystemExit(f"{path}: reference {i}: codes_sha256 does not match vq_codes")
-        if len(reference.get("audio_sha256") or "") != 64:
-            raise SystemExit(f"{path}: reference {i} names no clip (audio_sha256)")
+        if not isinstance(reference.get("audio_sha256"), str) or not re.fullmatch(r"[0-9a-f]{64}", reference["audio_sha256"]):
+            raise SystemExit(f"{path}: reference {i}: audio_sha256 is not a clip's sha256 (64 lowercase hex digits)")
     return [{key: reference[key] for key in REFERENCE_FIELDS if key in reference} for reference in found], kind
 
 
diff --git a/tools/zig/drama_voice_test.py b/tools/zig/drama_voice_test.py
index 311e26e0..e3c87a2c 100644
--- a/tools/zig/drama_voice_test.py
+++ b/tools/zig/drama_voice_test.py
@@ -168,6 +168,28 @@ class CombineTests(unittest.TestCase):
             self.combine(one, one, "--source-note", " \t")
         self.assertFalse(self.out.exists())
 
+    def test_every_input_carries_the_attestation_the_loader_asks(self):
+        one = self.write("one.json", single("One.", 1))
+        for i, note in enumerate((" \t\n", "", 3, None)):
+            unnoted = single("Two.", 2)
+            unnoted["source"]["note"] = note
+            with self.assertRaisesRegex(SystemExit, "unnoted.*source.note"):
+                self.combine(one, self.write(f"unnoted{i}.json", unnoted), "--source-note", "n")
+        noteless = single("Two.", 2)
+        del noteless["source"]["note"]
+        with self.assertRaisesRegex(SystemExit, "noteless.*source.note"):
+            self.combine(one, self.write("noteless.json", noteless), "--source-note", "n")
+        self.assertFalse(self.out.exists())
+
+    def test_a_clip_digest_must_be_64_lowercase_hex_digits_as_the_loader_reads_it(self):
+        one = self.write("one.json", single("One.", 1))
+        good = single("Two.", 2)["audio_sha256"]
+        for i, digest in enumerate((good.upper(), "g" * 64, good[:63] + " ", good[:63], 7 * 10**63)):
+            bad = single("Two.", 2)
+            bad["audio_sha256"] = digest
+            with self.assertRaisesRegex(SystemExit, "reference 0: audio_sha256 is not a clip's sha256"):
+                self.combine(one, self.write(f"bad{i}.json", bad), "--source-note", "n")
+        self.assertFalse(self.out.exists())
 
 
 if __name__ == "__main__":
