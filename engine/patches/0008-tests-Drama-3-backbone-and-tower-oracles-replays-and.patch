diff --git a/zig/tests/cuda/drama_backbone_oracle.zig b/zig/tests/cuda/drama_backbone_oracle.zig
new file mode 100644
index 00000000..8c148b8d
--- /dev/null
+++ b/zig/tests/cuda/drama_backbone_oracle.zig
@@ -0,0 +1,93 @@
+//! Exercise production backbone state across chunk sizes and reset, without tower sampling or HTTP serving.
+//! Caller owns the GPU lock, admission, cap and lifetime monitoring. Input is 2..512 little-endian u32 text tokens.
+const std = @import("std");
+const builtin = @import("builtin");
+const cuda = @import("cuda");
+const drama = @import("drama");
+const width = 2048;
+const candidate_count = 4097;
+
+fn runChunks(model: *drama.backbone.Model, stream: cuda.Stream, tokens: []const u32, chunk: usize, hidden: []u16, logits: []f32) !void {
+    try model.reset(stream);
+    var at: usize = 0;
+    while (at < tokens.len) {
+        const end = @min(at + chunk, tokens.len);
+        const output = try model.run(stream, .prefill, tokens[at..end], null);
+        try output.hidden.download(0, std.mem.sliceAsBytes(hidden[at * width .. end * width]));
+        if (end == tokens.len) try output.semantic_logits.download(0, std.mem.sliceAsBytes(logits));
+        at = end;
+    }
+    for (hidden) |bits| {
+        const value: f32 = @bitCast(@as(u32, bits) << 16);
+        if (!std.math.isFinite(value)) return error.NonFiniteBackboneHidden;
+    }
+    for (logits) |value| if (!std.math.isFinite(value)) return error.NonFiniteBackboneLogits;
+}
+
+pub fn main(init: std.process.Init) !u8 {
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    if (args.len != 4) {
+        std.debug.print("usage: tf-drama-backbone-oracle CHECKPOINT TOKENS_U32LE OUTPUT_DIRECTORY\n", .{});
+        return 2;
+    }
+    if (builtin.cpu.arch.endian() != .little) return error.UnsupportedHostEndian;
+    var bytes: [512 * 4 + 1]u8 align(@alignOf(u32)) = undefined;
+    const file = try std.Io.Dir.cwd().openFile(init.io, args[2], .{});
+    defer file.close(init.io);
+    const count = try file.readPositionalAll(init.io, &bytes, 0);
+    if (count < 8 or count > 512 * 4 or count % 4 != 0) return error.ExpectedTwoTo512Tokens;
+    const tokens = std.mem.bytesAsSlice(u32, @as([]align(@alignOf(u32)) u8, bytes[0..count]));
+    var out = try std.Io.Dir.cwd().openDir(init.io, args[3], .{});
+    defer out.close(init.io);
+    const baseline = try init.gpa.alloc(u16, tokens.len * width);
+    defer init.gpa.free(baseline);
+    const actual = try init.gpa.alloc(u16, tokens.len * width);
+    defer init.gpa.free(actual);
+    var baseline_logits: [candidate_count]f32 = undefined;
+    var logits: [candidate_count]f32 = undefined;
+    _ = try cuda.setAllocationLimit(54 * (1 << 30));
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    var model = try drama.backbone.Model.init(init.gpa, init.io, &ctx, args[1], "", .{ .context = 512, .max_rows = 128 });
+    defer model.deinit();
+    for (tokens) |token| if (token >= model.semantic_start and token <= model.semantic_end) return error.TextFixtureMustNotContainSemanticTokens;
+    var all_equal = true;
+    var name_buffer: [128]u8 = undefined;
+    for ([_]usize{ 1, 7, 128 }) |chunk| {
+        const started = std.Io.Clock.awake.now(init.io).toNanoseconds();
+        try runChunks(&model, stream, tokens, chunk, actual, &logits);
+        const elapsed = std.Io.Clock.awake.now(init.io).toNanoseconds() - started;
+        var name = try std.fmt.bufPrint(&name_buffer, "native-chunk-{d}-hidden.bf16", .{chunk});
+        try out.writeFile(init.io, .{ .sub_path = name, .data = std.mem.sliceAsBytes(actual) });
+        name = try std.fmt.bufPrint(&name_buffer, "native-chunk-{d}-semantic.f32", .{chunk});
+        try out.writeFile(init.io, .{ .sub_path = name, .data = std.mem.sliceAsBytes(&logits) });
+        if (chunk == 1) {
+            @memcpy(baseline, actual);
+            baseline_logits = logits;
+        }
+        var hidden_differences: usize = 0;
+        for (baseline, actual) |a, b| if (a != b) {
+            hidden_differences += 1;
+        };
+        const head_equal = std.mem.eql(u8, std.mem.sliceAsBytes(&baseline_logits), std.mem.sliceAsBytes(&logits));
+        all_equal = all_equal and hidden_differences == 0 and head_equal;
+        std.debug.print("rows={d} chunk={d} elapsed_s={d:.6} hidden_bit_differences={d} semantic_logits_bit_equal={}\n", .{
+            tokens.len, chunk, @as(f64, @floatFromInt(elapsed)) / 1e9, hidden_differences, head_equal,
+        });
+    }
+    // Repeat the exact last execution after reset; chunk consistency and reset are separate invariants.
+    @memcpy(baseline, actual);
+    baseline_logits = logits;
+    try runChunks(&model, stream, tokens, 128, actual, &logits);
+    const reset_equal = std.mem.eql(u16, baseline, actual) and std.mem.eql(u8, std.mem.sliceAsBytes(&baseline_logits), std.mem.sliceAsBytes(&logits));
+    var metadata: [512]u8 = undefined;
+    const text = try std.fmt.bufPrint(&metadata, "{{\"rows\":{d},\"hidden_width\":{d},\"eos\":{d},\"semantic_start\":{d},\"semantic_end\":{d},\"chunk_bit_exact\":{},\"reset_bit_exact\":{}}}\n", .{ tokens.len, width, model.eos, model.semantic_start, model.semantic_end, all_equal, reset_equal });
+    try out.writeFile(init.io, .{ .sub_path = "native-metadata.json", .data = text });
+    const used = cuda.usage(false);
+    std.debug.print("reset_bit_exact={} cuda_bytes={d} pinned_bytes={d}\n", .{ reset_equal, used.device, used.host });
+    return if (all_equal and reset_equal) 0 else 1;
+}
diff --git a/zig/tests/cuda/drama_backbone_replay.zig b/zig/tests/cuda/drama_backbone_replay.zig
new file mode 100644
index 00000000..7a5db9dd
--- /dev/null
+++ b/zig/tests/cuda/drama_backbone_replay.zig
@@ -0,0 +1,672 @@
+//! Development diagnostic, not a gate: replays the production backbone's attention (DeltaNet or full attention)
+//! and MoE operators of selected layers on frozen stage inputs, to separate propagated input differences from
+//! native/reference operator differences (backbone-replay-contract.json, native_replay).
+//!
+//! usage: tf-drama-backbone-replay CHECKPOINT NATIVE_STAGE_DIR REFERENCE_STAGE_DIR OUTPUT_DIR
+//!
+//! NATIVE_STAGE_DIR is a tf-drama-backbone-trace output, REFERENCE_STAGE_DIR the reference's capture of the same
+//! stages; both hold manifest.json plus layer-{LL}-{stage}.bf16 [182, 2048] BF16 captures of
+//! the contract prompt. OUTPUT_DIR must exist; every output is created exclusively, so nothing is overwritten.
+//!
+//! 1. Fixtures (CPU only): both manifests are parsed and checked (schema, rows, width, dtype, layer count, contract
+//!    tokens hash, the source's own evidence_valid). For each replayed layer, attention_input, attention_output,
+//!    mlp_input and mlp_output are read from each directory; each must have exactly one manifest entry with the
+//!    expected file name and shape, the file must have exactly 182 * 2048 * 2 bytes, match the manifest SHA-256 and
+//!    hold only finite values. Any failure is recorded and the model is never loaded.
+//! 2. Replay: the model is built once as tf-drama-backbone-trace builds it (context 512, max_rows 128). For each
+//!    origin (native, reference), layer (0, 3, 13, 39) and operator: reset, then `Model.replayOperator`, which feeds
+//!    the frozen input rows into the production scratch input in chunks 128 + 54 and runs the production
+//!    `deltaNet`/`fullAttention`/`moe` method at the right request position, so the layer's own recurrent state or
+//!    KV cache carries across chunks. MoE always replays the frozen mlp_input, never the attention replay result.
+//!    The output goes to {origin}/layer-{LL}-{attention_output|mlp_output}.bf16.
+//! 3. Self-control: every native-origin output must be bit identical to the original native stage output it
+//!    replays; a difference invalidates the evidence. Differences against the reference capture, for either
+//!    origin, are recorded as diagnostics only.
+//! 4. Production control: run and replay without a reset must both be refused (poison guard); then reset and the
+//!    production `Model.run` over the contract prompt (the native manifest's tokens_file) in chunks 128 + 54 must
+//!    reproduce the native trace's final hidden and semantic logits SHA-256.
+//! 5. manifest.json; evidence_valid is false (exit 3) on any recorded error. A CUDA error, an existing output file
+//!    or an unexpected replay protocol error aborts without a manifest (Zig error exit).
+//!
+//! The caller owns the shared GPU lock, admission, process cap and lifetime monitoring.
+const std = @import("std");
+const builtin = @import("builtin");
+const cuda = @import("cuda");
+const drama = @import("drama");
+
+const Allocator = std.mem.Allocator;
+const Sha256 = std.crypto.hash.sha2.Sha256;
+const Model = drama.backbone.Model;
+const Stage = drama.backbone.Stage;
+const Operator = drama.backbone.ReplayOperator;
+const linear = drama.backbone.config.linear;
+
+const width = 2048;
+const candidate_count = 4097;
+const max_rows = 128;
+const context = 512;
+const rows = 182;
+const tensor_bytes = rows * width * 2;
+/// The forward's own layer array.
+const layer_count = @typeInfo(@FieldType(@FieldType(Model, "w"), "layers")).array.len;
+const contract_tokens_sha256 = "fe39111abb37fc10cb2e5c846313464c38fad13d92d44f082ef465d5b3baba86";
+const contract_name = "drama-backbone-replay-contract/1";
+const replay_layers = [_]usize{ 0, 3, 13, 39 };
+/// The native capture's chunks: Model.run over 182 rows at max_rows 128.
+const chunks = [_]usize{ 128, 54 };
+const operators = std.meta.tags(Operator);
+const Origin = enum(usize) { native, reference };
+const origins = std.meta.tags(Origin);
+/// Stages read from each source directory per replayed layer: the operators' inputs and original outputs.
+const used_stages = [_]Stage{ .attention_input, .attention_output, .mlp_input, .mlp_output };
+
+comptime {
+    std.debug.assert(drama.backbone.config.hidden == width);
+    std.debug.assert(drama.backbone.weights.head_cols == candidate_count);
+    var total: usize = 0;
+    for (chunks) |c| {
+        std.debug.assert(c > 0 and c <= max_rows);
+        total += c;
+    }
+    std.debug.assert(total == rows and rows <= context);
+    for (replay_layers) |layer| std.debug.assert(layer < layer_count);
+}
+
+fn inputStage(op: Operator) Stage {
+    return switch (op) {
+        .attention => .attention_input,
+        .moe => .mlp_input,
+    };
+}
+
+fn outputStage(op: Operator) Stage {
+    return switch (op) {
+        .attention => .attention_output,
+        .moe => .mlp_output,
+    };
+}
+
+/// The production method `Model.replayOperator` runs for this layer and operator.
+fn methodName(layer: usize, op: Operator) []const u8 {
+    return switch (op) {
+        .attention => if (linear(layer)) "deltaNet" else "fullAttention",
+        .moe => "moe",
+    };
+}
+
+fn usedIndex(stage: Stage) usize {
+    for (used_stages, 0..) |s, i| {
+        if (s == stage) return i;
+    }
+    unreachable;
+}
+
+fn stageFileName(buffer: []u8, layer: usize, stage: Stage) ![]u8 {
+    return std.fmt.bufPrint(buffer, "layer-{d:0>2}-{s}.bf16", .{ layer, @tagName(stage) });
+}
+
+/// Recorded failures that leave the outputs written but the evidence invalid.
+const Errors = struct {
+    gpa: Allocator,
+    json: std.ArrayList(u8) = .empty,
+    count: usize = 0,
+
+    fn add(e: *Errors, comptime f: []const u8, args: anytype) !void {
+        const message = try std.fmt.allocPrint(e.gpa, f, args);
+        defer e.gpa.free(message);
+        std.debug.print("error: {s}\n", .{message});
+        try e.json.appendSlice(e.gpa, if (e.count == 0) "\n    " else ",\n    ");
+        try jsonString(&e.json, e.gpa, message);
+        e.count += 1;
+    }
+};
+
+/// One stage directory's validated fixtures. A null tensor failed validation (and recorded why).
+const Source = struct {
+    origin: Origin,
+    path: []const u8,
+    manifest_sha: ?[64]u8 = null,
+    manifest_evidence_valid: bool = false,
+    tensors: [replay_layers.len][used_stages.len]?[]align(16) const u8 = @splat(@splat(null)),
+    shas: [replay_layers.len][used_stages.len][64]u8 = undefined,
+    /// Native only: the prompt and the production run's final outputs the trace recorded.
+    tokens_file: ?[]const u8 = null,
+    final_hidden_sha: ?[]const u8 = null,
+    semantic_logits_sha: ?[]const u8 = null,
+
+    fn tensor(s: *const Source, li: usize, stage: Stage) []align(16) const u8 {
+        return s.tensors[li][usedIndex(stage)].?;
+    }
+
+    fn sha(s: *const Source, li: usize, stage: Stage) []const u8 {
+        return &s.shas[li][usedIndex(stage)];
+    }
+};
+
+fn jsonUint(v: ?std.json.Value, expected: u64) bool {
+    const value = v orelse return false;
+    return value == .integer and value.integer >= 0 and @as(u64, @intCast(value.integer)) == expected;
+}
+
+fn jsonText(v: ?std.json.Value) ?[]const u8 {
+    const value = v orelse return null;
+    return if (value == .string) value.string else null;
+}
+
+fn isSha256Hex(s: []const u8) bool {
+    if (s.len != 64) return false;
+    for (s) |c| switch (c) {
+        '0'...'9', 'a'...'f' => {},
+        else => return false,
+    };
+    return true;
+}
+
+fn expectUint(errors: *Errors, origin: Origin, o: std.json.ObjectMap, key: []const u8, expected: u64) !void {
+    if (!jsonUint(o.get(key), expected)) try errors.add("{s} manifest: {s} is not {d}", .{ @tagName(origin), key, expected });
+}
+
+fn expectText(errors: *Errors, origin: Origin, o: std.json.ObjectMap, key: []const u8, expected: []const u8) !void {
+    const got = jsonText(o.get(key)) orelse "";
+    if (!std.mem.eql(u8, got, expected)) try errors.add("{s} manifest: {s} is not {s}", .{ @tagName(origin), key, expected });
+}
+
+/// A nested object's string field, or null after recording the failure.
+fn nestedText(errors: *Errors, origin: Origin, o: std.json.ObjectMap, outer: []const u8, inner: []const u8) !?[]const u8 {
+    if (o.get(outer)) |v| {
+        if (v == .object) {
+            if (jsonText(v.object.get(inner))) |s| return s;
+        }
+    }
+    try errors.add("{s} manifest: {s}.{s} missing or not a string", .{ @tagName(origin), outer, inner });
+    return null;
+}
+
+fn jsonChunks(v: std.json.Value) bool {
+    if (v != .array or v.array.items.len != chunks.len) return false;
+    for (v.array.items, chunks) |item, c| {
+        if (!jsonUint(item, c)) return false;
+    }
+    return true;
+}
+
+fn loadSource(arena: Allocator, io: std.Io, origin: Origin, path: []const u8, errors: *Errors) !Source {
+    var src: Source = .{ .origin = origin, .path = path };
+    const dir = std.Io.Dir.cwd().openDir(io, path, .{}) catch |err| {
+        try errors.add("{s}: stage directory {s} unreadable: {s}", .{ @tagName(origin), path, @errorName(err) });
+        return src;
+    };
+    defer dir.close(io);
+    const text = dir.readFileAlloc(io, "manifest.json", arena, .limited(1 << 24)) catch |err| {
+        try errors.add("{s}: manifest.json unreadable: {s}", .{ @tagName(origin), @errorName(err) });
+        return src;
+    };
+    src.manifest_sha = sha256Hex(text);
+    const doc = std.json.parseFromSliceLeaky(std.json.Value, arena, text, .{}) catch |err| {
+        try errors.add("{s}: manifest.json is not JSON: {s}", .{ @tagName(origin), @errorName(err) });
+        return src;
+    };
+    if (doc != .object) {
+        try errors.add("{s}: manifest.json is not an object", .{@tagName(origin)});
+        return src;
+    }
+    const root = doc.object;
+    try expectUint(errors, origin, root, "schema_version", 1);
+    try expectUint(errors, origin, root, "rows", rows);
+    try expectUint(errors, origin, root, "width", width);
+    try expectUint(errors, origin, root, "layer_count", layer_count);
+    try expectText(errors, origin, root, "dtype", "bf16le");
+    try expectText(errors, origin, root, "tokens_sha256", contract_tokens_sha256);
+    src.manifest_evidence_valid = if (root.get("evidence_valid")) |v| v == .bool and v.bool else false;
+    if (!src.manifest_evidence_valid) try errors.add("{s} manifest: evidence_valid is not true", .{@tagName(origin)});
+    if (origin == .native) {
+        const options_ok = if (root.get("model_options")) |v| v == .object and jsonUint(v.object.get("context"), context) and jsonUint(v.object.get("max_rows"), max_rows) else false;
+        if (!options_ok) try errors.add("native manifest: model_options is not context {d} max_rows {d}", .{ context, max_rows });
+        const chunks_ok = if (root.get("chunks")) |v| jsonChunks(v) else false;
+        if (!chunks_ok) try errors.add("native manifest: chunks is not [128, 54]", .{});
+        src.tokens_file = jsonText(root.get("tokens_file"));
+        if (src.tokens_file == null) try errors.add("native manifest: tokens_file missing", .{});
+        src.final_hidden_sha = try nestedText(errors, origin, root, "final_hidden", "sha256");
+        src.semantic_logits_sha = try nestedText(errors, origin, root, "semantic_logits", "sha256");
+    }
+    const captures = root.get("captures") orelse std.json.Value{ .null = {} };
+    if (captures != .array) {
+        try errors.add("{s} manifest: captures is not an array", .{@tagName(origin)});
+        return src;
+    }
+    for (replay_layers, 0..) |layer, li| {
+        for (used_stages, 0..) |stage, si| {
+            src.tensors[li][si] = try loadCapture(arena, io, dir, origin, captures.array.items, layer, stage, errors, &src.shas[li][si]);
+        }
+    }
+    return src;
+}
+
+/// One stage file checked against its unique manifest entry; null after recording any failure.
+fn loadCapture(arena: Allocator, io: std.Io, dir: std.Io.Dir, origin: Origin, captures: []const std.json.Value, layer: usize, stage: Stage, errors: *Errors, sha_out: *[64]u8) !?[]align(16) const u8 {
+    const tag = @tagName(origin);
+    var name_buffer: [64]u8 = undefined;
+    const name = try stageFileName(&name_buffer, layer, stage);
+    var entry: ?std.json.ObjectMap = null;
+    var matches: usize = 0;
+    for (captures) |c| {
+        if (c != .object) continue;
+        const stage_name = jsonText(c.object.get("stage")) orelse continue;
+        if (jsonUint(c.object.get("layer"), layer) and std.mem.eql(u8, stage_name, @tagName(stage))) {
+            entry = c.object;
+            matches += 1;
+        }
+    }
+    if (matches != 1) {
+        try errors.add("{s} {s}: {d} manifest captures, expected exactly 1", .{ tag, name, matches });
+        return null;
+    }
+    const e = entry.?;
+    const file = jsonText(e.get("file")) orelse "";
+    if (!std.mem.eql(u8, file, name)) {
+        try errors.add("{s} {s}: manifest file is {s}", .{ tag, name, file });
+        return null;
+    }
+    const want = jsonText(e.get("sha256")) orelse "";
+    if (!isSha256Hex(want)) {
+        try errors.add("{s} {s}: manifest sha256 is not 64 lowercase hex digits", .{ tag, name });
+        return null;
+    }
+    const shape_ok = if (e.get("shape")) |v| v == .array and v.array.items.len == 2 and jsonUint(v.array.items[0], rows) and jsonUint(v.array.items[1], width) else false;
+    if (!shape_ok) {
+        try errors.add("{s} {s}: manifest shape is not [{d}, {d}]", .{ tag, name, rows, width });
+        return null;
+    }
+    const bytes = dir.readFileAllocOptions(io, name, arena, .limited(tensor_bytes + 1), .@"16", null) catch |err| {
+        try errors.add("{s} {s}: unreadable or larger than {d} bytes: {s}", .{ tag, name, tensor_bytes, @errorName(err) });
+        return null;
+    };
+    if (bytes.len != tensor_bytes) {
+        try errors.add("{s} {s}: {d} bytes, expected {d}", .{ tag, name, bytes.len, tensor_bytes });
+        return null;
+    }
+    const got = sha256Hex(bytes);
+    if (!std.mem.eql(u8, &got, want)) {
+        try errors.add("{s} {s}: sha256 {s} does not match manifest {s}", .{ tag, name, got[0..], want });
+        return null;
+    }
+    const nonfinite = nonfiniteBf16(std.mem.bytesAsSlice(u16, bytes));
+    if (nonfinite != 0) {
+        try errors.add("{s} {s}: {d} nonfinite values", .{ tag, name, nonfinite });
+        return null;
+    }
+    sha_out.* = got;
+    return bytes;
+}
+
+/// The contract prompt, from the native manifest's tokens_file; null after recording any failure.
+fn loadTokens(arena: Allocator, io: std.Io, native: *const Source, errors: *Errors) !?[]const u32 {
+    const path = native.tokens_file orelse return null;
+    const bytes = std.Io.Dir.cwd().readFileAllocOptions(io, path, arena, .limited(context * 4 + 1), .@"16", null) catch |err| {
+        try errors.add("tokens file {s} unreadable: {s}", .{ path, @errorName(err) });
+        return null;
+    };
+    if (bytes.len != rows * 4) {
+        try errors.add("tokens file {s}: {d} bytes, expected {d}", .{ path, bytes.len, rows * 4 });
+        return null;
+    }
+    const got = sha256Hex(bytes);
+    if (!std.mem.eql(u8, &got, contract_tokens_sha256)) {
+        try errors.add("tokens file {s}: sha256 {s} is not the contract prompt", .{ path, got[0..] });
+        return null;
+    }
+    return std.mem.bytesAsSlice(u32, bytes);
+}
+
+fn nonfiniteBf16(values: []const u16) usize {
+    var count: usize = 0;
+    for (values) |bits| {
+        if ((bits & 0x7f80) == 0x7f80) count += 1;
+    }
+    return count;
+}
+
+fn nonfiniteF32(values: []const f32) usize {
+    var count: usize = 0;
+    for (values) |v| {
+        if (!std.math.isFinite(v)) count += 1;
+    }
+    return count;
+}
+
+fn bf16(bits: u16) f64 {
+    return @as(f32, @bitCast(@as(u32, bits) << 16));
+}
+
+/// `got` against an original capture `want`, both BF16 [rows, width].
+const Comparison = struct {
+    bit_differences: usize = 0,
+    max_abs: f64 = 0,
+    /// ||got - want|| / ||want||.
+    relative_l2: f64 = 0,
+    min_row_cosine: f64 = 1,
+    min_row: usize = 0,
+
+    fn of(got_bytes: []align(16) const u8, want_bytes: []align(16) const u8) Comparison {
+        const got = std.mem.bytesAsSlice(u16, got_bytes);
+        const want = std.mem.bytesAsSlice(u16, want_bytes);
+        var c: Comparison = .{};
+        var diff_sq: f64 = 0;
+        var want_sq: f64 = 0;
+        for (0..rows) |r| {
+            var dot: f64 = 0;
+            var gg: f64 = 0;
+            var ww: f64 = 0;
+            for (got[r * width ..][0..width], want[r * width ..][0..width]) |gb, wb| {
+                if (gb != wb) c.bit_differences += 1;
+                const g = bf16(gb);
+                const w = bf16(wb);
+                const d = g - w;
+                c.max_abs = @max(c.max_abs, @abs(d));
+                diff_sq += d * d;
+                dot += g * w;
+                gg += g * g;
+                ww += w * w;
+            }
+            want_sq += ww;
+            const cosine: f64 = if (gg == 0 and ww == 0) 1 else if (gg == 0 or ww == 0) 0 else dot / (@sqrt(gg) * @sqrt(ww));
+            if (r == 0 or cosine < c.min_row_cosine) {
+                c.min_row_cosine = cosine;
+                c.min_row = r;
+            }
+        }
+        c.relative_l2 = if (want_sq == 0) (if (diff_sq == 0) 0 else std.math.inf(f64)) else @sqrt(diff_sq / want_sq);
+        return c;
+    }
+
+    fn json(c: Comparison, list: *std.ArrayList(u8), gpa: Allocator, want_sha: []const u8) !void {
+        try list.print(gpa, "{{\"original_sha256\": \"{s}\", \"bit_differences\": {d}, \"bit_exact\": {}, \"max_abs\": ", .{ want_sha, c.bit_differences, c.bit_differences == 0 });
+        try jsonNumber(list, gpa, c.max_abs);
+        try list.appendSlice(gpa, ", \"relative_l2\": ");
+        try jsonNumber(list, gpa, c.relative_l2);
+        try list.appendSlice(gpa, ", \"min_row_cosine\": ");
+        try jsonNumber(list, gpa, c.min_row_cosine);
+        try list.print(gpa, ", \"min_row\": {d}}}", .{c.min_row});
+    }
+};
+
+/// A finite number, else null (JSON has no NaN or infinity).
+fn jsonNumber(list: *std.ArrayList(u8), gpa: Allocator, v: f64) !void {
+    if (std.math.isFinite(v)) try list.print(gpa, "{e}", .{v}) else try list.appendSlice(gpa, "null");
+}
+
+fn sha256Hex(bytes: []const u8) [64]u8 {
+    var out: [32]u8 = undefined;
+    Sha256.hash(bytes, &out, .{});
+    return std.fmt.bytesToHex(out, .lower);
+}
+
+fn fileSha256(gpa: Allocator, io: std.Io, path: []const u8) ![64]u8 {
+    const file = try std.Io.Dir.openFileAbsolute(io, path, .{});
+    defer file.close(io);
+    const buffer = try gpa.alloc(u8, 1 << 20);
+    defer gpa.free(buffer);
+    var hash = Sha256.init(.{});
+    var offset: u64 = 0;
+    while (true) {
+        const got = try file.readPositionalAll(io, buffer, offset);
+        hash.update(buffer[0..got]);
+        offset += got;
+        if (got < buffer.len) break;
+    }
+    return std.fmt.bytesToHex(hash.finalResult(), .lower);
+}
+
+fn jsonString(list: *std.ArrayList(u8), gpa: Allocator, s: []const u8) !void {
+    try list.append(gpa, '"');
+    for (s) |c| switch (c) {
+        '"', '\\' => {
+            try list.append(gpa, '\\');
+            try list.append(gpa, c);
+        },
+        0...0x1f => try list.print(gpa, "\\u{x:0>4}", .{c}),
+        else => try list.append(gpa, c),
+    };
+    try list.append(gpa, '"');
+}
+
+fn nowNs(io: std.Io) i128 {
+    return std.Io.Clock.awake.now(io).toNanoseconds();
+}
+
+fn seconds(ns: i128) f64 {
+    return @as(f64, @floatFromInt(ns)) / 1e9;
+}
+
+/// What the GPU phase measured besides the per-capture JSON.
+const Gpu = struct {
+    after_init: cuda.Usage,
+    end: cuda.Usage,
+    replay_pinned_bytes: usize,
+    captures: usize,
+    replay_ns: i128,
+    run_after_replay_refused: bool,
+    replay_after_replay_refused: bool,
+    final_hidden_sha: [64]u8,
+    semantic_logits_sha: [64]u8,
+    production_bit_exact: bool,
+};
+
+fn replayAll(gpa: Allocator, io: std.Io, checkpoint: []const u8, sources: *const [origins.len]Source, tokens: []const u32, out: std.Io.Dir, errors: *Errors, captures: *std.ArrayList(u8), self_control: *std.ArrayList(u8)) !Gpu {
+    const native = &sources[@backingInt(Origin.native)];
+    const reference = &sources[@backingInt(Origin.reference)];
+    const hidden = try gpa.alloc(u16, rows * width);
+    defer gpa.free(hidden);
+    var logits: [candidate_count]f32 = undefined;
+
+    _ = try cuda.setAllocationLimit(54 * (1 << 30));
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    var model = try Model.init(gpa, io, &ctx, checkpoint, "", .{ .context = context, .max_rows = max_rows });
+    defer model.deinit();
+    if (model.hidden != width) return error.UnexpectedBackboneWidth;
+    const after_init = cuda.usage(false);
+    var input = try cuda.HostBuffer.alloc(&driver, tensor_bytes);
+    defer input.free();
+    var output = try cuda.HostBuffer.alloc(&driver, tensor_bytes);
+    defer output.free();
+    const in_bytes: []align(16) u8 = input.bytes[0..tensor_bytes];
+    const out_bytes: []align(16) u8 = output.bytes[0..tensor_bytes];
+    for (origins) |origin| try out.createDir(io, @tagName(origin), .default_dir);
+
+    // 2-3. replay every origin, layer and operator from a fresh reset; compare against both original captures
+    var replay_ns: i128 = 0;
+    var count: usize = 0;
+    var name_buffer: [64]u8 = undefined;
+    var path_buffer: [96]u8 = undefined;
+    for (origins) |origin| {
+        const src = &sources[@backingInt(origin)];
+        for (replay_layers, 0..) |layer, li| {
+            for (operators) |op| {
+                const in_stage = inputStage(op);
+                const out_stage = outputStage(op);
+                @memcpy(in_bytes, src.tensor(li, in_stage));
+                @memset(out_bytes, 0xff); // BF16 NaN: a row the replay never wrote would show as nonfinite
+                try model.reset(stream);
+                const start = nowNs(io);
+                try model.replayOperator(stream, layer, op, &chunks, in_bytes, out_bytes);
+                const ns = nowNs(io) - start;
+                replay_ns += ns;
+                count += 1;
+
+                const name = try stageFileName(&name_buffer, layer, out_stage);
+                const path = try std.fmt.bufPrint(&path_buffer, "{s}/{s}", .{ @tagName(origin), name });
+                try out.writeFile(io, .{ .sub_path = path, .data = out_bytes, .flags = .{ .exclusive = true } });
+                const sha = sha256Hex(out_bytes);
+                const nonfinite = nonfiniteBf16(std.mem.bytesAsSlice(u16, out_bytes));
+                if (nonfinite != 0) try errors.add("{s}: {d} nonfinite values", .{ path, nonfinite });
+                const vs_native = Comparison.of(out_bytes, native.tensor(li, out_stage));
+                const vs_reference = Comparison.of(out_bytes, reference.tensor(li, out_stage));
+
+                try captures.print(gpa, "{s}\n    {{\"origin\": \"{s}\", \"layer\": {d}, \"stage\": \"{s}\", \"method\": \"{s}\", \"input_stage\": \"{s}\", \"input_sha256\": \"{s}\", \"file\": \"{s}\", \"sha256\": \"{s}\", \"shape\": [{d}, {d}], \"chunks\": [{d}, {d}], \"nonfinite\": {d}, \"replay_s\": {d:.6}, \"vs_native_original\": ", .{
+                    if (captures.items.len == 0) "" else ",", @tagName(origin), layer, @tagName(out_stage), methodName(layer, op), @tagName(in_stage), src.sha(li, in_stage), path, sha[0..], rows, width, chunks[0], chunks[1], nonfinite, seconds(ns),
+                });
+                try vs_native.json(captures, gpa, native.sha(li, out_stage));
+                try captures.appendSlice(gpa, ", \"vs_reference_original\": ");
+                try vs_reference.json(captures, gpa, reference.sha(li, out_stage));
+                try captures.appendSlice(gpa, "}");
+
+                if (origin == .native) {
+                    if (vs_native.bit_differences != 0) try errors.add("native self-control {s}: {d} bit differences vs the original native capture", .{ path, vs_native.bit_differences });
+                    try self_control.print(gpa, "{s}\n    {{\"layer\": {d}, \"stage\": \"{s}\", \"method\": \"{s}\", \"file\": \"{s}\", \"sha256\": \"{s}\", \"original_sha256\": \"{s}\", \"bit_differences\": {d}, \"bit_exact\": {}}}", .{
+                        if (self_control.items.len == 0) "" else ",", layer, @tagName(out_stage), methodName(layer, op), path, sha[0..], native.sha(li, out_stage), vs_native.bit_differences, vs_native.bit_differences == 0,
+                    });
+                }
+                std.debug.print("{s}: {s} sha256={s} vs_native_bits={d} vs_reference_bits={d} replay_s={d:.6}\n", .{ path, methodName(layer, op), sha[0..], vs_native.bit_differences, vs_reference.bit_differences, seconds(ns) });
+            }
+        }
+    }
+    if (count != origins.len * replay_layers.len * operators.len) try errors.add("{d} replays, expected {d}", .{ count, origins.len * replay_layers.len * operators.len });
+
+    // 4. poison guard, then the production run over the contract prompt
+    const run_refused = if (model.run(stream, .prefill, tokens[0..1], null)) |_| false else |err| err == error.DramaStateNeedsReset;
+    if (!run_refused) try errors.add("Model.run after a replay was not refused with DramaStateNeedsReset", .{});
+    const replay_refused = if (model.replayOperator(stream, replay_layers[0], .moe, &chunks, in_bytes, out_bytes)) |_| false else |err| err == error.DramaStateNeedsReset;
+    if (!replay_refused) try errors.add("replayOperator after a replay was not refused with DramaStateNeedsReset", .{});
+    try model.reset(stream);
+    var at: usize = 0;
+    for (chunks) |n| {
+        const result = try model.run(stream, .prefill, tokens[at..][0..n], null);
+        if (result.rows != n) return error.UnexpectedBackboneRows;
+        try result.hidden.download(0, std.mem.sliceAsBytes(hidden[at * width ..][0 .. n * width]));
+        at += n;
+        if (at == rows) try result.semantic_logits.download(0, std.mem.sliceAsBytes(&logits));
+    }
+    const end = cuda.usage(false);
+    const hidden_sha = sha256Hex(std.mem.sliceAsBytes(hidden));
+    const logits_sha = sha256Hex(std.mem.sliceAsBytes(&logits));
+    const hidden_nonfinite = nonfiniteBf16(hidden);
+    const logits_nonfinite = nonfiniteF32(&logits);
+    if (hidden_nonfinite != 0 or logits_nonfinite != 0) try errors.add("production control: {d} hidden and {d} logit nonfinite values", .{ hidden_nonfinite, logits_nonfinite });
+    const hidden_equal = std.mem.eql(u8, &hidden_sha, native.final_hidden_sha.?);
+    const logits_equal = std.mem.eql(u8, &logits_sha, native.semantic_logits_sha.?);
+    if (!hidden_equal) try errors.add("production control: final hidden sha256 {s} differs from the native trace {s}", .{ hidden_sha[0..], native.final_hidden_sha.? });
+    if (!logits_equal) try errors.add("production control: semantic logits sha256 {s} differ from the native trace {s}", .{ logits_sha[0..], native.semantic_logits_sha.? });
+    return .{
+        .after_init = after_init,
+        .end = end,
+        .replay_pinned_bytes = input.bytes.len + output.bytes.len,
+        .captures = count,
+        .replay_ns = replay_ns,
+        .run_after_replay_refused = run_refused,
+        .replay_after_replay_refused = replay_refused,
+        .final_hidden_sha = hidden_sha,
+        .semantic_logits_sha = logits_sha,
+        .production_bit_exact = hidden_equal and logits_equal,
+    };
+}
+
+pub fn main(init: std.process.Init) !u8 {
+    const gpa = init.gpa;
+    const io = init.io;
+    const arena = init.arena.allocator();
+    const args = try init.minimal.args.toSlice(arena);
+    if (args.len != 5) {
+        std.debug.print("usage: tf-drama-backbone-replay CHECKPOINT NATIVE_STAGE_DIR REFERENCE_STAGE_DIR OUTPUT_DIR\n", .{});
+        return 2;
+    }
+    if (builtin.cpu.arch.endian() != .little) return error.UnsupportedHostEndian;
+    const out = try std.Io.Dir.cwd().openDir(io, args[4], .{});
+    defer out.close(io);
+
+    var errors: Errors = .{ .gpa = gpa };
+    defer errors.json.deinit(gpa);
+
+    // 1. fixtures
+    var sources: [origins.len]Source = undefined;
+    for (origins) |origin| sources[@backingInt(origin)] = try loadSource(arena, io, origin, args[2 + @backingInt(origin)], &errors);
+    const native = &sources[@backingInt(Origin.native)];
+    const tokens = try loadTokens(arena, io, native, &errors);
+    var fixture_host_bytes: usize = 0;
+    for (sources) |src| {
+        for (src.tensors) |layer_tensors| {
+            for (layer_tensors) |t| fixture_host_bytes += if (t) |bytes| bytes.len else 0;
+        }
+    }
+
+    var captures: std.ArrayList(u8) = .empty;
+    defer captures.deinit(gpa);
+    var self_control: std.ArrayList(u8) = .empty;
+    defer self_control.deinit(gpa);
+    const gpu: ?Gpu = if (errors.count == 0)
+        try replayAll(gpa, io, args[1], &sources, tokens.?, out, &errors, &captures, &self_control)
+    else blk: {
+        std.debug.print("fixture validation failed: no model load, no replay\n", .{});
+        break :blk null;
+    };
+
+    // 5. manifest
+    const exe_path = "/proc/self/exe";
+    var binary_json: std.ArrayList(u8) = .empty;
+    defer binary_json.deinit(gpa);
+    if (fileSha256(gpa, io, exe_path)) |sha| {
+        try binary_json.print(gpa, "\"{s}\"", .{sha[0..]});
+    } else |err| {
+        std.debug.print("binary hash unavailable: {s}\n", .{@errorName(err)});
+        try binary_json.appendSlice(gpa, "null");
+    }
+    const backbone_source_sha = sha256Hex(drama.backbone.trace_source);
+    const replay_source_sha = sha256Hex(@embedFile("drama_backbone_replay.zig"));
+    const evidence_valid = errors.count == 0;
+
+    var m: std.ArrayList(u8) = .empty;
+    defer m.deinit(gpa);
+    try m.print(gpa, "{{\n  \"schema_version\": 1,\n  \"producer\": \"tf-drama-backbone-replay\",\n  \"contract\": \"{s}\",\n  \"checkpoint\": ", .{contract_name});
+    try jsonString(&m, gpa, args[1]);
+    try m.appendSlice(gpa, ",\n  \"origins\": [");
+    for (sources, 0..) |src, i| {
+        try m.print(gpa, "{s}\n    {{\"origin\": \"{s}\", \"stage_dir\": ", .{ if (i == 0) "" else ",", @tagName(src.origin) });
+        try jsonString(&m, gpa, src.path);
+        if (src.manifest_sha) |sha| try m.print(gpa, ", \"manifest_sha256\": \"{s}\"", .{sha[0..]}) else try m.appendSlice(gpa, ", \"manifest_sha256\": null");
+        try m.print(gpa, ", \"manifest_evidence_valid\": {}}}", .{src.manifest_evidence_valid});
+    }
+    try m.appendSlice(gpa, "\n  ],\n  \"tokens_file\": ");
+    if (native.tokens_file) |path| try jsonString(&m, gpa, path) else try m.appendSlice(gpa, "null");
+    try m.print(gpa, ",\n  \"tokens_sha256\": {s}{s}{s},\n  \"rows\": {d},\n  \"width\": {d},\n  \"dtype\": \"bf16le\",\n  \"layer_count\": {d},\n  \"layers\": [", .{
+        if (tokens != null) "\"" else "", if (tokens != null) contract_tokens_sha256 else "null", if (tokens != null) "\"" else "", rows, width, layer_count,
+    });
+    for (replay_layers, 0..) |layer, i| try m.print(gpa, "{s}{d}", .{ if (i == 0) "" else ", ", layer });
+    try m.print(gpa, "],\n  \"chunks\": [{d}, {d}],\n  \"model_options\": {{\"context\": {d}, \"max_rows\": {d}}}," ++
+        "\n  \"replay\": \"per origin, layer and operator: Model.reset, then Model.replayOperator, which uploads each chunk of the frozen input into Scratch.normed and runs the production method at request position row0; MoE replays the frozen mlp_input\"," ++
+        "\n  \"inputs\": [", .{ chunks[0], chunks[1], context, max_rows });
+    var first = true;
+    var name_buffer: [64]u8 = undefined;
+    for (sources) |src| {
+        for (replay_layers, 0..) |layer, li| {
+            for (used_stages, 0..) |stage, si| {
+                if (src.tensors[li][si] == null) continue;
+                const name = try stageFileName(&name_buffer, layer, stage);
+                try m.print(gpa, "{s}\n    {{\"origin\": \"{s}\", \"layer\": {d}, \"stage\": \"{s}\", \"file\": \"{s}\", \"sha256\": \"{s}\", \"shape\": [{d}, {d}]}}", .{
+                    if (first) "" else ",", @tagName(src.origin), layer, @tagName(stage), name, src.shas[li][si][0..], rows, width,
+                });
+                first = false;
+            }
+        }
+    }
+    try m.print(gpa, "\n  ],\n  \"captures\": [{s}\n  ],\n  \"native_self_control\": [{s}\n  ],", .{ captures.items, self_control.items });
+    if (gpu) |g| {
+        try m.print(gpa, "\n  \"production_control\": {{\"kind\": \"after all replays: Model.run and replayOperator without reset must be refused; then reset and production Model.run over the tokens_file in chunks 128 + 54\", \"run_after_replay_refused\": {}, \"replay_after_replay_refused\": {}, \"final_hidden_sha256\": \"{s}\", \"expected_final_hidden_sha256\": \"{s}\", \"semantic_logits_sha256\": \"{s}\", \"expected_semantic_logits_sha256\": \"{s}\", \"bit_exact\": {}}}," ++
+            "\n  \"timing_s\": {{\"replay_total\": {d:.6}}}," ++
+            "\n  \"allocations\": {{\"cuda_device_bytes_after_init\": {d}, \"cuda_device_bytes\": {d}, \"cuda_device_peak_bytes\": {d}, \"pinned_host_bytes\": {d}, \"replay_pinned_bytes\": {d}, \"fixture_host_bytes\": {d}}},", .{
+            g.run_after_replay_refused, g.replay_after_replay_refused, g.final_hidden_sha[0..], native.final_hidden_sha.?, g.semantic_logits_sha[0..], native.semantic_logits_sha.?, g.production_bit_exact,
+            seconds(g.replay_ns),       g.after_init.device,           g.end.device,            g.end.peak,                g.end.host,                 g.replay_pinned_bytes,        fixture_host_bytes,
+        });
+    } else {
+        try m.print(gpa, "\n  \"production_control\": null,\n  \"timing_s\": null,\n  \"allocations\": {{\"cuda_device_bytes_after_init\": null, \"fixture_host_bytes\": {d}}},", .{fixture_host_bytes});
+    }
+    try m.print(gpa, "\n  \"binary_sha256\": {s},\n  \"backbone_source_sha256\": \"{s}\",\n  \"replay_source_sha256\": \"{s}\"," ++
+        "\n  \"evidence_valid\": {},\n  \"errors\": [{s}\n  ]\n}}\n", .{ binary_json.items, backbone_source_sha[0..], replay_source_sha[0..], evidence_valid, errors.json.items });
+    try out.writeFile(io, .{ .sub_path = "manifest.json", .data = m.items, .flags = .{ .exclusive = true } });
+
+    std.debug.print("replays={d} evidence_valid={} errors={d}\n", .{ if (gpu) |g| g.captures else 0, evidence_valid, errors.count });
+    return if (evidence_valid) 0 else 3;
+}
diff --git a/zig/tests/cuda/drama_backbone_trace.zig b/zig/tests/cuda/drama_backbone_trace.zig
new file mode 100644
index 00000000..0cbb7d38
--- /dev/null
+++ b/zig/tests/cuda/drama_backbone_trace.zig
@@ -0,0 +1,353 @@
+//! Development diagnostic, not a gate: captures six stage tensors of every actual backbone layer from the
+//! production forward, for comparison with the reference's capture of the same stages.
+//!
+//! usage: tf-drama-backbone-trace CHECKPOINT TOKENS_U32LE OUTPUT_DIRECTORY
+//!
+//! TOKENS_U32LE is 2..512 little-endian u32 text tokens (the contract prompt, pinned by its SHA-256 below,
+//! 182 rows). OUTPUT_DIRECTORY must exist; every file is created exclusively, so an earlier trace is never
+//! overwritten. The model is built as tf-drama-backbone-oracle builds it: context 512, max_rows 128, so the
+//! prompt runs as chunks 128 + 54.
+//!
+//! 1. Traced: reset, then `Model.runTraced` per chunk with a tracer. Each capture point in `forward` copies the
+//!    live scratch tensor on the model's stream right after its producing kernel was queued and waits for the
+//!    copy, so the kernels, their order and their inputs are production's; only host waits are added. The rows
+//!    are written to layer-{LL}-{stage}.bf16 at their request position (Model.pos), so chunks concatenate in
+//!    logical row order, and hashed as they arrive.
+//! 2. Control: reset, then the production `Model.run` (the same forward instantiated with a void trace) over
+//!    the same chunks. Final hidden and semantic logits must be bit identical to the traced run.
+//! 3. final-hidden.bf16 / semantic-logits.f32 (traced), untraced-final-hidden.bf16 /
+//!    untraced-semantic-logits.f32, and manifest.json listing every file with shape and SHA-256.
+//!    evidence_valid is false (exit 3) on any recorded error: a token file other than the contract prompt, a
+//!    missing capture row, a nonfinite value, or a traced/untraced bit difference. A duplicate, out-of-order or
+//!    misshapen capture, or an existing output file, aborts the run without a manifest.
+//!
+//! The caller owns the shared GPU lock, admission, process cap and lifetime monitoring.
+const std = @import("std");
+const builtin = @import("builtin");
+const cuda = @import("cuda");
+const drama = @import("drama");
+
+const Allocator = std.mem.Allocator;
+const Model = drama.backbone.Model;
+const Stage = drama.backbone.Stage;
+
+const width = 2048;
+const candidate_count = 4097;
+const max_rows = 128;
+const context = 512;
+const stages = std.meta.tags(Stage);
+const stage_count = stages.len;
+/// The forward's own layer array: every layer it iterates is captured.
+const layer_count = @typeInfo(@FieldType(@FieldType(Model, "w"), "layers")).array.len;
+const contract_tokens_sha256 = "fe39111abb37fc10cb2e5c846313464c38fad13d92d44f082ef465d5b3baba86";
+
+comptime {
+    std.debug.assert(drama.backbone.config.hidden == width);
+    std.debug.assert(drama.backbone.weights.head_cols == candidate_count);
+}
+
+/// What each stage file holds, in `Model.forward`'s terms.
+const stage_sources =
+    \\{"attention_input": "Scratch.normed after addNorm(x, residual, ln1): input RMSNorm output",
+    \\    "attention_residual": "Scratch.residual after addNorm(x, residual, ln1): updated residual (layer 0: the embedding)",
+    \\    "attention_output": "Scratch.x after deltaNet or fullAttention: out projection, before the second add-norm",
+    \\    "mlp_input": "Scratch.normed after addNorm(x, residual, ln2): post-attention RMSNorm output",
+    \\    "mlp_residual": "Scratch.residual after addNorm(x, residual, ln2): updated residual",
+    \\    "mlp_output": "Scratch.x after moe: routed experts combined with the sigmoid-gated shared expert"}
+;
+
+/// Recorded failures that leave the files written but the evidence invalid. Messages hold no quote or backslash.
+const Errors = struct {
+    gpa: Allocator,
+    json: std.ArrayList(u8) = .empty,
+    count: usize = 0,
+
+    fn add(e: *Errors, comptime f: []const u8, args: anytype) !void {
+        std.debug.print("error: " ++ f ++ "\n", args);
+        try e.json.appendSlice(e.gpa, if (e.count == 0) "\n    \"" else ",\n    \"");
+        try e.json.print(e.gpa, f, args);
+        try e.json.append(e.gpa, '"');
+        e.count += 1;
+    }
+};
+
+/// The `drama.backbone.Model.runTraced` tracer. Each (layer, stage) file is written chunk by chunk at its rows'
+/// offset and hashed as it goes, so the trace holds no host copy beyond the pinned staging buffer.
+const Tracer = struct {
+    io: std.Io,
+    dir: std.Io.Dir,
+    rows: usize,
+    /// Pinned, max_rows * width * 2 bytes: the target of the stream-ordered copy.
+    staging: []align(16) u8,
+    /// Rows captured so far per (layer, stage); a capture must start exactly there.
+    next_row: [slots]usize = @splat(0),
+    hashes: [slots]std.crypto.hash.sha2.Sha256 = @splat(std.crypto.hash.sha2.Sha256.init(.{})),
+    nonfinite: [slots]usize = @splat(0),
+    captures: usize = 0,
+    written: usize = 0,
+
+    const slots = layer_count * stage_count;
+
+    fn slotOf(layer: usize, stage: Stage) usize {
+        return layer * stage_count + @backingInt(stage);
+    }
+
+    fn fileName(buffer: []u8, layer: usize, stage: Stage) ![]u8 {
+        return std.fmt.bufPrint(buffer, "layer-{d:0>2}-{s}.bf16", .{ layer, @tagName(stage) });
+    }
+
+    pub fn capture(t: *Tracer, stream: cuda.Stream, layer: usize, stage: Stage, src: cuda.DeviceBuffer, row0: usize) !void {
+        if (layer >= layer_count) return error.TraceLayerOutOfRange;
+        if (src.len == 0 or src.len % (width * 2) != 0 or src.len > t.staging.len) return error.TraceCaptureShape;
+        const n = src.len / (width * 2);
+        if (row0 > t.rows or n > t.rows - row0) return error.TraceRowsOutOfRange;
+        const at = slotOf(layer, stage);
+        if (row0 != t.next_row[at]) return error.TraceDuplicateOrMissingRows;
+        // Queued behind the stage's kernel and ahead of the next one, then drained before the forward continues.
+        const bytes = t.staging[0..src.len];
+        try src.downloadAsync(0, bytes, stream.handle);
+        try stream.synchronize();
+        var name_buffer: [64]u8 = undefined;
+        const name = try fileName(&name_buffer, layer, stage);
+        const file = if (row0 == 0)
+            try t.dir.createFile(t.io, name, .{ .exclusive = true })
+        else
+            try t.dir.openFile(t.io, name, .{ .mode = .write_only });
+        defer file.close(t.io);
+        try file.writePositionalAll(t.io, bytes, row0 * width * 2);
+        t.hashes[at].update(bytes);
+        t.nonfinite[at] += nonfiniteBf16(std.mem.bytesAsSlice(u16, bytes));
+        t.next_row[at] = row0 + n;
+        t.captures += 1;
+        t.written += bytes.len;
+    }
+};
+
+/// Reset, then the whole prompt in max_rows chunks: `Model.run` for a void trace, else `Model.runTraced`.
+fn runPrompt(model: *Model, stream: cuda.Stream, tokens: []const u32, trace: anytype, hidden: []u16, logits: *[candidate_count]f32) !void {
+    try model.reset(stream);
+    var at: usize = 0;
+    while (at < tokens.len) {
+        const end = @min(at + max_rows, tokens.len);
+        const output = if (@TypeOf(trace) == void)
+            try model.run(stream, .prefill, tokens[at..end], null)
+        else
+            try model.runTraced(stream, .prefill, tokens[at..end], null, trace);
+        if (output.rows != end - at) return error.UnexpectedBackboneRows;
+        try output.hidden.download(0, std.mem.sliceAsBytes(hidden[at * width .. end * width]));
+        if (end == tokens.len) try output.semantic_logits.download(0, std.mem.sliceAsBytes(logits));
+        at = end;
+    }
+}
+
+fn nonfiniteBf16(values: []const u16) usize {
+    var count: usize = 0;
+    for (values) |bits| {
+        if ((bits & 0x7f80) == 0x7f80) count += 1;
+    }
+    return count;
+}
+
+fn nonfiniteF32(values: []const f32) usize {
+    var count: usize = 0;
+    for (values) |v| {
+        if (!std.math.isFinite(v)) count += 1;
+    }
+    return count;
+}
+
+fn sha256Hex(bytes: []const u8) [64]u8 {
+    var out: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(bytes, &out, .{});
+    return std.fmt.bytesToHex(out, .lower);
+}
+
+fn fileSha256(gpa: Allocator, io: std.Io, path: []const u8) ![64]u8 {
+    const file = try std.Io.Dir.openFileAbsolute(io, path, .{});
+    defer file.close(io);
+    const buffer = try gpa.alloc(u8, 1 << 20);
+    defer gpa.free(buffer);
+    var hash = std.crypto.hash.sha2.Sha256.init(.{});
+    var offset: u64 = 0;
+    while (true) {
+        const got = try file.readPositionalAll(io, buffer, offset);
+        hash.update(buffer[0..got]);
+        offset += got;
+        if (got < buffer.len) break;
+    }
+    return std.fmt.bytesToHex(hash.finalResult(), .lower);
+}
+
+fn jsonString(list: *std.ArrayList(u8), gpa: Allocator, s: []const u8) !void {
+    try list.append(gpa, '"');
+    for (s) |c| switch (c) {
+        '"', '\\' => {
+            try list.append(gpa, '\\');
+            try list.append(gpa, c);
+        },
+        0...0x1f => try list.print(gpa, "\\u{x:0>4}", .{c}),
+        else => try list.append(gpa, c),
+    };
+    try list.append(gpa, '"');
+}
+
+/// Writes one new file and returns its SHA-256.
+fn emit(dir: std.Io.Dir, io: std.Io, name: []const u8, data: []const u8) ![64]u8 {
+    try dir.writeFile(io, .{ .sub_path = name, .data = data, .flags = .{ .exclusive = true } });
+    return sha256Hex(data);
+}
+
+pub fn main(init: std.process.Init) !u8 {
+    const gpa = init.gpa;
+    const io = init.io;
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    if (args.len != 4) {
+        std.debug.print("usage: tf-drama-backbone-trace CHECKPOINT TOKENS_U32LE OUTPUT_DIRECTORY\n", .{});
+        return 2;
+    }
+    if (builtin.cpu.arch.endian() != .little) return error.UnsupportedHostEndian;
+
+    var bytes: [context * 4 + 1]u8 align(@alignOf(u32)) = undefined;
+    const input = try std.Io.Dir.cwd().openFile(io, args[2], .{});
+    defer input.close(io);
+    const count = try input.readPositionalAll(io, &bytes, 0);
+    if (count < 8 or count > context * 4 or count % 4 != 0) return error.ExpectedTwoTo512Tokens;
+    const tokens = std.mem.bytesAsSlice(u32, @as([]align(@alignOf(u32)) u8, bytes[0..count]));
+    const tokens_sha = sha256Hex(bytes[0..count]);
+    const rows = tokens.len;
+    const chunks = (rows + max_rows - 1) / max_rows;
+    const out = try std.Io.Dir.cwd().openDir(io, args[3], .{});
+    defer out.close(io);
+
+    var errors: Errors = .{ .gpa = gpa };
+    defer errors.json.deinit(gpa);
+    if (!std.mem.eql(u8, &tokens_sha, contract_tokens_sha256)) try errors.add("tokens_sha256 {s} is not the contract prompt {s}", .{ tokens_sha[0..], contract_tokens_sha256 });
+
+    const traced_hidden = try gpa.alloc(u16, rows * width);
+    defer gpa.free(traced_hidden);
+    const plain_hidden = try gpa.alloc(u16, rows * width);
+    defer gpa.free(plain_hidden);
+    const trace_host_bytes = (traced_hidden.len + plain_hidden.len) * 2 + @sizeOf(Tracer);
+    var traced_logits: [candidate_count]f32 = undefined;
+    var plain_logits: [candidate_count]f32 = undefined;
+
+    _ = try cuda.setAllocationLimit(54 * (1 << 30));
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    var model = try Model.init(gpa, io, &ctx, args[1], "", .{ .context = context, .max_rows = max_rows });
+    defer model.deinit();
+    if (model.hidden != width) return error.UnexpectedBackboneWidth;
+    for (tokens) |token| if (token >= model.semantic_start and token <= model.semantic_end) return error.TextFixtureMustNotContainSemanticTokens;
+    const model_usage = cuda.usage(false);
+    var staging = try cuda.HostBuffer.alloc(&driver, max_rows * width * 2);
+    defer staging.free();
+
+    // 1. traced
+    var tracer: Tracer = .{ .io = io, .dir = out, .rows = rows, .staging = staging.bytes };
+    const traced_start = std.Io.Clock.awake.now(io).toNanoseconds();
+    try runPrompt(&model, stream, tokens, &tracer, traced_hidden, &traced_logits);
+    const traced_ns = std.Io.Clock.awake.now(io).toNanoseconds() - traced_start;
+
+    // 2. control: production run, no tracer
+    const plain_start = std.Io.Clock.awake.now(io).toNanoseconds();
+    try runPrompt(&model, stream, tokens, {}, plain_hidden, &plain_logits);
+    const plain_ns = std.Io.Clock.awake.now(io).toNanoseconds() - plain_start;
+    const used = cuda.usage(false);
+
+    var hidden_differences: usize = 0;
+    for (traced_hidden, plain_hidden) |a, b| {
+        if (a != b) hidden_differences += 1;
+    }
+    const logits_equal = std.mem.eql(u8, std.mem.sliceAsBytes(&traced_logits), std.mem.sliceAsBytes(&plain_logits));
+    const control_exact = hidden_differences == 0 and logits_equal;
+    if (!control_exact) try errors.add("traced vs untraced: {d} final hidden bit differences, semantic logits bit equal {}", .{ hidden_differences, logits_equal });
+    if (tracer.captures != layer_count * stage_count * chunks) try errors.add("{d} captures, expected {d}", .{ tracer.captures, layer_count * stage_count * chunks });
+
+    // 3. manifest entries for the stage files the tracer wrote; then the final outputs
+    var captures: std.ArrayList(u8) = .empty;
+    defer captures.deinit(gpa);
+    var name_buffer: [64]u8 = undefined;
+    for (0..layer_count) |layer| {
+        for (stages) |stage| {
+            const name = try Tracer.fileName(&name_buffer, layer, stage);
+            const at = Tracer.slotOf(layer, stage);
+            const got = tracer.next_row[at];
+            if (got != rows) try errors.add("{s}: captured {d} of {d} rows", .{ name, got, rows });
+            const nonfinite = tracer.nonfinite[at];
+            if (nonfinite != 0) try errors.add("{s}: {d} nonfinite values", .{ name, nonfinite });
+            const sha = std.fmt.bytesToHex(tracer.hashes[at].finalResult(), .lower);
+            try captures.print(gpa, "{s}\n    {{\"layer\": {d}, \"stage\": \"{s}\", \"file\": \"{s}\", \"sha256\": \"{s}\", \"shape\": [{d}, {d}], \"rows_captured\": {d}, \"nonfinite\": {d}}}", .{
+                if (captures.items.len == 0) "" else ",", layer, @tagName(stage), name, sha[0..], rows, width, got, nonfinite,
+            });
+        }
+    }
+    var written = tracer.written;
+    const finals = [_]struct { name: []const u8, bytes: []const u8, nonfinite: usize }{
+        .{ .name = "final-hidden.bf16", .bytes = std.mem.sliceAsBytes(traced_hidden), .nonfinite = nonfiniteBf16(traced_hidden) },
+        .{ .name = "semantic-logits.f32", .bytes = std.mem.sliceAsBytes(&traced_logits), .nonfinite = nonfiniteF32(&traced_logits) },
+        .{ .name = "untraced-final-hidden.bf16", .bytes = std.mem.sliceAsBytes(plain_hidden), .nonfinite = nonfiniteBf16(plain_hidden) },
+        .{ .name = "untraced-semantic-logits.f32", .bytes = std.mem.sliceAsBytes(&plain_logits), .nonfinite = nonfiniteF32(&plain_logits) },
+    };
+    var final_sha: [finals.len][64]u8 = undefined;
+    for (finals, &final_sha) |f, *sha| {
+        if (f.nonfinite != 0) try errors.add("{s}: {d} nonfinite values", .{ f.name, f.nonfinite });
+        sha.* = try emit(out, io, f.name, f.bytes);
+        written += f.bytes.len;
+    }
+
+    const exe_path = "/proc/self/exe";
+    var binary_json: std.ArrayList(u8) = .empty;
+    defer binary_json.deinit(gpa);
+    if (fileSha256(gpa, io, exe_path)) |sha| {
+        try binary_json.print(gpa, "\"{s}\"", .{sha[0..]});
+    } else |err| {
+        std.debug.print("binary hash unavailable: {s}\n", .{@errorName(err)});
+        try binary_json.appendSlice(gpa, "null");
+    }
+    const backbone_source_sha = sha256Hex(drama.backbone.trace_source);
+    const trace_source_sha = sha256Hex(@embedFile("drama_backbone_trace.zig"));
+    const evidence_valid = errors.count == 0;
+
+    var manifest: std.ArrayList(u8) = .empty;
+    defer manifest.deinit(gpa);
+    try manifest.appendSlice(gpa, "{\n  \"schema_version\": 1,\n  \"producer\": \"tf-drama-backbone-trace\",\n  \"checkpoint\": ");
+    try jsonString(&manifest, gpa, args[1]);
+    try manifest.appendSlice(gpa, ",\n  \"tokens_file\": ");
+    try jsonString(&manifest, gpa, args[2]);
+    try manifest.print(gpa, ",\n  \"tokens_sha256\": \"{s}\",\n  \"contract_tokens_sha256\": \"{s}\",\n  \"rows\": {d},\n  \"width\": {d},\n  \"dtype\": \"bf16le\",\n  \"layer_count\": {d}," ++
+        "\n  \"stages\": [", .{ tokens_sha[0..], contract_tokens_sha256, rows, width, layer_count });
+    for (stages, 0..) |stage, i| try manifest.print(gpa, "{s}\"{s}\"", .{ if (i == 0) "" else ", ", @tagName(stage) });
+    try manifest.print(gpa, "],\n  \"stage_sources\": {s},\n  \"row_order\": \"logical request position; each chunk's rows land at Model.pos\"," ++
+        "\n  \"model_options\": {{\"context\": {d}, \"max_rows\": {d}}},\n  \"chunks\": [", .{ stage_sources, context, max_rows });
+    for (0..chunks) |c| try manifest.print(gpa, "{s}{d}", .{ if (c == 0) "" else ", ", @min(max_rows, rows - c * max_rows) });
+    try manifest.print(gpa, "],\n  \"eos\": {d},\n  \"semantic_start\": {d},\n  \"semantic_end\": {d},\n  \"captures\": [{s}\n  ]," ++
+        "\n  \"final_hidden\": {{\"file\": \"{s}\", \"sha256\": \"{s}\", \"shape\": [{d}, {d}], \"dtype\": \"bf16le\", \"source\": \"Model.run Rows.hidden, final RMSNorm, traced run\"}}," ++
+        "\n  \"semantic_logits\": {{\"file\": \"{s}\", \"sha256\": \"{s}\", \"shape\": [{d}], \"dtype\": \"f32le\", \"row\": {d}, \"layout\": \"EOS then semantic_start..semantic_end\", \"source\": \"Model.run Rows.semantic_logits, last row, traced run\"}},", .{
+        model.eos,      model.semantic_start, model.semantic_end, captures.items,
+        finals[0].name, final_sha[0][0..],    rows,               width,
+        finals[1].name, final_sha[1][0..],    candidate_count,    rows - 1,
+    });
+    try manifest.print(gpa, "\n  \"control\": {{\"kind\": \"reset, then production Model.run (void trace) over the same chunks\", \"untraced_final_hidden\": {{\"file\": \"{s}\", \"sha256\": \"{s}\"}}, \"untraced_semantic_logits\": {{\"file\": \"{s}\", \"sha256\": \"{s}\"}}, \"final_hidden_bit_differences\": {d}, \"semantic_logits_bit_equal\": {}, \"traced_untraced_bit_exact\": {}}}," ++
+        "\n  \"timing_s\": {{\"traced\": {d:.6}, \"untraced\": {d:.6}}}," ++
+        "\n  \"allocations\": {{\"cuda_device_bytes_after_init\": {d}, \"cuda_device_bytes\": {d}, \"cuda_device_peak_bytes\": {d}, \"pinned_host_bytes\": {d}, \"trace_staging_pinned_bytes\": {d}, \"trace_host_bytes\": {d}}}," ++
+        "\n  \"binary_sha256\": {s},\n  \"backbone_source_sha256\": \"{s}\",\n  \"trace_source_sha256\": \"{s}\"," ++
+        "\n  \"evidence_valid\": {},\n  \"errors\": [{s}\n  ]\n}}\n", .{
+        finals[2].name,                          final_sha[2][0..],     finals[3].name,   final_sha[3][0..],
+        hidden_differences,                      logits_equal,          control_exact,    @as(f64, @floatFromInt(traced_ns)) / 1e9,
+        @as(f64, @floatFromInt(plain_ns)) / 1e9, model_usage.device,    used.device,      used.peak,
+        used.host,                               staging.bytes.len,     trace_host_bytes, binary_json.items,
+        backbone_source_sha[0..],                trace_source_sha[0..], evidence_valid,   errors.json.items,
+    });
+    try out.writeFile(io, .{ .sub_path = "manifest.json", .data = manifest.items, .flags = .{ .exclusive = true } });
+
+    std.debug.print("rows={d} chunks={d} layers={d} captures={d} bytes_written={d} traced_s={d:.6} untraced_s={d:.6} final_hidden_bit_differences={d} semantic_logits_bit_equal={} evidence_valid={} errors={d} cuda_bytes={d} cuda_peak={d} pinned_bytes={d}\n", .{
+        rows,                                     chunks,                                  layer_count,        tracer.captures, written + manifest.items.len,
+        @as(f64, @floatFromInt(traced_ns)) / 1e9, @as(f64, @floatFromInt(plain_ns)) / 1e9, hidden_differences, logits_equal,    evidence_valid,
+        errors.count,                             used.device,                             used.peak,          used.host,
+    });
+    return if (evidence_valid) 0 else 3;
+}
diff --git a/zig/tests/cuda/drama_conv_tests.zig b/zig/tests/cuda/drama_conv_tests.zig
new file mode 100644
index 00000000..b4faa940
--- /dev/null
+++ b/zig/tests/cuda/drama_conv_tests.zig
@@ -0,0 +1,111 @@
+//! Causal convolution's phase-specific precision, raw history, stride and chunk boundaries; no checkpoint required.
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+
+const channels = 257; // Exercise a partial second CUDA block.
+const stride = channels + 3;
+const rows = 7;
+const guard = 32;
+const sentinel: u16 = 0x7fc1;
+const input = [rows][3]u16{
+    .{ 0xc06e, 0xbfee, 0x0000 }, .{ 0xbfa5, 0x3f12, 0x401b },
+    .{ 0x3f92, 0x4040, 0xc02e }, .{ 0x4065, 0xc009, 0xbe92 },
+    .{ 0xbfc9, 0x3e92, 0x4009 }, .{ 0x3f5b, 0x402e, 0xc040 },
+    .{ 0x4052, 0xc01b, 0xbf12 },
+};
+const weights = [3][4]u16{
+    .{ 0xbf9c, 0x0000, 0x3f9c, 0xbde4 },
+    .{ 0xbf2b, 0x3f0e, 0xbf47, 0x3ee4 },
+    .{ 0xbde4, 0x3f8e, 0xbe64, 0x3f80 },
+};
+const initial = [3][3]u16{
+    .{ 0xbfa3, 0xbf23, 0x0000 }, .{ 0x3ee9, 0x3f8c, 0xbf69 }, .{ 0xbee9, 0x3e3a, 0x3f51 },
+};
+// Independently evaluated from the stored BF16 operands: ordered FP32 sums,
+// BF16 product rounding for prefill only, then silu and BF16 RNE. Values are
+// away from rounding midpoints; row zero distinguishes one-row prefill from decode.
+const prefill = [rows][3]u16{
+    .{ 0x3f92, 0x3d02, 0xbe8e }, .{ 0xbd0f, 0x3f4c, 0x4055 },
+    .{ 0xbe8d, 0xbde8, 0xbde9 }, .{ 0x40b0, 0xbe86, 0x4037 },
+    .{ 0x40c3, 0x403c, 0xbe8c }, .{ 0xbde1, 0xbe61, 0xbdd4 },
+    .{ 0xbdb7, 0xbe8a, 0x4014 },
+};
+const decode = [rows][3]u16{
+    .{ 0x3f91, 0x3d05, 0xbe8e }, .{ 0xbd0f, 0x3f4c, 0x4055 },
+    .{ 0xbe8d, 0xbde8, 0xbde9 }, .{ 0x40b0, 0xbe85, 0x4037 },
+    .{ 0x40c3, 0x403c, 0xbe8c }, .{ 0xbde1, 0xbe60, 0xbdd4 },
+    .{ 0xbdb9, 0xbe8a, 0x4014 },
+};
+
+fn runCase(gpu: check.Gpu, stream: cuda.Stream, kernel: cuda.Function, chunk: usize, expected: *const [rows][3]u16) !void {
+    var x: [rows * stride]u16 = @splat(sentinel);
+    var w: [channels * 4]u16 = undefined;
+    var history: [guard + 3 * channels + guard]u16 = @splat(sentinel);
+    var output: [guard + rows * channels + guard]u16 = @splat(sentinel);
+    for (0..channels) |c| {
+        for (0..rows) |r| x[r * stride + c] = input[r][c % 3];
+        for (0..4) |k| w[4 * c + k] = weights[c % 3][k];
+        for (0..3) |r| history[guard + r * channels + c] = initial[r][c % 3];
+    }
+    var dx = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.asBytes(&x));
+    defer dx.free();
+    var dw = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.asBytes(&w));
+    defer dw.free();
+    var dh = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.asBytes(&history));
+    defer dh.free();
+    var dy = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.asBytes(&output));
+    defer dy.free();
+    try gpu.ctx.synchronize();
+    var start: usize = 0;
+    while (start < rows) {
+        const count = @min(chunk, rows - start);
+        var args: cuda.Args = .{};
+        args.add(dx.ptr + start * stride * 2);
+        args.add(@as(i32, stride));
+        args.add(dw.ptr);
+        args.add(dh.ptr + guard * 2);
+        args.add(dy.ptr + (guard + start * channels) * 2);
+        args.add(@as(i32, @intCast(count)));
+        args.add(@as(i32, channels));
+        try cuda.launch.launch(kernel, .{ .grid = .{ .x = (channels + 255) / 256 }, .block = .{ .x = 256 } }, stream, &args);
+        try stream.synchronize();
+        try dh.download(0, std.mem.asBytes(&history));
+        // History contains raw inputs, including the initial state until three rows have arrived.
+        const seen = start + count;
+        for (0..3) |r| for (0..channels) |c| {
+            const index = seen + r;
+            const want = if (index < 3) initial[index][c % 3] else input[index - 3][c % 3];
+            try check.expect(history[guard + r * channels + c] == want, "conv history at row {d}, channel {d}, chunk {d}", .{ seen, c, chunk });
+        };
+        start = seen;
+    }
+    try dy.download(0, std.mem.asBytes(&output));
+    for (0..rows) |r| for (0..channels) |c| {
+        try check.expect(output[guard + r * channels + c] == expected[r][c % 3], "conv output row {d}, channel {d}, chunk {d}: {x} != {x}", .{ r, c, chunk, output[guard + r * channels + c], expected[r][c % 3] });
+    };
+    for (0..guard) |i| {
+        try check.expect(output[i] == sentinel and output[guard + rows * channels + i] == sentinel, "conv output guard {d}", .{i});
+        try check.expect(history[i] == sentinel and history[guard + 3 * channels + i] == sentinel, "conv history guard {d}", .{i});
+    }
+    var x_after: @TypeOf(x) = undefined;
+    var w_after: @TypeOf(w) = undefined;
+    try dx.download(0, std.mem.asBytes(&x_after));
+    try dw.download(0, std.mem.asBytes(&w_after));
+    try check.sameBytes("conv input unchanged", std.mem.asBytes(&x_after), std.mem.asBytes(&x));
+    try check.sameBytes("conv weights unchanged", std.mem.asBytes(&w_after), std.mem.asBytes(&w));
+}
+
+pub fn run(gpu: check.Gpu) !void {
+    var module = try cuda.Module.load(gpu.d, cuda.kernels.drama_backbone);
+    defer module.unload();
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    const prefill_fn = try module.function("drama_gdn_conv_prefill");
+    const decode_fn = try module.function("drama_gdn_conv");
+    for ([_]usize{ 1, 3, 7 }) |chunk| {
+        try runCase(gpu, stream, prefill_fn, chunk, &prefill);
+        try runCase(gpu, stream, decode_fn, chunk, &decode);
+    }
+    check.pass("Drama convolution: prefill/decode precision, raw history, chunks 1/3/7, stride and partial block", .{});
+}
diff --git a/zig/tests/cuda/drama_gdn_canonical_oracle.zig b/zig/tests/cuda/drama_gdn_canonical_oracle.zig
new file mode 100644
index 00000000..62a77d3b
--- /dev/null
+++ b/zig/tests/cuda/drama_gdn_canonical_oracle.zig
@@ -0,0 +1,1086 @@
+//! Private verification driver, not a gate by itself: runs the production Drama GDN controller
+//! (`drama.backbone.gdn`: State, Workspace, Kernels) on deterministic raw fixtures and writes every output, every
+//! boundary state and the controller metadata for an external checker to judge against the pinned reference.
+//!
+//! usage: tf-drama-gdn-canonical-oracle GLUE_FATBIN FROZEN_FATBIN CASES_DIR OUTPUT_DIR
+//!
+//! GLUE_FATBIN is the produced drama_backbone.fatbin (loaded with cuda.Module; gdn.Kernels.init resolves the
+//! controller's kernels from it). FROZEN_FATBIN must be the frozen pre-chunk drama_backbone image
+//! (SHA-256 pinned below): its unchanged `drama_gdn_recur` is the decode baseline and its `drama_gdn_recur_prefill`
+//! the old sequential prefill control. CASES_DIR holds cases.json (schema drama-gdn-canonical-cases/1, written by
+//! that checker) and the raw tensors it names; OUTPUT_DIR must exist and every output is created
+//! exclusively. No model weights are read.
+//!
+//! 1. Fixtures (CPU only): cases.json is parsed strictly; every raw file must have its exact size and manifest
+//!    SHA-256. Any failure exits 2 before the GPU is touched.
+//! 2. Memory, once per geometry: a_log/dt_bias, the padded input streams, two layers' caller-owned regions
+//!    (guard | bank0 | guard | bank1 | guard | qkv_cache | guard | ba_cache | guard), one workspace sized for the
+//!    largest case (front and back guards), guarded output rows, the frozen controls' states. Nothing is allocated
+//!    while a case runs; the counted device bytes are recorded and checked constant.
+//! 3. Each case runs twice (pass 1 must reproduce pass 0 bit for bit). A pass starts by resetting both layers:
+//!    zero banks and caches (or NaN caches for an explicit poison reset), State.resetMetadata(), then a nonzero
+//!    initial state uploaded into bank0. Ops call exactly gdn.Kernels.prefill / gdn.Kernels.decode on the layer's
+//!    State, the shared placed Workspace and the caller stream. Before every prefill the workspace and the output
+//!    rows are filled with 0xFF (NaN); afterwards rows [0, n) must all be written and every guard byte must be intact.
+//!    Inputs (streams, a_log, dt_bias) are compared byte for byte after every op. Each decode first copies
+//!    State.current() and runs the frozen image's decode export on that copy and the same rows: output and state
+//!    must be bit identical. The old sequential chain (frozen prefill/decode exports on its own state) runs next to
+//!    it for the old-discrepancy control.
+//! 4. result.json: per op metadata (pending/committed before and after, which bank current() returned), SHA-256 of
+//!    every output and state, coverage, overrun, guard, input and repeat findings, timings, allocations, image and
+//!    binary hashes. evidence_valid is false (exit 3) on any recorded error. A CUDA or controller error aborts.
+//!
+//! The caller owns the shared GPU lock, admission, process cap and lifetime monitoring.
+const std = @import("std");
+const builtin = @import("builtin");
+const cuda = @import("cuda");
+const drama = @import("drama");
+
+const gdn = drama.backbone.gdn;
+const Allocator = std.mem.Allocator;
+const Sha256 = std.crypto.hash.sha2.Sha256;
+
+const producer = "tf-drama-gdn-canonical-oracle";
+const cases_schema = "drama-gdn-canonical-cases/1";
+const result_schema = "drama-gdn-canonical-native/1";
+const frozen_image_sha256 = "60ec0492bd5926c12bec45b1a555022d080bfe187bb9180d89aec36a0ac43b7f";
+const frozen_decode = "drama_gdn_recur";
+const frozen_prefill = "drama_gdn_recur_prefill";
+const dv = 128;
+const chunk = gdn.chunk_rows;
+const layer_count = 2;
+const passes = 2;
+const guard = 4096; // bytes; a multiple of 256 keeps every placed buffer aligned like cuMemAlloc
+const y_guard_rows = 2;
+const fill = 0xff; // bf16 0xFFFF and f32 0xFFFFFFFF are NaN: no finite result has these bytes
+const device_limit = 1 << 30;
+const max_file = 1 << 28;
+/// Workspace fields read for the gate probe when the component's (free) representation has them as device
+/// addresses: FP32 [capacity rows][nv] each, as the prototype workspace. Absent fields are reported, not invented.
+const probe_fields = [_][]const u8{ "g", "gc", "beta" };
+const probe_available = blk: {
+    for (probe_fields) |f| {
+        if (!@hasField(gdn.Workspace, f)) break :blk false;
+        if (@FieldType(gdn.Workspace, f) != u64) break :blk false;
+    }
+    break :blk true;
+};
+
+comptime {
+    std.debug.assert(chunk == 64);
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// manifest
+
+const BadCases = error{BadCases};
+
+fn bad(comptime f: []const u8, args: anytype) BadCases {
+    std.debug.print("cases manifest: " ++ f ++ "\n", args);
+    return error.BadCases;
+}
+
+const File = struct { name: []const u8, sha: []const u8, bytes: []align(16) const u8 };
+
+const Geometry = struct {
+    name: []const u8,
+    nk: usize,
+    nv: usize,
+    a_log: File,
+    dt_bias: File,
+    max_rows: usize = 0, // largest case max_rows: output rows allocated
+    ws_bytes: usize = 0, // largest Workspace.layout size over this geometry's cases
+    used: bool = false,
+
+    fn width(g: Geometry) usize {
+        return (2 * g.nk + g.nv) * dv;
+    }
+    fn stateBytes(g: Geometry) usize {
+        return g.nv * dv * dv * 4;
+    }
+    fn rowBytes(g: Geometry) usize {
+        return g.nv * dv * 2;
+    }
+    fn qkvCacheBytes(g: Geometry) usize {
+        return chunk * g.width() * 2;
+    }
+    fn baCacheBytes(g: Geometry) usize {
+        return chunk * 2 * g.nv * 2;
+    }
+};
+
+const Stream = struct { name: []const u8, geometry: usize, rows: usize, ld_qkv: usize, ld_ba: usize, qkv: File, ba: File };
+const Init = struct { name: []const u8, geometry: usize, file: File };
+const OpKind = enum { prefill, decode, reset };
+const Op = struct {
+    kind: OpKind,
+    layer: usize,
+    stream: usize = 0,
+    start: usize = 0,
+    rows: usize = 0,
+    probe: bool = false,
+    init: ?usize = null, // reset: null = zero state
+    poison_cache: bool = false,
+};
+const Case = struct {
+    name: []const u8,
+    geometry: usize,
+    max_rows: usize,
+    init: [layer_count]?usize,
+    ops: []const Op,
+    save_old_states: bool,
+    last_op: [layer_count]?usize, // the layer's last prefill/decode op
+};
+
+const Cases = struct {
+    sha: [64]u8,
+    geometries: []Geometry,
+    streams: []Stream,
+    inits: []Init,
+    cases: []Case,
+};
+
+fn get(o: std.json.ObjectMap, key: []const u8) BadCases!std.json.Value {
+    return o.get(key) orelse bad("missing key {s}", .{key});
+}
+
+fn uintOf(o: std.json.ObjectMap, key: []const u8) BadCases!usize {
+    const v = try get(o, key);
+    if (v != .integer or v.integer < 0) return bad("{s} is not a non-negative integer", .{key});
+    return @intCast(v.integer);
+}
+
+fn textOf(o: std.json.ObjectMap, key: []const u8) BadCases![]const u8 {
+    const v = try get(o, key);
+    if (v != .string) return bad("{s} is not a string", .{key});
+    return v.string;
+}
+
+fn boolOr(o: std.json.ObjectMap, key: []const u8, default: bool) BadCases!bool {
+    const v = o.get(key) orelse return default;
+    if (v != .bool) return bad("{s} is not a bool", .{key});
+    return v.bool;
+}
+
+fn objectOf(v: std.json.Value, what: []const u8) BadCases!std.json.ObjectMap {
+    if (v != .object) return bad("{s} is not an object", .{what});
+    return v.object;
+}
+
+fn arrayOf(o: std.json.ObjectMap, key: []const u8) BadCases![]std.json.Value {
+    const v = try get(o, key);
+    if (v != .array) return bad("{s} is not an array", .{key});
+    return v.array.items;
+}
+
+/// Names become file names: lowercase letters, digits, '_', '-', '.', not leading '.', at most 96 bytes.
+fn safeName(s: []const u8) BadCases![]const u8 {
+    if (s.len == 0 or s.len > 96 or s[0] == '.') return bad("unsafe name '{s}'", .{s});
+    for (s) |c| switch (c) {
+        'a'...'z', '0'...'9', '_', '-', '.' => {},
+        else => return bad("unsafe name '{s}'", .{s}),
+    };
+    return s;
+}
+
+fn isSha256Hex(s: []const u8) bool {
+    if (s.len != 64) return false;
+    for (s) |c| switch (c) {
+        '0'...'9', 'a'...'f' => {},
+        else => return false,
+    };
+    return true;
+}
+
+fn loadFile(arena: Allocator, io: std.Io, dir: std.Io.Dir, v: std.json.Value, what: []const u8, size: usize) !File {
+    const o = try objectOf(v, what);
+    const name = try safeName(try textOf(o, "file"));
+    const sha = try textOf(o, "sha256");
+    if (!isSha256Hex(sha)) return bad("{s}: sha256 is not 64 lowercase hex digits", .{what});
+    const bytes = dir.readFileAllocOptions(io, name, arena, .limited(max_file), .@"16", null) catch |err|
+        return bad("{s}: {s} unreadable: {s}", .{ what, name, @errorName(err) });
+    if (bytes.len != size) return bad("{s}: {s} has {d} bytes, expected {d}", .{ what, name, bytes.len, size });
+    const got = sha256Hex(bytes);
+    if (!std.mem.eql(u8, &got, sha)) return bad("{s}: {s} sha256 {s} is not the manifest's {s}", .{ what, name, got[0..], sha });
+    return .{ .name = name, .sha = sha, .bytes = bytes };
+}
+
+fn findName(comptime T: type, items: []const T, name: []const u8, what: []const u8) BadCases!usize {
+    for (items, 0..) |item, i| {
+        if (std.mem.eql(u8, item.name, name)) return i;
+    }
+    return bad("unknown {s} '{s}'", .{ what, name });
+}
+
+fn workspaceCapacity(max_rows: usize) usize {
+    return @max(chunk, max_rows / chunk * chunk);
+}
+
+fn parseCases(arena: Allocator, io: std.Io, dir: std.Io.Dir) !Cases {
+    const text = dir.readFileAlloc(io, "cases.json", arena, .limited(1 << 24)) catch |err| return bad("cases.json unreadable: {s}", .{@errorName(err)});
+    const doc = std.json.parseFromSliceLeaky(std.json.Value, arena, text, .{}) catch |err| return bad("cases.json is not JSON: {s}", .{@errorName(err)});
+    const root = try objectOf(doc, "cases.json");
+    if (!std.mem.eql(u8, try textOf(root, "schema"), cases_schema)) return bad("schema is not {s}", .{cases_schema});
+
+    const gs = try arrayOf(root, "geometries");
+    const geometries = try arena.alloc(Geometry, gs.len);
+    for (gs, geometries) |v, *g| {
+        const o = try objectOf(v, "geometry");
+        const nk = try uintOf(o, "nk");
+        const nv = try uintOf(o, "nv");
+        if (nk == 0 or nv == 0 or nv % nk != 0) return bad("geometry nk {d} nv {d}: nv must be a positive multiple of nk", .{ nk, nv });
+        if ((try uintOf(o, "dv")) != dv) return bad("geometry dv must be {d}", .{dv});
+        g.* = .{
+            .name = try safeName(try textOf(o, "name")),
+            .nk = nk,
+            .nv = nv,
+            .a_log = try loadFile(arena, io, dir, try get(o, "a_log"), "a_log", nv * 4),
+            .dt_bias = try loadFile(arena, io, dir, try get(o, "dt_bias"), "dt_bias", nv * 4),
+        };
+    }
+    for (geometries, 0..) |g, i| for (geometries[0..i]) |h| if (std.mem.eql(u8, g.name, h.name)) return bad("duplicate geometry {s}", .{g.name});
+
+    const ss = try arrayOf(root, "streams");
+    const streams = try arena.alloc(Stream, ss.len);
+    for (ss, streams) |v, *s| {
+        const o = try objectOf(v, "stream");
+        const gi = try findName(Geometry, geometries, try textOf(o, "geometry"), "geometry");
+        const g = geometries[gi];
+        const rows = try uintOf(o, "rows");
+        const ld_qkv = try uintOf(o, "ld_qkv");
+        const ld_ba = try uintOf(o, "ld_ba");
+        if (rows == 0) return bad("stream with zero rows", .{});
+        if (ld_qkv < g.width() or ld_ba < 2 * g.nv) return bad("stream strides {d}/{d} below the row widths {d}/{d}", .{ ld_qkv, ld_ba, g.width(), 2 * g.nv });
+        if (ld_qkv % 8 != 0 or ld_ba % 8 != 0) return bad("stream strides must keep 16-byte rows", .{});
+        s.* = .{
+            .name = try safeName(try textOf(o, "name")),
+            .geometry = gi,
+            .rows = rows,
+            .ld_qkv = ld_qkv,
+            .ld_ba = ld_ba,
+            .qkv = try loadFile(arena, io, dir, try get(o, "qkv"), "qkv", rows * ld_qkv * 2),
+            .ba = try loadFile(arena, io, dir, try get(o, "ba"), "ba", rows * ld_ba * 2),
+        };
+    }
+
+    const is = try arrayOf(root, "states");
+    const inits = try arena.alloc(Init, is.len);
+    for (is, inits) |v, *s| {
+        const o = try objectOf(v, "state");
+        const gi = try findName(Geometry, geometries, try textOf(o, "geometry"), "geometry");
+        s.* = .{
+            .name = try safeName(try textOf(o, "name")),
+            .geometry = gi,
+            .file = try loadFile(arena, io, dir, try get(o, "data"), "state", geometries[gi].stateBytes()),
+        };
+    }
+
+    const cs = try arrayOf(root, "cases");
+    const cases = try arena.alloc(Case, cs.len);
+    for (cs, cases) |v, *c| {
+        const o = try objectOf(v, "case");
+        const name = try safeName(try textOf(o, "name"));
+        const gi = try findName(Geometry, geometries, try textOf(o, "geometry"), "geometry");
+        const max_rows = try uintOf(o, "max_rows");
+        if (max_rows == 0) return bad("{s}: max_rows 0", .{name});
+        const init_list = try arrayOf(o, "init");
+        if (init_list.len != layer_count) return bad("{s}: init must name {d} layer states", .{ name, layer_count });
+        var init: [layer_count]?usize = undefined;
+        for (init_list, &init) |iv, *slot| slot.* = try initRef(inits, iv, gi, name);
+        const ov = try arrayOf(o, "ops");
+        if (ov.len == 0) return bad("{s}: no ops", .{name});
+        const ops = try arena.alloc(Op, ov.len);
+        var last: [layer_count]?usize = @splat(null);
+        for (ov, ops, 0..) |item, *op, oi| {
+            const p = try objectOf(item, "op");
+            const kind = std.meta.stringToEnum(OpKind, try textOf(p, "op")) orelse return bad("{s} op {d}: unknown op", .{ name, oi });
+            const layer = try uintOf(p, "layer");
+            if (layer >= layer_count) return bad("{s} op {d}: layer {d}", .{ name, oi, layer });
+            op.* = .{ .kind = kind, .layer = layer };
+            switch (kind) {
+                .reset => {
+                    op.init = try initRef(inits, try get(p, "state"), gi, name);
+                    op.poison_cache = try boolOr(p, "poison_cache", false);
+                },
+                .prefill, .decode => {
+                    op.stream = try findName(Stream, streams, try textOf(p, "stream"), "stream");
+                    op.start = try uintOf(p, "start");
+                    op.rows = try uintOf(p, "rows");
+                    op.probe = try boolOr(p, "probe", false);
+                    const s = streams[op.stream];
+                    if (s.geometry != gi) return bad("{s} op {d}: stream {s} has another geometry", .{ name, oi, s.name });
+                    if (op.rows == 0 or op.rows > max_rows) return bad("{s} op {d}: rows {d} outside 1..max_rows {d}", .{ name, oi, op.rows, max_rows });
+                    if (op.start + op.rows > s.rows) return bad("{s} op {d}: rows {d}+{d} beyond stream {s}", .{ name, oi, op.start, op.rows, s.name });
+                    if (op.probe and kind != .prefill) return bad("{s} op {d}: probe on a decode", .{ name, oi });
+                    last[layer] = oi;
+                },
+            }
+        }
+        c.* = .{
+            .name = name,
+            .geometry = gi,
+            .max_rows = max_rows,
+            .init = init,
+            .ops = ops,
+            .save_old_states = try boolOr(o, "save_old_states", false),
+            .last_op = last,
+        };
+        const g = &geometries[gi];
+        g.used = true;
+        g.max_rows = @max(g.max_rows, max_rows);
+        _, const ws_bytes = gdn.Workspace.layout(max_rows, g.nk, g.nv);
+        g.ws_bytes = @max(g.ws_bytes, ws_bytes);
+    }
+    for (cases, 0..) |c, i| for (cases[0..i]) |d| if (std.mem.eql(u8, c.name, d.name)) return bad("duplicate case {s}", .{c.name});
+    return .{ .sha = sha256Hex(text), .geometries = geometries, .streams = streams, .inits = inits, .cases = cases };
+}
+
+/// A state reference: the string "zero" or the name of a state of geometry `gi`.
+fn initRef(inits: []const Init, v: std.json.Value, gi: usize, case_name: []const u8) BadCases!?usize {
+    if (v != .string) return bad("{s}: state reference is not a string", .{case_name});
+    if (std.mem.eql(u8, v.string, "zero")) return null;
+    const i = try findName(Init, inits, v.string, "state");
+    if (inits[i].geometry != gi) return bad("{s}: state {s} has another geometry", .{ case_name, v.string });
+    return i;
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// recorded failures, hashing, JSON
+
+const Errors = struct {
+    gpa: Allocator,
+    json: std.ArrayList(u8) = .empty,
+    count: usize = 0,
+
+    fn add(e: *Errors, comptime f: []const u8, args: anytype) !void {
+        const message = try std.fmt.allocPrint(e.gpa, f, args);
+        defer e.gpa.free(message);
+        if (e.count < 200) std.debug.print("error: {s}\n", .{message});
+        try e.json.appendSlice(e.gpa, if (e.count == 0) "\n    " else ",\n    ");
+        try jsonString(&e.json, e.gpa, message);
+        e.count += 1;
+    }
+};
+
+fn sha256Hex(bytes: []const u8) [64]u8 {
+    var out: [32]u8 = undefined;
+    Sha256.hash(bytes, &out, .{});
+    return std.fmt.bytesToHex(out, .lower);
+}
+
+fn fileSha256(gpa: Allocator, io: std.Io, path: []const u8) ![64]u8 {
+    const file = try std.Io.Dir.openFileAbsolute(io, path, .{});
+    defer file.close(io);
+    const buffer = try gpa.alloc(u8, 1 << 20);
+    defer gpa.free(buffer);
+    var hash = Sha256.init(.{});
+    var offset: u64 = 0;
+    while (true) {
+        const got = try file.readPositionalAll(io, buffer, offset);
+        hash.update(buffer[0..got]);
+        offset += got;
+        if (got < buffer.len) break;
+    }
+    return std.fmt.bytesToHex(hash.finalResult(), .lower);
+}
+
+fn jsonString(list: *std.ArrayList(u8), gpa: Allocator, s: []const u8) !void {
+    try list.append(gpa, '"');
+    for (s) |c| switch (c) {
+        '"', '\\' => {
+            try list.append(gpa, '\\');
+            try list.append(gpa, c);
+        },
+        0...0x1f => try list.print(gpa, "\\u{x:0>4}", .{c}),
+        else => try list.append(gpa, c),
+    };
+    try list.append(gpa, '"');
+}
+
+fn nowNs(io: std.Io) i128 {
+    return std.Io.Clock.awake.now(io).toNanoseconds();
+}
+
+fn notFill(bytes: []const u8) usize {
+    var n: usize = 0;
+    for (bytes) |b| {
+        if (b != fill) n += 1;
+    }
+    return n;
+}
+
+fn nonfiniteBf16(values: []const u16) usize {
+    var n: usize = 0;
+    for (values) |bits| {
+        if ((bits & 0x7f80) == 0x7f80) n += 1;
+    }
+    return n;
+}
+
+fn unwrittenBf16(values: []const u16) usize {
+    var n: usize = 0;
+    for (values) |bits| {
+        if (bits == 0xffff) n += 1;
+    }
+    return n;
+}
+
+fn nonfiniteF32(bytes: []align(16) const u8) usize {
+    var n: usize = 0;
+    for (std.mem.bytesAsSlice(u32, bytes)) |bits| {
+        if ((bits & 0x7f800000) == 0x7f800000) n += 1;
+    }
+    return n;
+}
+
+fn bitsDifferent(comptime T: type, a: []align(16) const u8, b: []align(16) const u8) usize {
+    var n: usize = 0;
+    for (std.mem.bytesAsSlice(T, a), std.mem.bytesAsSlice(T, b)) |x, y| {
+        if (x != y) n += 1;
+    }
+    return n;
+}
+
+fn int(v: usize) i32 {
+    return @intCast(v);
+}
+
+fn sameBank(a: ?u1, b: ?u1) bool {
+    if (a) |x| {
+        if (b) |y| return x == y;
+        return false;
+    }
+    return b == null;
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// device
+
+/// One layer's caller-owned controller memory with guards between every buffer, and its frozen-control states.
+const LayerMem = struct {
+    region: cuda.DeviceBuffer,
+    old: cuda.DeviceBuffer, // old sequential chain state (frozen prefill/decode exports)
+    state: gdn.State,
+    bank_bytes: usize,
+    qkv_cache_bytes: usize,
+    ba_cache_bytes: usize,
+
+    fn offsets(m: LayerMem) [4]usize {
+        const b0 = guard;
+        const b1 = b0 + m.bank_bytes + guard;
+        const q = b1 + m.bank_bytes + guard;
+        const a = q + m.qkv_cache_bytes + guard;
+        return .{ b0, b1, q, a };
+    }
+
+    fn total(bank: usize, qkvc: usize, bac: usize) usize {
+        return 5 * guard + 2 * bank + qkvc + bac;
+    }
+
+    /// [start, len) of the five guards.
+    fn guards(m: LayerMem) [5][2]usize {
+        const o = m.offsets();
+        return .{ .{ 0, guard }, .{ o[0] + m.bank_bytes, guard }, .{ o[1] + m.bank_bytes, guard }, .{ o[2] + m.qkv_cache_bytes, guard }, .{ o[3] + m.ba_cache_bytes, guard } };
+    }
+};
+
+const GeoMem = struct {
+    a_log: cuda.DeviceBuffer,
+    dt_bias: cuda.DeviceBuffer,
+    layers: [layer_count]LayerMem,
+    ws: cuda.DeviceBuffer, // guard | workspace (largest layout) | guard
+    y: cuda.DeviceBuffer, // guard rows | max_rows | guard rows, bf16 rows of nv * 128
+    y_old: cuda.DeviceBuffer,
+    y_base: cuda.DeviceBuffer,
+    base_state: cuda.DeviceBuffer,
+};
+
+fn view(d: *const cuda.Driver, ptr: u64, len: usize) cuda.DeviceBuffer {
+    return .{ .d = d, .ptr = ptr, .len = len, .borrowed = true };
+}
+
+const Recur = struct { qkv: u64, ld_qkv: usize, ba: u64, ld_ba: usize, a_log: u64, dt_bias: u64, state: u64, y: u64, rows: usize, nk: usize, nv: usize, scale: f32 };
+
+/// The frozen image's exports with backbone-kernels-pre-chunk.zig's launch: grid (128 / 32, nv), 128 threads.
+fn launchFrozen(f: cuda.Function, s: cuda.Stream, r: Recur) !void {
+    var a: cuda.Args = .{};
+    a.add(r.qkv);
+    a.add(int(r.ld_qkv));
+    a.add(r.ba);
+    a.add(int(r.ld_ba));
+    a.add(r.a_log);
+    a.add(r.dt_bias);
+    a.add(r.state);
+    a.add(r.y);
+    a.add(int(r.rows));
+    a.add(int(r.nk));
+    a.add(int(r.nv));
+    a.add(r.scale);
+    try cuda.launch.launch(f, .{ .grid = .{ .x = dv / 32, .y = @intCast(r.nv), .z = 1 }, .block = .{ .x = 128 } }, s, &a);
+}
+
+/// What one op observed in one pass.
+const OpRecord = struct {
+    pending_before: usize = 0,
+    committed_before: u1 = 0,
+    pending_after: usize = 0,
+    committed_after: u1 = 0,
+    current_bank: ?u1 = null,
+    y_sha: [64]u8 = @splat('-'),
+    state_sha: [64]u8 = @splat('-'),
+    old_y_sha: [64]u8 = @splat('-'),
+    old_state_sha: [64]u8 = @splat('-'),
+    base_y_sha: [64]u8 = @splat('-'),
+    base_state_sha: [64]u8 = @splat('-'),
+    base_y_bits_different: usize = 0,
+    base_state_bits_different: usize = 0,
+    y_unwritten: usize = 0,
+    y_nonfinite: usize = 0,
+    y_guard_before_changed: usize = 0,
+    y_guard_after_changed: usize = 0,
+    state_nonfinite: usize = 0,
+    ws_front_guard_changed: usize = 0,
+    ws_tail_changed: usize = 0,
+    layer_guards_changed: usize = 0,
+    inputs_unchanged: bool = true,
+    elapsed_ns: i128 = 0,
+    probe_sha: [probe_fields.len][64]u8 = @splat(@splat('-')),
+    probe_nonfinite: [probe_fields.len]usize = @splat(0),
+    probe_in_layout: bool = false,
+
+    fn sameOutputs(a: OpRecord, b: OpRecord) bool {
+        return a.pending_after == b.pending_after and a.committed_after == b.committed_after and sameBank(a.current_bank, b.current_bank) and
+            std.mem.eql(u8, &a.y_sha, &b.y_sha) and std.mem.eql(u8, &a.state_sha, &b.state_sha) and
+            std.mem.eql(u8, &a.old_y_sha, &b.old_y_sha) and std.mem.eql(u8, &a.old_state_sha, &b.old_state_sha) and
+            std.mem.eql(u8, &a.base_y_sha, &b.base_y_sha) and std.mem.eql(u8, &a.base_state_sha, &b.base_state_sha) and
+            std.mem.eql(u8, std.mem.sliceAsBytes(&a.probe_sha), std.mem.sliceAsBytes(&b.probe_sha));
+    }
+};
+
+const Runner = struct {
+    gpa: Allocator,
+    io: std.Io,
+    d: *const cuda.Driver,
+    stream: cuda.Stream,
+    kernels: *const gdn.Kernels,
+    frozen_decode_fn: cuda.Function,
+    frozen_prefill_fn: cuda.Function,
+    cs: *const Cases,
+    stream_bufs: []const [2]cuda.DeviceBuffer, // per stream: qkv, ba
+    out: std.Io.Dir,
+    errors: *Errors,
+    scale: f32,
+    // host scratch, sized once for the largest geometry and stream
+    scratch: []align(16) u8,
+    scratch2: []align(16) u8,
+
+    fn sync(r: *const Runner) !void {
+        try r.stream.synchronize();
+    }
+
+    fn download(r: *const Runner, ptr: u64, len: usize, dst: []align(16) u8) ![]align(16) u8 {
+        const buf = dst[0..len];
+        try view(r.d, ptr, len).download(0, buf);
+        return buf;
+    }
+
+    /// Zero (or NaN-poison) the layer's caches, zero both banks, resetMetadata, then a nonzero state into bank0.
+    fn reset(r: *Runner, g: Geometry, m: *GeoMem, layer: usize, init: ?usize, poison_cache: bool, rec: *OpRecord) !void {
+        const lm = &m.layers[layer];
+        const o = lm.offsets();
+        const base = lm.region.ptr;
+        try view(r.d, base + o[0], lm.bank_bytes).fill8(0, r.stream.handle);
+        try view(r.d, base + o[1], lm.bank_bytes).fill8(0, r.stream.handle);
+        const cache_value: u8 = if (poison_cache) fill else 0;
+        try view(r.d, base + o[2], lm.qkv_cache_bytes).fill8(cache_value, r.stream.handle);
+        try view(r.d, base + o[3], lm.ba_cache_bytes).fill8(cache_value, r.stream.handle);
+        try lm.old.fill8(0, r.stream.handle);
+        rec.pending_before = lm.state.pending;
+        rec.committed_before = lm.state.committed_bank;
+        lm.state.resetMetadata();
+        try r.sync();
+        if (init) |i| {
+            const bytes = r.cs.inits[i].file.bytes;
+            try view(r.d, lm.state.banks[0], g.stateBytes()).upload(0, bytes);
+            try lm.old.upload(0, bytes);
+        }
+        rec.pending_after = lm.state.pending;
+        rec.committed_after = lm.state.committed_bank;
+        rec.current_bank = bankOf(lm.state);
+        if (lm.state.pending != 0 or lm.state.committed_bank != 0 or !sameBank(rec.current_bank, 0))
+            try r.errors.add("layer {d}: after resetMetadata pending {d} committed_bank {d}, current() not bank0", .{ layer, lm.state.pending, lm.state.committed_bank });
+        const cur = try r.download(lm.state.current(), g.stateBytes(), r.scratch);
+        rec.state_sha = sha256Hex(cur);
+        if (init) |i| {
+            if (!std.mem.eql(u8, cur, r.cs.inits[i].file.bytes)) try r.errors.add("layer {d}: bank0 does not hold the uploaded initial state", .{layer});
+        } else if (notZero(cur)) try r.errors.add("layer {d}: zeroed bank0 is not zero", .{layer});
+    }
+
+    fn notZero(bytes: []const u8) bool {
+        for (bytes) |b| {
+            if (b != 0) return true;
+        }
+        return false;
+    }
+
+    fn bankOf(s: gdn.State) ?u1 {
+        const c = s.current();
+        if (c == s.banks[0]) return 0;
+        if (c == s.banks[1]) return 1;
+        return null;
+    }
+
+    fn checkInputs(r: *Runner, g: Geometry, m: *GeoMem, op: Op) !bool {
+        const s = r.cs.streams[op.stream];
+        const bufs = r.stream_bufs[op.stream];
+        var same = true;
+        for ([_]struct { []align(16) const u8, cuda.DeviceBuffer }{ .{ s.qkv.bytes, bufs[0] }, .{ s.ba.bytes, bufs[1] }, .{ g.a_log.bytes, m.a_log }, .{ g.dt_bias.bytes, m.dt_bias } }) |pair| {
+            const host, const dev = pair;
+            const got = try r.download(dev.ptr, host.len, r.scratch2);
+            if (!std.mem.eql(u8, got, host)) same = false;
+        }
+        return same;
+    }
+
+    fn checkLayerGuards(r: *Runner, m: *GeoMem) !usize {
+        var changed: usize = 0;
+        for (m.layers) |lm| {
+            for (lm.guards()) |gr| changed += notFill(try r.download(lm.region.ptr + gr[0], gr[1], r.scratch2));
+        }
+        return changed;
+    }
+
+    /// Rows [0, n) of the guarded output buffer, after checking coverage and both guards.
+    fn checkY(r: *Runner, g: Geometry, buf: cuda.DeviceBuffer, n: usize, rec: *OpRecord) ![]align(16) u8 {
+        const rb = g.rowBytes();
+        const all = try r.download(buf.ptr, buf.len, r.scratch2);
+        rec.y_guard_before_changed = notFill(all[0 .. y_guard_rows * rb]);
+        const rows: []align(16) u8 = @alignCast(all[y_guard_rows * rb ..][0 .. n * rb]);
+        rec.y_guard_after_changed = notFill(all[(y_guard_rows + n) * rb ..]);
+        const values = std.mem.bytesAsSlice(u16, rows);
+        rec.y_unwritten = unwrittenBf16(values);
+        rec.y_nonfinite = nonfiniteBf16(values);
+        return rows;
+    }
+
+    fn runCase(r: *Runner, c: Case, m: *GeoMem, records: []OpRecord, pass: usize, ys: *[layer_count]std.ArrayList(u8), old_ys: *[layer_count]std.ArrayList(u8), base_ys: *[layer_count]std.ArrayList(u8)) !void {
+        const g = r.cs.geometries[c.geometry];
+        const ws_proto, const ws_bytes = gdn.Workspace.layout(c.max_rows, g.nk, g.nv);
+        const ws_base = m.ws.ptr + guard;
+        const ws = ws_proto.place(ws_base);
+        const rb = g.rowBytes();
+        const y_ptr = m.y.ptr + y_guard_rows * rb;
+        var path_buffer: [256]u8 = undefined;
+
+        // a pass starts from both layers' case initial states
+        for (0..layer_count) |layer| {
+            var rec: OpRecord = .{};
+            try r.reset(g, m, layer, c.init[layer], false, &rec);
+        }
+        for (c.ops, records, 0..) |op, *rec, oi| {
+            rec.* = .{};
+            const lm = &m.layers[op.layer];
+            if (op.kind == .reset) {
+                try r.reset(g, m, op.layer, op.init, op.poison_cache, rec);
+                rec.layer_guards_changed = try r.checkLayerGuards(m);
+                continue;
+            }
+            const sb = r.stream_bufs[op.stream];
+            const s = r.cs.streams[op.stream];
+            const run: gdn.Run = .{
+                .qkv = sb[0].ptr + op.start * s.ld_qkv * 2,
+                .ld_qkv = s.ld_qkv,
+                .ba = sb[1].ptr + op.start * s.ld_ba * 2,
+                .ld_ba = s.ld_ba,
+                .a_log = m.a_log.ptr,
+                .dt_bias = m.dt_bias.ptr,
+                .y = y_ptr,
+                .rows = op.rows,
+                .nk = g.nk,
+                .nv = g.nv,
+                .dv = dv,
+                .scale = r.scale,
+            };
+            const frozen: Recur = .{ .qkv = run.qkv, .ld_qkv = run.ld_qkv, .ba = run.ba, .ld_ba = run.ld_ba, .a_log = run.a_log, .dt_bias = run.dt_bias, .state = lm.old.ptr, .y = m.y_old.ptr, .rows = op.rows, .nk = g.nk, .nv = g.nv, .scale = r.scale };
+            rec.pending_before = lm.state.pending;
+            rec.committed_before = lm.state.committed_bank;
+            try m.y.fill8(fill, r.stream.handle);
+            if (op.kind == .prefill) {
+                try m.ws.fill8(fill, r.stream.handle);
+                try r.sync();
+                const t0 = nowNs(r.io);
+                try r.kernels.prefill(r.stream, &lm.state, ws, run);
+                try r.sync();
+                rec.elapsed_ns = nowNs(r.io) - t0;
+                rec.ws_front_guard_changed = notFill(try r.download(m.ws.ptr, guard, r.scratch2));
+                rec.ws_tail_changed = notFill(try r.download(ws_base + ws_bytes, m.ws.len - guard - ws_bytes, r.scratch2));
+                if (op.probe) try r.probe(c, g, ws, ws_base, ws_bytes, op, oi, rec, pass, &path_buffer);
+            } else {
+                // the unchanged frozen decode on a copy of the state decode must start from, the same rows
+                try m.y_base.fill8(fill, r.stream.handle);
+                try m.base_state.copyFrom(0, lm.state.current(), g.stateBytes(), r.stream.handle);
+                try r.sync();
+                const t0 = nowNs(r.io);
+                try r.kernels.decode(r.stream, &lm.state, run);
+                try r.sync();
+                rec.elapsed_ns = nowNs(r.io) - t0;
+                var base = frozen;
+                base.state = m.base_state.ptr;
+                base.y = m.y_base.ptr;
+                try launchFrozen(r.frozen_decode_fn, r.stream, base);
+                try r.sync();
+            }
+            rec.pending_after = lm.state.pending;
+            rec.committed_after = lm.state.committed_bank;
+            rec.current_bank = bankOf(lm.state);
+            if (rec.current_bank == null) try r.errors.add("{s} op {d}: State.current() is neither bank", .{ c.name, oi });
+
+            // the controller's outputs, then its state, before any control touches device memory again
+            const y = try r.checkY(g, m.y, op.rows, rec);
+            rec.y_sha = sha256Hex(y);
+            if (pass == 0) try ys[op.layer].appendSlice(r.gpa, y);
+            const y_copy = try r.gpa.alignedAlloc(u8, .@"16", y.len);
+            defer r.gpa.free(y_copy);
+            @memcpy(y_copy, y);
+            const state = try r.download(lm.state.current(), g.stateBytes(), r.scratch);
+            rec.state_sha = sha256Hex(state);
+            rec.state_nonfinite = nonfiniteF32(state);
+            if (pass == 0) {
+                const name = try std.fmt.bufPrint(&path_buffer, "{s}/op-{d:0>4}.state.f32", .{ c.name, oi });
+                try r.out.writeFile(r.io, .{ .sub_path = name, .data = state, .flags = .{ .exclusive = true } });
+            }
+            if (op.kind == .decode) {
+                const by = try r.download(m.y_base.ptr, op.rows * rb, r.scratch2);
+                rec.base_y_sha = sha256Hex(by);
+                rec.base_y_bits_different = bitsDifferent(u16, by, y_copy);
+                if (pass == 0) try base_ys[op.layer].appendSlice(r.gpa, by);
+                const bs = try r.download(m.base_state.ptr, g.stateBytes(), r.scratch2);
+                rec.base_state_sha = sha256Hex(bs);
+                rec.base_state_bits_different = bitsDifferent(u32, bs, state);
+                if (rec.base_y_bits_different != 0 or rec.base_state_bits_different != 0) {
+                    try r.errors.add("{s} op {d}: decode differs from the frozen decode export on identical state and rows ({d} output, {d} state elements)", .{ c.name, oi, rec.base_y_bits_different, rec.base_state_bits_different });
+                    if (pass == 0) {
+                        const name = try std.fmt.bufPrint(&path_buffer, "{s}/op-{d:0>4}.decbase.state.f32", .{ c.name, oi });
+                        try r.out.writeFile(r.io, .{ .sub_path = name, .data = bs, .flags = .{ .exclusive = true } });
+                    }
+                }
+            }
+
+            // the old sequential chain on its own state: frozen prefill export for prefill, frozen decode for decode
+            try launchFrozen(if (op.kind == .prefill) r.frozen_prefill_fn else r.frozen_decode_fn, r.stream, frozen);
+            try r.sync();
+            const oy = try r.download(m.y_old.ptr, op.rows * rb, r.scratch2);
+            rec.old_y_sha = sha256Hex(oy);
+            if (pass == 0) try old_ys[op.layer].appendSlice(r.gpa, oy);
+            const os = try r.download(lm.old.ptr, g.stateBytes(), r.scratch2);
+            rec.old_state_sha = sha256Hex(os);
+            if (pass == 0 and (c.save_old_states or c.last_op[op.layer] == oi)) {
+                const name = try std.fmt.bufPrint(&path_buffer, "{s}/op-{d:0>4}.old.state.f32", .{ c.name, oi });
+                try r.out.writeFile(r.io, .{ .sub_path = name, .data = os, .flags = .{ .exclusive = true } });
+            }
+
+            rec.inputs_unchanged = try r.checkInputs(g, m, op);
+            rec.layer_guards_changed = try r.checkLayerGuards(m);
+            var prefix_buffer: [192]u8 = undefined;
+            const prefix = try std.fmt.bufPrint(&prefix_buffer, "{s} pass {d} op {d} ({s} layer {d} rows {d})", .{ c.name, pass, oi, @tagName(op.kind), op.layer, op.rows });
+            if (!rec.inputs_unchanged) try r.errors.add("{s}: inputs changed", .{prefix});
+            if (rec.y_unwritten != 0 or rec.y_nonfinite != 0) try r.errors.add("{s}: output rows unwritten {d}, nonfinite {d}", .{ prefix, rec.y_unwritten, rec.y_nonfinite });
+            if (rec.y_guard_before_changed != 0 or rec.y_guard_after_changed != 0) try r.errors.add("{s}: output overrun: {d} bytes before, {d} bytes after the rows changed", .{ prefix, rec.y_guard_before_changed, rec.y_guard_after_changed });
+            if (rec.state_nonfinite != 0) try r.errors.add("{s}: {d} nonfinite state values", .{ prefix, rec.state_nonfinite });
+            if (rec.ws_front_guard_changed != 0 or rec.ws_tail_changed != 0) try r.errors.add("{s}: workspace wrote outside its layout ({d} front-guard bytes, {d} bytes past layout {d})", .{ prefix, rec.ws_front_guard_changed, rec.ws_tail_changed, ws_bytes });
+            if (rec.layer_guards_changed != 0) try r.errors.add("{s}: {d} bank/cache guard bytes changed", .{ prefix, rec.layer_guards_changed });
+            if (rec.pending_after >= chunk) try r.errors.add("{s} pass {d} op {d}: pending {d} is not below {d}", .{ c.name, pass, oi, rec.pending_after, chunk });
+        }
+    }
+
+    fn probe(r: *Runner, c: Case, g: Geometry, ws: gdn.Workspace, ws_base: u64, ws_bytes: usize, op: Op, oi: usize, rec: *OpRecord, pass: usize, path_buffer: *[256]u8) !void {
+        if (comptime !probe_available) {
+            if (pass == 0) try r.errors.add("{s} op {d}: gate probe requested but gdn.Workspace has no u64 fields g, gc and beta", .{ c.name, oi });
+            return;
+        } else {
+            const bytes = op.rows * g.nv * 4;
+            rec.probe_in_layout = true;
+            inline for (probe_fields, 0..) |name, fi| {
+                const ptr: u64 = @field(ws, name);
+                if (ptr < ws_base or ptr + bytes > ws_base + ws_bytes) {
+                    rec.probe_in_layout = false;
+                    try r.errors.add("{s} op {d}: Workspace.{s} [{d} rows][{d}] f32 is not inside the placed layout", .{ c.name, oi, name, op.rows, g.nv });
+                } else {
+                    const got = try r.download(ptr, bytes, r.scratch2);
+                    rec.probe_sha[fi] = sha256Hex(got);
+                    rec.probe_nonfinite[fi] = nonfiniteF32(got);
+                    if (pass == 0) {
+                        const file = try std.fmt.bufPrint(path_buffer, "{s}/op-{d:0>4}.ws-{s}.f32", .{ c.name, oi, name });
+                        try r.out.writeFile(r.io, .{ .sub_path = file, .data = got, .flags = .{ .exclusive = true } });
+                    }
+                }
+            }
+        }
+    }
+};
+
+// ---------------------------------------------------------------------------------------------------------------
+
+pub fn main(init: std.process.Init) !u8 {
+    const gpa = init.gpa;
+    const io = init.io;
+    const arena = init.arena.allocator();
+    const args = try init.minimal.args.toSlice(arena);
+    if (args.len != 5) {
+        std.debug.print("usage: tf-drama-gdn-canonical-oracle GLUE_FATBIN FROZEN_FATBIN CASES_DIR OUTPUT_DIR\n", .{});
+        return 2;
+    }
+    if (builtin.cpu.arch.endian() != .little) return error.UnsupportedHostEndian;
+    const started = nowNs(io);
+
+    // 1. fixtures and images, CPU only
+    const cases_dir = try std.Io.Dir.cwd().openDir(io, args[3], .{});
+    defer cases_dir.close(io);
+    const out = try std.Io.Dir.cwd().openDir(io, args[4], .{});
+    defer out.close(io);
+    const cs = parseCases(arena, io, cases_dir) catch |err| switch (err) {
+        error.BadCases => return 2,
+        else => return err,
+    };
+    const glue_image = try std.Io.Dir.cwd().readFileAllocOptions(io, args[1], arena, .limited(max_file), .@"16", null);
+    const frozen_image = try std.Io.Dir.cwd().readFileAllocOptions(io, args[2], arena, .limited(max_file), .@"16", null);
+    const glue_sha = sha256Hex(glue_image);
+    const frozen_sha = sha256Hex(frozen_image);
+    if (!std.mem.eql(u8, &frozen_sha, frozen_image_sha256)) {
+        std.debug.print("FROZEN_FATBIN sha256 {s} is not the frozen image {s}\n", .{ frozen_sha[0..], frozen_image_sha256 });
+        return 2;
+    }
+    if (std.mem.eql(u8, &glue_sha, frozen_image_sha256)) {
+        std.debug.print("GLUE_FATBIN is the frozen pre-chunk image\n", .{});
+        return 2;
+    }
+
+    var errors: Errors = .{ .gpa = gpa };
+    defer errors.json.deinit(gpa);
+    const scale: f32 = @floatCast(1.0 / @sqrt(@as(f64, dv))); // backbone.zig's deltaNet scale
+
+    // 2. device memory, once
+    _ = try cuda.setAllocationLimit(device_limit);
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    var name_buffer: [128]u8 = undefined;
+    const device_name = try arena.dupe(u8, try ctx.name(&name_buffer));
+    const capability = try ctx.capability();
+    const driver_version = try driver.version();
+    const usage_start = cuda.usage(true);
+
+    var glue = try cuda.Module.load(&driver, glue_image);
+    defer glue.unload();
+    const kernels = try gdn.Kernels.init(&glue);
+    var frozen = try cuda.Module.load(&driver, frozen_image);
+    defer frozen.unload();
+    const frozen_decode_fn = try frozen.function(frozen_decode);
+    const frozen_prefill_fn = try frozen.function(frozen_prefill);
+
+    const stream_bufs = try arena.alloc([2]cuda.DeviceBuffer, cs.streams.len);
+    var streams_made: usize = 0;
+    defer for (stream_bufs[0..streams_made]) |*p| {
+        p[0].free();
+        p[1].free();
+    };
+    var scratch_len: usize = 0;
+    for (cs.streams, stream_bufs) |s, *p| {
+        p[0] = try cuda.DeviceBuffer.fromHost(&driver, s.qkv.bytes);
+        p[1] = cuda.DeviceBuffer.fromHost(&driver, s.ba.bytes) catch |e| {
+            p[0].free();
+            return e;
+        };
+        streams_made += 1;
+        scratch_len = @max(scratch_len, s.qkv.bytes.len, s.ba.bytes.len);
+    }
+
+    const mems = try arena.alloc(?GeoMem, cs.geometries.len);
+    @memset(mems, null);
+    defer for (mems) |*slot| if (slot.*) |*m| {
+        m.a_log.free();
+        m.dt_bias.free();
+        for (&m.layers) |*lm| {
+            lm.region.free();
+            lm.old.free();
+        }
+        m.ws.free();
+        m.y.free();
+        m.y_old.free();
+        m.y_base.free();
+        m.base_state.free();
+        slot.* = null;
+    };
+    var geometry_json: std.ArrayList(u8) = .empty;
+    defer geometry_json.deinit(gpa);
+    for (cs.geometries, mems) |g, *slot| {
+        if (!g.used) continue;
+        const sb = g.stateBytes();
+        const y_bytes = (g.max_rows + 2 * y_guard_rows) * g.rowBytes();
+        var m: GeoMem = undefined;
+        m.a_log = try cuda.DeviceBuffer.fromHost(&driver, g.a_log.bytes);
+        m.dt_bias = try cuda.DeviceBuffer.fromHost(&driver, g.dt_bias.bytes);
+        for (&m.layers) |*lm| {
+            lm.bank_bytes = sb;
+            lm.qkv_cache_bytes = g.qkvCacheBytes();
+            lm.ba_cache_bytes = g.baCacheBytes();
+            lm.region = try cuda.DeviceBuffer.alloc(&driver, LayerMem.total(sb, lm.qkv_cache_bytes, lm.ba_cache_bytes));
+            try lm.region.fill8(fill, null);
+            lm.old = try cuda.DeviceBuffer.alloc(&driver, sb);
+            const o = lm.offsets();
+            lm.state = .{ .banks = .{ lm.region.ptr + o[0], lm.region.ptr + o[1] }, .qkv_cache = lm.region.ptr + o[2], .ba_cache = lm.region.ptr + o[3] };
+        }
+        m.ws = try cuda.DeviceBuffer.alloc(&driver, guard + g.ws_bytes + guard);
+        m.y = try cuda.DeviceBuffer.alloc(&driver, y_bytes);
+        m.y_old = try cuda.DeviceBuffer.alloc(&driver, g.max_rows * g.rowBytes());
+        m.y_base = try cuda.DeviceBuffer.alloc(&driver, g.max_rows * g.rowBytes());
+        m.base_state = try cuda.DeviceBuffer.alloc(&driver, sb);
+        slot.* = m;
+        scratch_len = @max(scratch_len, y_bytes, sb, m.ws.len);
+        try geometry_json.print(gpa, "{s}\n    {{\"name\": \"{s}\", \"nk\": {d}, \"nv\": {d}, \"dv\": {d}, \"width\": {d}, \"state_bytes\": {d}, \"qkv_cache_bytes\": {d}, \"ba_cache_bytes\": {d}, \"layer_region_bytes\": {d}, \"layers\": {d}, \"workspace_allocated_bytes\": {d}, \"workspace_largest_layout_bytes\": {d}, \"output_rows_allocated\": {d}, \"guard_bytes\": {d}, \"output_guard_rows\": {d}}}", .{
+            if (geometry_json.items.len == 0) "" else ",", g.name, g.nk, g.nv, dv, g.width(), sb, g.qkvCacheBytes(), g.baCacheBytes(), m.layers[0].region.len, layer_count, m.ws.len, g.ws_bytes, g.max_rows, guard, y_guard_rows,
+        });
+    }
+    try ctx.synchronize();
+    const usage_after_setup = cuda.usage(false);
+    const mem_after_setup = try ctx.memInfo();
+
+    const scratch = try gpa.alignedAlloc(u8, .@"16", scratch_len);
+    defer gpa.free(scratch);
+    const scratch2 = try gpa.alignedAlloc(u8, .@"16", scratch_len);
+    defer gpa.free(scratch2);
+
+    var runner: Runner = .{
+        .gpa = gpa,
+        .io = io,
+        .d = &driver,
+        .stream = stream,
+        .kernels = &kernels,
+        .frozen_decode_fn = frozen_decode_fn,
+        .frozen_prefill_fn = frozen_prefill_fn,
+        .cs = &cs,
+        .stream_bufs = stream_bufs,
+        .out = out,
+        .errors = &errors,
+        .scale = scale,
+        .scratch = scratch,
+        .scratch2 = scratch2,
+    };
+
+    // 3. cases, two passes each
+    var cases_json: std.ArrayList(u8) = .empty;
+    defer cases_json.deinit(gpa);
+    var path_buffer: [256]u8 = undefined;
+    var max_ops: usize = 0;
+    for (cs.cases) |c| max_ops = @max(max_ops, c.ops.len);
+    const records = [passes][]OpRecord{ try gpa.alloc(OpRecord, max_ops), try gpa.alloc(OpRecord, max_ops) };
+    defer for (records) |r| gpa.free(r);
+    var total_ops: usize = 0;
+    for (cs.cases) |c| {
+        const m = &mems[c.geometry].?;
+        const g = cs.geometries[c.geometry];
+        try out.createDir(io, c.name, .default_dir);
+        var ys: [layer_count]std.ArrayList(u8) = @splat(.empty);
+        var old_ys: [layer_count]std.ArrayList(u8) = @splat(.empty);
+        var base_ys: [layer_count]std.ArrayList(u8) = @splat(.empty);
+        defer for (&ys, &old_ys, &base_ys) |*a, *b, *e| {
+            a.deinit(gpa);
+            b.deinit(gpa);
+            e.deinit(gpa);
+        };
+        const case_start = nowNs(io);
+        for (0..passes) |pass| try runner.runCase(c, m, records[pass][0..c.ops.len], pass, &ys, &old_ys, &base_ys);
+        const case_ns = nowNs(io) - case_start;
+        total_ops += c.ops.len;
+        const usage_now = cuda.usage(false);
+        if (usage_now.device != usage_after_setup.device or usage_now.host != usage_after_setup.host)
+            try errors.add("{s}: counted allocations changed while running ({d} -> {d} device bytes)", .{ c.name, usage_after_setup.device, usage_now.device });
+
+        // per layer concatenated outputs
+        var files_json: std.ArrayList(u8) = .empty;
+        defer files_json.deinit(gpa);
+        for (0..layer_count) |layer| {
+            for ([_]struct { []const u8, *std.ArrayList(u8) }{ .{ "y", &ys[layer] }, .{ "old.y", &old_ys[layer] }, .{ "decbase.y", &base_ys[layer] } }) |entry| {
+                const kind, const list = entry;
+                if (list.items.len == 0) continue;
+                const name = try std.fmt.bufPrint(&path_buffer, "{s}/L{d}.{s}.bf16", .{ c.name, layer, kind });
+                try out.writeFile(io, .{ .sub_path = name, .data = list.items, .flags = .{ .exclusive = true } });
+                const file_sha = sha256Hex(list.items);
+                try files_json.print(gpa, "{s}\"L{d}.{s}.bf16\": {{\"sha256\": \"{s}\", \"rows\": {d}}}", .{ if (files_json.items.len == 0) "" else ", ", layer, kind, file_sha[0..], list.items.len / g.rowBytes() });
+            }
+        }
+
+        _, const ws_bytes = gdn.Workspace.layout(c.max_rows, g.nk, g.nv);
+        try cases_json.print(gpa, "{s}\n    {{\"name\": \"{s}\", \"geometry\": \"{s}\", \"max_rows\": {d}, \"workspace_layout_bytes\": {d}, \"workspace_capacity_rows_contract\": {d}, \"init\": [", .{
+            if (cases_json.items.len == 0) "" else ",", c.name, g.name, c.max_rows, ws_bytes, workspaceCapacity(c.max_rows),
+        });
+        for (c.init, 0..) |iv, i| try cases_json.print(gpa, "{s}\"{s}\"", .{ if (i == 0) "" else ", ", if (iv) |x| cs.inits[x].name else "zero" });
+        try cases_json.print(gpa, "], \"wall_s\": {d:.6}, \"files\": {{{s}}}, \"ops\": [", .{ @as(f64, @floatFromInt(case_ns)) / 1e9, files_json.items });
+        for (c.ops, 0..) |op, oi| {
+            const a = records[0][oi];
+            const b = records[1][oi];
+            const repeat_equal = a.sameOutputs(b);
+            if (!repeat_equal) try errors.add("{s} op {d}: pass 1 did not reproduce pass 0 (outputs, states, metadata or controls)", .{ c.name, oi });
+            try cases_json.print(gpa, "{s}\n      {{\"index\": {d}, \"op\": \"{s}\", \"layer\": {d}", .{ if (oi == 0) "" else ",", oi, @tagName(op.kind), op.layer });
+            if (op.kind == .reset) {
+                try cases_json.print(gpa, ", \"state\": \"{s}\", \"poison_cache\": {}", .{ if (op.init) |x| cs.inits[x].name else "zero", op.poison_cache });
+            } else {
+                try cases_json.print(gpa, ", \"stream\": \"{s}\", \"start\": {d}, \"rows\": {d}, \"probe\": {}, \"y_sha256\": \"{s}\", \"old_y_sha256\": \"{s}\", \"old_state_sha256\": \"{s}\", \"y_unwritten\": {d}, \"y_nonfinite\": {d}, \"y_guard_before_changed\": {d}, \"y_guard_after_changed\": {d}, \"state_nonfinite\": {d}, \"ws_front_guard_changed\": {d}, \"ws_tail_changed\": {d}, \"inputs_unchanged\": {}, \"elapsed_s\": [{d:.9}, {d:.9}]", .{
+                    cs.streams[op.stream].name, op.start, op.rows, op.probe, a.y_sha[0..], a.old_y_sha[0..], a.old_state_sha[0..], a.y_unwritten, a.y_nonfinite, a.y_guard_before_changed, a.y_guard_after_changed, a.state_nonfinite, a.ws_front_guard_changed, a.ws_tail_changed, a.inputs_unchanged and b.inputs_unchanged, @as(f64, @floatFromInt(a.elapsed_ns)) / 1e9, @as(f64, @floatFromInt(b.elapsed_ns)) / 1e9,
+                });
+                if (op.kind == .decode) try cases_json.print(gpa, ", \"decode_baseline\": {{\"y_sha256\": \"{s}\", \"state_sha256\": \"{s}\", \"y_bits_different\": {d}, \"state_bits_different\": {d}}}", .{ a.base_y_sha[0..], a.base_state_sha[0..], a.base_y_bits_different, a.base_state_bits_different });
+                if (op.probe) {
+                    try cases_json.print(gpa, ", \"gate_probe\": {{\"available\": {}, \"in_layout\": {}", .{ probe_available, a.probe_in_layout });
+                    for (probe_fields, 0..) |f, fi| try cases_json.print(gpa, ", \"{s}\": {{\"sha256\": \"{s}\", \"nonfinite\": {d}}}", .{ f, a.probe_sha[fi][0..], a.probe_nonfinite[fi] });
+                    try cases_json.appendSlice(gpa, "}");
+                }
+            }
+            try cases_json.print(gpa, ", \"pending_before\": {d}, \"committed_bank_before\": {d}, \"pending_after\": {d}, \"committed_bank_after\": {d}, \"current_bank\": {s}, \"state_sha256\": \"{s}\", \"layer_guards_changed\": {d}, \"repeat_bit_exact\": {}}}", .{
+                a.pending_before, a.committed_before, a.pending_after, a.committed_after, if (a.current_bank) |x| (if (x == 0) "0" else "1") else "null", a.state_sha[0..], a.layer_guards_changed, repeat_equal,
+            });
+        }
+        try cases_json.appendSlice(gpa, "\n    ]}");
+        std.debug.print("{s}: ops={d} wall_s={d:.3} errors_so_far={d}\n", .{ c.name, c.ops.len, @as(f64, @floatFromInt(case_ns)) / 1e9, errors.count });
+    }
+    const usage_end = cuda.usage(false);
+    const mem_end = try ctx.memInfo();
+
+    // 4. result.json
+    var binary_json: std.ArrayList(u8) = .empty;
+    defer binary_json.deinit(gpa);
+    if (fileSha256(gpa, io, "/proc/self/exe")) |sha| {
+        try binary_json.print(gpa, "\"{s}\"", .{sha[0..]});
+    } else |err| {
+        std.debug.print("binary hash unavailable: {s}\n", .{@errorName(err)});
+        try binary_json.appendSlice(gpa, "null");
+    }
+    const source_sha = sha256Hex(@embedFile("drama_gdn_canonical_oracle.zig"));
+    const evidence_valid = errors.count == 0;
+    var mj: std.ArrayList(u8) = .empty;
+    defer mj.deinit(gpa);
+    try mj.print(gpa, "{{\n  \"schema\": \"{s}\",\n  \"producer\": \"{s}\",\n  \"glue_fatbin\": ", .{ result_schema, producer });
+    try jsonString(&mj, gpa, args[1]);
+    try mj.print(gpa, ",\n  \"glue_fatbin_sha256\": \"{s}\",\n  \"glue_fatbin_bytes\": {d},\n  \"frozen_fatbin\": ", .{ glue_sha[0..], glue_image.len });
+    try jsonString(&mj, gpa, args[2]);
+    try mj.print(gpa, ",\n  \"frozen_fatbin_sha256\": \"{s}\",\n  \"cases_dir\": ", .{frozen_sha[0..]});
+    try jsonString(&mj, gpa, args[3]);
+    try mj.print(gpa, ",\n  \"cases_sha256\": \"{s}\",\n  \"binary_sha256\": {s},\n  \"oracle_source_sha256\": \"{s}\",\n  \"device\": ", .{ cs.sha[0..], binary_json.items, source_sha[0..] });
+    try jsonString(&mj, gpa, device_name);
+    try mj.print(gpa, ",\n  \"capability\": {d},\n  \"driver_version\": {d},\n  \"scale_f32_bits\": {d},\n  \"chunk_rows\": {d},\n  \"passes\": {d},\n  \"layers\": {d}," ++
+        "\n  \"gate_probe_fields_available\": {},\n  \"controller\": \"drama.backbone.gdn: State.resetMetadata/current, Workspace.layout/place, Kernels.init/prefill/decode; frozen controls: {s} (decode baseline, old decode) and {s} (old sequential prefill)\"," ++
+        "\n  \"geometries\": [{s}\n  ],\n  \"cases\": [{s}\n  ]," ++
+        "\n  \"allocations\": {{\"counted_device_bytes_start\": {d}, \"counted_device_bytes_after_setup\": {d}, \"counted_device_bytes_end\": {d}, \"counted_device_peak_bytes\": {d}, \"counted_pinned_host_bytes_end\": {d}, \"device_limit_bytes\": {d}, \"driver_free_bytes_after_setup\": {d}, \"driver_free_bytes_end\": {d}, \"driver_total_bytes\": {d}, \"host_scratch_bytes\": {d}}}," ++
+        "\n  \"ops_per_pass\": {d},\n  \"wall_s\": {d:.6},\n  \"evidence_valid\": {},\n  \"errors\": [{s}\n  ]\n}}\n", .{
+        capability,               driver_version,   @as(u32, @bitCast(scale)), chunk,               passes,                                             layer_count,
+        probe_available,          frozen_decode,    frozen_prefill,            geometry_json.items, cases_json.items,                                   usage_start.device,
+        usage_after_setup.device, usage_end.device, usage_end.peak,            usage_end.host,      @as(u64, device_limit),                             mem_after_setup.free,
+        mem_end.free,             mem_end.total,    2 * scratch_len,           total_ops,           @as(f64, @floatFromInt(nowNs(io) - started)) / 1e9, evidence_valid,
+        errors.json.items,
+    });
+    try out.writeFile(io, .{ .sub_path = "result.json", .data = mj.items, .flags = .{ .exclusive = true } });
+    std.debug.print("cases={d} ops_per_pass={d} evidence_valid={} errors={d}\n", .{ cs.cases.len, total_ops, evidence_valid, errors.count });
+    return if (evidence_valid) 0 else 3;
+}
diff --git a/zig/tests/cuda/drama_gdn_layer0_trace.zig b/zig/tests/cuda/drama_gdn_layer0_trace.zig
new file mode 100644
index 00000000..64fbfb4c
--- /dev/null
+++ b/zig/tests/cuda/drama_gdn_layer0_trace.zig
@@ -0,0 +1,162 @@
+//! Private diagnostic: production layer-zero attention on frozen normalized inputs.
+//! No production instrumentation or arithmetic changes. Capture surviving scratch after
+//! Model.replayOperator; compare each prefix with the full native stage capture, repeat
+//! from reset, and verify input/weight immutability. The parent validates fixture provenance.
+//! Usage: CHECKPOINT INPUT_182_BF16 EXPECTED_OUTPUT_182_BF16 EXISTING_OUTPUT_DIR
+const std = @import("std");
+const builtin = @import("builtin");
+const cuda = @import("cuda");
+const drama = @import("drama");
+const Model = drama.backbone.Model;
+const H = 2048;
+const R = 128;
+const source_rows = 182;
+const lengths = [_]usize{ 1, 7, 128, 182 };
+const LD = drama.backbone.weights.gdn_in_rows;
+const Capture = struct { file: []const u8, dtype: []const u8, shape: [2]usize, sha256: [64]u8 };
+const View = struct { name: []const u8, ptr: u64, cols: usize, rows: usize, f32: bool = false };
+
+fn sha(bytes: []const u8) [64]u8 {
+    var digest: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(bytes, &digest, .{});
+    return std.fmt.bytesToHex(digest, .lower);
+}
+fn finite(bytes: []align(16) const u8, is_f32: bool) bool {
+    if (is_f32) {
+        for (std.mem.bytesAsSlice(f32, bytes)) |x| if (!std.math.isFinite(x)) return false;
+    } else {
+        for (std.mem.bytesAsSlice(u16, bytes)) |x| if ((x & 0x7f80) == 0x7f80) return false;
+    }
+    return true;
+}
+fn download(driver: *cuda.Driver, staging: []align(16) u8, view: View) ![]align(16) const u8 {
+    const bytes = view.rows * view.cols * @as(usize, if (view.f32) 4 else 2);
+    const buffer: cuda.DeviceBuffer = .{ .d = driver, .ptr = view.ptr, .len = bytes, .borrowed = true };
+    try buffer.download(0, staging[0..bytes]);
+    if (!finite(staging[0..bytes], view.f32)) return error.NonfiniteCapture;
+    return staging[0..bytes];
+}
+fn capture(gpa: std.mem.Allocator, io: std.Io, out: std.Io.Dir, driver: *cuda.Driver, staging: []align(16) u8, prefix: []const u8, view: View) !Capture {
+    const bytes = try download(driver, staging, view);
+    const file = try std.fmt.allocPrint(gpa, "{s}{s}.{s}", .{ prefix, view.name, if (view.f32) "f32" else "bf16" });
+    errdefer gpa.free(file);
+    try out.writeFile(io, .{ .sub_path = file, .data = bytes, .flags = .{ .exclusive = true } });
+    return .{ .file = file, .dtype = if (view.f32) "f32le" else "bf16le", .shape = .{ view.rows, view.cols }, .sha256 = sha(bytes) };
+}
+
+pub fn main(init: std.process.Init) !u8 {
+    const gpa = init.gpa;
+    const io = init.io;
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    if (args.len != 5) return error.UsageCheckpointInputExpectedOutputDirectory;
+    if (builtin.cpu.arch.endian() != .little) return error.UnsupportedHostEndian;
+    const out = try std.Io.Dir.cwd().openDir(io, args[4], .{});
+    defer out.close(io);
+    const total_bytes = source_rows * H * 2;
+    const input_data = try std.Io.Dir.cwd().readFileAllocOptions(io, args[2], gpa, .limited(total_bytes + 1), .@"16", null);
+    defer gpa.free(input_data);
+    const expected = try std.Io.Dir.cwd().readFileAllocOptions(io, args[3], gpa, .limited(total_bytes + 1), .@"16", null);
+    defer gpa.free(expected);
+    if (input_data.len != total_bytes or expected.len != total_bytes) return error.FixtureShape;
+    if (!finite(input_data, false) or !finite(expected, false)) return error.NonfiniteFixture;
+    _ = try cuda.setAllocationLimit(54 * (1 << 30));
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    var model = try Model.init(gpa, io, &ctx, args[1], "", .{ .context = 512, .max_rows = R });
+    defer model.deinit();
+    if (!drama.backbone.config.linear(0) or model.hidden != H) return error.UnexpectedArchitecture;
+    var input = try cuda.HostBuffer.alloc(&driver, total_bytes);
+    defer input.free();
+    var output = try cuda.HostBuffer.alloc(&driver, total_bytes);
+    defer output.free();
+    const staging = try gpa.alignedAlloc(u8, .@"16", LD * H * 2);
+    defer gpa.free(staging);
+    const w = &model.w.layers[0];
+    const weight_views = [_]View{
+        .{ .name = "weight_in", .ptr = w.gdn_in, .rows = LD, .cols = H },
+        .{ .name = "weight_conv", .ptr = w.conv, .rows = 8192, .cols = 4 },
+        .{ .name = "weight_a_log", .ptr = w.a_log, .rows = 32, .cols = 1, .f32 = true },
+        .{ .name = "weight_dt_bias", .ptr = w.dt_bias, .rows = 32, .cols = 1, .f32 = true },
+        .{ .name = "weight_norm", .ptr = w.gnorm, .rows = 1, .cols = 128 },
+        .{ .name = "weight_out", .ptr = w.gdn_out, .rows = H, .cols = 4096 },
+    };
+    var captures: std.ArrayList(Capture) = .empty;
+    defer {
+        for (captures.items) |c| gpa.free(c.file);
+        captures.deinit(gpa);
+    }
+    try captures.ensureTotalCapacity(gpa, weight_views.len + lengths.len * 6);
+    for (weight_views) |view| captures.appendAssumeCapacity(try capture(gpa, io, out, &driver, staging, "", view));
+    for (lengths) |rows| {
+        const bytes = rows * H * 2;
+        const row0: usize = if (rows == source_rows) R else 0;
+        const captured_rows = rows - row0;
+        const captured_at = row0 * H * 2;
+        const chunks: []const usize = if (rows == source_rows) &.{ R, source_rows - R } else &.{rows};
+        @memcpy(input.bytes[0..bytes], input_data[0..bytes]);
+        const views = [_]View{
+            .{ .name = "input", .ptr = model.s.normed, .rows = captured_rows, .cols = H },
+            .{ .name = "proj", .ptr = model.s.proj, .rows = captured_rows, .cols = LD },
+            .{ .name = "conv", .ptr = model.s.conv, .rows = captured_rows, .cols = 8192 },
+            .{ .name = "core", .ptr = model.s.core, .rows = captured_rows, .cols = 4096 },
+            .{ .name = "gated", .ptr = model.s.gated, .rows = captured_rows, .cols = 4096 },
+            .{ .name = "output", .ptr = model.s.x, .rows = captured_rows, .cols = H },
+        };
+        var hashes: [views.len][64]u8 = undefined;
+        var prefix_buffer: [32]u8 = undefined;
+        const prefix = try std.fmt.bufPrint(&prefix_buffer, "rows-{d}-", .{rows});
+        for (0..2) |repeat| {
+            try model.reset(stream);
+            @memset(output.bytes[0..bytes], 0xff);
+            try model.replayOperator(stream, 0, .attention, chunks, input.bytes[0..bytes], output.bytes[0..bytes]);
+            if (!std.mem.eql(u8, output.bytes[0..bytes], expected[0..bytes])) return error.NativeFrozenSelfControl;
+            if (!std.mem.eql(u8, input.bytes[0..bytes], input_data[0..bytes])) return error.HostInputMutated;
+            for (views, 0..) |view, i| {
+                if (repeat == 0) {
+                    const c = try capture(gpa, io, out, &driver, staging, prefix, view);
+                    hashes[i] = c.sha256;
+                    captures.appendAssumeCapacity(c);
+                } else if (!std.mem.eql(u8, &sha(try download(&driver, staging, view)), &hashes[i])) {
+                    return error.ScratchRepeatMismatch;
+                }
+            }
+            if (!std.mem.eql(u8, &hashes[0], &sha(input_data[captured_at..bytes]))) return error.DeviceInputMutated;
+            if (!std.mem.eql(u8, &hashes[5], &sha(output.bytes[captured_at..bytes]))) return error.OutputCaptureMismatch;
+        }
+    }
+    for (weight_views, 0..) |view, i| {
+        if (!std.mem.eql(u8, &sha(try download(&driver, staging, view)), &captures.items[i].sha256)) return error.WeightMutated;
+    }
+    const used = cuda.usage(false);
+    const manifest = try std.json.Stringify.valueAlloc(gpa, .{
+        .producer = "tf-drama-gdn-layer0-trace",
+        .evidence_valid = true,
+        .layer = 0,
+        .rows = lengths,
+        .repeats = 2,
+        .native_frozen_prefix_controls = true,
+        .capture_row_offsets = [_]usize{ 0, 0, 0, 128 },
+        .capture_rows = [_]usize{ 1, 7, 128, 54 },
+        .scratch_repeat_controls = true,
+        .input_and_weight_immutability = true,
+        .input_sha256 = sha(input_data),
+        .expected_sha256 = sha(expected),
+        .driver_source_sha256 = sha(@embedFile("drama_gdn_layer0_trace.zig")),
+        .backbone_source_sha256 = sha(drama.backbone.trace_source),
+        .backbone_image_sha256 = sha(cuda.kernels.drama_backbone),
+        .gemm_image_sha256 = sha(cuda.kernels.drama_backbone_gemm),
+        .norm_image_sha256 = sha(cuda.kernels.norms),
+        .cuda_bytes = used.device,
+        .cuda_peak_bytes = used.peak,
+        .pinned_host_bytes = used.host,
+        .captures = captures.items,
+    }, .{ .whitespace = .indent_2 });
+    defer gpa.free(manifest);
+    try out.writeFile(io, .{ .sub_path = "manifest.json", .data = manifest, .flags = .{ .exclusive = true } });
+    std.debug.print("layer=0 rows=1,7,128,182 repeats=2 frozen_native_exact=true captures={d} cuda_bytes={d}\n", .{ captures.items.len, used.device });
+    return 0;
+}
diff --git a/zig/tests/cuda/drama_qk_tests.zig b/zig/tests/cuda/drama_qk_tests.zig
new file mode 100644
index 00000000..2d10e01e
--- /dev/null
+++ b/zig/tests/cuda/drama_qk_tests.zig
@@ -0,0 +1,135 @@
+//! Gemma Q/K normalization and interleaved RoPE: numerical rounding, position/chunk invariance and cache bounds.
+//! Synthetic operands only; BF16 goldens were produced by FlashInfer CuTe Gemma RMSNorm and SGLang fused RoPE on GB10.
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+
+const rows = 7;
+const qheads = 16;
+const kheads = 2;
+const dim = 256;
+const qw = qheads * dim;
+const kw = kheads * dim;
+const qkv = 2 * qw + 2 * kw;
+const start = 181;
+const context = 192;
+const guard = 32;
+const sentinel: u16 = 0x7fc1;
+const Expected = struct { index: usize, bits: u16 };
+const expected_q = [_]Expected{
+    .{ .index = 0, .bits = 0xbcc7 },
+    .{ .index = 1, .bits = 0x3b2c },
+    .{ .index = 63, .bits = 0xbc8a },
+    .{ .index = 64, .bits = 0xbc0b },
+    .{ .index = 255, .bits = 0x3d4b },
+    .{ .index = 256, .bits = 0xbedf },
+    .{ .index = 4095, .bits = 0x3b19 },
+    .{ .index = 24576, .bits = 0xbce2 },
+    .{ .index = 24577, .bits = 0xbc52 },
+    .{ .index = 24639, .bits = 0xbcab },
+    .{ .index = 24640, .bits = 0xbc41 },
+    .{ .index = 24831, .bits = 0x3cfa },
+    .{ .index = 24832, .bits = 0x3f05 },
+    .{ .index = 28671, .bits = 0x0000 },
+};
+// Indices 1065 and 2055 distinguish the old export from the reference's rounded arithmetic.
+const expected_k = [_]Expected{
+    .{ .index = 0, .bits = 0x3c99 },
+    .{ .index = 1, .bits = 0x3c67 },
+    .{ .index = 63, .bits = 0x3a7e },
+    .{ .index = 64, .bits = 0x3d41 },
+    .{ .index = 255, .bits = 0xbe93 },
+    .{ .index = 256, .bits = 0xbec1 },
+    .{ .index = 511, .bits = 0xbc4d },
+    .{ .index = 1065, .bits = 0x3fde },
+    .{ .index = 2055, .bits = 0x3a3b },
+    .{ .index = 3072, .bits = 0xbbb4 },
+    .{ .index = 3073, .bits = 0x3c87 },
+    .{ .index = 3135, .bits = 0xbc35 },
+    .{ .index = 3136, .bits = 0x3c89 },
+    .{ .index = 3327, .bits = 0xbeb9 },
+    .{ .index = 3328, .bits = 0xbf3d },
+    .{ .index = 3583, .bits = 0x3c2b },
+};
+
+fn bf16Exact(value: f32) u16 {
+    return @truncate(@as(u32, @bitCast(value)) >> 16);
+}
+
+fn runCase(gpu: check.Gpu, stream: cuda.Stream, kernel: cuda.Function, chunk: usize) !void {
+    var x: [rows * qkv]u16 = undefined;
+    var weights: [2][dim]u16 = undefined;
+    const scale = [_]f32{ 0.0625, 0.125, 0.25, 0.5, 1, 2, 4, 8, 16 };
+    // Integer mantissas and powers of two make all operands exactly BF16-representable, without a host rounding oracle.
+    for (&x, 0..) |*value, i| {
+        const mantissa: i32 = @intCast((37 * i + 11) % 257);
+        value.* = bf16Exact(@as(f32, @floatFromInt(mantissa - 128)) / 16 * scale[i % scale.len]);
+    }
+    for (0..dim) |i| {
+        const q: i32 = @intCast((5 * i + 3) % 17);
+        const k: i32 = @intCast((7 * i + 1) % 19);
+        weights[0][i] = bf16Exact(@as(f32, @floatFromInt(q - 8)) / 16);
+        weights[1][i] = bf16Exact(@as(f32, @floatFromInt(k - 9)) / 32);
+    }
+    var queries: [guard + rows * qw + guard]u16 = @splat(sentinel);
+    var keys: [guard + context * kw + guard]u16 = @splat(sentinel);
+    var values: @TypeOf(keys) = @splat(sentinel);
+    var dx = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.asBytes(&x));
+    defer dx.free();
+    var dw = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.asBytes(&weights));
+    defer dw.free();
+    var dq = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.asBytes(&queries));
+    defer dq.free();
+    var dk = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.asBytes(&keys));
+    defer dk.free();
+    var dv = try cuda.DeviceBuffer.fromHost(gpu.d, std.mem.asBytes(&values));
+    defer dv.free();
+    try gpu.ctx.synchronize();
+    var at: usize = 0;
+    while (at < rows) {
+        const count = @min(chunk, rows - at);
+        var args: cuda.Args = .{};
+        args.add(dx.ptr + at * qkv * 2);
+        args.add(dw.ptr);
+        args.add(dw.ptr + dim * 2);
+        args.add(dq.ptr + (guard + at * qw) * 2);
+        args.add(dk.ptr + guard * 2);
+        args.add(dv.ptr + guard * 2);
+        args.add(@as(i32, @intCast(start + at)));
+        args.add(@as(i32, qheads));
+        args.add(@as(i32, kheads));
+        args.add(@as(i32, dim));
+        args.add(@as(i32, 64));
+        args.add(@as(f32, 10000000));
+        args.add(@as(f32, 1e-6));
+        try cuda.launch.launch(kernel, .{ .grid = .{ .x = @intCast(count * (qheads + kheads)) }, .block = .{ .x = 256 } }, stream, &args);
+        at += count;
+    }
+    try stream.synchronize();
+    try dq.download(0, std.mem.asBytes(&queries));
+    try dk.download(0, std.mem.asBytes(&keys));
+    try dv.download(0, std.mem.asBytes(&values));
+    for (expected_q) |e| try check.expect(queries[guard + e.index] == e.bits, "Drama query index {d}, chunk {d}: {x} != {x}", .{ e.index, chunk, queries[guard + e.index], e.bits });
+    for (expected_k) |e| try check.expect(keys[guard + start * kw + e.index] == e.bits, "Drama key index {d}, chunk {d}: {x} != {x}", .{ e.index, chunk, keys[guard + start * kw + e.index], e.bits });
+    for (0..guard) |i| try check.expect(queries[i] == sentinel and queries[guard + rows * qw + i] == sentinel, "Drama query guard {d}, chunk {d}", .{ i, chunk });
+    for (keys, values, 0..) |key, value, i| {
+        if (i < guard + start * kw or i >= guard + (start + rows) * kw)
+            try check.expect(key == sentinel and value == sentinel, "Drama KV cache outside append range at {d}, chunk {d}", .{ i, chunk });
+    }
+    var x_after: @TypeOf(x) = undefined;
+    var weights_after: @TypeOf(weights) = undefined;
+    try dx.download(0, std.mem.asBytes(&x_after));
+    try dw.download(0, std.mem.asBytes(&weights_after));
+    try check.sameBytes("Drama QKV input unchanged", std.mem.asBytes(&x_after), std.mem.asBytes(&x));
+    try check.sameBytes("Drama Q/K gamma unchanged", std.mem.asBytes(&weights_after), std.mem.asBytes(&weights));
+}
+
+pub fn run(gpu: check.Gpu) !void {
+    var module = try cuda.Module.load(gpu.d, cuda.kernels.drama_tower);
+    defer module.unload();
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    const kernel = try module.function("drama_rope_cache");
+    for ([_]usize{ 1, 3, 7 }) |chunk| try runCase(gpu, stream, kernel, chunk);
+    check.pass("Drama Q/K: reference-rounded norm and RoPE, positions 181..187, chunks 1/3/7, cache bounds", .{});
+}
diff --git a/zig/tests/cuda/drama_semantic_fixture.zig b/zig/tests/cuda/drama_semantic_fixture.zig
new file mode 100644
index 00000000..6fc75bf7
--- /dev/null
+++ b/zig/tests/cuda/drama_semantic_fixture.zig
@@ -0,0 +1,116 @@
+//! Capture paired backbone hidden states and sampled frames with production backbone/tower APIs.
+//! Mirrors drama_host.zig's prompt and generation ordering; stops after 128 frames without running the codec.
+//! Caller owns the GPU lock, admission, memory cap and lifetime monitoring. Captures stay outside source control.
+const std = @import("std");
+const builtin = @import("builtin");
+const cuda = @import("cuda");
+const drama = @import("drama");
+const Frame = drama.tower.Frame;
+const width = 2048;
+const rows = 128;
+const context = 512;
+
+fn plainFrame(token: u32) Frame {
+    var frame: Frame = @splat(0);
+    frame[0] = token;
+    return frame;
+}
+
+fn lastRow(buffer: cuda.DeviceBuffer, count: usize, row_bytes: usize) !cuda.DeviceBuffer {
+    if (count == 0 or buffer.len != count * row_bytes) return error.DramaRowsMismatch;
+    return .{ .d = buffer.d, .ptr = buffer.ptr + (count - 1) * row_bytes, .len = row_bytes, .borrowed = true };
+}
+
+pub fn main(init: std.process.Init) !u8 {
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    if (args.len != 4) {
+        std.debug.print("usage: tf-drama-semantic-fixture CHECKPOINT TOKENS_U32LE OUTPUT_DIRECTORY\n", .{});
+        return 2;
+    }
+    if (builtin.cpu.arch.endian() != .little) return error.UnsupportedHostEndian;
+    var bytes: [(context - rows) * 4 + 1]u8 align(@alignOf(u32)) = undefined;
+    const file = try std.Io.Dir.cwd().openFile(init.io, args[2], .{});
+    defer file.close(init.io);
+    const size = try file.readPositionalAll(init.io, &bytes, 0);
+    if (size < 8 or size > (context - rows) * 4 or size % 4 != 0) return error.ExpectedTwoTo384Tokens;
+    const tokens = std.mem.bytesAsSlice(u32, @as([]align(@alignOf(u32)) u8, bytes[0..size]));
+    for (tokens) |token| if (token >= drama.backbone.config.vocab) return error.InvalidPromptToken;
+    var out = try std.Io.Dir.cwd().openDir(init.io, args[3], .{});
+    defer out.close(init.io);
+    const hidden_capture = try init.gpa.alloc(u16, rows * width);
+    defer init.gpa.free(hidden_capture);
+    var captured_frames: [rows + 1]Frame = undefined;
+    var staged: [rows + 1]Frame = undefined;
+
+    _ = try cuda.setAllocationLimit(54 * (1 << 30));
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    var backbone = try drama.backbone.Model.init(init.gpa, init.io, &ctx, args[1], "", .{ .context = context, .max_rows = rows });
+    defer backbone.deinit();
+    var tower = try drama.tower.Model.init(init.gpa, init.io, &ctx, args[1], "", .{ .context = context, .max_rows = rows });
+    defer tower.deinit();
+    if (backbone.hidden != width) return error.DramaHiddenMismatch;
+    for (tokens) |token| if (token >= backbone.semantic_start and token <= backbone.semantic_end) return error.TextFixtureMustNotContainSemanticTokens;
+    try backbone.reset(stream);
+    try tower.reset(stream, tokens, 0);
+
+    var last: drama.backbone.Rows = undefined;
+    var start: usize = 0;
+    while (start < tokens.len) {
+        const end = @min(start + rows, tokens.len);
+        const n = end - start;
+        const look = @min(end + 1, tokens.len);
+        for (tokens[start..look], staged[0 .. look - start]) |token, *frame| frame.* = plainFrame(token);
+        const extra = try tower.setInput(stream, staged[0..n]);
+        last = try backbone.run(stream, .prefill, tokens[start..end], extra);
+        if (last.rows != n) return error.DramaRowsMismatch;
+        const taught = look - start - 1;
+        if (taught > 0) try tower.prefill(stream, last.hidden, staged[1 .. 1 + taught]);
+        if (end == tokens.len and taught > 0) _ = try tower.setInput(stream, staged[n - 1 .. n]);
+        start = end;
+    }
+
+    // Row 0 is the final prompt row. Frame i+1 is the sampled label for hidden row i.
+    // The independent tower oracle rebases this captured suffix to position zero: it does not replay prompt KV.
+    captured_frames[0] = plainFrame(tokens[tokens.len - 1]);
+    var hidden = try lastRow(last.hidden, last.rows, width * 2);
+    var logits = try lastRow(last.semantic_logits, 1, drama.backbone.weights.head_cols * 4);
+    const sampling: drama.tower.Sampling = .{ .temperature = 1, .top_p = 0.9, .top_k = 30 };
+    for (0..rows) |i| {
+        try stream.synchronize();
+        try hidden.download(0, std.mem.sliceAsBytes(hidden_capture[i * width .. (i + 1) * width]));
+        const frame = try tower.generate(stream, logits, hidden, sampling);
+        if (frame[0] == backbone.eos) {
+            std.debug.print("early_eos generated_frames={d}; no padded fixture is written\n", .{i});
+            return error.InsufficientGeneratedFrames;
+        }
+        if (frame[0] < backbone.semantic_start or frame[0] > backbone.semantic_end) return error.BadSpeechFrame;
+        if (frame[0] - backbone.semantic_start != frame[1]) return error.SemanticCodeMismatch;
+        for (frame[1..]) |code| if (code >= 4096) return error.InvalidCodebookIndex;
+        captured_frames[i + 1] = frame;
+        if (i + 1 < rows) {
+            staged[0] = frame;
+            const extra = try tower.setInput(stream, staged[0..1]);
+            const decoded = try backbone.run(stream, .decode, staged[0][0..1], extra);
+            if (decoded.rows != 1) return error.DramaRowsMismatch;
+            hidden = try lastRow(decoded.hidden, 1, width * 2);
+            logits = try lastRow(decoded.semantic_logits, 1, drama.backbone.weights.head_cols * 4);
+        }
+    }
+    for (hidden_capture) |bits| {
+        const value: f32 = @bitCast(@as(u32, bits) << 16);
+        if (!std.math.isFinite(value)) return error.NonFiniteBackboneHidden;
+    }
+    try out.writeFile(init.io, .{ .sub_path = "hidden.bf16", .data = std.mem.sliceAsBytes(hidden_capture) });
+    try out.writeFile(init.io, .{ .sub_path = "frames.u32le", .data = std.mem.sliceAsBytes(&captured_frames) });
+    const used = cuda.usage(false);
+    var metadata: [1024]u8 = undefined;
+    const text = try std.fmt.bufPrint(&metadata, "{{\"prompt_rows\":{d},\"hidden_rows\":{d},\"frame_rows\":{d},\"hidden_width\":{d},\"context\":{d},\"first_position\":{d},\"semantic_start\":{d},\"semantic_end\":{d},\"seed\":0,\"temperature\":1,\"top_p\":0.9,\"top_k\":30,\"stopped_at_fixture_bound\":true,\"codec_loaded\":false,\"cuda_bytes\":{d},\"pinned_bytes\":{d},\"scope\":\"Native-generated fixed-input suffix; independent tower replay rebases positions and omits earlier prompt KV. Not reference generation or complete speech.\"}}\n", .{ tokens.len, rows, rows + 1, width, context, tokens.len - 1, backbone.semantic_start, backbone.semantic_end, used.device, used.host });
+    try out.writeFile(init.io, .{ .sub_path = "capture.json", .data = text });
+    std.debug.print("{s}", .{text});
+    return 0;
+}
diff --git a/zig/tests/cuda/drama_tower_context_oracle.zig b/zig/tests/cuda/drama_tower_context_oracle.zig
new file mode 100644
index 00000000..fdf6b6e0
--- /dev/null
+++ b/zig/tests/cuda/drama_tower_context_oracle.zig
@@ -0,0 +1,452 @@
+//! Development diagnostic, not a gate: the production tower teacher-forced over a whole prompt prefix and then a
+//! suffix, at absolute positions, with no sampling.
+//!
+//! usage: tf-drama-tower-context-oracle CHECKPOINT FIXTURE_DIRECTORY OUTPUT_DIRECTORY
+//!
+//! FIXTURE_DIRECTORY holds hidden.bf16 (309 row-major BF16 rows of 2048: 181 prompt rows, then 128 suffix rows) and
+//! frames.u32le (310 frames of 11 u32; row r is the input frame of hidden row r and frame r + 1 its next-frame label).
+//! It is only read. OUTPUT_DIRECTORY must exist; every file is created exclusively, so nothing is ever overwritten.
+//! The model is built with context 512 and max_rows 128 (the production host's capacity for this prompt).
+//!
+//! For each suffix length N in 1, 7, 128 (in that order), four schedules, each starting with reset:
+//!   batch      prefix rows 0..180 in the host's chunks 128 then 53 (setInput(frames[a..b]), prefill(hidden[a..b],
+//!              frames[a+1..b+1])), then the N suffix rows 181..181+N-1 in ONE prefill at positions 181..
+//!   repeat     the KV cache is first filled with 0xFF (BF16 NaN), then exactly `batch` again: equal bits prove both
+//!              repeatability and that no unwritten cache row is read (reset does not clear the cache)
+//!   streaming  the same prefix, then N one-row prefills at positions 181, 182, ...
+//!   rebased    no prefix: the N suffix rows in one prefill at positions 0..N-1, as the earlier generated-suffix
+//!              oracle ran them (control against its frozen native files)
+//! Exports per schedule: suffix final hidden [N][2048], the codebook-9 head on the last suffix row (the rows = 1
+//! cuBLASLt plan and heads[8], exactly tf-drama-tower-oracle's call, after a 0xFF NaN fill) and the N suffix KV rows of
+//! every layer (cache positions 181.. or 0.. for rebased). The prefix final hidden [181][2048] and prefix KV rows
+//! [181][512] of every layer are exported once (first batch run) and every later prefix is compared bit for bit.
+//! Finally the device input rows and host fixture bytes are re-read and compared with what was loaded.
+//!
+//! manifest.json lists every file with shape, SHA-256 and nonfinite count. evidence_valid is false (exit 3) on any
+//! recorded error: nonfinite output, batch / repeat bit difference, a prefix that differs between schedules, a
+//! mutated input, an unexpected model layout. An existing output file aborts the run without a manifest.
+//! The caller owns the shared GPU lock, admission, process cap and lifetime monitoring.
+const std = @import("std");
+const builtin = @import("builtin");
+const cuda = @import("cuda");
+const drama = @import("drama");
+
+const Allocator = std.mem.Allocator;
+const tower = drama.tower;
+const Frame = tower.Frame;
+const Impl = @typeInfo(@FieldType(tower.Model, "impl")).pointer.child;
+
+const width = 2048;
+const kv_width = 512;
+const vocab = 4096;
+const max_rows = 128;
+const context = 512;
+const prefix_rows = 181;
+const suffix_rows = 128;
+const hidden_rows = prefix_rows + suffix_rows;
+const frame_rows = hidden_rows + 1;
+const prefix_chunks = [_]usize{ 128, 53 }; // the production host's teacher-forced prompt chunks
+const row_counts = [_]usize{ 1, 7, suffix_rows };
+const projection_count = 6; // tower.zig `projections.len`
+const head_kind = 5; // tower.zig `projections[5]` = { 4096, hidden }
+const head_index = 8; // codebook 9: audio_decoder_mtp.heads.8
+const head_plan = (1 - 1) * projection_count + head_kind; // rows = 1, as generate() and tf-drama-tower-oracle
+const layer_count = @typeInfo(@FieldType(Impl, "layers")).array.len;
+
+const Mode = enum { batch, repeat, streaming, rebased };
+const modes = std.meta.tags(Mode);
+
+comptime {
+    std.debug.assert(layer_count == 13);
+    var sum: usize = 0;
+    for (prefix_chunks) |c| sum += c;
+    std.debug.assert(sum == prefix_rows);
+    std.debug.assert(hidden_rows <= context);
+    for (prefix_chunks) |c| std.debug.assert(c <= max_rows);
+}
+
+/// Recorded failures that leave the files written but the evidence invalid. Messages hold no quote or backslash.
+const Errors = struct {
+    gpa: Allocator,
+    json: std.ArrayList(u8) = .empty,
+    count: usize = 0,
+
+    fn add(e: *Errors, comptime f: []const u8, args: anytype) !void {
+        std.debug.print("error: " ++ f ++ "\n", args);
+        try e.json.appendSlice(e.gpa, if (e.count == 0) "\n    \"" else ",\n    \"");
+        try e.json.print(e.gpa, f, args);
+        try e.json.append(e.gpa, '"');
+        e.count += 1;
+    }
+};
+
+/// One schedule's outputs, sized for the largest suffix; a case uses the first n rows.
+const Run = struct {
+    hidden: []u16, // [max_rows][width] suffix final hidden
+    head: []u16, // [vocab]
+    kv: []u16, // [layer][keys, values][n][kv_width] suffix cache rows
+    prefix_hidden: []u16, // [prefix_rows][width]
+    prefix_kv: []u16, // [layer][keys, values][prefix_rows][kv_width]
+
+    fn alloc(arena: Allocator) !Run {
+        return .{
+            .hidden = try arena.alloc(u16, max_rows * width),
+            .head = try arena.alloc(u16, vocab),
+            .kv = try arena.alloc(u16, layer_count * 2 * max_rows * kv_width),
+            .prefix_hidden = try arena.alloc(u16, prefix_rows * width),
+            .prefix_kv = try arena.alloc(u16, layer_count * 2 * prefix_rows * kv_width),
+        };
+    }
+
+    fn kvRows(r: Run, n: usize, layer: usize, which: usize) []u16 {
+        const at = (layer * 2 + which) * n * kv_width;
+        return r.kv[at .. at + n * kv_width];
+    }
+
+    fn prefixKvRows(r: Run, layer: usize, which: usize) []u16 {
+        const at = (layer * 2 + which) * prefix_rows * kv_width;
+        return r.prefix_kv[at .. at + prefix_rows * kv_width];
+    }
+};
+
+fn view(buffer: cuda.DeviceBuffer, offset: usize, len: usize) cuda.DeviceBuffer {
+    std.debug.assert(offset <= buffer.len and len <= buffer.len - offset);
+    return .{ .d = buffer.d, .ptr = buffer.ptr + offset, .len = len, .borrowed = true };
+}
+
+/// tower.zig cache layout: per layer a keys block then a values block of `context` rows of kv_width BF16.
+fn cacheOffset(layer: usize, which: usize, row: usize) usize {
+    return ((layer * 2 + which) * context + row) * kv_width * 2;
+}
+
+/// The oracle's head: rows = 1 plan, heads[8], one output_hidden row, after a NaN fill so a no-op cannot pass.
+fn head(p: *Impl, stream: cuda.Stream, row: usize, out: []u16) !void {
+    try p.head_logits.fill8(0xff, stream.handle);
+    try p.plans.items[head_plan].run(p.output_hidden.ptr + row * width * 2, p.heads[head_index].ptr, p.head_logits.ptr, p.workspace.ptr, p.workspace.len, stream.handle);
+    try stream.synchronize();
+    try p.head_logits.download(0, std.mem.sliceAsBytes(out));
+}
+
+/// One teacher-forced schedule (see the file comment); row r always uses frames[r] and labels frames[r + 1].
+fn runSchedule(model: *tower.Model, stream: cuda.Stream, dev: cuda.DeviceBuffer, frames: []const Frame, n: usize, mode: Mode, r: Run) !void {
+    const p = model.impl;
+    try model.reset(stream, &.{}, 0);
+    if (mode != .rebased) {
+        var row: usize = 0;
+        for (prefix_chunks) |c| {
+            _ = try model.setInput(stream, frames[row .. row + c]);
+            try model.prefill(stream, view(dev, row * width * 2, c * width * 2), frames[row + 1 .. row + c + 1]);
+            try p.output_hidden.download(0, std.mem.sliceAsBytes(r.prefix_hidden[row * width .. (row + c) * width]));
+            row += c;
+        }
+        for (0..layer_count) |layer| for (0..2) |which| {
+            try p.cache.download(cacheOffset(layer, which, 0), std.mem.sliceAsBytes(r.prefixKvRows(layer, which)));
+        };
+    }
+    const a = prefix_rows; // absolute fixture row of the first suffix row
+    switch (mode) {
+        .batch, .repeat, .rebased => {
+            _ = try model.setInput(stream, frames[a .. a + n]);
+            try model.prefill(stream, view(dev, a * width * 2, n * width * 2), frames[a + 1 .. a + n + 1]);
+            try p.output_hidden.download(0, std.mem.sliceAsBytes(r.hidden[0 .. n * width]));
+            try head(p, stream, n - 1, r.head);
+        },
+        .streaming => {
+            for (0..n) |i| {
+                _ = try model.setInput(stream, frames[a + i .. a + i + 1]);
+                try model.prefill(stream, view(dev, (a + i) * width * 2, width * 2), frames[a + i + 1 .. a + i + 2]);
+                try p.output_hidden.download(0, std.mem.sliceAsBytes(r.hidden[i * width .. (i + 1) * width]));
+            }
+            try head(p, stream, 0, r.head);
+        },
+    }
+    const position0: usize = if (mode == .rebased) 0 else prefix_rows;
+    for (0..layer_count) |layer| for (0..2) |which| {
+        try p.cache.download(cacheOffset(layer, which, position0), std.mem.sliceAsBytes(r.kvRows(n, layer, which)));
+    };
+}
+
+fn differences(a: []const u16, b: []const u16) usize {
+    var count: usize = 0;
+    for (a, b) |x, y| {
+        if (x != y) count += 1;
+    }
+    return count;
+}
+
+fn nonfiniteBf16(values: []const u16) usize {
+    var count: usize = 0;
+    for (values) |bits| {
+        if ((bits & 0x7f80) == 0x7f80) count += 1;
+    }
+    return count;
+}
+
+fn sha256Hex(bytes: []const u8) [64]u8 {
+    var out: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(bytes, &out, .{});
+    return std.fmt.bytesToHex(out, .lower);
+}
+
+fn fileSha256(gpa: Allocator, io: std.Io, path: []const u8) ![64]u8 {
+    const file = try std.Io.Dir.openFileAbsolute(io, path, .{});
+    defer file.close(io);
+    const buffer = try gpa.alloc(u8, 1 << 20);
+    defer gpa.free(buffer);
+    var hash = std.crypto.hash.sha2.Sha256.init(.{});
+    var offset: u64 = 0;
+    while (true) {
+        const got = try file.readPositionalAll(io, buffer, offset);
+        hash.update(buffer[0..got]);
+        offset += got;
+        if (got < buffer.len) break;
+    }
+    return std.fmt.bytesToHex(hash.finalResult(), .lower);
+}
+
+fn readExact(io: std.Io, dir: std.Io.Dir, name: []const u8, bytes: []u8) !void {
+    const file = try dir.openFile(io, name, .{});
+    defer file.close(io);
+    if (try file.length(io) != bytes.len or try file.readPositionalAll(io, bytes, 0) != bytes.len) return error.BadFixtureLength;
+}
+
+fn jsonString(list: *std.ArrayList(u8), gpa: Allocator, s: []const u8) !void {
+    try list.append(gpa, '"');
+    for (s) |c| switch (c) {
+        '"', '\\' => {
+            try list.append(gpa, '\\');
+            try list.append(gpa, c);
+        },
+        0...0x1f => try list.print(gpa, "\\u{x:0>4}", .{c}),
+        else => try list.append(gpa, c),
+    };
+    try list.append(gpa, '"');
+}
+
+/// Writes one BF16 array as a new file and appends `"key": {file, sha256, shape, nonfinite}` to json.
+fn emit(gpa: Allocator, io: std.Io, dir: std.Io.Dir, json: *std.ArrayList(u8), key: []const u8, name: []const u8, data: []const u16, rows: usize, cols: usize, errors: *Errors) !usize {
+    const bytes = std.mem.sliceAsBytes(data);
+    try dir.writeFile(io, .{ .sub_path = name, .data = bytes, .flags = .{ .exclusive = true } });
+    const bad = nonfiniteBf16(data);
+    if (bad != 0) try errors.add("{s}: {d} nonfinite values", .{ name, bad });
+    const sha = sha256Hex(bytes);
+    try json.print(gpa, "\"{s}\": {{\"file\": \"{s}\", \"sha256\": \"{s}\", \"shape\": [{d}, {d}], \"nonfinite\": {d}}}", .{ key, name, sha[0..], rows, cols, bad });
+    return bytes.len;
+}
+
+/// One schedule's suffix outputs as new files: native-N-MODE-{hidden,head9,layer-LL-keys,layer-LL-values}.bf16.
+fn emitRun(gpa: Allocator, io: std.Io, dir: std.Io.Dir, json: *std.ArrayList(u8), n: usize, mode: Mode, r: Run, errors: *Errors) !usize {
+    var name_buffer: [96]u8 = undefined;
+    var written: usize = 0;
+    try json.print(gpa, "\"{s}\": {{", .{@tagName(mode)});
+    var name = try std.fmt.bufPrint(&name_buffer, "native-{d}-{s}-hidden.bf16", .{ n, @tagName(mode) });
+    written += try emit(gpa, io, dir, json, "hidden", name, r.hidden[0 .. n * width], n, width, errors);
+    try json.appendSlice(gpa, ", ");
+    name = try std.fmt.bufPrint(&name_buffer, "native-{d}-{s}-head9.bf16", .{ n, @tagName(mode) });
+    written += try emit(gpa, io, dir, json, "head9", name, r.head, 1, vocab, errors);
+    try json.appendSlice(gpa, ", \"kv\": {");
+    for (0..layer_count) |layer| for ([_][]const u8{ "keys", "values" }, 0..) |kind, which| {
+        var key_buffer: [32]u8 = undefined;
+        const key = try std.fmt.bufPrint(&key_buffer, "layer-{d:0>2}-{s}", .{ layer, kind });
+        name = try std.fmt.bufPrint(&name_buffer, "native-{d}-{s}-layer-{d:0>2}-{s}.bf16", .{ n, @tagName(mode), layer, kind });
+        if (layer != 0 or which != 0) try json.appendSlice(gpa, ", ");
+        written += try emit(gpa, io, dir, json, key, name, r.kvRows(n, layer, which), n, kv_width, errors);
+    };
+    try json.appendSlice(gpa, "}}");
+    return written;
+}
+
+const Diff = struct { hidden: usize, head9: usize, kv: usize, prefix_hidden: usize, prefix_kv: usize };
+
+fn compareRuns(n: usize, a: Run, b: Run, prefixes: bool) Diff {
+    return .{
+        .hidden = differences(a.hidden[0 .. n * width], b.hidden[0 .. n * width]),
+        .head9 = differences(a.head, b.head),
+        .kv = differences(a.kv[0 .. layer_count * 2 * n * kv_width], b.kv[0 .. layer_count * 2 * n * kv_width]),
+        .prefix_hidden = if (prefixes) differences(a.prefix_hidden, b.prefix_hidden) else 0,
+        .prefix_kv = if (prefixes) differences(a.prefix_kv, b.prefix_kv) else 0,
+    };
+}
+
+fn printDiff(json: *std.ArrayList(u8), gpa: Allocator, d: Diff) !void {
+    try json.print(gpa, "{{\"hidden\": {d}, \"head9\": {d}, \"kv\": {d}, \"prefix_hidden\": {d}, \"prefix_kv\": {d}}}", .{ d.hidden, d.head9, d.kv, d.prefix_hidden, d.prefix_kv });
+}
+
+fn seconds(ns: anytype) f64 {
+    return @as(f64, @floatFromInt(ns)) / 1e9;
+}
+
+pub fn main(init: std.process.Init) !u8 {
+    const gpa = init.gpa;
+    const io = init.io;
+    const arena = init.arena.allocator();
+    const args = try init.minimal.args.toSlice(arena);
+    if (args.len != 4) {
+        std.debug.print("usage: tf-drama-tower-context-oracle CHECKPOINT FIXTURE_DIRECTORY OUTPUT_DIRECTORY\n", .{});
+        return 2;
+    }
+    if (builtin.cpu.arch.endian() != .little) return error.UnsupportedHostEndian;
+    const fixture = try std.Io.Dir.cwd().openDir(io, args[2], .{});
+    defer fixture.close(io);
+    const out = try std.Io.Dir.cwd().openDir(io, args[3], .{});
+    defer out.close(io);
+
+    // Every input is read before any CUDA call, so a missing or short fixture never touches the device.
+    const hidden = try arena.alloc(u16, hidden_rows * width);
+    var frames: [frame_rows]Frame = undefined;
+    try readExact(io, fixture, "hidden.bf16", std.mem.sliceAsBytes(hidden));
+    try readExact(io, fixture, "frames.u32le", std.mem.sliceAsBytes(&frames));
+    const hidden_sha = sha256Hex(std.mem.sliceAsBytes(hidden));
+    const frames_sha = sha256Hex(std.mem.sliceAsBytes(&frames));
+    for (hidden) |bits| if ((bits & 0x7f80) == 0x7f80) return error.NonfiniteFixtureHidden;
+
+    var runs: [modes.len]Run = undefined;
+    for (&runs) |*r| r.* = try Run.alloc(arena);
+    const base_prefix_hidden = try arena.alloc(u16, prefix_rows * width);
+    const base_prefix_kv = try arena.alloc(u16, layer_count * 2 * prefix_rows * kv_width);
+    const device_check = try arena.alloc(u16, hidden_rows * width);
+
+    var errors: Errors = .{ .gpa = gpa };
+    defer errors.json.deinit(gpa);
+
+    _ = try cuda.setAllocationLimit(54 * (1 << 30));
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    var model = try tower.Model.init(gpa, io, &ctx, args[1], "", .{ .context = context, .max_rows = max_rows });
+    defer model.deinit();
+    const p = model.impl;
+    if (p.plans.items.len != max_rows * projection_count or p.head_logits.len != vocab * 2 or p.output_hidden.len != max_rows * width * 2 or
+        p.cache.len != layer_count * 2 * context * kv_width * 2) return error.UnexpectedTowerLayout;
+    const model_usage = cuda.usage(false);
+    var device_hidden = try cuda.DeviceBuffer.alloc(&driver, hidden_rows * width * 2);
+    defer device_hidden.free();
+    try device_hidden.upload(0, std.mem.sliceAsBytes(hidden));
+
+    var cases: std.ArrayList(u8) = .empty;
+    defer cases.deinit(gpa);
+    var prefix_json: std.ArrayList(u8) = .empty;
+    defer prefix_json.deinit(gpa);
+    var written: usize = 0;
+    var have_base_prefix = false;
+    for (row_counts, 0..) |n, case_index| {
+        var timing: [modes.len]f64 = undefined;
+        for (modes, 0..) |mode, i| {
+            // The repeat runs on a poisoned cache: any read of a row this request did not write turns into NaN.
+            if (mode == .repeat) {
+                try p.cache.fill8(0xff, stream.handle);
+                try stream.synchronize();
+            }
+            const start = std.Io.Clock.awake.now(io).toNanoseconds();
+            try runSchedule(&model, stream, device_hidden, &frames, n, mode, runs[i]);
+            timing[i] = seconds(std.Io.Clock.awake.now(io).toNanoseconds() - start);
+        }
+        const batch = runs[@backingInt(Mode.batch)];
+        const repeat_diff = compareRuns(n, batch, runs[@backingInt(Mode.repeat)], true);
+        if (repeat_diff.hidden != 0 or repeat_diff.head9 != 0 or repeat_diff.kv != 0 or repeat_diff.prefix_hidden != 0 or repeat_diff.prefix_kv != 0)
+            try errors.add("rows {d}: batch vs poisoned-cache repeat bit differences hidden {d} head9 {d} kv {d} prefix_hidden {d} prefix_kv {d}", .{
+                n, repeat_diff.hidden, repeat_diff.head9, repeat_diff.kv, repeat_diff.prefix_hidden, repeat_diff.prefix_kv,
+            });
+        const streaming = runs[@backingInt(Mode.streaming)];
+        const streaming_prefix = Diff{ .hidden = 0, .head9 = 0, .kv = 0, .prefix_hidden = differences(batch.prefix_hidden, streaming.prefix_hidden), .prefix_kv = differences(batch.prefix_kv, streaming.prefix_kv) };
+        if (streaming_prefix.prefix_hidden != 0 or streaming_prefix.prefix_kv != 0)
+            try errors.add("rows {d}: streaming prefix differs from batch prefix hidden {d} kv {d}", .{ n, streaming_prefix.prefix_hidden, streaming_prefix.prefix_kv });
+        if (!have_base_prefix) {
+            @memcpy(base_prefix_hidden, batch.prefix_hidden);
+            @memcpy(base_prefix_kv, batch.prefix_kv);
+            have_base_prefix = true;
+            var name_buffer: [96]u8 = undefined;
+            try prefix_json.appendSlice(gpa, "{");
+            written += try emit(gpa, io, out, &prefix_json, "hidden", "native-prefix-hidden.bf16", base_prefix_hidden, prefix_rows, width, &errors);
+            try prefix_json.appendSlice(gpa, ", \"kv\": {");
+            for (0..layer_count) |layer| for ([_][]const u8{ "keys", "values" }, 0..) |kind, which| {
+                var key_buffer: [32]u8 = undefined;
+                const key = try std.fmt.bufPrint(&key_buffer, "layer-{d:0>2}-{s}", .{ layer, kind });
+                const name = try std.fmt.bufPrint(&name_buffer, "native-prefix-layer-{d:0>2}-{s}.bf16", .{ layer, kind });
+                if (layer != 0 or which != 0) try prefix_json.appendSlice(gpa, ", ");
+                written += try emit(gpa, io, out, &prefix_json, key, name, batch.prefixKvRows(layer, which), prefix_rows, kv_width, &errors);
+            };
+            try prefix_json.appendSlice(gpa, "}}");
+        }
+        const across_cases = .{ differences(base_prefix_hidden, batch.prefix_hidden), differences(base_prefix_kv, batch.prefix_kv) };
+        if (across_cases[0] != 0 or across_cases[1] != 0)
+            try errors.add("rows {d}: batch prefix differs from the first case prefix hidden {d} kv {d}", .{ n, across_cases[0], across_cases[1] });
+
+        try cases.print(gpa, "{s}\n    {{\"rows\": {d}, \"suffix_positions\": [{d}, {d}], \"head_row\": \"last suffix row\"," ++
+            " \"timing_s\": {{\"batch\": {d:.6}, \"repeat\": {d:.6}, \"streaming\": {d:.6}, \"rebased\": {d:.6}}}," ++
+            " \"prefix_differences_vs_first_case\": {{\"hidden\": {d}, \"kv\": {d}}}, \"batch_vs_repeat_bit_differences\": ", .{
+            if (case_index == 0) "" else ",", n, prefix_rows, prefix_rows + n - 1, timing[0], timing[1], timing[2], timing[3], across_cases[0], across_cases[1],
+        });
+        try printDiff(&cases, gpa, repeat_diff);
+        try cases.appendSlice(gpa, ", \"streaming_vs_batch_prefix_bit_differences\": ");
+        try printDiff(&cases, gpa, streaming_prefix);
+        try cases.appendSlice(gpa, ", \"files\": {");
+        for (modes, 0..) |mode, i| {
+            if (i != 0) try cases.appendSlice(gpa, ", ");
+            written += try emitRun(gpa, io, out, &cases, n, mode, runs[i], &errors);
+        }
+        try cases.appendSlice(gpa, "}}");
+        std.debug.print("suffix_rows={d} repeat_hidden_diff={d} repeat_kv_diff={d} repeat_prefix_kv_diff={d} streaming_prefix_kv_diff={d}\n", .{
+            n, repeat_diff.hidden, repeat_diff.kv, repeat_diff.prefix_kv, streaming_prefix.prefix_kv,
+        });
+    }
+
+    // Input immutability: the device rows every schedule read, and the host fixture bytes, are what was loaded.
+    try device_hidden.download(0, std.mem.sliceAsBytes(device_check));
+    const device_input_differences = differences(device_check, hidden);
+    if (device_input_differences != 0) try errors.add("device input hidden changed in {d} values", .{device_input_differences});
+    const host_hidden_unchanged = std.mem.eql(u8, &sha256Hex(std.mem.sliceAsBytes(hidden)), &hidden_sha);
+    const host_frames_unchanged = std.mem.eql(u8, &sha256Hex(std.mem.sliceAsBytes(&frames)), &frames_sha);
+    if (!host_hidden_unchanged or !host_frames_unchanged) try errors.add("host fixture changed: hidden unchanged {} frames unchanged {}", .{ host_hidden_unchanged, host_frames_unchanged });
+    const used = cuda.usage(false);
+
+    var binary_json: std.ArrayList(u8) = .empty;
+    defer binary_json.deinit(gpa);
+    if (fileSha256(gpa, io, "/proc/self/exe")) |sha| {
+        try binary_json.print(gpa, "\"{s}\"", .{sha[0..]});
+    } else |err| {
+        std.debug.print("binary hash unavailable: {s}\n", .{@errorName(err)});
+        try binary_json.appendSlice(gpa, "null");
+    }
+    const tower_source_sha = sha256Hex(tower.trace_source);
+    const driver_source_sha = sha256Hex(@embedFile("drama_tower_context_oracle.zig"));
+    const kernel_image_sha = sha256Hex(cuda.kernels.drama_tower);
+    if (cuda.kernels.drama_tower.len == 0) try errors.add("embedded drama_tower kernel image is empty", .{});
+    const evidence_valid = errors.count == 0;
+
+    var manifest: std.ArrayList(u8) = .empty;
+    defer manifest.deinit(gpa);
+    try manifest.appendSlice(gpa, "{\n  \"schema_version\": 1,\n  \"producer\": \"tf-drama-tower-context-oracle\",\n  \"checkpoint\": ");
+    try jsonString(&manifest, gpa, args[1]);
+    try manifest.appendSlice(gpa, ",\n  \"fixture_directory\": ");
+    try jsonString(&manifest, gpa, args[2]);
+    try manifest.print(gpa, ",\n  \"input_hidden_sha256\": \"{s}\",\n  \"input_frames_sha256\": \"{s}\",\n  \"width\": {d},\n  \"dtype\": \"bf16le\",\n  \"layer_count\": {d}," ++
+        "\n  \"model_options\": {{\"context\": {d}, \"max_rows\": {d}}},\n  \"prefix_rows\": {d},\n  \"prefix_chunks\": [{d}, {d}],\n  \"suffix_rows\": [{d}, {d}, {d}]," ++
+        "\n  \"schedules\": [\"batch\", \"repeat\", \"streaming\", \"rebased\"]," ++
+        "\n  \"row_mapping\": \"fixture row r is request position r (rebased: suffix row j at position j); input frame frames[r], next-frame label frames[r+1]; suffix KV rows are cache positions 181.. (rebased 0..)\"," ++
+        "\n  \"repeat_control\": \"KV cache filled with 0xFF before the repeat schedule; reset does not clear it\"," ++
+        "\n  \"head\": {{\"weight\": \"audio_decoder_mtp.heads.{d}.weight\", \"plan\": \"plans[{d}] (rows 1, kind {d})\", \"input\": \"last suffix row of output_hidden\"}}," ++
+        "\n  \"prefix\": {s},\n  \"cases\": [{s}\n  ]," ++
+        "\n  \"input_immutable\": {{\"device_hidden_differences\": {d}, \"host_hidden_unchanged\": {}, \"host_frames_unchanged\": {}}}," ++
+        "\n  \"allocations\": {{\"cuda_device_bytes_after_init\": {d}, \"cuda_device_bytes\": {d}, \"cuda_device_peak_bytes\": {d}, \"pinned_host_bytes\": {d}}}," ++
+        "\n  \"bytes_written\": {d}," ++
+        "\n  \"binary_sha256\": {s},\n  \"tower_source_sha256\": \"{s}\",\n  \"driver_source_sha256\": \"{s}\",\n  \"tower_kernel_image_sha256\": \"{s}\"," ++
+        "\n  \"evidence_valid\": {},\n  \"errors\": [{s}\n  ]\n}}\n", .{
+        hidden_sha[0..],       frames_sha[0..],          width,                 layer_count,
+        context,               max_rows,                 prefix_rows,           prefix_chunks[0],
+        prefix_chunks[1],      row_counts[0],            row_counts[1],         row_counts[2],
+        head_index,            head_plan,                head_kind,             prefix_json.items,
+        cases.items,           device_input_differences, host_hidden_unchanged, host_frames_unchanged,
+        model_usage.device,    used.device,              used.peak,             used.host,
+        written,               binary_json.items,        tower_source_sha[0..], driver_source_sha[0..],
+        kernel_image_sha[0..], evidence_valid,           errors.json.items,
+    });
+    try out.writeFile(io, .{ .sub_path = "manifest.json", .data = manifest.items, .flags = .{ .exclusive = true } });
+    std.debug.print("cases={d} bytes_written={d} evidence_valid={} errors={d} cuda_bytes={d} cuda_peak={d} pinned_bytes={d}\n", .{
+        row_counts.len, written + manifest.items.len, evidence_valid, errors.count, used.device, used.peak, used.host,
+    });
+    return if (evidence_valid) 0 else 3;
+}
diff --git a/zig/tests/cuda/drama_tower_context_trace.zig b/zig/tests/cuda/drama_tower_context_trace.zig
new file mode 100644
index 00000000..7ff88bed
--- /dev/null
+++ b/zig/tests/cuda/drama_tower_context_trace.zig
@@ -0,0 +1,636 @@
+//! Development diagnostic, not a gate: every tower Stage of the production model along the CURRENT full-context
+//! trajectory of the seven-row suffix, batch and one-row streaming, prefix included.
+//!
+//! usage: tf-drama-tower-context-trace CHECKPOINT HIDDEN.bf16 FRAMES.u32le OUTPUT_DIRECTORY
+//!
+//! HIDDEN.bf16 is 309 row-major BF16 rows of 2048 (181 prompt rows, then 128 suffix rows) and FRAMES.u32le 310 frames of
+//! 11 u32 (row r uses input frame frames[r] and next-frame label frames[r + 1]): the full-context fixture. Both
+//! are only read. OUTPUT_DIRECTORY must exist; every file is created exclusively. Model options as
+//! tf-drama-tower-context-oracle: context 512, max_rows 128. Only suffix N = 7 is run.
+//!
+//! Schedules, each starting with reset (exactly tf-drama-tower-context-oracle's batch / streaming):
+//!   batch      prefix rows 0..180 in prefills of 128 then 53, then rows 181..187 in ONE prefill at positions 181..
+//!   streaming  the same prefix, then seven one-row prefills at positions 181, 182, .., 187
+//! Each schedule runs three times: traced (Model.prefillTraced on EVERY call, prefix included, with a tracer that
+//! copies every Stage of every layer right after its producing kernel), untraced (Model.prefill), and a traced repeat
+//! on a KV cache first filled with 0xFF (BF16 NaN) whose captures are compared in place with the first traced run.
+//! A capture is stored at its request positions (row0 .. row0 + rows - 1), so the calls of a schedule tile rows
+//! 0..187 exactly once per (layer, stage); shared_input is the layer-0 mixer's extra input only (residual layers do
+//! not read it). After each run: suffix final hidden, the codebook-9 head on the last suffix row (rows = 1 plan,
+//! heads[8], after a 0xFF NaN fill; tf-drama-tower-context-oracle's call), the 7 suffix KV rows of every layer, the
+//! prefix final hidden and the 181 prefix KV rows of every layer.
+//!
+//! Files: native-batch-layer-LL-STAGE.bf16 [188][width] (all rows, call boundaries in the manifest),
+//! native-streaming-layer-LL-STAGE.bf16 [7][width] (suffix rows 181..187; the streaming prefix rows are compared with
+//! batch in the driver), native-SCHEDULE-{hidden,head9,prefix-hidden,layer-LL-{keys,values},
+//! prefix-layer-LL-{keys,values}}.bf16 of the traced run. manifest.json lists every file with shape, SHA-256 and
+//! nonfinite count. evidence_valid is false (exit 3) on any recorded error: capture order / count / row mismatch,
+//! uncovered or twice-covered rows, traced / untraced / repeat differences, streaming prefix differing from batch, a
+//! layer-12 output or key / value capture differing from the exported hidden / KV, nonfinite data, changed device
+//! weights, a mutated input. Equality with the frozen current context-oracle outputs is checked by
+//! an external checker. The caller owns the shared GPU lock, admission, process cap and lifetime monitoring.
+const std = @import("std");
+const builtin = @import("builtin");
+const cuda = @import("cuda");
+const drama = @import("drama");
+
+const Allocator = std.mem.Allocator;
+const Sha256 = std.crypto.hash.sha2.Sha256;
+const tower = drama.tower;
+const Stage = tower.Stage;
+const Frame = tower.Frame;
+const Impl = @typeInfo(@FieldType(tower.Model, "impl")).pointer.child;
+const LayerWeights = @typeInfo(@FieldType(Impl, "layers")).array.child;
+
+const width = 2048;
+const kv_width = 512;
+const vocab = 4096;
+const max_rows = 128;
+const context = 512;
+const prefix_rows = 181;
+const suffix = 7;
+const total_rows = prefix_rows + suffix;
+const fixture_hidden_rows = 309;
+const fixture_frame_rows = fixture_hidden_rows + 1;
+const prefix_chunks = [_]usize{ 128, 53 };
+const projection_count = 6; // tower.zig `projections.len`
+const head_kind = 5; // tower.zig `projections[5]` = { 4096, hidden }
+const head_index = 8; // codebook 9: audio_decoder_mtp.heads.8
+const head_plan = (1 - 1) * projection_count + head_kind;
+const layer_count = @typeInfo(@FieldType(Impl, "layers")).array.len;
+const stages = std.meta.tags(Stage);
+const stage_count = stages.len;
+const per_layer = stage_count - 1; // every stage except shared_input, once per layer
+const captures_per_call = 1 + layer_count * per_layer;
+const max_stage_width = 12288; // gate_up
+
+const Schedule = enum { batch, streaming };
+const schedules = std.meta.tags(Schedule);
+
+comptime {
+    std.debug.assert(layer_count == 13);
+    std.debug.assert(stages[0] == .shared_input and stage_count == 16);
+    for (stages) |s| std.debug.assert(tower.stageWidth(s) <= max_stage_width);
+    var sum: usize = 0;
+    for (prefix_chunks) |c| sum += c;
+    std.debug.assert(sum == prefix_rows and total_rows <= fixture_hidden_rows and total_rows <= context);
+}
+
+const Errors = struct {
+    gpa: Allocator,
+    json: std.ArrayList(u8) = .empty,
+    count: usize = 0,
+
+    fn add(e: *Errors, comptime f: []const u8, args: anytype) !void {
+        std.debug.print("error: " ++ f ++ "\n", args);
+        try e.json.appendSlice(e.gpa, if (e.count == 0) "\n    \"" else ",\n    \"");
+        try e.json.print(e.gpa, f, args);
+        try e.json.append(e.gpa, '"');
+        e.count += 1;
+    }
+};
+
+/// Every stage of one schedule at request positions 0..187; coverage counts how often each row was written.
+const Store = struct {
+    data: [layer_count][stage_count][]u16,
+    coverage: [layer_count][stage_count][]u8,
+
+    fn alloc(arena: Allocator) !Store {
+        var s: Store = undefined;
+        for (0..layer_count) |layer| for (stages, 0..) |stage, k| {
+            const count: usize = if (stage == .shared_input and layer != 0) 0 else total_rows;
+            s.data[layer][k] = try arena.alloc(u16, count * tower.stageWidth(stage));
+            s.coverage[layer][k] = try arena.alloc(u8, count);
+            @memset(s.coverage[layer][k], 0);
+        };
+        return s;
+    }
+
+    fn rows(s: *const Store, layer: usize, k: usize, row0: usize, n: usize) []u16 {
+        const w = tower.stageWidth(stages[k]);
+        return s.data[layer][k][row0 * w .. (row0 + n) * w];
+    }
+
+    fn captured(layer: usize, k: usize) bool {
+        return !(stages[k] == .shared_input and layer != 0);
+    }
+};
+
+const Tracer = struct {
+    store: *Store,
+    compare: bool, // false: record into store; true: count differences against it
+    staging: []align(16) u8,
+    call_row0: usize = 0,
+    call_rows: usize = 0,
+    calls: usize = 0,
+    expected: usize = 0,
+    out_of_order: usize = 0,
+    incomplete_calls: usize = 0,
+    bad_rows: usize = 0,
+    duplicate_rows: usize = 0,
+    compare_differences: usize = 0,
+
+    fn begin(t: *Tracer, row0: usize, rows: usize) void {
+        t.call_row0 = row0;
+        t.call_rows = rows;
+        t.expected = 0;
+    }
+
+    fn end(t: *Tracer) void {
+        if (t.expected != captures_per_call) t.incomplete_calls += 1;
+        t.calls += 1;
+    }
+
+    pub fn capture(t: *Tracer, stream: cuda.Stream, layer: usize, stage: Stage, src: cuda.DeviceBuffer, row0: usize) !void {
+        const k = @backingInt(stage);
+        const index = if (stage == .shared_input) 0 else 1 + layer * per_layer + (k - 1);
+        if (index != t.expected or layer >= layer_count or (stage == .shared_input and layer != 0)) t.out_of_order += 1;
+        t.expected = index + 1;
+        if (layer >= layer_count or !Store.captured(layer, k)) return;
+        const bytes_len = t.call_rows * tower.stageWidth(stage) * 2;
+        if (row0 != t.call_row0 or src.len != bytes_len or row0 + t.call_rows > total_rows) {
+            t.bad_rows += 1;
+            return;
+        }
+        if (bytes_len > t.staging.len) return error.TraceCaptureShape;
+        try src.downloadAsync(0, t.staging[0..bytes_len], stream.handle);
+        try stream.synchronize();
+        const dst = t.store.rows(layer, k, row0, t.call_rows);
+        if (t.compare) {
+            t.compare_differences += differences(dst, std.mem.bytesAsSlice(u16, t.staging[0..bytes_len]));
+        } else {
+            @memcpy(std.mem.sliceAsBytes(dst), t.staging[0..bytes_len]);
+            for (t.store.coverage[layer][k][row0 .. row0 + t.call_rows]) |*c| {
+                if (c.* != 0) t.duplicate_rows += 1;
+                c.* +|= 1;
+            }
+        }
+    }
+};
+
+const Finals = struct {
+    hidden: []u16, // [suffix][width]
+    head: []u16, // [vocab]
+    kv: []u16, // [layer][keys, values][suffix][kv_width]
+    prefix_hidden: []u16, // [prefix_rows][width]
+    prefix_kv: []u16, // [layer][keys, values][prefix_rows][kv_width]
+
+    fn alloc(arena: Allocator) !Finals {
+        return .{ .hidden = try arena.alloc(u16, suffix * width), .head = try arena.alloc(u16, vocab), .kv = try arena.alloc(u16, layer_count * 2 * suffix * kv_width), .prefix_hidden = try arena.alloc(u16, prefix_rows * width), .prefix_kv = try arena.alloc(u16, layer_count * 2 * prefix_rows * kv_width) };
+    }
+
+    fn kvRows(f: Finals, layer: usize, which: usize) []u16 {
+        const at = (layer * 2 + which) * suffix * kv_width;
+        return f.kv[at .. at + suffix * kv_width];
+    }
+
+    fn prefixKvRows(f: Finals, layer: usize, which: usize) []u16 {
+        const at = (layer * 2 + which) * prefix_rows * kv_width;
+        return f.prefix_kv[at .. at + prefix_rows * kv_width];
+    }
+};
+
+const Diff = struct { hidden: usize, head9: usize, kv: usize, prefix_hidden: usize, prefix_kv: usize };
+
+fn compareFinals(a: Finals, b: Finals) Diff {
+    return .{ .hidden = differences(a.hidden, b.hidden), .head9 = differences(a.head, b.head), .kv = differences(a.kv, b.kv), .prefix_hidden = differences(a.prefix_hidden, b.prefix_hidden), .prefix_kv = differences(a.prefix_kv, b.prefix_kv) };
+}
+
+fn zero(d: Diff) bool {
+    return d.hidden == 0 and d.head9 == 0 and d.kv == 0 and d.prefix_hidden == 0 and d.prefix_kv == 0;
+}
+
+fn printDiff(json: *std.ArrayList(u8), gpa: Allocator, d: Diff) !void {
+    try json.print(gpa, "{{\"hidden\": {d}, \"head9\": {d}, \"kv\": {d}, \"prefix_hidden\": {d}, \"prefix_kv\": {d}}}", .{ d.hidden, d.head9, d.kv, d.prefix_hidden, d.prefix_kv });
+}
+
+fn view(buffer: cuda.DeviceBuffer, offset: usize, len: usize) cuda.DeviceBuffer {
+    std.debug.assert(offset <= buffer.len and len <= buffer.len - offset);
+    return .{ .d = buffer.d, .ptr = buffer.ptr + offset, .len = len, .borrowed = true };
+}
+
+/// tower.zig cache layout: per layer a keys block then a values block of `context` rows of kv_width BF16.
+fn cacheOffset(layer: usize, which: usize, row: usize) usize {
+    return ((layer * 2 + which) * context + row) * kv_width * 2;
+}
+
+/// tf-drama-tower-context-oracle's head: rows = 1 plan, heads[8], one output_hidden row, after a NaN fill.
+fn head(p: *Impl, stream: cuda.Stream, row: usize, out: []u16) !void {
+    try p.head_logits.fill8(0xff, stream.handle);
+    try p.plans.items[head_plan].run(p.output_hidden.ptr + row * width * 2, p.heads[head_index].ptr, p.head_logits.ptr, p.workspace.ptr, p.workspace.len, stream.handle);
+    try stream.synchronize();
+    try p.head_logits.download(0, std.mem.sliceAsBytes(out));
+}
+
+/// One prefill of `rows` fixture rows from `row0` (positions row0..); traced when `trace` is a tracer pointer.
+fn call(model: *tower.Model, stream: cuda.Stream, dev: cuda.DeviceBuffer, frames: []const Frame, row0: usize, rows: usize, trace: anytype) !void {
+    _ = try model.setInput(stream, frames[row0 .. row0 + rows]);
+    const hidden_rows = view(dev, row0 * width * 2, rows * width * 2);
+    const labels = frames[row0 + 1 .. row0 + rows + 1];
+    if (@TypeOf(trace) == void) {
+        try model.prefill(stream, hidden_rows, labels);
+    } else {
+        trace.begin(row0, rows);
+        try model.prefillTraced(stream, hidden_rows, labels, trace);
+        trace.end();
+    }
+}
+
+fn runSchedule(model: *tower.Model, stream: cuda.Stream, dev: cuda.DeviceBuffer, frames: []const Frame, schedule: Schedule, trace: anytype, f: Finals) !void {
+    const p = model.impl;
+    try model.reset(stream, &.{}, 0);
+    var row: usize = 0;
+    for (prefix_chunks) |c| {
+        try call(model, stream, dev, frames, row, c, trace);
+        try p.output_hidden.download(0, std.mem.sliceAsBytes(f.prefix_hidden[row * width .. (row + c) * width]));
+        row += c;
+    }
+    for (0..layer_count) |layer| for (0..2) |which| {
+        try p.cache.download(cacheOffset(layer, which, 0), std.mem.sliceAsBytes(f.prefixKvRows(layer, which)));
+    };
+    switch (schedule) {
+        .batch => {
+            try call(model, stream, dev, frames, prefix_rows, suffix, trace);
+            try p.output_hidden.download(0, std.mem.sliceAsBytes(f.hidden));
+            try head(p, stream, suffix - 1, f.head);
+        },
+        .streaming => {
+            for (0..suffix) |i| {
+                try call(model, stream, dev, frames, prefix_rows + i, 1, trace);
+                try p.output_hidden.download(0, std.mem.sliceAsBytes(f.hidden[i * width .. (i + 1) * width]));
+            }
+            try head(p, stream, 0, f.head);
+        },
+    }
+    for (0..layer_count) |layer| for (0..2) |which| {
+        try p.cache.download(cacheOffset(layer, which, prefix_rows), std.mem.sliceAsBytes(f.kvRows(layer, which)));
+    };
+}
+
+fn hashBuffer(hash: *Sha256, buffer: cuda.DeviceBuffer, host: []u8) !void {
+    var offset: usize = 0;
+    while (offset < buffer.len) {
+        const n = @min(host.len, buffer.len - offset);
+        try buffer.download(offset, host[0..n]);
+        hash.update(host[0..n]);
+        offset += n;
+    }
+}
+
+/// SHA-256 over every device weight the tower reads: each layer's buffers in field order, the nine heads, the
+/// codebook embedding table.
+fn weightDigest(p: *Impl, host: []u8) ![64]u8 {
+    var hash = Sha256.init(.{});
+    for (p.layers) |layer_weights| {
+        inline for (@typeInfo(LayerWeights).@"struct".field_names) |name| try hashBuffer(&hash, @field(layer_weights, name), host);
+    }
+    for (p.heads) |h| try hashBuffer(&hash, h, host);
+    try hashBuffer(&hash, p.embeddings, host);
+    return std.fmt.bytesToHex(hash.finalResult(), .lower);
+}
+
+fn differences(a: []const u16, b: []const u16) usize {
+    var count: usize = 0;
+    for (a, b) |x, y| {
+        if (x != y) count += 1;
+    }
+    return count;
+}
+
+fn nonfiniteBf16(values: []const u16) usize {
+    var count: usize = 0;
+    for (values) |bits| {
+        if ((bits & 0x7f80) == 0x7f80) count += 1;
+    }
+    return count;
+}
+
+fn sha256Hex(bytes: []const u8) [64]u8 {
+    var out: [32]u8 = undefined;
+    Sha256.hash(bytes, &out, .{});
+    return std.fmt.bytesToHex(out, .lower);
+}
+
+fn fileSha256(gpa: Allocator, io: std.Io, path: []const u8) ![64]u8 {
+    const file = try std.Io.Dir.openFileAbsolute(io, path, .{});
+    defer file.close(io);
+    const buffer = try gpa.alloc(u8, 1 << 20);
+    defer gpa.free(buffer);
+    var hash = Sha256.init(.{});
+    var offset: u64 = 0;
+    while (true) {
+        const got = try file.readPositionalAll(io, buffer, offset);
+        hash.update(buffer[0..got]);
+        offset += got;
+        if (got < buffer.len) break;
+    }
+    return std.fmt.bytesToHex(hash.finalResult(), .lower);
+}
+
+fn readExact(io: std.Io, path: []const u8, bytes: []u8) !void {
+    const file = try std.Io.Dir.cwd().openFile(io, path, .{});
+    defer file.close(io);
+    if (try file.length(io) != bytes.len or try file.readPositionalAll(io, bytes, 0) != bytes.len) return error.BadFixtureLength;
+}
+
+fn jsonString(list: *std.ArrayList(u8), gpa: Allocator, s: []const u8) !void {
+    try list.append(gpa, '"');
+    for (s) |c| switch (c) {
+        '"', '\\' => {
+            try list.append(gpa, '\\');
+            try list.append(gpa, c);
+        },
+        0...0x1f => try list.print(gpa, "\\u{x:0>4}", .{c}),
+        else => try list.append(gpa, c),
+    };
+    try list.append(gpa, '"');
+}
+
+/// Writes one BF16 array as a new file and appends `"file": .., "sha256": .., "shape": [r, c], "nonfinite": n`.
+fn emitFields(gpa: Allocator, io: std.Io, dir: std.Io.Dir, json: *std.ArrayList(u8), name: []const u8, data: []const u16, rows: usize, cols: usize, errors: *Errors) !usize {
+    const bytes = std.mem.sliceAsBytes(data);
+    try dir.writeFile(io, .{ .sub_path = name, .data = bytes, .flags = .{ .exclusive = true } });
+    const bad = nonfiniteBf16(data);
+    if (bad != 0) try errors.add("{s}: {d} nonfinite values", .{ name, bad });
+    const sha = sha256Hex(bytes);
+    try json.print(gpa, "\"file\": \"{s}\", \"sha256\": \"{s}\", \"shape\": [{d}, {d}], \"nonfinite\": {d}", .{ name, sha[0..], rows, cols, bad });
+    return bytes.len;
+}
+
+fn emitKeyed(gpa: Allocator, io: std.Io, dir: std.Io.Dir, json: *std.ArrayList(u8), key: []const u8, name: []const u8, data: []const u16, rows: usize, cols: usize, errors: *Errors) !usize {
+    try json.print(gpa, "\"{s}\": {{", .{key});
+    const written = try emitFields(gpa, io, dir, json, name, data, rows, cols, errors);
+    try json.appendSlice(gpa, "}");
+    return written;
+}
+
+fn emitFinals(gpa: Allocator, io: std.Io, dir: std.Io.Dir, json: *std.ArrayList(u8), schedule: Schedule, f: Finals, errors: *Errors) !usize {
+    const s = @tagName(schedule);
+    var name_buffer: [96]u8 = undefined;
+    var written: usize = 0;
+    try json.appendSlice(gpa, "{");
+    written += try emitKeyed(gpa, io, dir, json, "hidden", try std.fmt.bufPrint(&name_buffer, "native-{s}-hidden.bf16", .{s}), f.hidden, suffix, width, errors);
+    try json.appendSlice(gpa, ", ");
+    written += try emitKeyed(gpa, io, dir, json, "head9", try std.fmt.bufPrint(&name_buffer, "native-{s}-head9.bf16", .{s}), f.head, 1, vocab, errors);
+    try json.appendSlice(gpa, ", ");
+    written += try emitKeyed(gpa, io, dir, json, "prefix_hidden", try std.fmt.bufPrint(&name_buffer, "native-{s}-prefix-hidden.bf16", .{s}), f.prefix_hidden, prefix_rows, width, errors);
+    try json.appendSlice(gpa, ", \"kv\": {");
+    for (0..layer_count) |layer| for ([_][]const u8{ "keys", "values" }, 0..) |kind, which| {
+        var key_buffer: [32]u8 = undefined;
+        const key = try std.fmt.bufPrint(&key_buffer, "layer-{d:0>2}-{s}", .{ layer, kind });
+        if (layer != 0 or which != 0) try json.appendSlice(gpa, ", ");
+        written += try emitKeyed(gpa, io, dir, json, key, try std.fmt.bufPrint(&name_buffer, "native-{s}-layer-{d:0>2}-{s}.bf16", .{ s, layer, kind }), f.kvRows(layer, which), suffix, kv_width, errors);
+    };
+    try json.appendSlice(gpa, "}, \"prefix_kv\": {");
+    for (0..layer_count) |layer| for ([_][]const u8{ "keys", "values" }, 0..) |kind, which| {
+        var key_buffer: [32]u8 = undefined;
+        const key = try std.fmt.bufPrint(&key_buffer, "layer-{d:0>2}-{s}", .{ layer, kind });
+        if (layer != 0 or which != 0) try json.appendSlice(gpa, ", ");
+        written += try emitKeyed(gpa, io, dir, json, key, try std.fmt.bufPrint(&name_buffer, "native-{s}-prefix-layer-{d:0>2}-{s}.bf16", .{ s, layer, kind }), f.prefixKvRows(layer, which), prefix_rows, kv_width, errors);
+    };
+    try json.appendSlice(gpa, "}}");
+    return written;
+}
+
+/// The stage files of one schedule: batch all 188 rows, streaming its 7 suffix rows.
+fn emitStages(gpa: Allocator, io: std.Io, dir: std.Io.Dir, json: *std.ArrayList(u8), schedule: Schedule, store: *const Store, errors: *Errors) !usize {
+    const row0: usize = if (schedule == .batch) 0 else prefix_rows;
+    const n: usize = total_rows - row0;
+    var name_buffer: [96]u8 = undefined;
+    var written: usize = 0;
+    var first = true;
+    try json.appendSlice(gpa, "[");
+    for (0..layer_count) |layer| for (stages, 0..) |stage, k| {
+        if (!Store.captured(layer, k)) continue;
+        try json.print(gpa, "{s}\n      {{\"layer\": {d}, \"stage\": \"{s}\", \"row0\": {d}, ", .{ if (first) "" else ",", layer, @tagName(stage), row0 });
+        first = false;
+        const name = try std.fmt.bufPrint(&name_buffer, "native-{s}-layer-{d:0>2}-{s}.bf16", .{ @tagName(schedule), layer, @tagName(stage) });
+        written += try emitFields(gpa, io, dir, json, name, store.rows(layer, k, row0, n), n, tower.stageWidth(stage), errors);
+        try json.appendSlice(gpa, "}");
+    };
+    try json.appendSlice(gpa, "]");
+    return written;
+}
+
+fn checkTracer(t: *const Tracer, label: []const u8, expected_calls: usize, errors: *Errors) !void {
+    if (t.calls != expected_calls or t.out_of_order != 0 or t.incomplete_calls != 0 or t.bad_rows != 0 or t.duplicate_rows != 0)
+        try errors.add("{s}: calls {d} (expected {d}), out of order {d}, incomplete calls {d}, bad rows {d}, duplicate rows {d}", .{
+            label, t.calls, expected_calls, t.out_of_order, t.incomplete_calls, t.bad_rows, t.duplicate_rows,
+        });
+    if (t.compare_differences != 0) try errors.add("{s}: {d} captured values differ from the first traced run", .{ label, t.compare_differences });
+}
+
+fn uncovered(store: *const Store) usize {
+    var count: usize = 0;
+    for (0..layer_count) |layer| for (0..stage_count) |k| {
+        for (store.coverage[layer][k]) |c| {
+            if (c != 1) count += 1;
+        }
+    };
+    return count;
+}
+
+/// Layer-12 output and every layer's key / value captures equal the exported hidden and KV rows.
+fn consistency(store: *const Store, f: Finals) usize {
+    const output = @backingInt(Stage.output);
+    const key = @backingInt(Stage.key);
+    const value = @backingInt(Stage.value);
+    var count = differences(store.rows(layer_count - 1, output, 0, prefix_rows), f.prefix_hidden) +
+        differences(store.rows(layer_count - 1, output, prefix_rows, suffix), f.hidden);
+    for (0..layer_count) |layer| {
+        count += differences(store.rows(layer, key, 0, prefix_rows), f.prefixKvRows(layer, 0));
+        count += differences(store.rows(layer, value, 0, prefix_rows), f.prefixKvRows(layer, 1));
+        count += differences(store.rows(layer, key, prefix_rows, suffix), f.kvRows(layer, 0));
+        count += differences(store.rows(layer, value, prefix_rows, suffix), f.kvRows(layer, 1));
+    }
+    return count;
+}
+
+pub fn main(init: std.process.Init) !u8 {
+    const gpa = init.gpa;
+    const io = init.io;
+    const arena = init.arena.allocator();
+    const args = try init.minimal.args.toSlice(arena);
+    if (args.len != 5) {
+        std.debug.print("usage: tf-drama-tower-context-trace CHECKPOINT HIDDEN.bf16 FRAMES.u32le OUTPUT_DIRECTORY\n", .{});
+        return 2;
+    }
+    if (builtin.cpu.arch.endian() != .little) return error.UnsupportedHostEndian;
+    const out = try std.Io.Dir.cwd().openDir(io, args[4], .{});
+    defer out.close(io);
+
+    // Every input is read before any CUDA call.
+    const hidden = try arena.alloc(u16, fixture_hidden_rows * width);
+    var frames: [fixture_frame_rows]Frame = undefined;
+    try readExact(io, args[2], std.mem.sliceAsBytes(hidden));
+    try readExact(io, args[3], std.mem.sliceAsBytes(&frames));
+    const hidden_sha = sha256Hex(std.mem.sliceAsBytes(hidden));
+    const frames_sha = sha256Hex(std.mem.sliceAsBytes(&frames));
+    for (hidden) |bits| if ((bits & 0x7f80) == 0x7f80) return error.NonfiniteFixtureHidden;
+
+    var stores: [schedules.len]Store = undefined;
+    for (&stores) |*store| store.* = try Store.alloc(arena);
+    var finals: [schedules.len][3]Finals = undefined; // traced, untraced, repeat
+    for (&finals) |*per| for (per) |*f| {
+        f.* = try Finals.alloc(arena);
+    };
+    const device_check = try arena.alloc(u16, fixture_hidden_rows * width);
+    const host_chunk = try gpa.alloc(u8, 64 << 20);
+    defer gpa.free(host_chunk);
+
+    var errors: Errors = .{ .gpa = gpa };
+    defer errors.json.deinit(gpa);
+
+    _ = try cuda.setAllocationLimit(54 * (1 << 30));
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    var model = try tower.Model.init(gpa, io, &ctx, args[1], "", .{ .context = context, .max_rows = max_rows });
+    defer model.deinit();
+    const p = model.impl;
+    if (p.plans.items.len != max_rows * projection_count or p.head_logits.len != vocab * 2 or p.output_hidden.len != max_rows * width * 2 or
+        p.cache.len != layer_count * 2 * context * kv_width * 2) return error.UnexpectedTowerLayout;
+    const model_usage = cuda.usage(false);
+    const weights_before = try weightDigest(p, host_chunk);
+    var device_hidden = try cuda.DeviceBuffer.alloc(&driver, fixture_hidden_rows * width * 2);
+    defer device_hidden.free();
+    try device_hidden.upload(0, std.mem.sliceAsBytes(hidden));
+    var staging = try cuda.HostBuffer.alloc(&driver, max_rows * max_stage_width * 2);
+    defer staging.free();
+
+    var schedule_json: std.ArrayList(u8) = .empty;
+    defer schedule_json.deinit(gpa);
+    var written: usize = 0;
+    for (schedules, 0..) |schedule, si| {
+        const label = @tagName(schedule);
+        const expected_calls = prefix_chunks.len + @as(usize, if (schedule == .batch) 1 else suffix);
+        var traced: Tracer = .{ .store = &stores[si], .compare = false, .staging = staging.bytes };
+        try runSchedule(&model, stream, device_hidden, &frames, schedule, &traced, finals[si][0]);
+        try runSchedule(&model, stream, device_hidden, &frames, schedule, {}, finals[si][1]);
+        try p.cache.fill8(0xff, stream.handle);
+        try stream.synchronize();
+        var again: Tracer = .{ .store = &stores[si], .compare = true, .staging = staging.bytes };
+        try runSchedule(&model, stream, device_hidden, &frames, schedule, &again, finals[si][2]);
+        try checkTracer(&traced, label, expected_calls, &errors);
+        try checkTracer(&again, label, expected_calls, &errors);
+        const missing = uncovered(&stores[si]);
+        if (missing != 0) try errors.add("{s}: {d} stage rows not written exactly once", .{ label, missing });
+        const untraced_diff = compareFinals(finals[si][0], finals[si][1]);
+        const repeat_diff = compareFinals(finals[si][0], finals[si][2]);
+        if (!zero(untraced_diff)) try errors.add("{s}: traced vs untraced finals differ hidden {d} head9 {d} kv {d} prefix_hidden {d} prefix_kv {d}", .{ label, untraced_diff.hidden, untraced_diff.head9, untraced_diff.kv, untraced_diff.prefix_hidden, untraced_diff.prefix_kv });
+        if (!zero(repeat_diff)) try errors.add("{s}: traced vs poisoned repeat finals differ hidden {d} head9 {d} kv {d} prefix_hidden {d} prefix_kv {d}", .{ label, repeat_diff.hidden, repeat_diff.head9, repeat_diff.kv, repeat_diff.prefix_hidden, repeat_diff.prefix_kv });
+        const inconsistent = consistency(&stores[si], finals[si][0]);
+        if (inconsistent != 0) try errors.add("{s}: {d} layer-12 output or key/value capture values differ from the exported hidden/KV", .{ label, inconsistent });
+
+        try schedule_json.print(gpa, "{s}\n    \"{s}\": {{\"calls\": [", .{ if (si == 0) "" else ",", label });
+        var row: usize = 0;
+        for (0..expected_calls) |c| {
+            const rows: usize = if (c < prefix_chunks.len) prefix_chunks[c] else if (schedule == .batch) suffix else 1;
+            try schedule_json.print(gpa, "{s}{{\"row0\": {d}, \"rows\": {d}}}", .{ if (c == 0) "" else ", ", row, rows });
+            row += rows;
+        }
+        try schedule_json.print(gpa, "], \"trace\": {{\"calls\": {d}, \"captures_per_call\": {d}, \"out_of_order\": {d}, \"incomplete_calls\": {d}," ++
+            " \"bad_rows\": {d}, \"duplicate_rows\": {d}, \"uncovered_rows\": {d}, \"repeat_capture_differences\": {d}, \"repeat_calls\": {d}," ++
+            " \"repeat_out_of_order\": {d}}}, \"output_kv_capture_inconsistencies\": {d}, \"traced_vs_untraced\": ", .{
+            traced.calls,              captures_per_call, traced.out_of_order, traced.incomplete_calls, traced.bad_rows, traced.duplicate_rows, missing,
+            again.compare_differences, again.calls,       again.out_of_order,  inconsistent,
+        });
+        try printDiff(&schedule_json, gpa, untraced_diff);
+        try schedule_json.appendSlice(gpa, ", \"traced_vs_repeat\": ");
+        try printDiff(&schedule_json, gpa, repeat_diff);
+        try schedule_json.appendSlice(gpa, ", \"finals\": ");
+        written += try emitFinals(gpa, io, out, &schedule_json, schedule, finals[si][0], &errors);
+        try schedule_json.appendSlice(gpa, ", \"stages\": ");
+        written += try emitStages(gpa, io, out, &schedule_json, schedule, &stores[si], &errors);
+        try schedule_json.appendSlice(gpa, "}");
+        std.debug.print("{s}: calls={d} untraced_diff={d}/{d}/{d} repeat_capture_diff={d} uncovered={d}\n", .{
+            label, traced.calls, untraced_diff.hidden, untraced_diff.head9, untraced_diff.kv, again.compare_differences, missing,
+        });
+    }
+
+    // The streaming prefix calls are the batch prefix calls: finals and every stage row must be identical.
+    const bi = @backingInt(Schedule.batch);
+    const st = @backingInt(Schedule.streaming);
+    const prefix_finals = .{ differences(finals[bi][0].prefix_hidden, finals[st][0].prefix_hidden), differences(finals[bi][0].prefix_kv, finals[st][0].prefix_kv) };
+    var prefix_stage_differences: usize = 0;
+    for (0..layer_count) |layer| for (0..stage_count) |k| {
+        if (Store.captured(layer, k)) prefix_stage_differences += differences(stores[bi].rows(layer, k, 0, prefix_rows), stores[st].rows(layer, k, 0, prefix_rows));
+    };
+    if (prefix_finals[0] != 0 or prefix_finals[1] != 0 or prefix_stage_differences != 0)
+        try errors.add("streaming prefix differs from batch: hidden {d} kv {d} stage values {d}", .{ prefix_finals[0], prefix_finals[1], prefix_stage_differences });
+
+    try device_hidden.download(0, std.mem.sliceAsBytes(device_check));
+    const device_input_differences = differences(device_check, hidden);
+    if (device_input_differences != 0) try errors.add("device input hidden changed in {d} values", .{device_input_differences});
+    const host_hidden_unchanged = std.mem.eql(u8, &sha256Hex(std.mem.sliceAsBytes(hidden)), &hidden_sha);
+    const host_frames_unchanged = std.mem.eql(u8, &sha256Hex(std.mem.sliceAsBytes(&frames)), &frames_sha);
+    if (!host_hidden_unchanged or !host_frames_unchanged) try errors.add("host fixture changed: hidden unchanged {} frames unchanged {}", .{ host_hidden_unchanged, host_frames_unchanged });
+    const weights_after = try weightDigest(p, host_chunk);
+    const weights_unchanged = std.mem.eql(u8, &weights_before, &weights_after);
+    if (!weights_unchanged) try errors.add("device weights changed during the run", .{});
+    const used = cuda.usage(false);
+
+    var binary_json: std.ArrayList(u8) = .empty;
+    defer binary_json.deinit(gpa);
+    if (fileSha256(gpa, io, "/proc/self/exe")) |sha| {
+        try binary_json.print(gpa, "\"{s}\"", .{sha[0..]});
+    } else |err| {
+        std.debug.print("binary hash unavailable: {s}\n", .{@errorName(err)});
+        try binary_json.appendSlice(gpa, "null");
+    }
+    const tower_source_sha = sha256Hex(tower.trace_source);
+    const driver_source_sha = sha256Hex(@embedFile("drama_tower_context_trace.zig"));
+    const kernel_image_sha = sha256Hex(cuda.kernels.drama_tower);
+    if (cuda.kernels.drama_tower.len == 0) try errors.add("embedded drama_tower kernel image is empty", .{});
+    const evidence_valid = errors.count == 0;
+
+    var stage_order: std.ArrayList(u8) = .empty;
+    defer stage_order.deinit(gpa);
+    for (stages, 0..) |stage, k| try stage_order.print(gpa, "{s}{{\"stage\": \"{s}\", \"width\": {d}}}", .{ if (k == 0) "" else ", ", @tagName(stage), tower.stageWidth(stage) });
+
+    var manifest: std.ArrayList(u8) = .empty;
+    defer manifest.deinit(gpa);
+    try manifest.appendSlice(gpa, "{\n  \"schema_version\": 1,\n  \"producer\": \"tf-drama-tower-context-trace\",\n  \"checkpoint\": ");
+    try jsonString(&manifest, gpa, args[1]);
+    try manifest.appendSlice(gpa, ",\n  \"hidden_path\": ");
+    try jsonString(&manifest, gpa, args[2]);
+    try manifest.appendSlice(gpa, ",\n  \"frames_path\": ");
+    try jsonString(&manifest, gpa, args[3]);
+    try manifest.print(gpa, ",\n  \"input_hidden_sha256\": \"{s}\",\n  \"input_frames_sha256\": \"{s}\",\n  \"width\": {d},\n  \"dtype\": \"bf16le\",\n  \"layer_count\": {d}," ++
+        "\n  \"model_options\": {{\"context\": {d}, \"max_rows\": {d}}},\n  \"prefix_rows\": {d},\n  \"prefix_chunks\": [{d}, {d}],\n  \"suffix_rows\": {d},\n  \"total_rows\": {d}," ++
+        "\n  \"stage_order\": [{s}],\n  \"captures_per_call\": {d}," ++
+        "\n  \"row_mapping\": \"stage row r is request position r = fixture row r; input frame frames[r], next-frame label frames[r+1]; batch stage files hold rows 0..187, streaming stage files rows 181..187; shared_input is layer 0 only (the layer-0 mixer extra input)\"," ++
+        "\n  \"column_mapping\": \"qkv in checkpoint order [query 16x256 | gate 16x256 | key 2x256 | value 2x256]; key / value are the layer's cache rows of the call\"," ++
+        "\n  \"repeat_control\": \"KV cache filled with 0xFF before each traced repeat; its captures are compared with the first traced run\"," ++
+        "\n  \"head\": {{\"weight\": \"audio_decoder_mtp.heads.{d}.weight\", \"plan\": \"plans[{d}] (rows 1, kind {d})\", \"input\": \"last suffix row of output_hidden\"}}," ++
+        "\n  \"schedules\": {{{s}\n  }},", .{
+        hidden_sha[0..],     frames_sha[0..], width,       layer_count,
+        context,             max_rows,        prefix_rows, prefix_chunks[0],
+        prefix_chunks[1],    suffix,          total_rows,  stage_order.items,
+        captures_per_call,   head_index,      head_plan,   head_kind,
+        schedule_json.items,
+    });
+    try manifest.print(gpa, "\n  \"streaming_prefix_vs_batch\": {{\"prefix_hidden\": {d}, \"prefix_kv\": {d}, \"stage_values\": {d}}}," ++
+        "\n  \"input_immutable\": {{\"device_hidden_differences\": {d}, \"host_hidden_unchanged\": {}, \"host_frames_unchanged\": {}}}," ++
+        "\n  \"weights\": {{\"sha256_before\": \"{s}\", \"sha256_after\": \"{s}\", \"unchanged\": {}}}," ++
+        "\n  \"allocations\": {{\"cuda_device_bytes_after_init\": {d}, \"cuda_device_bytes\": {d}, \"cuda_device_peak_bytes\": {d}, \"pinned_host_bytes\": {d}}}," ++
+        "\n  \"bytes_written\": {d}," ++
+        "\n  \"binary_sha256\": {s},\n  \"tower_source_sha256\": \"{s}\",\n  \"driver_source_sha256\": \"{s}\",\n  \"tower_kernel_image_sha256\": \"{s}\"," ++
+        "\n  \"evidence_valid\": {},\n  \"errors\": [{s}\n  ]\n}}\n", .{
+        prefix_finals[0],         prefix_finals[1],       prefix_stage_differences,
+        device_input_differences, host_hidden_unchanged,  host_frames_unchanged,
+        weights_before[0..],      weights_after[0..],     weights_unchanged,
+        model_usage.device,       used.device,            used.peak,
+        used.host,                written,                binary_json.items,
+        tower_source_sha[0..],    driver_source_sha[0..], kernel_image_sha[0..],
+        evidence_valid,           errors.json.items,
+    });
+    try out.writeFile(io, .{ .sub_path = "manifest.json", .data = manifest.items, .flags = .{ .exclusive = true } });
+    std.debug.print("bytes_written={d} evidence_valid={} errors={d} cuda_bytes={d} cuda_peak={d}\n", .{
+        written + manifest.items.len, evidence_valid, errors.count, used.device, used.peak,
+    });
+    return if (evidence_valid) 0 else 3;
+}
diff --git a/zig/tests/cuda/drama_tower_head_replay.zig b/zig/tests/cuda/drama_tower_head_replay.zig
new file mode 100644
index 00000000..8390be6f
--- /dev/null
+++ b/zig/tests/cuda/drama_tower_head_replay.zig
@@ -0,0 +1,88 @@
+//! Identical-input codebook-9 head replay on the production tower: diagnostic only, no production hook.
+//! Runs exactly the call drama_tower_oracle.zig used to export native-N-head9.bf16, which is generate()'s
+//! Impl.project(rows = 1, kind = 5): plans[(1 - 1) * projections.len + 5].run on output_hidden row N - 1,
+//! heads[8], head_logits and workspace, all from drama.tower.Model.init with the oracle's options.
+//! usage: tf-drama-tower-head-replay CHECKPOINT INPUT_DIRECTORY OUTPUT_DIRECTORY
+//! INPUT_DIRECTORY holds input-{1,7,128}-{native,reference}.bf16 (N row-major BF16 rows of 2048), prepared and
+//! hash-validated on CPU by the reference side. Each run writes native-op-N-ORIGIN.bf16 (4096 BF16 logits).
+//! The caller owns the GPU lock, admission, process cap and lifetime monitoring.
+const std = @import("std");
+const builtin = @import("builtin");
+const cuda = @import("cuda");
+const drama = @import("drama");
+const max_rows = 128;
+const width = 2048;
+const vocab = 4096;
+const projection_count = 6; // tower.zig `projections.len`
+const head_kind = 5; // tower.zig `projections[5]` = { 4096, hidden }, the codebook head shape
+const head_index = 8; // codebook 9: audio_decoder_mtp.heads.8, the oracle's `p.heads[8]`
+const head_rows = 1; // generate() and the oracle project one row through the head
+const row_counts = [_]usize{ 1, 7, max_rows };
+const origins = [_][]const u8{ "native", "reference" };
+
+fn readExact(io: std.Io, dir: std.Io.Dir, name: []const u8, bytes: []u8) !void {
+    const file = try dir.openFile(io, name, .{});
+    defer file.close(io);
+    if (try file.length(io) != bytes.len or try file.readPositionalAll(io, bytes, 0) != bytes.len) return error.BadFixtureLength;
+}
+
+pub fn main(init: std.process.Init) !u8 {
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    if (args.len != 4) {
+        std.debug.print("usage: tf-drama-tower-head-replay CHECKPOINT INPUT_DIRECTORY OUTPUT_DIRECTORY\n", .{});
+        return 2;
+    }
+    if (builtin.cpu.arch.endian() != .little) return error.UnsupportedHostEndian;
+    var input = try std.Io.Dir.cwd().openDir(init.io, args[2], .{});
+    defer input.close(init.io);
+    var out = try std.Io.Dir.cwd().openDir(init.io, args[3], .{});
+    defer out.close(init.io);
+    var total_rows: usize = 0;
+    for (row_counts) |n| total_rows += n * origins.len;
+    const rows = try init.gpa.alloc(u16, total_rows * width);
+    defer init.gpa.free(rows);
+    var inputs: [row_counts.len][origins.len][]u16 = undefined;
+    var name_buffer: [128]u8 = undefined;
+    // Every input is read before any CUDA call, so a missing or short fixture never touches the device.
+    var offset: usize = 0;
+    for (row_counts, 0..) |n, i| for (origins, 0..) |origin, j| {
+        inputs[i][j] = rows[offset .. offset + n * width];
+        offset += n * width;
+        const name = try std.fmt.bufPrint(&name_buffer, "input-{d}-{s}.bf16", .{ n, origin });
+        try readExact(init.io, input, name, std.mem.sliceAsBytes(inputs[i][j]));
+    };
+    var logits: [vocab]u16 = undefined;
+    var repeated: [vocab]u16 = undefined;
+    _ = try cuda.setAllocationLimit(54 * (1 << 30));
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    // Same options as drama_tower_oracle.zig, so the plan list, weights and buffers are the ones it ran.
+    var tower = try drama.tower.Model.init(init.gpa, init.io, &ctx, args[1], "", .{ .context = max_rows, .max_rows = max_rows });
+    defer tower.deinit();
+    const p = tower.impl;
+    if (p.plans.items.len != max_rows * projection_count or p.head_logits.len != vocab * 2 or p.output_hidden.len != max_rows * width * 2)
+        return error.UnexpectedTowerLayout;
+    const plan = &p.plans.items[(head_rows - 1) * projection_count + head_kind];
+    for (row_counts, 0..) |n, i| for (origins, 0..) |origin, j| {
+        // Full N rows at offset 0 of the production buffer: the head reads row N - 1 at the oracle's address.
+        try p.output_hidden.upload(0, std.mem.sliceAsBytes(inputs[i][j]));
+        for ([_]*[vocab]u16{ &logits, &repeated }) |destination| {
+            // 0xffff is a BF16 NaN: a head that writes nothing cannot pass the CPU-side self-control.
+            try p.head_logits.fill8(0xff, stream.handle);
+            try plan.run(p.output_hidden.ptr + (n - 1) * width * 2, p.heads[head_index].ptr, p.head_logits.ptr, p.workspace.ptr, p.workspace.len, stream.handle);
+            try stream.synchronize();
+            try p.head_logits.download(0, std.mem.sliceAsBytes(destination));
+        }
+        if (!std.mem.eql(u16, &logits, &repeated)) return error.HeadReplayNotReproducible;
+        const name = try std.fmt.bufPrint(&name_buffer, "native-op-{d}-{s}.bf16", .{ n, origin });
+        try out.writeFile(init.io, .{ .sub_path = name, .data = std.mem.sliceAsBytes(&logits) });
+        std.debug.print("head_rows={d} input={s} last_row={d} repeat_bit_exact=true\n", .{ n, origin, n - 1 });
+    };
+    const used = cuda.usage(false);
+    std.debug.print("cuda_bytes={d} pinned_bytes={d}\n", .{ used.device, used.host });
+    return 0;
+}
diff --git a/zig/tests/cuda/drama_tower_linear_replay.zig b/zig/tests/cuda/drama_tower_linear_replay.zig
new file mode 100644
index 00000000..c21911b5
--- /dev/null
+++ b/zig/tests/cuda/drama_tower_linear_replay.zig
@@ -0,0 +1,347 @@
+//! Development diagnostic, not a gate: the production tower's eh_proj projection (layer-0 kind-0 plan,
+//! cuda.cublaslt.Linear, D[m,2048] = X[m,4096] . W[2048,4096]^T, BF16 in/out, FP32 compute) replayed on frozen inputs.
+//!
+//! usage: tf-drama-tower-linear-replay WEIGHT.bf16 BATCH_JOINED.bf16 STREAMING_JOINED.bf16 OUTPUT_DIRECTORY
+//!
+//! WEIGHT.bf16: [2048][4096] layer-0 eh_proj weight bytes (exactly what tower.zig uploads; no transformation).
+//! BATCH_JOINED.bf16: [188][4096] layer-0 `joined` capture of the batch schedule (rows 0..187; calls 128, 53, 7).
+//! STREAMING_JOINED.bf16: [7][4096] layer-0 `joined` capture of the streaming suffix (rows 181..187, one call each).
+//! All three are only read. OUTPUT_DIRECTORY must exist; every file is created exclusively.
+//!
+//! One plan per row count m in 1, 7, 53, 128, built exactly as tower.zig builds plans[(m - 1) * 6 + 0]:
+//! Linear.init(lib, m, 2048, 4096, .bf16, 8 MiB). Cells, each the tower's own call (x at offset 0 of its buffer, the
+//! 8 MiB workspace, the model stream):
+//!   batch-call0 rows 0..127 (m 128), batch-call1 rows 128..180 (m 53), batch-call2 rows 181..187 (m 7),
+//!   streaming-row-181 .. streaming-row-187 (m 1 each).
+//! Every cell runs three times; before each run the output (m rows plus one guard row) and the workspace are filled
+//! with 0xFF. Runs 2 and 3 must equal run 1 bit for bit, the guard row must stay 0xFFFF, every output value must be
+//! finite, and the device input rows and weight must be unchanged afterwards. The chosen algorithm of each plan is
+//! decoded with cublasLtMatmulAlgoConfigGetAttribute (sizes per cublasLt.h). Files: native-replay-CELL.bf16 [m][2048] and
+//! manifest.json (identity, plans, cells, controls). evidence_valid false (exit 3) on any recorded error.
+//! The caller owns the shared GPU lock, admission, process cap and lifetime monitoring.
+const std = @import("std");
+const builtin = @import("builtin");
+const cuda = @import("cuda");
+
+const Allocator = std.mem.Allocator;
+const Sha256 = std.crypto.hash.sha2.Sha256;
+const lt_api = cuda.cublaslt;
+
+const n_out = 2048; // tower.zig projections[0] = { hidden, 2 * hidden }: out 2048
+const k_in = 4096; // in 4096
+const workspace_bytes = 8 << 20; // tower.zig `workspace_bytes`
+const batch_rows = 188;
+const streaming_rows = 7;
+const plan_rows = [_]usize{ 1, 7, 53, 128 };
+const repeats = 3;
+
+const Cell = struct { label: []const u8, streaming: bool, row0: usize, m: usize };
+const cells = [_]Cell{
+    .{ .label = "batch-call0", .streaming = false, .row0 = 0, .m = 128 },
+    .{ .label = "batch-call1", .streaming = false, .row0 = 128, .m = 53 },
+    .{ .label = "batch-call2", .streaming = false, .row0 = 181, .m = 7 },
+    .{ .label = "streaming-row-181", .streaming = true, .row0 = 0, .m = 1 },
+    .{ .label = "streaming-row-182", .streaming = true, .row0 = 1, .m = 1 },
+    .{ .label = "streaming-row-183", .streaming = true, .row0 = 2, .m = 1 },
+    .{ .label = "streaming-row-184", .streaming = true, .row0 = 3, .m = 1 },
+    .{ .label = "streaming-row-185", .streaming = true, .row0 = 4, .m = 1 },
+    .{ .label = "streaming-row-186", .streaming = true, .row0 = 5, .m = 1 },
+    .{ .label = "streaming-row-187", .streaming = true, .row0 = 6, .m = 1 },
+};
+// cublasLtMatmulAlgoConfigAttributes_t (cublasLt.h): id, name, exact storage size in bytes.
+const AlgoAttribute = struct { id: c_int, name: []const u8, size: usize };
+const algo_attributes = [_]AlgoAttribute{
+    .{ .id = 0, .name = "algo_id", .size = 4 },          .{ .id = 1, .name = "tile_id", .size = 4 },
+    .{ .id = 2, .name = "splitk_num", .size = 4 },       .{ .id = 3, .name = "reduction_scheme", .size = 4 },
+    .{ .id = 4, .name = "cta_swizzling", .size = 4 },    .{ .id = 5, .name = "custom_option", .size = 4 },
+    .{ .id = 6, .name = "stages_id", .size = 4 },        .{ .id = 7, .name = "inner_shape_id", .size = 2 },
+    .{ .id = 8, .name = "cluster_shape_id", .size = 2 },
+};
+const AlgoConfigGetAttribute = *const fn (*const lt_api.Algo, c_int, *anyopaque, usize, *usize) callconv(.c) lt_api.Status;
+
+comptime {
+    for (cells) |c| std.debug.assert(c.row0 + c.m <= (if (c.streaming) streaming_rows else batch_rows));
+}
+
+const Errors = struct {
+    gpa: Allocator,
+    json: std.ArrayList(u8) = .empty,
+    count: usize = 0,
+
+    fn add(e: *Errors, comptime f: []const u8, args: anytype) !void {
+        std.debug.print("error: " ++ f ++ "\n", args);
+        try e.json.appendSlice(e.gpa, if (e.count == 0) "\n    \"" else ",\n    \"");
+        try e.json.print(e.gpa, f, args);
+        try e.json.append(e.gpa, '"');
+        e.count += 1;
+    }
+};
+
+fn differences(a: []const u16, b: []const u16) usize {
+    var count: usize = 0;
+    for (a, b) |x, y| {
+        if (x != y) count += 1;
+    }
+    return count;
+}
+
+fn nonfiniteBf16(values: []const u16) usize {
+    var count: usize = 0;
+    for (values) |bits| {
+        if ((bits & 0x7f80) == 0x7f80) count += 1;
+    }
+    return count;
+}
+
+fn sha256Hex(bytes: []const u8) [64]u8 {
+    var out: [32]u8 = undefined;
+    Sha256.hash(bytes, &out, .{});
+    return std.fmt.bytesToHex(out, .lower);
+}
+
+fn fileSha256(gpa: Allocator, io: std.Io, path: []const u8) ![64]u8 {
+    const file = try std.Io.Dir.openFileAbsolute(io, path, .{});
+    defer file.close(io);
+    const buffer = try gpa.alloc(u8, 1 << 20);
+    defer gpa.free(buffer);
+    var hash = Sha256.init(.{});
+    var offset: u64 = 0;
+    while (true) {
+        const got = try file.readPositionalAll(io, buffer, offset);
+        hash.update(buffer[0..got]);
+        offset += got;
+        if (got < buffer.len) break;
+    }
+    return std.fmt.bytesToHex(hash.finalResult(), .lower);
+}
+
+fn readExact(io: std.Io, path: []const u8, bytes: []u8) !void {
+    const file = try std.Io.Dir.cwd().openFile(io, path, .{});
+    defer file.close(io);
+    if (try file.length(io) != bytes.len or try file.readPositionalAll(io, bytes, 0) != bytes.len) return error.BadInputLength;
+}
+
+fn jsonString(list: *std.ArrayList(u8), gpa: Allocator, s: []const u8) !void {
+    try list.append(gpa, '"');
+    for (s) |c| switch (c) {
+        '"', '\\' => {
+            try list.append(gpa, '\\');
+            try list.append(gpa, c);
+        },
+        0...0x1f => try list.print(gpa, "\\u{x:0>4}", .{c}),
+        else => try list.append(gpa, c),
+    };
+    try list.append(gpa, '"');
+}
+
+/// The path of the mapped libcublasLt, from /proc/self/maps (after the library was opened).
+fn mappedCublasLt(gpa: Allocator, io: std.Io, out: *std.ArrayList(u8)) !void {
+    const file = try std.Io.Dir.cwd().openFile(io, "/proc/self/maps", .{});
+    defer file.close(io);
+    var buffer: [4096]u8 = undefined;
+    var reader = file.readerStreaming(io, &buffer);
+    const maps = try reader.interface.allocRemaining(gpa, .limited(1 << 24));
+    defer gpa.free(maps);
+    var lines = std.mem.splitScalar(u8, maps, '\n');
+    while (lines.next()) |line| {
+        if (std.mem.indexOf(u8, line, "libcublasLt.so") == null) continue;
+        const slash = std.mem.indexOfScalar(u8, line, '/') orelse continue;
+        try out.appendSlice(gpa, line[slash..]);
+        return;
+    }
+}
+
+pub fn main(init: std.process.Init) !u8 {
+    const gpa = init.gpa;
+    const io = init.io;
+    const arena = init.arena.allocator();
+    const args = try init.minimal.args.toSlice(arena);
+    if (args.len != 5) {
+        std.debug.print("usage: tf-drama-tower-linear-replay WEIGHT.bf16 BATCH_JOINED.bf16 STREAMING_JOINED.bf16 OUTPUT_DIRECTORY\n", .{});
+        return 2;
+    }
+    if (builtin.cpu.arch.endian() != .little) return error.UnsupportedHostEndian;
+    const out = try std.Io.Dir.cwd().openDir(io, args[4], .{});
+    defer out.close(io);
+
+    // Every input is read before any CUDA call.
+    const weight = try arena.alloc(u16, n_out * k_in);
+    const batch = try arena.alloc(u16, batch_rows * k_in);
+    const streaming = try arena.alloc(u16, streaming_rows * k_in);
+    try readExact(io, args[1], std.mem.sliceAsBytes(weight));
+    try readExact(io, args[2], std.mem.sliceAsBytes(batch));
+    try readExact(io, args[3], std.mem.sliceAsBytes(streaming));
+    const weight_sha = sha256Hex(std.mem.sliceAsBytes(weight));
+    const batch_sha = sha256Hex(std.mem.sliceAsBytes(batch));
+    const streaming_sha = sha256Hex(std.mem.sliceAsBytes(streaming));
+    for ([_][]const u16{ weight, batch, streaming }) |values| if (nonfiniteBf16(values) != 0) return error.NonfiniteInput;
+
+    const max_m = 128;
+    const result = try arena.alloc(u16, (max_m + 1) * n_out);
+    const again = try arena.alloc(u16, (max_m + 1) * n_out);
+    const input_check = try arena.alloc(u16, max_m * k_in);
+    const weight_check = try arena.alloc(u16, n_out * k_in);
+
+    var errors: Errors = .{ .gpa = gpa };
+    defer errors.json.deinit(gpa);
+
+    _ = try cuda.setAllocationLimit(54 * (1 << 30));
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    var lt = try lt_api.Library.open();
+    defer lt.close();
+    const get_attribute = lt.lib.lookup(AlgoConfigGetAttribute, "cublasLtMatmulAlgoConfigGetAttribute") orelse return error.MissingSymbol;
+
+    var plans: [plan_rows.len]lt_api.Linear = undefined;
+    var plans_made: usize = 0;
+    defer for (plans[0..plans_made]) |*plan| plan.deinit();
+    for (plan_rows, 0..) |m, i| {
+        plans[i] = try lt_api.Linear.init(&lt, m, n_out, k_in, .bf16, workspace_bytes);
+        plans_made += 1;
+    }
+
+    var device_weight = try cuda.DeviceBuffer.alloc(&driver, n_out * k_in * 2);
+    defer device_weight.free();
+    try device_weight.upload(0, std.mem.sliceAsBytes(weight));
+    var device_x = try cuda.DeviceBuffer.alloc(&driver, max_m * k_in * 2);
+    defer device_x.free();
+    var device_d = try cuda.DeviceBuffer.alloc(&driver, (max_m + 1) * n_out * 2);
+    defer device_d.free();
+    var workspace = try cuda.DeviceBuffer.alloc(&driver, workspace_bytes);
+    defer workspace.free();
+
+    // Plans: the chosen algorithm, decoded.
+    var plans_json: std.ArrayList(u8) = .empty;
+    defer plans_json.deinit(gpa);
+    for (plan_rows, 0..) |m, i| {
+        const plan = &plans[i];
+        try plans_json.print(gpa, "{s}\n    {{\"m\": {d}, \"n\": {d}, \"k\": {d}, \"workspace_need\": {d}, \"workspace_limit\": {d}, \"algo_bytes\": \"", .{
+            if (i == 0) "" else ",", m, n_out, k_in, plan.workspace_need, workspace_bytes,
+        });
+        for (std.mem.asBytes(&plan.algo)) |byte| try plans_json.print(gpa, "{x:0>2}", .{byte});
+        try plans_json.appendSlice(gpa, "\"");
+        for (algo_attributes) |attribute| {
+            var buffer: [8]u8 = @splat(0);
+            var written: usize = 0;
+            const status = get_attribute(&plan.algo, attribute.id, &buffer, attribute.size, &written);
+            if (status != 0 or written != attribute.size) {
+                try errors.add("m {d}: cublasLtMatmulAlgoConfigGetAttribute({s}) status {d} written {d}", .{ m, attribute.name, status, written });
+                try plans_json.print(gpa, ", \"{s}\": null", .{attribute.name});
+            } else {
+                const value: i64 = if (attribute.size == 4) std.mem.readInt(i32, buffer[0..4], .little) else std.mem.readInt(u16, buffer[0..2], .little);
+                try plans_json.print(gpa, ", \"{s}\": {d}", .{ attribute.name, value });
+            }
+        }
+        try plans_json.appendSlice(gpa, "}");
+    }
+
+    var cells_json: std.ArrayList(u8) = .empty;
+    defer cells_json.deinit(gpa);
+    var name_buffer: [96]u8 = undefined;
+    for (cells, 0..) |cell, ci| {
+        const plan_index = std.mem.indexOfScalar(usize, &plan_rows, cell.m) orelse unreachable;
+        const plan = &plans[plan_index];
+        const source = if (cell.streaming) streaming else batch;
+        const x = source[cell.row0 * k_in .. (cell.row0 + cell.m) * k_in];
+        const out_len = cell.m * n_out;
+        var repeat_differences: usize = 0;
+        var guard_broken: usize = 0;
+        var input_changed: usize = 0;
+        var nonfinite: usize = 0;
+        for (0..repeats) |r| {
+            try device_x.upload(0, std.mem.sliceAsBytes(x));
+            try device_d.fill8(0xff, stream.handle);
+            try workspace.fill8(0xff, stream.handle);
+            try plan.run(device_x.ptr, device_weight.ptr, device_d.ptr, workspace.ptr, workspace.len, stream.handle);
+            try stream.synchronize();
+            const target = if (r == 0) result else again;
+            try device_d.download(0, std.mem.sliceAsBytes(target[0 .. out_len + n_out]));
+            for (target[out_len .. out_len + n_out]) |bits| {
+                if (bits != 0xffff) guard_broken += 1;
+            }
+            if (r == 0) nonfinite = nonfiniteBf16(result[0..out_len]) else repeat_differences += differences(result[0..out_len], again[0..out_len]);
+            try device_x.download(0, std.mem.sliceAsBytes(input_check[0 .. cell.m * k_in]));
+            input_changed += differences(input_check[0 .. cell.m * k_in], x);
+        }
+        if (repeat_differences != 0 or guard_broken != 0 or input_changed != 0 or nonfinite != 0)
+            try errors.add("{s}: repeat differences {d}, guard values changed {d}, device input changed {d}, nonfinite {d}", .{
+                cell.label, repeat_differences, guard_broken, input_changed, nonfinite,
+            });
+        const name = try std.fmt.bufPrint(&name_buffer, "native-replay-{s}.bf16", .{cell.label});
+        const bytes = std.mem.sliceAsBytes(result[0..out_len]);
+        try out.writeFile(io, .{ .sub_path = name, .data = bytes, .flags = .{ .exclusive = true } });
+        const sha = sha256Hex(bytes);
+        try cells_json.print(gpa, "{s}\n    {{\"label\": \"{s}\", \"source\": \"{s}\", \"source_row0\": {d}, \"m\": {d}, \"plan_m\": {d}, \"runs\": {d}," ++
+            " \"file\": \"{s}\", \"sha256\": \"{s}\", \"shape\": [{d}, {d}], \"nonfinite\": {d}, \"repeat_differences\": {d}," ++
+            " \"guard_values_changed\": {d}, \"device_input_changed\": {d}}}", .{
+            if (ci == 0) "" else ",", cell.label, if (cell.streaming) "streaming" else "batch", cell.row0, cell.m,    plan_rows[plan_index], repeats,
+            name,                     sha[0..],   cell.m,                                       n_out,     nonfinite, repeat_differences,    guard_broken,
+            input_changed,
+        });
+    }
+
+    try device_weight.download(0, std.mem.sliceAsBytes(weight_check));
+    const device_weight_differences = differences(weight_check, weight);
+    if (device_weight_differences != 0) try errors.add("device weight changed in {d} values", .{device_weight_differences});
+    const host_unchanged = std.mem.eql(u8, &sha256Hex(std.mem.sliceAsBytes(weight)), &weight_sha) and
+        std.mem.eql(u8, &sha256Hex(std.mem.sliceAsBytes(batch)), &batch_sha) and
+        std.mem.eql(u8, &sha256Hex(std.mem.sliceAsBytes(streaming)), &streaming_sha);
+    if (!host_unchanged) try errors.add("host inputs changed", .{});
+    const used = cuda.usage(false);
+
+    var library_path: std.ArrayList(u8) = .empty;
+    defer library_path.deinit(gpa);
+    try mappedCublasLt(gpa, io, &library_path);
+    var library_sha: [64]u8 = @splat('0');
+    if (library_path.items.len == 0) {
+        try errors.add("libcublasLt mapping not found", .{});
+    } else {
+        library_sha = fileSha256(gpa, io, library_path.items) catch |err| blk: {
+            try errors.add("libcublasLt hash failed: {s}", .{@errorName(err)});
+            break :blk library_sha;
+        };
+    }
+    var binary_json: std.ArrayList(u8) = .empty;
+    defer binary_json.deinit(gpa);
+    if (fileSha256(gpa, io, "/proc/self/exe")) |sha| {
+        try binary_json.print(gpa, "\"{s}\"", .{sha[0..]});
+    } else |err| {
+        std.debug.print("binary hash unavailable: {s}\n", .{@errorName(err)});
+        try binary_json.appendSlice(gpa, "null");
+    }
+    const driver_source_sha = sha256Hex(@embedFile("drama_tower_linear_replay.zig"));
+    const evidence_valid = errors.count == 0;
+
+    var manifest: std.ArrayList(u8) = .empty;
+    defer manifest.deinit(gpa);
+    try manifest.appendSlice(gpa, "{\n  \"schema_version\": 1,\n  \"producer\": \"tf-drama-tower-linear-replay\",\n  \"weight_path\": ");
+    try jsonString(&manifest, gpa, args[1]);
+    try manifest.appendSlice(gpa, ",\n  \"batch_joined_path\": ");
+    try jsonString(&manifest, gpa, args[2]);
+    try manifest.appendSlice(gpa, ",\n  \"streaming_joined_path\": ");
+    try jsonString(&manifest, gpa, args[3]);
+    try manifest.appendSlice(gpa, ",\n  \"cublaslt_path\": ");
+    try jsonString(&manifest, gpa, library_path.items);
+    try manifest.print(gpa, ",\n  \"weight_sha256\": \"{s}\",\n  \"batch_joined_sha256\": \"{s}\",\n  \"streaming_joined_sha256\": \"{s}\"," ++
+        "\n  \"operation\": \"cuda.cublaslt.Linear: D[m,{d}] = X[m,{d}] . W[{d},{d}]^T, BF16 A/B/D, compute 32F, scale 32F, transa T, transb N, first heuristic, workspace limit {d}\"," ++
+        "\n  \"cublaslt_version\": {d},\n  \"cublaslt_sha256\": \"{s}\",\n  \"repeats\": {d}," ++
+        "\n  \"plans\": [{s}\n  ],\n  \"cells\": [{s}\n  ]," ++
+        "\n  \"device_weight_differences\": {d},\n  \"host_inputs_unchanged\": {}," ++
+        "\n  \"allocations\": {{\"cuda_device_bytes\": {d}, \"cuda_device_peak_bytes\": {d}}}," ++
+        "\n  \"binary_sha256\": {s},\n  \"driver_source_sha256\": \"{s}\"," ++
+        "\n  \"evidence_valid\": {},\n  \"errors\": [{s}\n  ]\n}}\n", .{
+        weight_sha[0..],             batch_sha[0..],            streaming_sha[0..],     n_out,
+        k_in,                        n_out,                     k_in,                   workspace_bytes,
+        lt.api.cublasLtGetVersion(), library_sha[0..],          repeats,                plans_json.items,
+        cells_json.items,            device_weight_differences, host_unchanged,         used.device,
+        used.peak,                   binary_json.items,         driver_source_sha[0..], evidence_valid,
+        errors.json.items,
+    });
+    try out.writeFile(io, .{ .sub_path = "manifest.json", .data = manifest.items, .flags = .{ .exclusive = true } });
+    std.debug.print("cells={d} evidence_valid={} errors={d}\n", .{ cells.len, evidence_valid, errors.count });
+    return if (evidence_valid) 0 else 3;
+}
diff --git a/zig/tests/cuda/drama_tower_mixer_trace.zig b/zig/tests/cuda/drama_tower_mixer_trace.zig
new file mode 100644
index 00000000..2d5c4205
--- /dev/null
+++ b/zig/tests/cuda/drama_tower_mixer_trace.zig
@@ -0,0 +1,410 @@
+//! Development diagnostic, not a gate: the production tower's mixer operands and outputs on the full-context fixture.
+//!
+//! usage: tf-drama-tower-mixer-trace CHECKPOINT FIXTURE_DIRECTORY OUTPUT_DIRECTORY
+//!
+//! FIXTURE_DIRECTORY is the full-context fixture (hidden.bf16 [309][2048]: 181 prompt rows then 128 suffix rows;
+//! frames.u32le [310][11]; row r uses input frame frames[r] and next-frame label frames[r + 1]); it is only read.
+//! OUTPUT_DIRECTORY must exist; every file is created exclusively. The model is built as tf-drama-tower-context-oracle
+//! builds it (context 512, max_rows 128).
+//!
+//! For each suffix length N in 1, 7, 128, the context oracle's `batch` schedule, twice:
+//!   reset; prefix rows 0..180 untraced in the host's chunks 128 then 53 (setInput(frames[a..b]),
+//!   prefill(hidden[a..b], frames[a+1..b+1])); then the N suffix rows in one call at positions 181..
+//!   1. traced: the suffix call is `Model.prefillTraced` with a tracer that copies, on the model's stream right after
+//!      the producing kernel, only three stages: shared_input (once, Impl.shared after setInput), joined (each layer,
+//!      Impl.joined after drama_mix: [enorm half | hnorm half]) and output (each layer, Impl.output_hidden: the
+//!      layer's final hidden, which is the next layer's mixer hidden input). Other capture points return at once.
+//!   2. untraced: the production `Model.prefill` for the suffix call.
+//! After each run: the suffix final hidden, the codebook-9 head on the last suffix row (rows = 1 plan, heads[8], after
+//! a 0xFF NaN fill) and every layer's N suffix KV rows (cache positions 181..).
+//! Files: native-N-shared_input.bf16 [N][2048], native-N-layer-LL-joined.bf16 [N][4096],
+//! native-N-layer-LL-output.bf16 [N][2048], native-N-{traced,untraced}-{hidden,head9,layer-LL-keys,layer-LL-values}.bf16.
+//!
+//! manifest.json lists every file with shape, SHA-256 and nonfinite count. evidence_valid is false (exit 3) on any
+//! recorded error: a nonfinite capture or output, traced / untraced bit differences, a layer-12 output capture that
+//! differs from the final hidden, a missing or misordered capture, or a mutated input. Bit equality with the frozen
+//! full-context native batch outputs is checked by an external checker.
+//! The caller owns the shared GPU lock, admission, process cap and lifetime monitoring.
+const std = @import("std");
+const builtin = @import("builtin");
+const cuda = @import("cuda");
+const drama = @import("drama");
+
+const Allocator = std.mem.Allocator;
+const tower = drama.tower;
+const Stage = tower.Stage;
+const Frame = tower.Frame;
+const Impl = @typeInfo(@FieldType(tower.Model, "impl")).pointer.child;
+
+const width = 2048;
+const joined_width = 2 * width;
+const kv_width = 512;
+const vocab = 4096;
+const max_rows = 128;
+const context = 512;
+const prefix_rows = 181;
+const suffix_rows = 128;
+const hidden_rows = prefix_rows + suffix_rows;
+const frame_rows = hidden_rows + 1;
+const prefix_chunks = [_]usize{ 128, 53 };
+const row_counts = [_]usize{ 1, 7, suffix_rows };
+const projection_count = 6;
+const head_kind = 5;
+const head_index = 8;
+const head_plan = (1 - 1) * projection_count + head_kind;
+const layer_count = @typeInfo(@FieldType(Impl, "layers")).array.len;
+
+comptime {
+    std.debug.assert(layer_count == 13);
+    std.debug.assert(tower.stageWidth(.joined) == joined_width and tower.stageWidth(.output) == width and tower.stageWidth(.shared_input) == width);
+    var sum: usize = 0;
+    for (prefix_chunks) |c| sum += c;
+    std.debug.assert(sum == prefix_rows and hidden_rows <= context);
+}
+
+const Errors = struct {
+    gpa: Allocator,
+    json: std.ArrayList(u8) = .empty,
+    count: usize = 0,
+
+    fn add(e: *Errors, comptime f: []const u8, args: anytype) !void {
+        std.debug.print("error: " ++ f ++ "\n", args);
+        try e.json.appendSlice(e.gpa, if (e.count == 0) "\n    \"" else ",\n    \"");
+        try e.json.print(e.gpa, f, args);
+        try e.json.append(e.gpa, '"');
+        e.count += 1;
+    }
+};
+
+/// Copies shared_input, every joined and every output of one suffix call; ignores the other capture points.
+const Tracer = struct {
+    n: usize,
+    staging: []align(16) u8,
+    shared: []u16, // [max_rows][width]
+    joined: []u16, // [layer][max_rows][joined_width]
+    output: []u16, // [layer][max_rows][width]
+    shared_seen: usize = 0,
+    joined_seen: [layer_count]usize = @splat(0),
+    output_seen: [layer_count]usize = @splat(0),
+    next_layer: usize = 0, // joined of layer L must come after output of layer L - 1
+    out_of_order: usize = 0,
+    bad_row0: usize = 0,
+
+    pub fn capture(t: *Tracer, stream: cuda.Stream, layer: usize, stage: Stage, src: cuda.DeviceBuffer, row0: usize) !void {
+        const dst: []u16 = switch (stage) {
+            .shared_input => blk: {
+                t.shared_seen += 1;
+                break :blk t.shared[0 .. t.n * width];
+            },
+            .joined => blk: {
+                if (layer != t.next_layer) t.out_of_order += 1;
+                t.joined_seen[layer] += 1;
+                break :blk t.joined[layer * max_rows * joined_width ..][0 .. t.n * joined_width];
+            },
+            .output => blk: {
+                if (layer != t.next_layer) t.out_of_order += 1;
+                t.output_seen[layer] += 1;
+                t.next_layer = layer + 1;
+                break :blk t.output[layer * max_rows * width ..][0 .. t.n * width];
+            },
+            else => return,
+        };
+        if (row0 != prefix_rows) t.bad_row0 += 1;
+        const bytes = std.mem.sliceAsBytes(dst);
+        if (src.len != bytes.len or bytes.len > t.staging.len) return error.TraceCaptureShape;
+        try src.downloadAsync(0, t.staging[0..bytes.len], stream.handle);
+        try stream.synchronize();
+        @memcpy(bytes, t.staging[0..bytes.len]);
+    }
+};
+
+const Finals = struct {
+    hidden: []u16,
+    head: []u16,
+    kv: []u16, // [layer][keys, values][n][kv_width]
+
+    fn alloc(arena: Allocator) !Finals {
+        return .{ .hidden = try arena.alloc(u16, max_rows * width), .head = try arena.alloc(u16, vocab), .kv = try arena.alloc(u16, layer_count * 2 * max_rows * kv_width) };
+    }
+
+    fn kvRows(f: Finals, n: usize, layer: usize, which: usize) []u16 {
+        const at = (layer * 2 + which) * n * kv_width;
+        return f.kv[at .. at + n * kv_width];
+    }
+};
+
+fn view(buffer: cuda.DeviceBuffer, offset: usize, len: usize) cuda.DeviceBuffer {
+    std.debug.assert(offset <= buffer.len and len <= buffer.len - offset);
+    return .{ .d = buffer.d, .ptr = buffer.ptr + offset, .len = len, .borrowed = true };
+}
+
+fn cacheOffset(layer: usize, which: usize, row: usize) usize {
+    return ((layer * 2 + which) * context + row) * kv_width * 2;
+}
+
+/// The context oracle's batch schedule; the suffix call is traced when `trace` is not void.
+fn runBatch(model: *tower.Model, stream: cuda.Stream, dev: cuda.DeviceBuffer, frames: []const Frame, n: usize, trace: anytype, f: Finals) !void {
+    const p = model.impl;
+    try model.reset(stream, &.{}, 0);
+    var row: usize = 0;
+    for (prefix_chunks) |c| {
+        _ = try model.setInput(stream, frames[row .. row + c]);
+        try model.prefill(stream, view(dev, row * width * 2, c * width * 2), frames[row + 1 .. row + c + 1]);
+        row += c;
+    }
+    const a = prefix_rows;
+    _ = try model.setInput(stream, frames[a .. a + n]);
+    if (@TypeOf(trace) == void)
+        try model.prefill(stream, view(dev, a * width * 2, n * width * 2), frames[a + 1 .. a + n + 1])
+    else
+        try model.prefillTraced(stream, view(dev, a * width * 2, n * width * 2), frames[a + 1 .. a + n + 1], trace);
+    try p.output_hidden.download(0, std.mem.sliceAsBytes(f.hidden[0 .. n * width]));
+    try p.head_logits.fill8(0xff, stream.handle);
+    try p.plans.items[head_plan].run(p.output_hidden.ptr + (n - 1) * width * 2, p.heads[head_index].ptr, p.head_logits.ptr, p.workspace.ptr, p.workspace.len, stream.handle);
+    try stream.synchronize();
+    try p.head_logits.download(0, std.mem.sliceAsBytes(f.head));
+    for (0..layer_count) |layer| for (0..2) |which| {
+        try p.cache.download(cacheOffset(layer, which, prefix_rows), std.mem.sliceAsBytes(f.kvRows(n, layer, which)));
+    };
+}
+
+fn differences(a: []const u16, b: []const u16) usize {
+    var count: usize = 0;
+    for (a, b) |x, y| {
+        if (x != y) count += 1;
+    }
+    return count;
+}
+
+fn nonfiniteBf16(values: []const u16) usize {
+    var count: usize = 0;
+    for (values) |bits| {
+        if ((bits & 0x7f80) == 0x7f80) count += 1;
+    }
+    return count;
+}
+
+fn sha256Hex(bytes: []const u8) [64]u8 {
+    var out: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(bytes, &out, .{});
+    return std.fmt.bytesToHex(out, .lower);
+}
+
+fn fileSha256(gpa: Allocator, io: std.Io, path: []const u8) ![64]u8 {
+    const file = try std.Io.Dir.openFileAbsolute(io, path, .{});
+    defer file.close(io);
+    const buffer = try gpa.alloc(u8, 1 << 20);
+    defer gpa.free(buffer);
+    var hash = std.crypto.hash.sha2.Sha256.init(.{});
+    var offset: u64 = 0;
+    while (true) {
+        const got = try file.readPositionalAll(io, buffer, offset);
+        hash.update(buffer[0..got]);
+        offset += got;
+        if (got < buffer.len) break;
+    }
+    return std.fmt.bytesToHex(hash.finalResult(), .lower);
+}
+
+fn readExact(io: std.Io, dir: std.Io.Dir, name: []const u8, bytes: []u8) !void {
+    const file = try dir.openFile(io, name, .{});
+    defer file.close(io);
+    if (try file.length(io) != bytes.len or try file.readPositionalAll(io, bytes, 0) != bytes.len) return error.BadFixtureLength;
+}
+
+fn jsonString(list: *std.ArrayList(u8), gpa: Allocator, s: []const u8) !void {
+    try list.append(gpa, '"');
+    for (s) |c| switch (c) {
+        '"', '\\' => {
+            try list.append(gpa, '\\');
+            try list.append(gpa, c);
+        },
+        0...0x1f => try list.print(gpa, "\\u{x:0>4}", .{c}),
+        else => try list.append(gpa, c),
+    };
+    try list.append(gpa, '"');
+}
+
+/// Writes one BF16 array as a new file; appends `{"file", "sha256", "shape", "nonfinite"}` (with a leading key).
+fn emit(gpa: Allocator, io: std.Io, dir: std.Io.Dir, json: *std.ArrayList(u8), key: []const u8, name: []const u8, data: []const u16, rows: usize, cols: usize, errors: *Errors) !usize {
+    const bytes = std.mem.sliceAsBytes(data);
+    try dir.writeFile(io, .{ .sub_path = name, .data = bytes, .flags = .{ .exclusive = true } });
+    const bad = nonfiniteBf16(data);
+    if (bad != 0) try errors.add("{s}: {d} nonfinite values", .{ name, bad });
+    const sha = sha256Hex(bytes);
+    try json.print(gpa, "\"{s}\": {{\"file\": \"{s}\", \"sha256\": \"{s}\", \"shape\": [{d}, {d}], \"nonfinite\": {d}}}", .{ key, name, sha[0..], rows, cols, bad });
+    return bytes.len;
+}
+
+fn emitFinals(gpa: Allocator, io: std.Io, dir: std.Io.Dir, json: *std.ArrayList(u8), n: usize, label: []const u8, f: Finals, errors: *Errors) !usize {
+    var name_buffer: [96]u8 = undefined;
+    var written: usize = 0;
+    try json.print(gpa, "\"{s}\": {{", .{label});
+    var name = try std.fmt.bufPrint(&name_buffer, "native-{d}-{s}-hidden.bf16", .{ n, label });
+    written += try emit(gpa, io, dir, json, "hidden", name, f.hidden[0 .. n * width], n, width, errors);
+    try json.appendSlice(gpa, ", ");
+    name = try std.fmt.bufPrint(&name_buffer, "native-{d}-{s}-head9.bf16", .{ n, label });
+    written += try emit(gpa, io, dir, json, "head9", name, f.head, 1, vocab, errors);
+    try json.appendSlice(gpa, ", \"kv\": {");
+    for (0..layer_count) |layer| for ([_][]const u8{ "keys", "values" }, 0..) |kind, which| {
+        var key_buffer: [32]u8 = undefined;
+        const key = try std.fmt.bufPrint(&key_buffer, "layer-{d:0>2}-{s}", .{ layer, kind });
+        name = try std.fmt.bufPrint(&name_buffer, "native-{d}-{s}-layer-{d:0>2}-{s}.bf16", .{ n, label, layer, kind });
+        if (layer != 0 or which != 0) try json.appendSlice(gpa, ", ");
+        written += try emit(gpa, io, dir, json, key, name, f.kvRows(n, layer, which), n, kv_width, errors);
+    };
+    try json.appendSlice(gpa, "}}");
+    return written;
+}
+
+pub fn main(init: std.process.Init) !u8 {
+    const gpa = init.gpa;
+    const io = init.io;
+    const arena = init.arena.allocator();
+    const args = try init.minimal.args.toSlice(arena);
+    if (args.len != 4) {
+        std.debug.print("usage: tf-drama-tower-mixer-trace CHECKPOINT FIXTURE_DIRECTORY OUTPUT_DIRECTORY\n", .{});
+        return 2;
+    }
+    if (builtin.cpu.arch.endian() != .little) return error.UnsupportedHostEndian;
+    const fixture = try std.Io.Dir.cwd().openDir(io, args[2], .{});
+    defer fixture.close(io);
+    const out = try std.Io.Dir.cwd().openDir(io, args[3], .{});
+    defer out.close(io);
+
+    const hidden = try arena.alloc(u16, hidden_rows * width);
+    var frames: [frame_rows]Frame = undefined;
+    try readExact(io, fixture, "hidden.bf16", std.mem.sliceAsBytes(hidden));
+    try readExact(io, fixture, "frames.u32le", std.mem.sliceAsBytes(&frames));
+    const hidden_sha = sha256Hex(std.mem.sliceAsBytes(hidden));
+    const frames_sha = sha256Hex(std.mem.sliceAsBytes(&frames));
+    for (hidden) |bits| if ((bits & 0x7f80) == 0x7f80) return error.NonfiniteFixtureHidden;
+
+    const traced = try Finals.alloc(arena);
+    const untraced = try Finals.alloc(arena);
+    const shared = try arena.alloc(u16, max_rows * width);
+    const joined = try arena.alloc(u16, layer_count * max_rows * joined_width);
+    const output = try arena.alloc(u16, layer_count * max_rows * width);
+    const device_check = try arena.alloc(u16, hidden_rows * width);
+
+    var errors: Errors = .{ .gpa = gpa };
+    defer errors.json.deinit(gpa);
+
+    _ = try cuda.setAllocationLimit(54 * (1 << 30));
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    var model = try tower.Model.init(gpa, io, &ctx, args[1], "", .{ .context = context, .max_rows = max_rows });
+    defer model.deinit();
+    const p = model.impl;
+    if (p.plans.items.len != max_rows * projection_count or p.head_logits.len != vocab * 2 or p.output_hidden.len != max_rows * width * 2 or
+        p.joined.len != max_rows * joined_width * 2 or p.cache.len != layer_count * 2 * context * kv_width * 2) return error.UnexpectedTowerLayout;
+    const model_usage = cuda.usage(false);
+    var device_hidden = try cuda.DeviceBuffer.alloc(&driver, hidden_rows * width * 2);
+    defer device_hidden.free();
+    try device_hidden.upload(0, std.mem.sliceAsBytes(hidden));
+    var staging = try cuda.HostBuffer.alloc(&driver, max_rows * joined_width * 2);
+    defer staging.free();
+
+    var cases: std.ArrayList(u8) = .empty;
+    defer cases.deinit(gpa);
+    var written: usize = 0;
+    var name_buffer: [96]u8 = undefined;
+    for (row_counts, 0..) |n, case_index| {
+        var tracer: Tracer = .{ .n = n, .staging = staging.bytes, .shared = shared, .joined = joined, .output = output };
+        try runBatch(&model, stream, device_hidden, &frames, n, &tracer, traced);
+        try runBatch(&model, stream, device_hidden, &frames, n, {}, untraced);
+
+        if (tracer.shared_seen != 1 or tracer.out_of_order != 0 or tracer.bad_row0 != 0)
+            try errors.add("rows {d}: shared_input captures {d}, out of order {d}, bad row0 {d}", .{ n, tracer.shared_seen, tracer.out_of_order, tracer.bad_row0 });
+        for (0..layer_count) |layer| {
+            if (tracer.joined_seen[layer] != 1 or tracer.output_seen[layer] != 1)
+                try errors.add("rows {d} layer {d}: joined captures {d}, output captures {d}", .{ n, layer, tracer.joined_seen[layer], tracer.output_seen[layer] });
+        }
+        const last_output = output[(layer_count - 1) * max_rows * width ..][0 .. n * width];
+        const output_vs_hidden = differences(last_output, traced.hidden[0 .. n * width]);
+        if (output_vs_hidden != 0) try errors.add("rows {d}: layer 12 output capture differs from the final hidden in {d} values", .{ n, output_vs_hidden });
+        const d_hidden = differences(traced.hidden[0 .. n * width], untraced.hidden[0 .. n * width]);
+        const d_head = differences(traced.head, untraced.head);
+        const d_kv = differences(traced.kv[0 .. layer_count * 2 * n * kv_width], untraced.kv[0 .. layer_count * 2 * n * kv_width]);
+        if (d_hidden != 0 or d_head != 0 or d_kv != 0) try errors.add("rows {d}: traced vs untraced bit differences hidden {d} head9 {d} kv {d}", .{ n, d_hidden, d_head, d_kv });
+
+        try cases.print(gpa, "{s}\n    {{\"rows\": {d}, \"suffix_positions\": [{d}, {d}], \"traced_vs_untraced_bit_differences\": {{\"hidden\": {d}, \"head9\": {d}, \"kv\": {d}}}," ++
+            " \"layer12_output_vs_final_hidden_differences\": {d}, \"captures\": {{", .{
+            if (case_index == 0) "" else ",", n, prefix_rows, prefix_rows + n - 1, d_hidden, d_head, d_kv, output_vs_hidden,
+        });
+        var name = try std.fmt.bufPrint(&name_buffer, "native-{d}-shared_input.bf16", .{n});
+        written += try emit(gpa, io, out, &cases, "shared_input", name, shared[0 .. n * width], n, width, &errors);
+        try cases.appendSlice(gpa, ", \"layers\": [");
+        for (0..layer_count) |layer| {
+            try cases.print(gpa, "{s}{{\"layer\": {d}, \"code_index\": {d}, ", .{ if (layer == 0) "" else ", ", layer, if (layer < 4) 0 else layer - 4 });
+            name = try std.fmt.bufPrint(&name_buffer, "native-{d}-layer-{d:0>2}-joined.bf16", .{ n, layer });
+            written += try emit(gpa, io, out, &cases, "joined", name, joined[layer * max_rows * joined_width ..][0 .. n * joined_width], n, joined_width, &errors);
+            try cases.appendSlice(gpa, ", ");
+            name = try std.fmt.bufPrint(&name_buffer, "native-{d}-layer-{d:0>2}-output.bf16", .{ n, layer });
+            written += try emit(gpa, io, out, &cases, "output", name, output[layer * max_rows * width ..][0 .. n * width], n, width, &errors);
+            try cases.appendSlice(gpa, "}");
+        }
+        try cases.appendSlice(gpa, "]}, \"finals\": {");
+        written += try emitFinals(gpa, io, out, &cases, n, "traced", traced, &errors);
+        try cases.appendSlice(gpa, ", ");
+        written += try emitFinals(gpa, io, out, &cases, n, "untraced", untraced, &errors);
+        try cases.appendSlice(gpa, "}}");
+        std.debug.print("suffix_rows={d} traced_untraced_hidden_diff={d} head9_diff={d} kv_diff={d} layer12_output_diff={d}\n", .{ n, d_hidden, d_head, d_kv, output_vs_hidden });
+    }
+
+    try device_hidden.download(0, std.mem.sliceAsBytes(device_check));
+    const device_input_differences = differences(device_check, hidden);
+    if (device_input_differences != 0) try errors.add("device input hidden changed in {d} values", .{device_input_differences});
+    const host_hidden_unchanged = std.mem.eql(u8, &sha256Hex(std.mem.sliceAsBytes(hidden)), &hidden_sha);
+    const host_frames_unchanged = std.mem.eql(u8, &sha256Hex(std.mem.sliceAsBytes(&frames)), &frames_sha);
+    if (!host_hidden_unchanged or !host_frames_unchanged) try errors.add("host fixture changed: hidden unchanged {} frames unchanged {}", .{ host_hidden_unchanged, host_frames_unchanged });
+    const used = cuda.usage(false);
+
+    var binary_json: std.ArrayList(u8) = .empty;
+    defer binary_json.deinit(gpa);
+    if (fileSha256(gpa, io, "/proc/self/exe")) |sha| {
+        try binary_json.print(gpa, "\"{s}\"", .{sha[0..]});
+    } else |err| {
+        std.debug.print("binary hash unavailable: {s}\n", .{@errorName(err)});
+        try binary_json.appendSlice(gpa, "null");
+    }
+    const tower_source_sha = sha256Hex(tower.trace_source);
+    const driver_source_sha = sha256Hex(@embedFile("drama_tower_mixer_trace.zig"));
+    const kernel_image_sha = sha256Hex(cuda.kernels.drama_tower);
+    if (cuda.kernels.drama_tower.len == 0) try errors.add("embedded drama_tower kernel image is empty", .{});
+    const evidence_valid = errors.count == 0;
+
+    var manifest: std.ArrayList(u8) = .empty;
+    defer manifest.deinit(gpa);
+    try manifest.appendSlice(gpa, "{\n  \"schema_version\": 1,\n  \"producer\": \"tf-drama-tower-mixer-trace\",\n  \"checkpoint\": ");
+    try jsonString(&manifest, gpa, args[1]);
+    try manifest.appendSlice(gpa, ",\n  \"fixture_directory\": ");
+    try jsonString(&manifest, gpa, args[2]);
+    try manifest.print(gpa, ",\n  \"input_hidden_sha256\": \"{s}\",\n  \"input_frames_sha256\": \"{s}\",\n  \"layer_count\": {d}," ++
+        "\n  \"model_options\": {{\"context\": {d}, \"max_rows\": {d}}},\n  \"prefix_rows\": {d},\n  \"prefix_chunks\": [{d}, {d}],\n  \"suffix_rows\": [{d}, {d}, {d}]," ++
+        "\n  \"captured_stages\": [\"shared_input\", \"joined\", \"output\"]," ++
+        "\n  \"row_mapping\": \"capture row j is fixture row 181 + j at position 181 + j; labels frames[182 + j]; layer L mixer hidden input is layer L - 1 output (layer 0: fixture hidden)\"," ++
+        "\n  \"cases\": [{s}\n  ]," ++
+        "\n  \"input_immutable\": {{\"device_hidden_differences\": {d}, \"host_hidden_unchanged\": {}, \"host_frames_unchanged\": {}}}," ++
+        "\n  \"allocations\": {{\"cuda_device_bytes_after_init\": {d}, \"cuda_device_bytes\": {d}, \"cuda_device_peak_bytes\": {d}, \"pinned_host_bytes\": {d}}}," ++
+        "\n  \"bytes_written\": {d}," ++
+        "\n  \"binary_sha256\": {s},\n  \"tower_source_sha256\": \"{s}\",\n  \"driver_source_sha256\": \"{s}\",\n  \"tower_kernel_image_sha256\": \"{s}\"," ++
+        "\n  \"evidence_valid\": {},\n  \"errors\": [{s}\n  ]\n}}\n", .{
+        hidden_sha[0..],          frames_sha[0..],       layer_count,            context,
+        max_rows,                 prefix_rows,           prefix_chunks[0],       prefix_chunks[1],
+        row_counts[0],            row_counts[1],         row_counts[2],          cases.items,
+        device_input_differences, host_hidden_unchanged, host_frames_unchanged,  model_usage.device,
+        used.device,              used.peak,             used.host,              written,
+        binary_json.items,        tower_source_sha[0..], driver_source_sha[0..], kernel_image_sha[0..],
+        evidence_valid,           errors.json.items,
+    });
+    try out.writeFile(io, .{ .sub_path = "manifest.json", .data = manifest.items, .flags = .{ .exclusive = true } });
+    std.debug.print("cases={d} bytes_written={d} evidence_valid={} errors={d} cuda_bytes={d} cuda_peak={d}\n", .{
+        row_counts.len, written + manifest.items.len, evidence_valid, errors.count, used.device, used.peak,
+    });
+    return if (evidence_valid) 0 else 3;
+}
diff --git a/zig/tests/cuda/drama_tower_oracle.zig b/zig/tests/cuda/drama_tower_oracle.zig
new file mode 100644
index 00000000..de68f823
--- /dev/null
+++ b/zig/tests/cuda/drama_tower_oracle.zig
@@ -0,0 +1,97 @@
+//! Teacher-force fixed rows through the production tower and export its final hidden, last codebook head and KV cache.
+//! The caller owns the GPU lock, admission, process cap and lifetime monitoring.
+const std = @import("std");
+const builtin = @import("builtin");
+const cuda = @import("cuda");
+const drama = @import("drama");
+const rows = 128;
+const width = 2048;
+const kv_width = 512;
+const Frame = drama.tower.Frame;
+
+fn view(buffer: cuda.DeviceBuffer, offset: usize, len: usize) cuda.DeviceBuffer {
+    std.debug.assert(offset <= buffer.len and len <= buffer.len - offset);
+    return .{ .d = buffer.d, .ptr = buffer.ptr + offset, .len = len, .borrowed = true };
+}
+
+fn readExact(io: std.Io, dir: std.Io.Dir, name: []const u8, bytes: []u8) !void {
+    const file = try dir.openFile(io, name, .{});
+    defer file.close(io);
+    if (try file.length(io) != bytes.len or try file.readPositionalAll(io, bytes, 0) != bytes.len) return error.BadFixtureLength;
+}
+
+pub fn main(init: std.process.Init) !u8 {
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    if (args.len != 4) {
+        std.debug.print("usage: tf-drama-tower-oracle CHECKPOINT FIXTURE_DIRECTORY OUTPUT_DIRECTORY\n", .{});
+        return 2;
+    }
+    if (builtin.cpu.arch.endian() != .little) return error.UnsupportedHostEndian;
+    var fixture = try std.Io.Dir.cwd().openDir(init.io, args[2], .{});
+    defer fixture.close(init.io);
+    var out = try std.Io.Dir.cwd().openDir(init.io, args[3], .{});
+    defer out.close(init.io);
+    const hidden = try init.gpa.alloc(u16, rows * width);
+    defer init.gpa.free(hidden);
+    var frames: [rows + 1]Frame = undefined;
+    try readExact(init.io, fixture, "hidden.bf16", std.mem.sliceAsBytes(hidden));
+    try readExact(init.io, fixture, "frames.u32le", std.mem.sliceAsBytes(&frames));
+    const result = try init.gpa.alloc(u16, rows * width);
+    defer init.gpa.free(result);
+    const repeated = try init.gpa.alloc(u16, rows * width);
+    defer init.gpa.free(repeated);
+    const cache_row = try init.gpa.alloc(u16, rows * kv_width);
+    defer init.gpa.free(cache_row);
+    var logits: [4096]u16 = undefined;
+    _ = try cuda.setAllocationLimit(54 * (1 << 30));
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    var tower = try drama.tower.Model.init(init.gpa, init.io, &ctx, args[1], "", .{ .context = rows, .max_rows = rows });
+    defer tower.deinit();
+    var device_hidden = try cuda.DeviceBuffer.alloc(&driver, rows * width * 2);
+    defer device_hidden.free();
+    try device_hidden.upload(0, std.mem.sliceAsBytes(hidden));
+    const p = tower.impl;
+    var name_buffer: [128]u8 = undefined;
+    for ([_]usize{ 1, 7, rows }) |n| {
+        try tower.reset(stream, &.{}, 0);
+        _ = try tower.setInput(stream, frames[0..n]);
+        try tower.prefill(stream, view(device_hidden, 0, n * width * 2), frames[1 .. n + 1]);
+        try p.output_hidden.download(0, std.mem.sliceAsBytes(result[0 .. n * width]));
+        var name = try std.fmt.bufPrint(&name_buffer, "native-{d}-hidden.bf16", .{n});
+        try out.writeFile(init.io, .{ .sub_path = name, .data = std.mem.sliceAsBytes(result[0 .. n * width]) });
+        // The one-row final head uses the same production cuBLASLt plan and weights as generate(). No sampling is involved.
+        try p.plans.items[5].run(p.output_hidden.ptr + (n - 1) * width * 2, p.heads[8].ptr, p.head_logits.ptr, p.workspace.ptr, p.workspace.len, stream.handle);
+        try stream.synchronize();
+        try p.head_logits.download(0, std.mem.sliceAsBytes(&logits));
+        name = try std.fmt.bufPrint(&name_buffer, "native-{d}-head9.bf16", .{n});
+        try out.writeFile(init.io, .{ .sub_path = name, .data = std.mem.sliceAsBytes(&logits) });
+        for (0..13) |layer| for ([_][]const u8{ "keys", "values" }, 0..) |kind, which| {
+            const offset = (layer * 2 + which) * rows * kv_width * 2;
+            try p.cache.download(offset, std.mem.sliceAsBytes(cache_row[0 .. n * kv_width]));
+            name = try std.fmt.bufPrint(&name_buffer, "native-{d}-layer-{d}-{s}.bf16", .{ n, layer, kind });
+            try out.writeFile(init.io, .{ .sub_path = name, .data = std.mem.sliceAsBytes(cache_row[0 .. n * kv_width]) });
+        };
+        try tower.reset(stream, &.{}, 0);
+        _ = try tower.setInput(stream, frames[0..n]);
+        try tower.prefill(stream, view(device_hidden, 0, n * width * 2), frames[1 .. n + 1]);
+        try p.output_hidden.download(0, std.mem.sliceAsBytes(repeated[0 .. n * width]));
+        if (!std.mem.eql(u16, result[0 .. n * width], repeated[0 .. n * width])) return error.TowerResetNotReproducible;
+        // Different GEMM row counts may change low-order BF16 bits. Export chunked output for numerical comparison, not an unjustified bitwise gate.
+        try tower.reset(stream, &.{}, 0);
+        for (0..n) |r| {
+            _ = try tower.setInput(stream, frames[r .. r + 1]);
+            try tower.prefill(stream, view(device_hidden, r * width * 2, width * 2), frames[r + 1 .. r + 2]);
+            try p.output_hidden.download(0, std.mem.sliceAsBytes(repeated[r * width .. (r + 1) * width]));
+        }
+        name = try std.fmt.bufPrint(&name_buffer, "native-{d}-chunked-hidden.bf16", .{n});
+        try out.writeFile(init.io, .{ .sub_path = name, .data = std.mem.sliceAsBytes(repeated[0 .. n * width]) });
+        const used = cuda.usage(false);
+        std.debug.print("tower_rows={d} reset_bit_exact=true cuda_bytes={d} pinned_bytes={d}\n", .{ n, used.device, used.host });
+    }
+    return 0;
+}
diff --git a/zig/tests/cuda/drama_tower_qk_trace.zig b/zig/tests/cuda/drama_tower_qk_trace.zig
new file mode 100644
index 00000000..09e99901
--- /dev/null
+++ b/zig/tests/cuda/drama_tower_qk_trace.zig
@@ -0,0 +1,439 @@
+//! Development diagnostic, not a gate: the production tower's Q/K normalization and RoPE operands and outputs on the
+//! full-context fixture.
+//!
+//! usage: tf-drama-tower-qk-trace CHECKPOINT FIXTURE_DIRECTORY OUTPUT_DIRECTORY
+//!
+//! FIXTURE_DIRECTORY is the full-context fixture (hidden.bf16 [309][2048]; frames.u32le [310][11]; row r uses input
+//! frame frames[r] and next-frame label frames[r + 1]); only read. OUTPUT_DIRECTORY must exist; every file is created
+//! exclusively. Model options as tf-drama-tower-context-oracle: context 512, max_rows 128.
+//!
+//! For each suffix length N in 1, 7, 128, the context oracle's `batch` schedule three times:
+//!   reset; prefix rows 0..180 untraced in the host's chunks 128 then 53; then the N suffix rows in one call at
+//!   positions 181..
+//!   1. traced: the suffix call is `Model.prefillTraced` with a tracer that copies, on the model's stream right after
+//!      the producing kernel, only four stages of every layer: qkv (Impl.qkv after projection 1, checkpoint order
+//!      [query 16x256 | gate 16x256 | key 2x256 | value 2x256]), query (Impl.queries after drama_rope_cache), key and
+//!      value (the layer's cache rows 181..181+N-1 after drama_rope_cache). Other capture points return at once.
+//!   2. untraced: the production `Model.prefill` for the suffix call.
+//!   3. repeat: traced again; every capture and final must equal run 1 bit for bit.
+//! After each run: suffix final hidden, the codebook-9 head on the last suffix row (rows = 1 plan, heads[8], after a
+//! 0xFF NaN fill) and every layer's N suffix KV rows.
+//! Files: native-N-layer-LL-{qkv,query,key,value}.bf16 and native-N-{traced,untraced,repeat}-{hidden,head9,
+//! layer-LL-keys,layer-LL-values}.bf16. manifest.json lists every file with shape, SHA-256 and nonfinite count.
+//! evidence_valid is false (exit 3) on any recorded error: nonfinite data, traced / untraced / repeat differences, a
+//! key / value capture that differs from the exported cache rows, a missing or misordered capture, a mutated input.
+//! Bit equality with the frozen post-mix full-context native batch files is checked by an external checker.
+//! The caller owns the shared GPU lock, admission, process cap and lifetime monitoring.
+const std = @import("std");
+const builtin = @import("builtin");
+const cuda = @import("cuda");
+const drama = @import("drama");
+
+const Allocator = std.mem.Allocator;
+const tower = drama.tower;
+const Stage = tower.Stage;
+const Frame = tower.Frame;
+const Impl = @typeInfo(@FieldType(tower.Model, "impl")).pointer.child;
+
+const width = 2048;
+const qkv_width = 9216;
+const query_width = 4096;
+const kv_width = 512;
+const vocab = 4096;
+const max_rows = 128;
+const context = 512;
+const prefix_rows = 181;
+const suffix_rows = 128;
+const hidden_rows = prefix_rows + suffix_rows;
+const frame_rows = hidden_rows + 1;
+const prefix_chunks = [_]usize{ 128, 53 };
+const row_counts = [_]usize{ 1, 7, suffix_rows };
+const projection_count = 6;
+const head_kind = 5;
+const head_index = 8;
+const head_plan = (1 - 1) * projection_count + head_kind;
+const layer_count = @typeInfo(@FieldType(Impl, "layers")).array.len;
+const captured = [_]Stage{ .qkv, .query, .key, .value };
+
+comptime {
+    std.debug.assert(layer_count == 13);
+    std.debug.assert(tower.stageWidth(.qkv) == qkv_width and tower.stageWidth(.query) == query_width);
+    std.debug.assert(tower.stageWidth(.key) == kv_width and tower.stageWidth(.value) == kv_width);
+    var sum: usize = 0;
+    for (prefix_chunks) |c| sum += c;
+    std.debug.assert(sum == prefix_rows and hidden_rows <= context);
+}
+
+const Errors = struct {
+    gpa: Allocator,
+    json: std.ArrayList(u8) = .empty,
+    count: usize = 0,
+
+    fn add(e: *Errors, comptime f: []const u8, args: anytype) !void {
+        std.debug.print("error: " ++ f ++ "\n", args);
+        try e.json.appendSlice(e.gpa, if (e.count == 0) "\n    \"" else ",\n    \"");
+        try e.json.print(e.gpa, f, args);
+        try e.json.append(e.gpa, '"');
+        e.count += 1;
+    }
+};
+
+fn stageIndex(stage: Stage) ?usize {
+    for (captured, 0..) |s, i| if (s == stage) return i;
+    return null;
+}
+
+/// Per layer and captured stage, [max_rows][stageWidth] BF16.
+const Captures = struct {
+    data: [layer_count][captured.len][]u16,
+
+    fn alloc(arena: Allocator) !Captures {
+        var c: Captures = undefined;
+        for (&c.data) |*layer| for (layer, captured) |*slot, stage| {
+            slot.* = try arena.alloc(u16, max_rows * tower.stageWidth(stage));
+        };
+        return c;
+    }
+
+    fn rows(c: *const Captures, layer: usize, which: usize, n: usize) []u16 {
+        return c.data[layer][which][0 .. n * tower.stageWidth(captured[which])];
+    }
+};
+
+const Tracer = struct {
+    n: usize,
+    staging: []align(16) u8,
+    out: *Captures,
+    seen: [layer_count][captured.len]usize = std.mem.zeroes([layer_count][captured.len]usize),
+    expected: usize = 0, // next capture in (layer, stage) order
+    out_of_order: usize = 0,
+    bad_row0: usize = 0,
+
+    pub fn capture(t: *Tracer, stream: cuda.Stream, layer: usize, stage: Stage, src: cuda.DeviceBuffer, row0: usize) !void {
+        const which = stageIndex(stage) orelse return;
+        if (layer * captured.len + which != t.expected) t.out_of_order += 1;
+        t.expected = layer * captured.len + which + 1;
+        if (row0 != prefix_rows) t.bad_row0 += 1;
+        t.seen[layer][which] += 1;
+        const dst = t.out.rows(layer, which, t.n);
+        const bytes = std.mem.sliceAsBytes(dst);
+        if (src.len != bytes.len or bytes.len > t.staging.len) return error.TraceCaptureShape;
+        try src.downloadAsync(0, t.staging[0..bytes.len], stream.handle);
+        try stream.synchronize();
+        @memcpy(bytes, t.staging[0..bytes.len]);
+    }
+};
+
+const Finals = struct {
+    hidden: []u16,
+    head: []u16,
+    kv: []u16,
+
+    fn alloc(arena: Allocator) !Finals {
+        return .{ .hidden = try arena.alloc(u16, max_rows * width), .head = try arena.alloc(u16, vocab), .kv = try arena.alloc(u16, layer_count * 2 * max_rows * kv_width) };
+    }
+
+    fn kvRows(f: Finals, n: usize, layer: usize, which: usize) []u16 {
+        const at = (layer * 2 + which) * n * kv_width;
+        return f.kv[at .. at + n * kv_width];
+    }
+};
+
+fn view(buffer: cuda.DeviceBuffer, offset: usize, len: usize) cuda.DeviceBuffer {
+    std.debug.assert(offset <= buffer.len and len <= buffer.len - offset);
+    return .{ .d = buffer.d, .ptr = buffer.ptr + offset, .len = len, .borrowed = true };
+}
+
+fn cacheOffset(layer: usize, which: usize, row: usize) usize {
+    return ((layer * 2 + which) * context + row) * kv_width * 2;
+}
+
+fn runBatch(model: *tower.Model, stream: cuda.Stream, dev: cuda.DeviceBuffer, frames: []const Frame, n: usize, trace: anytype, f: Finals) !void {
+    const p = model.impl;
+    try model.reset(stream, &.{}, 0);
+    var row: usize = 0;
+    for (prefix_chunks) |c| {
+        _ = try model.setInput(stream, frames[row .. row + c]);
+        try model.prefill(stream, view(dev, row * width * 2, c * width * 2), frames[row + 1 .. row + c + 1]);
+        row += c;
+    }
+    const a = prefix_rows;
+    _ = try model.setInput(stream, frames[a .. a + n]);
+    if (@TypeOf(trace) == void)
+        try model.prefill(stream, view(dev, a * width * 2, n * width * 2), frames[a + 1 .. a + n + 1])
+    else
+        try model.prefillTraced(stream, view(dev, a * width * 2, n * width * 2), frames[a + 1 .. a + n + 1], trace);
+    try p.output_hidden.download(0, std.mem.sliceAsBytes(f.hidden[0 .. n * width]));
+    try p.head_logits.fill8(0xff, stream.handle);
+    try p.plans.items[head_plan].run(p.output_hidden.ptr + (n - 1) * width * 2, p.heads[head_index].ptr, p.head_logits.ptr, p.workspace.ptr, p.workspace.len, stream.handle);
+    try stream.synchronize();
+    try p.head_logits.download(0, std.mem.sliceAsBytes(f.head));
+    for (0..layer_count) |layer| for (0..2) |which| {
+        try p.cache.download(cacheOffset(layer, which, prefix_rows), std.mem.sliceAsBytes(f.kvRows(n, layer, which)));
+    };
+}
+
+fn differences(a: []const u16, b: []const u16) usize {
+    var count: usize = 0;
+    for (a, b) |x, y| {
+        if (x != y) count += 1;
+    }
+    return count;
+}
+
+fn nonfiniteBf16(values: []const u16) usize {
+    var count: usize = 0;
+    for (values) |bits| {
+        if ((bits & 0x7f80) == 0x7f80) count += 1;
+    }
+    return count;
+}
+
+fn sha256Hex(bytes: []const u8) [64]u8 {
+    var out: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(bytes, &out, .{});
+    return std.fmt.bytesToHex(out, .lower);
+}
+
+fn fileSha256(gpa: Allocator, io: std.Io, path: []const u8) ![64]u8 {
+    const file = try std.Io.Dir.openFileAbsolute(io, path, .{});
+    defer file.close(io);
+    const buffer = try gpa.alloc(u8, 1 << 20);
+    defer gpa.free(buffer);
+    var hash = std.crypto.hash.sha2.Sha256.init(.{});
+    var offset: u64 = 0;
+    while (true) {
+        const got = try file.readPositionalAll(io, buffer, offset);
+        hash.update(buffer[0..got]);
+        offset += got;
+        if (got < buffer.len) break;
+    }
+    return std.fmt.bytesToHex(hash.finalResult(), .lower);
+}
+
+fn readExact(io: std.Io, dir: std.Io.Dir, name: []const u8, bytes: []u8) !void {
+    const file = try dir.openFile(io, name, .{});
+    defer file.close(io);
+    if (try file.length(io) != bytes.len or try file.readPositionalAll(io, bytes, 0) != bytes.len) return error.BadFixtureLength;
+}
+
+fn jsonString(list: *std.ArrayList(u8), gpa: Allocator, s: []const u8) !void {
+    try list.append(gpa, '"');
+    for (s) |c| switch (c) {
+        '"', '\\' => {
+            try list.append(gpa, '\\');
+            try list.append(gpa, c);
+        },
+        0...0x1f => try list.print(gpa, "\\u{x:0>4}", .{c}),
+        else => try list.append(gpa, c),
+    };
+    try list.append(gpa, '"');
+}
+
+fn emit(gpa: Allocator, io: std.Io, dir: std.Io.Dir, json: *std.ArrayList(u8), key: []const u8, name: []const u8, data: []const u16, rows: usize, cols: usize, errors: *Errors) !usize {
+    const bytes = std.mem.sliceAsBytes(data);
+    try dir.writeFile(io, .{ .sub_path = name, .data = bytes, .flags = .{ .exclusive = true } });
+    const bad = nonfiniteBf16(data);
+    if (bad != 0) try errors.add("{s}: {d} nonfinite values", .{ name, bad });
+    const sha = sha256Hex(bytes);
+    try json.print(gpa, "\"{s}\": {{\"file\": \"{s}\", \"sha256\": \"{s}\", \"shape\": [{d}, {d}], \"nonfinite\": {d}}}", .{ key, name, sha[0..], rows, cols, bad });
+    return bytes.len;
+}
+
+fn emitFinals(gpa: Allocator, io: std.Io, dir: std.Io.Dir, json: *std.ArrayList(u8), n: usize, label: []const u8, f: Finals, errors: *Errors) !usize {
+    var name_buffer: [96]u8 = undefined;
+    var written: usize = 0;
+    try json.print(gpa, "\"{s}\": {{", .{label});
+    var name = try std.fmt.bufPrint(&name_buffer, "native-{d}-{s}-hidden.bf16", .{ n, label });
+    written += try emit(gpa, io, dir, json, "hidden", name, f.hidden[0 .. n * width], n, width, errors);
+    try json.appendSlice(gpa, ", ");
+    name = try std.fmt.bufPrint(&name_buffer, "native-{d}-{s}-head9.bf16", .{ n, label });
+    written += try emit(gpa, io, dir, json, "head9", name, f.head, 1, vocab, errors);
+    try json.appendSlice(gpa, ", \"kv\": {");
+    for (0..layer_count) |layer| for ([_][]const u8{ "keys", "values" }, 0..) |kind, which| {
+        var key_buffer: [32]u8 = undefined;
+        const key = try std.fmt.bufPrint(&key_buffer, "layer-{d:0>2}-{s}", .{ layer, kind });
+        name = try std.fmt.bufPrint(&name_buffer, "native-{d}-{s}-layer-{d:0>2}-{s}.bf16", .{ n, label, layer, kind });
+        if (layer != 0 or which != 0) try json.appendSlice(gpa, ", ");
+        written += try emit(gpa, io, dir, json, key, name, f.kvRows(n, layer, which), n, kv_width, errors);
+    };
+    try json.appendSlice(gpa, "}}");
+    return written;
+}
+
+fn compareFinals(n: usize, a: Finals, b: Finals) [3]usize {
+    return .{
+        differences(a.hidden[0 .. n * width], b.hidden[0 .. n * width]),
+        differences(a.head, b.head),
+        differences(a.kv[0 .. layer_count * 2 * n * kv_width], b.kv[0 .. layer_count * 2 * n * kv_width]),
+    };
+}
+
+fn checkTracer(t: *const Tracer, n: usize, label: []const u8, errors: *Errors) !void {
+    if (t.out_of_order != 0 or t.bad_row0 != 0) try errors.add("rows {d} {s}: {d} captures out of order, {d} with a bad row0", .{ n, label, t.out_of_order, t.bad_row0 });
+    for (0..layer_count) |layer| for (0..captured.len) |which| {
+        if (t.seen[layer][which] != 1) try errors.add("rows {d} {s}: layer {d} stage {s} captured {d} times", .{ n, label, layer, @tagName(captured[which]), t.seen[layer][which] });
+    };
+}
+
+pub fn main(init: std.process.Init) !u8 {
+    const gpa = init.gpa;
+    const io = init.io;
+    const arena = init.arena.allocator();
+    const args = try init.minimal.args.toSlice(arena);
+    if (args.len != 4) {
+        std.debug.print("usage: tf-drama-tower-qk-trace CHECKPOINT FIXTURE_DIRECTORY OUTPUT_DIRECTORY\n", .{});
+        return 2;
+    }
+    if (builtin.cpu.arch.endian() != .little) return error.UnsupportedHostEndian;
+    const fixture = try std.Io.Dir.cwd().openDir(io, args[2], .{});
+    defer fixture.close(io);
+    const out = try std.Io.Dir.cwd().openDir(io, args[3], .{});
+    defer out.close(io);
+
+    const hidden = try arena.alloc(u16, hidden_rows * width);
+    var frames: [frame_rows]Frame = undefined;
+    try readExact(io, fixture, "hidden.bf16", std.mem.sliceAsBytes(hidden));
+    try readExact(io, fixture, "frames.u32le", std.mem.sliceAsBytes(&frames));
+    const hidden_sha = sha256Hex(std.mem.sliceAsBytes(hidden));
+    const frames_sha = sha256Hex(std.mem.sliceAsBytes(&frames));
+    for (hidden) |bits| if ((bits & 0x7f80) == 0x7f80) return error.NonfiniteFixtureHidden;
+
+    var first = try Captures.alloc(arena);
+    var again = try Captures.alloc(arena);
+    const traced = try Finals.alloc(arena);
+    const untraced = try Finals.alloc(arena);
+    const repeat = try Finals.alloc(arena);
+    const device_check = try arena.alloc(u16, hidden_rows * width);
+
+    var errors: Errors = .{ .gpa = gpa };
+    defer errors.json.deinit(gpa);
+
+    _ = try cuda.setAllocationLimit(54 * (1 << 30));
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    var model = try tower.Model.init(gpa, io, &ctx, args[1], "", .{ .context = context, .max_rows = max_rows });
+    defer model.deinit();
+    const p = model.impl;
+    if (p.plans.items.len != max_rows * projection_count or p.head_logits.len != vocab * 2 or p.output_hidden.len != max_rows * width * 2 or
+        p.qkv.len != max_rows * qkv_width * 2 or p.queries.len != max_rows * query_width * 2 or
+        p.cache.len != layer_count * 2 * context * kv_width * 2) return error.UnexpectedTowerLayout;
+    const model_usage = cuda.usage(false);
+    var device_hidden = try cuda.DeviceBuffer.alloc(&driver, hidden_rows * width * 2);
+    defer device_hidden.free();
+    try device_hidden.upload(0, std.mem.sliceAsBytes(hidden));
+    var staging = try cuda.HostBuffer.alloc(&driver, max_rows * qkv_width * 2);
+    defer staging.free();
+
+    var cases: std.ArrayList(u8) = .empty;
+    defer cases.deinit(gpa);
+    var written: usize = 0;
+    var name_buffer: [96]u8 = undefined;
+    for (row_counts, 0..) |n, case_index| {
+        var t1: Tracer = .{ .n = n, .staging = staging.bytes, .out = &first };
+        try runBatch(&model, stream, device_hidden, &frames, n, &t1, traced);
+        try runBatch(&model, stream, device_hidden, &frames, n, {}, untraced);
+        var t2: Tracer = .{ .n = n, .staging = staging.bytes, .out = &again };
+        try runBatch(&model, stream, device_hidden, &frames, n, &t2, repeat);
+        try checkTracer(&t1, n, "traced", &errors);
+        try checkTracer(&t2, n, "repeat", &errors);
+
+        var capture_repeat_differences: usize = 0;
+        var cache_vs_capture: usize = 0;
+        for (0..layer_count) |layer| {
+            for (0..captured.len) |which| capture_repeat_differences += differences(first.rows(layer, which, n), again.rows(layer, which, n));
+            cache_vs_capture += differences(first.rows(layer, 2, n), traced.kvRows(n, layer, 0));
+            cache_vs_capture += differences(first.rows(layer, 3, n), traced.kvRows(n, layer, 1));
+        }
+        if (capture_repeat_differences != 0) try errors.add("rows {d}: {d} captured values differ between traced runs", .{ n, capture_repeat_differences });
+        if (cache_vs_capture != 0) try errors.add("rows {d}: key/value captures differ from the exported cache rows in {d} values", .{ n, cache_vs_capture });
+        const du = compareFinals(n, traced, untraced);
+        const dr = compareFinals(n, traced, repeat);
+        if (du[0] != 0 or du[1] != 0 or du[2] != 0) try errors.add("rows {d}: traced vs untraced bit differences hidden {d} head9 {d} kv {d}", .{ n, du[0], du[1], du[2] });
+        if (dr[0] != 0 or dr[1] != 0 or dr[2] != 0) try errors.add("rows {d}: traced vs repeat bit differences hidden {d} head9 {d} kv {d}", .{ n, dr[0], dr[1], dr[2] });
+
+        try cases.print(gpa, "{s}\n    {{\"rows\": {d}, \"suffix_positions\": [{d}, {d}]," ++
+            " \"traced_vs_untraced_bit_differences\": {{\"hidden\": {d}, \"head9\": {d}, \"kv\": {d}}}," ++
+            " \"traced_vs_repeat_bit_differences\": {{\"hidden\": {d}, \"head9\": {d}, \"kv\": {d}}}," ++
+            " \"capture_repeat_differences\": {d}, \"key_value_capture_vs_cache_differences\": {d}, \"captures\": [", .{
+            if (case_index == 0) "" else ",", n,                prefix_rows, prefix_rows + n - 1, du[0], du[1], du[2], dr[0], dr[1], dr[2],
+            capture_repeat_differences,       cache_vs_capture,
+        });
+        for (0..layer_count) |layer| {
+            try cases.print(gpa, "{s}{{\"layer\": {d}", .{ if (layer == 0) "" else ", ", layer });
+            for (captured, 0..) |stage, which| {
+                try cases.appendSlice(gpa, ", ");
+                const name = try std.fmt.bufPrint(&name_buffer, "native-{d}-layer-{d:0>2}-{s}.bf16", .{ n, layer, @tagName(stage) });
+                written += try emit(gpa, io, out, &cases, @tagName(stage), name, first.rows(layer, which, n), n, tower.stageWidth(stage), &errors);
+            }
+            try cases.appendSlice(gpa, "}");
+        }
+        try cases.appendSlice(gpa, "], \"finals\": {");
+        written += try emitFinals(gpa, io, out, &cases, n, "traced", traced, &errors);
+        try cases.appendSlice(gpa, ", ");
+        written += try emitFinals(gpa, io, out, &cases, n, "untraced", untraced, &errors);
+        try cases.appendSlice(gpa, ", ");
+        written += try emitFinals(gpa, io, out, &cases, n, "repeat", repeat, &errors);
+        try cases.appendSlice(gpa, "}}");
+        std.debug.print("suffix_rows={d} untraced_diff={d}/{d}/{d} repeat_diff={d}/{d}/{d} capture_repeat_diff={d}\n", .{
+            n, du[0], du[1], du[2], dr[0], dr[1], dr[2], capture_repeat_differences,
+        });
+    }
+
+    try device_hidden.download(0, std.mem.sliceAsBytes(device_check));
+    const device_input_differences = differences(device_check, hidden);
+    if (device_input_differences != 0) try errors.add("device input hidden changed in {d} values", .{device_input_differences});
+    const host_hidden_unchanged = std.mem.eql(u8, &sha256Hex(std.mem.sliceAsBytes(hidden)), &hidden_sha);
+    const host_frames_unchanged = std.mem.eql(u8, &sha256Hex(std.mem.sliceAsBytes(&frames)), &frames_sha);
+    if (!host_hidden_unchanged or !host_frames_unchanged) try errors.add("host fixture changed: hidden unchanged {} frames unchanged {}", .{ host_hidden_unchanged, host_frames_unchanged });
+    const used = cuda.usage(false);
+
+    var binary_json: std.ArrayList(u8) = .empty;
+    defer binary_json.deinit(gpa);
+    if (fileSha256(gpa, io, "/proc/self/exe")) |sha| {
+        try binary_json.print(gpa, "\"{s}\"", .{sha[0..]});
+    } else |err| {
+        std.debug.print("binary hash unavailable: {s}\n", .{@errorName(err)});
+        try binary_json.appendSlice(gpa, "null");
+    }
+    const tower_source_sha = sha256Hex(tower.trace_source);
+    const driver_source_sha = sha256Hex(@embedFile("drama_tower_qk_trace.zig"));
+    const kernel_image_sha = sha256Hex(cuda.kernels.drama_tower);
+    if (cuda.kernels.drama_tower.len == 0) try errors.add("embedded drama_tower kernel image is empty", .{});
+    const evidence_valid = errors.count == 0;
+
+    var manifest: std.ArrayList(u8) = .empty;
+    defer manifest.deinit(gpa);
+    try manifest.appendSlice(gpa, "{\n  \"schema_version\": 1,\n  \"producer\": \"tf-drama-tower-qk-trace\",\n  \"checkpoint\": ");
+    try jsonString(&manifest, gpa, args[1]);
+    try manifest.appendSlice(gpa, ",\n  \"fixture_directory\": ");
+    try jsonString(&manifest, gpa, args[2]);
+    try manifest.print(gpa, ",\n  \"input_hidden_sha256\": \"{s}\",\n  \"input_frames_sha256\": \"{s}\",\n  \"layer_count\": {d}," ++
+        "\n  \"model_options\": {{\"context\": {d}, \"max_rows\": {d}}},\n  \"prefix_rows\": {d},\n  \"prefix_chunks\": [{d}, {d}],\n  \"suffix_rows\": [{d}, {d}, {d}]," ++
+        "\n  \"captured_stages\": [\"qkv\", \"query\", \"key\", \"value\"]," ++
+        "\n  \"rope_launch\": \"drama_rope_cache(qkv, qnorm, knorm, queries, keys, values, start = position, 16, 2, 256, 64, rope_base, eps), grid rows * 18, block 256\"," ++
+        "\n  \"row_mapping\": \"capture row j is fixture row 181 + j at position 181 + j; qkv in checkpoint order [query 16x256 | gate 16x256 | key 2x256 | value 2x256]\"," ++
+        "\n  \"cases\": [{s}\n  ]," ++
+        "\n  \"input_immutable\": {{\"device_hidden_differences\": {d}, \"host_hidden_unchanged\": {}, \"host_frames_unchanged\": {}}}," ++
+        "\n  \"allocations\": {{\"cuda_device_bytes_after_init\": {d}, \"cuda_device_bytes\": {d}, \"cuda_device_peak_bytes\": {d}, \"pinned_host_bytes\": {d}}}," ++
+        "\n  \"bytes_written\": {d}," ++
+        "\n  \"binary_sha256\": {s},\n  \"tower_source_sha256\": \"{s}\",\n  \"driver_source_sha256\": \"{s}\",\n  \"tower_kernel_image_sha256\": \"{s}\"," ++
+        "\n  \"evidence_valid\": {},\n  \"errors\": [{s}\n  ]\n}}\n", .{
+        hidden_sha[0..],          frames_sha[0..],       layer_count,            context,
+        max_rows,                 prefix_rows,           prefix_chunks[0],       prefix_chunks[1],
+        row_counts[0],            row_counts[1],         row_counts[2],          cases.items,
+        device_input_differences, host_hidden_unchanged, host_frames_unchanged,  model_usage.device,
+        used.device,              used.peak,             used.host,              written,
+        binary_json.items,        tower_source_sha[0..], driver_source_sha[0..], kernel_image_sha[0..],
+        evidence_valid,           errors.json.items,
+    });
+    try out.writeFile(io, .{ .sub_path = "manifest.json", .data = manifest.items, .flags = .{ .exclusive = true } });
+    std.debug.print("cases={d} bytes_written={d} evidence_valid={} errors={d} cuda_bytes={d} cuda_peak={d}\n", .{
+        row_counts.len, written + manifest.items.len, evidence_valid, errors.count, used.device, used.peak,
+    });
+    return if (evidence_valid) 0 else 3;
+}
diff --git a/zig/tests/cuda/drama_tower_trace.zig b/zig/tests/cuda/drama_tower_trace.zig
new file mode 100644
index 00000000..26b9bc64
--- /dev/null
+++ b/zig/tests/cuda/drama_tower_trace.zig
@@ -0,0 +1,506 @@
+//! Development diagnostic, not a gate: captures every stage of every production tower layer on the frozen real-input
+//! fixture, for comparison with the reference's capture of the same stages.
+//!
+//! usage: tf-drama-tower-trace CHECKPOINT INPUT_DIRECTORY OUTPUT_DIRECTORY
+//!
+//! INPUT_DIRECTORY holds hidden.bf16 (128 row-major BF16 rows of 2048) and frames.u32le (129 frames of 11 u32),
+//! copied and hash-validated on CPU by the reference side from the real-input fixture. OUTPUT_DIRECTORY must
+//! exist; every file is created exclusively, so an earlier trace is never overwritten. The model is built as
+//! tf-drama-tower-oracle builds it (context 128, max_rows 128), and each case is the oracle's teacher-forced call:
+//! reset, setInput(frames[0..n]), prefill(hidden[0..n], frames[1..n+1]), for n = 1, 7, 128 in that order.
+//!
+//! Per case:
+//! 1. Traced: `Model.prefillTraced` with a tracer. Each capture point copies the live tensor on the model's stream
+//!    right after its producing kernel was queued and waits for the copy, so the kernels, their order and their
+//!    inputs are production's; only host waits are added. Captures must arrive in exactly the documented order
+//!    (shared_input, then the fifteen per-layer stages of `drama.tower.Stage` for layers 0..12). Each is written to
+//!    native-N-layer-LL-STAGE.bf16 (BF16 [N][stageWidth]) and hashed.
+//! 2. Untraced control: the production `Model.prefill` (the same code instantiated with a void trace).
+//! 3. Traced repeat: as 1, with every capture hashed and compared to 1 instead of written.
+//! After each run: the final hidden (layer 12 output), the oracle's codebook-9 head on row N - 1 (the rows = 1
+//! cuBLASLt plan, heads[8], exactly the tf-drama-tower-oracle call) and every layer's N KV cache rows are written as
+//! native-N-VARIANT-{hidden,head9,layer-LL-keys,layer-LL-values}.bf16, VARIANT in traced / untraced / repeat.
+//! Finally the device input rows and the host fixture bytes are re-read and compared with what was loaded.
+//!
+//! manifest.json lists every file with shape and SHA-256. evidence_valid is false (exit 3) on any recorded error:
+//! a nonfinite capture, a traced / untraced / repeat bit difference, a stage repeat mismatch or a mutated input.
+//! A misordered or misshapen capture, or an existing output file, aborts the run without a manifest.
+//! Bit equality with the frozen real-input oracle outputs is checked by the reference side.
+//!
+//! The caller owns the shared GPU lock, admission, process cap and lifetime monitoring.
+const std = @import("std");
+const builtin = @import("builtin");
+const cuda = @import("cuda");
+const drama = @import("drama");
+
+const Allocator = std.mem.Allocator;
+const tower = drama.tower;
+const Stage = tower.Stage;
+const Frame = tower.Frame;
+const Impl = @typeInfo(@FieldType(tower.Model, "impl")).pointer.child;
+
+const width = 2048;
+const kv_width = 512;
+const vocab = 4096;
+const max_rows = 128;
+/// tf-drama-tower-oracle's options: the same cuBLASLt plan list and KV cache layout.
+const context = 128;
+const fixture_frames = max_rows + 1;
+const row_counts = [_]usize{ 1, 7, max_rows };
+const variants = [_][]const u8{ "traced", "untraced", "repeat" };
+const projection_count = 6; // tower.zig `projections.len`
+const head_kind = 5; // tower.zig `projections[5]` = { 4096, hidden }, the codebook head shape
+const head_index = 8; // codebook 9: audio_decoder_mtp.heads.8, the oracle's `p.heads[8]`
+const head_plan = (1 - 1) * projection_count + head_kind; // rows = 1, as generate() and the oracle
+/// The prefill's own layer array: every layer it iterates is captured.
+const layer_count = @typeInfo(@FieldType(Impl, "layers")).array.len;
+const stages = std.meta.tags(Stage);
+const stage_count = stages.len;
+const slots = layer_count * stage_count;
+/// shared_input once, then every other stage once per layer.
+const capture_count = 1 + layer_count * (stage_count - 1);
+const max_stage_width = blk: {
+    var m: usize = 0;
+    for (stages) |s| m = @max(m, tower.stageWidth(s));
+    break :blk m;
+};
+
+comptime {
+    std.debug.assert(layer_count == 13);
+    std.debug.assert(stages[0] == .shared_input);
+    std.debug.assert(tower.stageWidth(.output) == width and tower.stageWidth(.key) == kv_width);
+}
+
+/// What each stage file holds, in `tower.zig` terms.
+const stage_sources =
+    \\{"shared_input": "Impl.shared after setInput: drama_frame_embeddings sum of codes 2..9 (layer 0 mix extra input), BF16 [N, 2048]",
+    \\    "joined": "Impl.joined after drama_mix: [enorm(code embedding (+ shared_input)), hnorm(layer input)], BF16 [N, 4096]",
+    \\    "mixed": "Impl.mixed after eh_proj (projection 0), BF16 [N, 2048]",
+    \\    "attention_input": "Impl.normalized after drama_norm(mixed, input_norm), BF16 [N, 2048]",
+    \\    "qkv": "Impl.qkv after wqkv (projection 1), checkpoint column order [query 16x256 | gate 16x256 | key 2x256 | value 2x256], BF16 [N, 9216]",
+    \\    "query": "Impl.queries after drama_rope_cache: q_norm then interleaved rope on the first 64 dims, BF16 [N, 4096]",
+    \\    "key": "layer key cache rows position..position+N after drama_rope_cache: k_norm then rope, BF16 [N, 512]",
+    \\    "value": "layer value cache rows position..position+N after drama_rope_cache: raw qkv value, BF16 [N, 512]",
+    \\    "attended": "Impl.attended after drama_attention: causal attention times sigmoid(gate), the wo input, BF16 [N, 4096]",
+    \\    "attention_output": "Impl.branch after wo (projection 2), BF16 [N, 2048]",
+    \\    "mlp_input": "Impl.normalized after drama_norm(attention_output + mixed, post_norm), BF16 [N, 2048]",
+    \\    "mlp_residual": "Impl.residual after the same drama_norm: BF16 attention_output + mixed, BF16 [N, 2048]",
+    \\    "gate_up": "Impl.gate_up after projection 3: [w1 gate | w3 up], BF16 [N, 12288]",
+    \\    "activated": "Impl.activated after drama_silu_mul: silu(gate) * up, BF16 [N, 6144]",
+    \\    "mlp_output": "Impl.branch after w2 (projection 4), BF16 [N, 2048]",
+    \\    "output": "Impl.output_hidden after drama_norm(mlp_output + mlp_residual, final_norm): layer output, BF16 [N, 2048]"}
+;
+
+/// Recorded failures that leave the files written but the evidence invalid. Messages hold no quote or backslash.
+const Errors = struct {
+    gpa: Allocator,
+    json: std.ArrayList(u8) = .empty,
+    count: usize = 0,
+
+    fn add(e: *Errors, comptime f: []const u8, args: anytype) !void {
+        std.debug.print("error: " ++ f ++ "\n", args);
+        try e.json.appendSlice(e.gpa, if (e.count == 0) "\n    \"" else ",\n    \"");
+        try e.json.print(e.gpa, f, args);
+        try e.json.append(e.gpa, '"');
+        e.count += 1;
+    }
+};
+
+const Slot = struct { layer: usize, stage: Stage };
+
+/// The k-th capture of one prefill, in execution order.
+fn expectedSlot(k: usize) Slot {
+    if (k == 0) return .{ .layer = 0, .stage = .shared_input };
+    return .{ .layer = (k - 1) / (stage_count - 1), .stage = stages[1 + (k - 1) % (stage_count - 1)] };
+}
+
+fn slotOf(layer: usize, stage: Stage) usize {
+    return layer * stage_count + @backingInt(stage);
+}
+
+fn stageFile(buffer: []u8, n: usize, layer: usize, stage: Stage) ![]u8 {
+    return std.fmt.bufPrint(buffer, "native-{d}-layer-{d:0>2}-{s}.bf16", .{ n, layer, @tagName(stage) });
+}
+
+/// The `drama.tower.Model.prefillTraced` tracer for one run of N rows.
+const Tracer = struct {
+    io: std.Io,
+    dir: std.Io.Dir,
+    n: usize,
+    /// Pinned, max_rows * max_stage_width * 2 bytes: the target of the stream-ordered copy.
+    staging: []align(16) u8,
+    /// null: the first traced run, which writes every capture. Otherwise that run's hashes, compared instead.
+    first: ?*const [slots][32]u8,
+    hashes: [slots][32]u8 = undefined,
+    nonfinite: [slots]usize = @splat(0),
+    captures: usize = 0,
+    repeat_mismatches: usize = 0,
+    written: usize = 0,
+
+    pub fn capture(t: *Tracer, stream: cuda.Stream, layer: usize, stage: Stage, src: cuda.DeviceBuffer, row0: usize) !void {
+        if (t.captures >= capture_count) return error.TraceTooManyCaptures;
+        const want = expectedSlot(t.captures);
+        if (layer != want.layer or stage != want.stage) return error.TraceCaptureOutOfOrder;
+        if (row0 != 0) return error.TraceRowsOutOfRange;
+        const len = t.n * tower.stageWidth(stage) * 2;
+        if (src.len != len or len > t.staging.len) return error.TraceCaptureShape;
+        // Queued behind the stage's kernel and ahead of the next one, then drained before the prefill continues.
+        const bytes = t.staging[0..len];
+        try src.downloadAsync(0, bytes, stream.handle);
+        try stream.synchronize();
+        const at = slotOf(layer, stage);
+        std.crypto.hash.sha2.Sha256.hash(bytes, &t.hashes[at], .{});
+        t.nonfinite[at] = nonfiniteBf16(std.mem.bytesAsSlice(u16, bytes));
+        if (t.first) |first| {
+            if (!std.mem.eql(u8, &first[at], &t.hashes[at])) t.repeat_mismatches += 1;
+        } else {
+            var name_buffer: [80]u8 = undefined;
+            const name = try stageFile(&name_buffer, t.n, layer, stage);
+            try t.dir.writeFile(t.io, .{ .sub_path = name, .data = bytes, .flags = .{ .exclusive = true } });
+            t.written += bytes.len;
+        }
+        t.captures += 1;
+    }
+};
+
+/// One run's outputs, sized for max_rows; a case uses the first n rows.
+const Finals = struct {
+    hidden: []u16,
+    head: []u16,
+    /// [layer][keys, values][n][kv_width]
+    kv: []u16,
+
+    fn alloc(gpa: Allocator) !Finals {
+        const hidden = try gpa.alloc(u16, max_rows * width);
+        errdefer gpa.free(hidden);
+        const head = try gpa.alloc(u16, vocab);
+        errdefer gpa.free(head);
+        return .{ .hidden = hidden, .head = head, .kv = try gpa.alloc(u16, layer_count * 2 * max_rows * kv_width) };
+    }
+
+    fn free(f: Finals, gpa: Allocator) void {
+        gpa.free(f.hidden);
+        gpa.free(f.head);
+        gpa.free(f.kv);
+    }
+
+    fn kvRows(f: Finals, n: usize, layer: usize, which: usize) []u16 {
+        const at = (layer * 2 + which) * n * kv_width;
+        return f.kv[at .. at + n * kv_width];
+    }
+};
+
+fn view(buffer: cuda.DeviceBuffer, offset: usize, len: usize) cuda.DeviceBuffer {
+    std.debug.assert(offset <= buffer.len and len <= buffer.len - offset);
+    return .{ .d = buffer.d, .ptr = buffer.ptr + offset, .len = len, .borrowed = true };
+}
+
+/// The oracle's teacher-forced call, then its final hidden, head and KV exports. `trace` void: production prefill.
+fn runCase(model: *tower.Model, stream: cuda.Stream, n: usize, hidden: cuda.DeviceBuffer, frames: []const Frame, trace: anytype, f: Finals) !void {
+    try model.reset(stream, &.{}, 0);
+    _ = try model.setInput(stream, frames[0..n]);
+    if (@TypeOf(trace) == void)
+        try model.prefill(stream, view(hidden, 0, n * width * 2), frames[1 .. n + 1])
+    else
+        try model.prefillTraced(stream, view(hidden, 0, n * width * 2), frames[1 .. n + 1], trace);
+    const p = model.impl;
+    try p.output_hidden.download(0, std.mem.sliceAsBytes(f.hidden[0 .. n * width]));
+    // 0xffff is a BF16 NaN: a head that writes nothing cannot pass. Same plan, weights and row as the oracle.
+    try p.head_logits.fill8(0xff, stream.handle);
+    try p.plans.items[head_plan].run(p.output_hidden.ptr + (n - 1) * width * 2, p.heads[head_index].ptr, p.head_logits.ptr, p.workspace.ptr, p.workspace.len, stream.handle);
+    try stream.synchronize();
+    try p.head_logits.download(0, std.mem.sliceAsBytes(f.head));
+    for (0..layer_count) |layer| for (0..2) |which| {
+        try p.cache.download((layer * 2 + which) * context * kv_width * 2, std.mem.sliceAsBytes(f.kvRows(n, layer, which)));
+    };
+}
+
+fn differences(a: []const u16, b: []const u16) usize {
+    var count: usize = 0;
+    for (a, b) |x, y| {
+        if (x != y) count += 1;
+    }
+    return count;
+}
+
+const Diff = struct { hidden: usize, head9: usize, kv: usize };
+
+fn compareFinals(n: usize, a: Finals, b: Finals) Diff {
+    return .{
+        .hidden = differences(a.hidden[0 .. n * width], b.hidden[0 .. n * width]),
+        .head9 = differences(a.head, b.head),
+        .kv = differences(a.kv[0 .. layer_count * 2 * n * kv_width], b.kv[0 .. layer_count * 2 * n * kv_width]),
+    };
+}
+
+fn nonfiniteBf16(values: []const u16) usize {
+    var count: usize = 0;
+    for (values) |bits| {
+        if ((bits & 0x7f80) == 0x7f80) count += 1;
+    }
+    return count;
+}
+
+fn sha256Hex(bytes: []const u8) [64]u8 {
+    var out: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(bytes, &out, .{});
+    return std.fmt.bytesToHex(out, .lower);
+}
+
+fn fileSha256(gpa: Allocator, io: std.Io, path: []const u8) ![64]u8 {
+    const file = try std.Io.Dir.openFileAbsolute(io, path, .{});
+    defer file.close(io);
+    const buffer = try gpa.alloc(u8, 1 << 20);
+    defer gpa.free(buffer);
+    var hash = std.crypto.hash.sha2.Sha256.init(.{});
+    var offset: u64 = 0;
+    while (true) {
+        const got = try file.readPositionalAll(io, buffer, offset);
+        hash.update(buffer[0..got]);
+        offset += got;
+        if (got < buffer.len) break;
+    }
+    return std.fmt.bytesToHex(hash.finalResult(), .lower);
+}
+
+fn readExact(io: std.Io, dir: std.Io.Dir, name: []const u8, bytes: []u8) !void {
+    const file = try dir.openFile(io, name, .{});
+    defer file.close(io);
+    if (try file.length(io) != bytes.len or try file.readPositionalAll(io, bytes, 0) != bytes.len) return error.BadFixtureLength;
+}
+
+fn jsonString(list: *std.ArrayList(u8), gpa: Allocator, s: []const u8) !void {
+    try list.append(gpa, '"');
+    for (s) |c| switch (c) {
+        '"', '\\' => {
+            try list.append(gpa, '\\');
+            try list.append(gpa, c);
+        },
+        0...0x1f => try list.print(gpa, "\\u{x:0>4}", .{c}),
+        else => try list.append(gpa, c),
+    };
+    try list.append(gpa, '"');
+}
+
+/// Writes one run's final outputs as new files and appends their manifest entries.
+fn emitFinals(gpa: Allocator, io: std.Io, dir: std.Io.Dir, json: *std.ArrayList(u8), n: usize, variant: []const u8, f: Finals, errors: *Errors) !usize {
+    var name_buffer: [96]u8 = undefined;
+    var written: usize = 0;
+    try json.print(gpa, "\"{s}\": {{", .{variant});
+    const singles = [_]struct { kind: []const u8, data: []const u16, cols: usize, rows: usize }{
+        .{ .kind = "hidden", .data = f.hidden[0 .. n * width], .cols = width, .rows = n },
+        .{ .kind = "head9", .data = f.head, .cols = vocab, .rows = 1 },
+    };
+    for (singles) |s| {
+        const name = try std.fmt.bufPrint(&name_buffer, "native-{d}-{s}-{s}.bf16", .{ n, variant, s.kind });
+        const bytes = std.mem.sliceAsBytes(s.data);
+        try dir.writeFile(io, .{ .sub_path = name, .data = bytes, .flags = .{ .exclusive = true } });
+        written += bytes.len;
+        const bad = nonfiniteBf16(s.data);
+        if (bad != 0) try errors.add("{s}: {d} nonfinite values", .{ name, bad });
+        const sha = sha256Hex(bytes);
+        try json.print(gpa, "\"{s}\": {{\"file\": \"{s}\", \"sha256\": \"{s}\", \"shape\": [{d}, {d}], \"nonfinite\": {d}}}, ", .{ s.kind, name, sha[0..], s.rows, s.cols, bad });
+    }
+    try json.appendSlice(gpa, "\"kv\": [");
+    for (0..layer_count) |layer| for ([_][]const u8{ "keys", "values" }, 0..) |kind, which| {
+        const rows = f.kvRows(n, layer, which);
+        const name = try std.fmt.bufPrint(&name_buffer, "native-{d}-{s}-layer-{d:0>2}-{s}.bf16", .{ n, variant, layer, kind });
+        const bytes = std.mem.sliceAsBytes(rows);
+        try dir.writeFile(io, .{ .sub_path = name, .data = bytes, .flags = .{ .exclusive = true } });
+        written += bytes.len;
+        const bad = nonfiniteBf16(rows);
+        if (bad != 0) try errors.add("{s}: {d} nonfinite values", .{ name, bad });
+        const sha = sha256Hex(bytes);
+        try json.print(gpa, "{s}{{\"layer\": {d}, \"kind\": \"{s}\", \"file\": \"{s}\", \"sha256\": \"{s}\", \"shape\": [{d}, {d}], \"nonfinite\": {d}}}", .{
+            if (layer == 0 and which == 0) "" else ", ", layer, kind, name, sha[0..], n, kv_width, bad,
+        });
+    };
+    try json.appendSlice(gpa, "]}");
+    return written;
+}
+
+fn seconds(ns: anytype) f64 {
+    return @as(f64, @floatFromInt(ns)) / 1e9;
+}
+
+pub fn main(init: std.process.Init) !u8 {
+    const gpa = init.gpa;
+    const io = init.io;
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    if (args.len != 4) {
+        std.debug.print("usage: tf-drama-tower-trace CHECKPOINT INPUT_DIRECTORY OUTPUT_DIRECTORY\n", .{});
+        return 2;
+    }
+    if (builtin.cpu.arch.endian() != .little) return error.UnsupportedHostEndian;
+    const input = try std.Io.Dir.cwd().openDir(io, args[2], .{});
+    defer input.close(io);
+    const out = try std.Io.Dir.cwd().openDir(io, args[3], .{});
+    defer out.close(io);
+
+    // Every input is read before any CUDA call, so a missing or short fixture never touches the device.
+    const hidden = try gpa.alloc(u16, max_rows * width);
+    defer gpa.free(hidden);
+    var frames: [fixture_frames]Frame = undefined;
+    try readExact(io, input, "hidden.bf16", std.mem.sliceAsBytes(hidden));
+    try readExact(io, input, "frames.u32le", std.mem.sliceAsBytes(&frames));
+    const hidden_sha = sha256Hex(std.mem.sliceAsBytes(hidden));
+    const frames_sha = sha256Hex(std.mem.sliceAsBytes(&frames));
+    for (hidden) |bits| if ((bits & 0x7f80) == 0x7f80) return error.NonfiniteFixtureHidden;
+
+    var finals: [variants.len]Finals = undefined;
+    var allocated: usize = 0;
+    defer {
+        for (finals[0..allocated]) |f| f.free(gpa);
+    }
+    for (&finals) |*f| {
+        f.* = try Finals.alloc(gpa);
+        allocated += 1;
+    }
+    const device_check = try gpa.alloc(u16, max_rows * width);
+    defer gpa.free(device_check);
+
+    var errors: Errors = .{ .gpa = gpa };
+    defer errors.json.deinit(gpa);
+
+    _ = try cuda.setAllocationLimit(54 * (1 << 30));
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    // Same options as drama_tower_oracle.zig, so the plan list, weights, cache layout and buffers are the ones it ran.
+    var model = try tower.Model.init(gpa, io, &ctx, args[1], "", .{ .context = context, .max_rows = max_rows });
+    defer model.deinit();
+    const p = model.impl;
+    if (p.plans.items.len != max_rows * projection_count or p.head_logits.len != vocab * 2 or p.output_hidden.len != max_rows * width * 2 or
+        p.cache.len != layer_count * 2 * context * kv_width * 2) return error.UnexpectedTowerLayout;
+    const model_usage = cuda.usage(false);
+    var device_hidden = try cuda.DeviceBuffer.alloc(&driver, max_rows * width * 2);
+    defer device_hidden.free();
+    try device_hidden.upload(0, std.mem.sliceAsBytes(hidden));
+    var staging = try cuda.HostBuffer.alloc(&driver, max_rows * max_stage_width * 2);
+    defer staging.free();
+
+    var captures: std.ArrayList(u8) = .empty;
+    defer captures.deinit(gpa);
+    var cases: std.ArrayList(u8) = .empty;
+    defer cases.deinit(gpa);
+    var written: usize = 0;
+    var total_captures: usize = 0;
+    var name_buffer: [80]u8 = undefined;
+    for (row_counts, 0..) |n, case_index| {
+        var traced: Tracer = .{ .io = io, .dir = out, .n = n, .staging = staging.bytes, .first = null };
+        const traced_start = std.Io.Clock.awake.now(io).toNanoseconds();
+        try runCase(&model, stream, n, device_hidden, &frames, &traced, finals[0]);
+        const traced_ns = std.Io.Clock.awake.now(io).toNanoseconds() - traced_start;
+        const untraced_start = std.Io.Clock.awake.now(io).toNanoseconds();
+        try runCase(&model, stream, n, device_hidden, &frames, {}, finals[1]);
+        const untraced_ns = std.Io.Clock.awake.now(io).toNanoseconds() - untraced_start;
+        var repeat: Tracer = .{ .io = io, .dir = out, .n = n, .staging = staging.bytes, .first = &traced.hashes };
+        try runCase(&model, stream, n, device_hidden, &frames, &repeat, finals[2]);
+        total_captures += traced.captures + repeat.captures;
+        written += traced.written;
+
+        for ([_]*const Tracer{ &traced, &repeat }, [_][]const u8{ "traced", "repeat" }) |t, label| {
+            if (t.captures != capture_count) try errors.add("rows {d} {s}: {d} captures, expected {d}", .{ n, label, t.captures, capture_count });
+        }
+        if (repeat.repeat_mismatches != 0) try errors.add("rows {d}: {d} stage captures differ between traced runs", .{ n, repeat.repeat_mismatches });
+        const untraced_diff = compareFinals(n, finals[0], finals[1]);
+        const repeat_diff = compareFinals(n, finals[0], finals[2]);
+        for ([_]Diff{ untraced_diff, repeat_diff }, [_][]const u8{ "untraced", "repeat" }) |d, label| {
+            if (d.hidden != 0 or d.head9 != 0 or d.kv != 0)
+                try errors.add("rows {d}: traced vs {s} bit differences hidden {d} head9 {d} kv {d}", .{ n, label, d.hidden, d.head9, d.kv });
+        }
+
+        for (0..capture_count) |k| {
+            const slot = expectedSlot(k);
+            const at = slotOf(slot.layer, slot.stage);
+            const name = try stageFile(&name_buffer, n, slot.layer, slot.stage);
+            const bad = traced.nonfinite[at];
+            if (bad != 0) try errors.add("{s}: {d} nonfinite values", .{ name, bad });
+            const repeat_equal = std.mem.eql(u8, &traced.hashes[at], &repeat.hashes[at]);
+            const sha = std.fmt.bytesToHex(traced.hashes[at], .lower);
+            try captures.print(gpa, "{s}\n    {{\"rows\": {d}, \"order\": {d}, \"layer\": {d}, \"stage\": \"{s}\", \"file\": \"{s}\", \"sha256\": \"{s}\", \"shape\": [{d}, {d}], \"dtype\": \"bf16le\", \"row0\": 0, \"nonfinite\": {d}, \"repeat_bit_equal\": {}}}", .{
+                if (captures.items.len == 0) "" else ",", n, k, slot.layer, @tagName(slot.stage), name, sha[0..], n, tower.stageWidth(slot.stage), bad, repeat_equal,
+            });
+        }
+
+        try cases.print(gpa, "{s}\n    {{\"rows\": {d}, \"head_row\": {d}, \"captures_per_run\": {d}, \"stage_repeat_mismatches\": {d}," ++
+            " \"traced_vs_untraced_bit_differences\": {{\"hidden\": {d}, \"head9\": {d}, \"kv\": {d}}}," ++
+            " \"traced_vs_repeat_bit_differences\": {{\"hidden\": {d}, \"head9\": {d}, \"kv\": {d}}}," ++
+            " \"timing_s\": {{\"traced\": {d:.6}, \"untraced\": {d:.6}}}, \"finals\": {{", .{
+            if (case_index == 0) "" else ",", n,                   n - 1,                capture_count,      repeat.repeat_mismatches,
+            untraced_diff.hidden,             untraced_diff.head9, untraced_diff.kv,     repeat_diff.hidden, repeat_diff.head9,
+            repeat_diff.kv,                   seconds(traced_ns),  seconds(untraced_ns),
+        });
+        for (variants, finals, 0..) |variant, f, i| {
+            if (i != 0) try cases.appendSlice(gpa, ", ");
+            written += try emitFinals(gpa, io, out, &cases, n, variant, f, &errors);
+        }
+        try cases.appendSlice(gpa, "}}");
+        std.debug.print("tower_rows={d} captures={d} traced_untraced_hidden_diff={d} head9_diff={d} kv_diff={d} repeat_hidden_diff={d} stage_repeat_mismatches={d}\n", .{
+            n, traced.captures, untraced_diff.hidden, untraced_diff.head9, untraced_diff.kv, repeat_diff.hidden, repeat.repeat_mismatches,
+        });
+    }
+
+    // Input immutability: the device rows every case read, and the host fixture bytes, are what was loaded.
+    try device_hidden.download(0, std.mem.sliceAsBytes(device_check));
+    const device_input_differences = differences(device_check, hidden);
+    if (device_input_differences != 0) try errors.add("device input hidden changed in {d} values", .{device_input_differences});
+    const hidden_sha_after = sha256Hex(std.mem.sliceAsBytes(hidden));
+    const frames_sha_after = sha256Hex(std.mem.sliceAsBytes(&frames));
+    const host_hidden_unchanged = std.mem.eql(u8, &hidden_sha_after, &hidden_sha);
+    const host_frames_unchanged = std.mem.eql(u8, &frames_sha_after, &frames_sha);
+    if (!host_hidden_unchanged or !host_frames_unchanged) try errors.add("host fixture changed: hidden unchanged {} frames unchanged {}", .{ host_hidden_unchanged, host_frames_unchanged });
+    const used = cuda.usage(false);
+
+    var binary_json: std.ArrayList(u8) = .empty;
+    defer binary_json.deinit(gpa);
+    if (fileSha256(gpa, io, "/proc/self/exe")) |sha| {
+        try binary_json.print(gpa, "\"{s}\"", .{sha[0..]});
+    } else |err| {
+        std.debug.print("binary hash unavailable: {s}\n", .{@errorName(err)});
+        try binary_json.appendSlice(gpa, "null");
+    }
+    const tower_source_sha = sha256Hex(tower.trace_source);
+    const trace_source_sha = sha256Hex(@embedFile("drama_tower_trace.zig"));
+    const kernel_image_sha = sha256Hex(cuda.kernels.drama_tower);
+    if (cuda.kernels.drama_tower.len == 0) try errors.add("embedded drama_tower kernel image is empty", .{});
+    const evidence_valid = errors.count == 0;
+
+    var manifest: std.ArrayList(u8) = .empty;
+    defer manifest.deinit(gpa);
+    try manifest.appendSlice(gpa, "{\n  \"schema_version\": 1,\n  \"producer\": \"tf-drama-tower-trace\",\n  \"checkpoint\": ");
+    try jsonString(&manifest, gpa, args[1]);
+    try manifest.appendSlice(gpa, ",\n  \"input_directory\": ");
+    try jsonString(&manifest, gpa, args[2]);
+    try manifest.print(gpa, ",\n  \"input_hidden_sha256\": \"{s}\",\n  \"input_frames_sha256\": \"{s}\",\n  \"width\": {d},\n  \"dtype\": \"bf16le\",\n  \"layer_count\": {d}," ++
+        "\n  \"rows\": [{d}, {d}, {d}],\n  \"model_options\": {{\"context\": {d}, \"max_rows\": {d}}},\n  \"stage_order\": [", .{
+        hidden_sha[0..], frames_sha[0..], width, layer_count, row_counts[0], row_counts[1], row_counts[2], context, max_rows,
+    });
+    for (stages, 0..) |stage, i| try manifest.print(gpa, "{s}\"{s}\"", .{ if (i == 0) "" else ", ", @tagName(stage) });
+    try manifest.appendSlice(gpa, "],\n  \"stage_widths\": {");
+    for (stages, 0..) |stage, i| try manifest.print(gpa, "{s}\"{s}\": {d}", .{ if (i == 0) "" else ", ", @tagName(stage), tower.stageWidth(stage) });
+    try manifest.print(gpa, "}},\n  \"stage_sources\": {s},\n  \"capture_order\": \"shared_input (layer 0) once, then the remaining stages in stage_order for layers 0..12; enforced\"," ++
+        "\n  \"row_mapping\": \"row r of every capture and final is request position r (reset position 0; prefill rows 0..N-1, labels frames[r+1]); KV rows are cache positions 0..N-1\"," ++
+        "\n  \"head\": {{\"weight\": \"audio_decoder_mtp.heads.{d}.weight\", \"plan\": \"plans[{d}] (rows 1, kind {d})\", \"input\": \"layer 12 output row N-1\"}}," ++
+        "\n  \"captures\": [{s}\n  ],\n  \"cases\": [{s}\n  ]," ++
+        "\n  \"input_immutable\": {{\"device_hidden_differences\": {d}, \"host_hidden_unchanged\": {}, \"host_frames_unchanged\": {}}}," ++
+        "\n  \"allocations\": {{\"cuda_device_bytes_after_init\": {d}, \"cuda_device_bytes\": {d}, \"cuda_device_peak_bytes\": {d}, \"pinned_host_bytes\": {d}, \"trace_staging_pinned_bytes\": {d}}}," ++
+        "\n  \"bytes_written\": {d},\n  \"total_captures\": {d}," ++
+        "\n  \"binary_sha256\": {s},\n  \"tower_source_sha256\": \"{s}\",\n  \"trace_source_sha256\": \"{s}\",\n  \"tower_kernel_image_sha256\": \"{s}\"," ++
+        "\n  \"evidence_valid\": {},\n  \"errors\": [{s}\n  ]\n}}\n", .{
+        stage_sources,         head_index,            head_plan,                head_kind,
+        captures.items,        cases.items,           device_input_differences, host_hidden_unchanged,
+        host_frames_unchanged, model_usage.device,    used.device,              used.peak,
+        used.host,             staging.bytes.len,     written,                  total_captures,
+        binary_json.items,     tower_source_sha[0..], trace_source_sha[0..],    kernel_image_sha[0..],
+        evidence_valid,        errors.json.items,
+    });
+    try out.writeFile(io, .{ .sub_path = "manifest.json", .data = manifest.items, .flags = .{ .exclusive = true } });
+    std.debug.print("cases={d} captures={d} bytes_written={d} evidence_valid={} errors={d} cuda_bytes={d} cuda_peak={d} pinned_bytes={d}\n", .{
+        row_counts.len, total_captures, written + manifest.items.len, evidence_valid, errors.count, used.device, used.peak, used.host,
+    });
+    return if (evidence_valid) 0 else 3;
+}
