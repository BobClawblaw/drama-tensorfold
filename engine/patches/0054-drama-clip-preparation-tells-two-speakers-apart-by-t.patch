     return float(sorted_medians[np.argmax(share >= 0.8)] - sorted_medians[np.argmax(share >= 0.2)]), len(medians)
 
 
+def mel_bank() -> np.ndarray:
+    """Triangular mel bands from MEL_LOW to MEL_HIGH over the bins of a SPECTRUM-point FFT."""
+    mel = 2595 * np.log10(1 + np.array([MEL_LOW, MEL_HIGH]) / 700)
+    edges = 700 * (10 ** (np.linspace(*mel, MEL_BANDS + 2) / 2595) - 1)
+    freqs = np.fft.rfftfreq(SPECTRUM, 1 / RATE)
+    low, centre, high = edges[:-2, None], edges[1:-1, None], edges[2:, None]
+    return np.clip(np.minimum((freqs - low) / (centre - low), (high - freqs) / (high - centre)), 0, None)
+
+
+def cepstra(x: np.ndarray, frames: np.ndarray) -> np.ndarray:
+    """Mel cepstra 1 to CEPSTRA of the 10 ms frames `frames`, each over the ENVELOPE_SAMPLES around its centre."""
+    at = np.clip(frames[:, None] * HOP + HOP // 2 - ENVELOPE_SAMPLES // 2 + np.arange(ENVELOPE_SAMPLES), 0, len(x) - 1)
+    power = np.abs(np.fft.rfft(x[at] * np.hanning(ENVELOPE_SAMPLES), SPECTRUM, axis=1)) ** 2
+    dct = np.cos(np.pi / MEL_BANDS * (np.arange(MEL_BANDS) + 0.5) * np.arange(1, CEPSTRA + 1)[:, None])
+    return np.log(power @ mel_bank().T + 1e-10) @ dct.T
+
+
+def two_groups(means: np.ndarray, weights: np.ndarray) -> np.ndarray:
+    """Weighted 2-means of `means`, started from the split along their main axis; True marks one group."""
+    centred = means - np.average(means, axis=0, weights=weights)
+    side = centred @ np.linalg.svd(centred * np.sqrt(weights)[:, None], full_matrices=False)[2][0] > 0
+    for _ in range(50):
+        if side.all() or not side.any():
+            break
+        near = [np.average(means[group], axis=0, weights=weights[group]) for group in (side, ~side)]
+        moved = ((means - near[0]) ** 2).sum(axis=1) < ((means - near[1]) ** 2).sum(axis=1)
+        if (moved == side).all():
+            break
+        side = moved
+    return side
+
+
+def speaker_split(x: np.ndarray, db: np.ndarray, level: float) -> float:
+    """sqrt(T² / rank): T² is Hotelling's two-sample statistic of the two groups a weighted two-means split gives."""
+    loud = np.flatnonzero(db >= level - 20)
+    groups = [group for start, end in stretches(db, level) if len(group := np.flatnonzero((loud >= start) & (loud < end))) >= STRETCH_FRAMES]
+    if len(groups) < 2:
+        raise SystemExit("fewer than two stretches of speech between pauses, so a second speaker cannot be ruled out: pause between sentences")
+    found = cepstra(x, loud)
+    spread, axes = np.linalg.eigh(np.cov(found.T))
+    kept = spread > spread[-1] * RANK_TOLERANCE
+    rank = int(kept.sum())
+    if rank < MIN_RANK:
+        raise SystemExit(f"the voice cannot be measured: its spectrum changes in {rank} of {CEPSTRA} directions (a repeated sound, for one)")
+    # whitened in the directions that vary, so the stretches group by each alike
+    z = (found - found.mean(axis=0)) @ axes[:, kept] / np.sqrt(spread[kept])
+    side = two_groups(np.array([z[group].mean(axis=0) for group in groups]), np.array([len(group) for group in groups], float))
+    if side.all() or not side.any():
+        # the stretches' means coincide: nothing sets one apart
+        return 0.0
+    a, b = (z[np.concatenate([group for group, s in zip(groups, side) if s == which])] for which in (True, False))
+    pooled = ((len(a) - 1) * np.cov(a.T) + (len(b) - 1) * np.cov(b.T)) / (len(a) + len(b) - 2)
+    within, along = np.linalg.eigh(pooled)
+    held = within > within[-1] * RANK_TOLERANCE
+    gap = (a.mean(axis=0) - b.mean(axis=0)) @ along
+    if np.any(np.abs(gap[~held]) > NULL_GAP):
+        raise SystemExit("the stretches fall into two groups that do not overlap at all in one direction: more than one speaker")
+    return float(np.sqrt(np.sum(gap[held] ** 2 / within[held]) / (rank * (1 / len(a) + 1 / len(b)))))
+
