From 70797adb8f7150fbb75f5af07aa3648d1bf3253e Mon Sep 17 00:00:00 2001
From: plotarmordev <299844489+plotarmordev@users.noreply.github.com>
Date: Fri, 16 Oct 2026 21:13:10 +0800
Subject: [PATCH 42/44] drama: a long-form reply's trailers are formatted
 without allocating, so a started stream always ends with them

---
 docs/drama-voices.md           |  2 +-
 zig/src/server/drama_long.zig  | 28 +++++++++++++++++-----------
 zig/src/server/speech_long.zig |  7 +++++--
 3 files changed, 23 insertions(+), 14 deletions(-)

diff --git a/docs/drama-voices.md b/docs/drama-voices.md
index 698c5e5e..13dc8beb 100644
--- a/docs/drama-voices.md
+++ b/docs/drama-voices.md
@@ -116,6 +116,6 @@ With `--long-form`, a speech input longer than `--long-form-chars` (default 500
   - A reply may use 6000 frames in all; each segment gets at most what is left.
   - A segment that is clipped (by the engine's frame limit or the budget) or ended by the silence guard ends the reply, and its audio is kept.
 - **Response headers.** `X-Finish-Reason` is `stop` only when every segment stopped by itself; otherwise it is the last segment's `length` or `silence`. `X-Long-Form-Segments: N;S2,S3,…` gives the number of segments spoken and the sample offset at which each segment after the first starts, after the added pauses.
-- **Streaming.** With `stream: true`, segment 1 streams as it is made. Each later segment is sent whole, with its pause, once it is complete, because its level and pause need all of it. Both headers come as trailers, declared by `Trailer: X-Finish-Reason, X-Long-Form-Segments`.
+- **Streaming.** With `stream: true`, segment 1 streams as it is made. Each later segment is sent whole, with its pause, once it is complete, because its level and pause need all of it. Both headers come as trailers, declared by `Trailer: X-Finish-Reason, X-Long-Form-Segments`. They are formatted without allocating, so a stream that finishes always ends with them.
 
 An input that fits in one segment, and every request when `--long-form` is off, is served exactly as before.
diff --git a/zig/src/server/drama_long.zig b/zig/src/server/drama_long.zig
index da51a11d..b74f1a60 100644
--- a/zig/src/server/drama_long.zig
+++ b/zig/src/server/drama_long.zig
@@ -269,12 +269,16 @@ pub fn carried(a: Allocator, base: []const Reference, heard: []const Reference,
     return std.mem.concat(a, Reference, &.{ base, heard[heard.len - keep ..] });
 }
 
-/// The X-Long-Form-Segments value: the segments spoken, then where each after the first starts, in samples.
-pub fn segmentsHeader(a: Allocator, starts: []const usize) Allocator.Error![]const u8 {
-    var out: std.ArrayList(u8) = .empty;
-    try out.print(a, "{d};", .{starts.len});
-    for (starts[1..], 0..) |start, i| try out.print(a, "{s}{d}", .{ if (i == 0) "" else ",", start });
-    return out.items;
+/// Bytes the X-Long-Form-Segments value takes at most: the count, then each later start as 20 digits, commas between.
+pub const segments_header_max = std.fmt.comptimePrint("{d};", .{max_segments}).len + (max_segments - 1) * 20 + (max_segments - 2);
+
+/// The X-Long-Form-Segments value in `buf`: the segments spoken, then where each after the first starts, in samples.
+pub fn segmentsHeader(buf: *[segments_header_max]u8, starts: []const usize) []const u8 {
+    std.debug.assert(starts.len >= 1 and starts.len <= max_segments);
+    var w: std.Io.Writer = .fixed(buf);
+    w.print("{d};", .{starts.len}) catch unreachable; // the buffer holds the largest value
+    for (starts[1..], 0..) |start, i| w.print("{s}{d}", .{ if (i == 0) "" else ",", start }) catch unreachable;
+    return w.buffered();
 }
 
 fn expectSplit(input: []const u8, chars: u32, want: []const []const u8) !void {
@@ -395,9 +399,11 @@ test "a sentence longer than the limit is cut at clause marks, then spaces, then
     try expectSplit("\u{3042}\u{3044}\u{3046}\u{3048}\u{304a}", 2, &.{ "\u{3042}\u{3044}", "\u{3046}\u{3048}", "\u{304a}" });
 }
 
-test "the segments header lists where each segment after the first starts" {
-    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
-    defer arena.deinit();
-    try std.testing.expectEqualStrings("3;2048,6144", try segmentsHeader(arena.allocator(), &.{ 0, 2048, 6144 }));
-    try std.testing.expectEqualStrings("1;", try segmentsHeader(arena.allocator(), &.{0}));
+test "the segments header lists where each segment after the first starts, and its largest value fits its buffer" {
+    var buf: [segments_header_max]u8 = undefined;
+    try std.testing.expectEqualStrings("3;2048,6144", segmentsHeader(&buf, &.{ 0, 2048, 6144 }));
+    try std.testing.expectEqualStrings("1;", segmentsHeader(&buf, &.{0}));
+    var starts: [max_segments]usize = @splat(std.math.maxInt(usize));
+    starts[0] = 0;
+    try std.testing.expectEqual(segments_header_max, segmentsHeader(&buf, &starts).len);
 }
diff --git a/zig/src/server/speech_long.zig b/zig/src/server/speech_long.zig
index 453904a6..f3d608bd 100644
--- a/zig/src/server/speech_long.zig
+++ b/zig/src/server/speech_long.zig
@@ -238,14 +238,17 @@ const Reply = struct {
 
     /// The whole body with the segments header, or the stream's terminating chunk with its trailers.
     fn finish(r: *Reply, format: speech.Format) void {
-        const segments = drama_long.segmentsHeader(r.cx.a, r.starts.items) catch return speech.fail(r.c, r.cx, r.id, .server, "out of memory");
+        // fixed buffers, never allocation: a stream already open must end with its trailers
+        var header: [drama_long.segments_header_max]u8 = undefined;
+        const segments = drama_long.segmentsHeader(&header, r.starts.items);
         if (r.stream) {
             const reason = switch (r.reason) {
                 .length => "X-Finish-Reason: length\r\n",
                 .silence => "X-Finish-Reason: silence\r\n",
                 else => "",
             };
-            const last = std.fmt.allocPrint(r.cx.a, "0\r\n{s}X-Long-Form-Segments: {s}\r\n\r\n", .{ reason, segments }) catch "0\r\n\r\n";
+            var buf: [drama_long.segments_header_max + 64]u8 = undefined;
+            const last = std.fmt.bufPrint(&buf, "0\r\n{s}X-Long-Form-Segments: {s}\r\n\r\n", .{ reason, segments }) catch unreachable;
             r.c.writeAll(last) catch {
                 r.c.close = true;
                 return;
