+const RowList = struct {
+    tokens: std.ArrayList(u32) = .empty,
+    codes: std.ArrayList(Codes) = .empty,
+
+    fn text(r: *RowList, a: Allocator, t: model_text.Text, segment: []const u8) model_text.Error!void {
+        const ids = try t.encode(a, segment, true);
+        try r.tokens.appendSlice(a, ids);
+        try r.codes.appendNTimes(a, @splat(0), ids.len);
+    }
+};
