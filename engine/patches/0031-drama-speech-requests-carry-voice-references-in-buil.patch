+/// A transcript as ``build_prompt_rows`` writes it: tagged, with a tag behind leading white space moved before it.
+pub fn transcript(a: Allocator, text: []const u8) Allocator.Error![]const u8 {
+    const with_tag = try tagged(a, text);
+    const body = trimStart(with_tag);
+    const tag = tagAt(body, 0).?;
+    return std.mem.concat(a, u8, &.{ body[0..tag.end], with_tag[0 .. with_tag.len - body.len], body[tag.end..] });
+}
