+/// ``build_prompt_rows`` with checked references: a frame's row is ``<|semantic:0|>`` plus its code 0, then its codes.
+pub fn encodeReferenced(a: Allocator, text: model_text.Text, input: []const u8, references: []const Reference) model_text.Error!Rows {
+    const begin = text.tokenId(semantic_begin_token) orelse return error.Template;
+    var rows: RowList = .{};
+    try rows.text(a, text, "<|im_start|>system\n");
+    try rows.text(a, text, reference_instruction);
+    for (references, 1..) |reference, n| {
+        try rows.text(a, text, try std.fmt.allocPrint(a, "\n\n[Reference {d}]\nText: {s}\nSpeech: ", .{ n, try transcript(a, reference.text) }));
+        for (reference.frames) |frame| {
+            try rows.tokens.append(a, begin + frame[0]);
+            try rows.codes.append(a, frame);
+        }
+    }
+    for ([_][]const u8{ message_end, "<|im_start|>user\n", try tagged(a, input), message_end, generation_start }) |segment| try rows.text(a, text, segment);
+    return .{ .tokens = rows.tokens.items, .codes = rows.codes.items };
+}
