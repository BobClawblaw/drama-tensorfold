@@ -0,0 +1,61 @@
+# Drama 3 voices
+
+Drama 3 can speak in a reference voice. The prompt carries a clip's codec codes and the clip's transcript, the way the pinned reference (sglang-omni `prompt.py`, `build_prompt_rows`) builds it.
+The native server does not encode audio. A clip is encoded once, offline, into a voice file.
+
+## Encode a clip
+
+```sh
+python3 tools/zig/drama_voice.py --reference SGLANG_OMNI_CHECKOUT --checkpoint DRAMA3_DIR \
+  --audio clip.wav --text clip.txt --out voices/NAME.json
+```
+
+The tool runs the reference server's own encode for a `references[].audio_path`: `load_audio` at the codec's 44.1 kHz in mono, then `FishReferenceEncodeHook` under bfloat16 autocast on CUDA (the reference's default `reference_encode_dtype`). With `--device cpu` it encodes in float32.
+Clips longer than 60 s are refused, as the reference refuses them. A 15.7 s clip takes about 2.6 GB of device memory and 10 to 20 s, most of it loading `codec.pth`.
+The transcript must be the clip's exact words; leading and trailing white space is dropped.
+
+A voice file is JSON with these fields:
+
+- `format`: `drama3-voice/1`.
+- `text`: the transcript.
+- `vq_codes`: the `[10, frames]` code grid.
+- `codes_sha256`: the grid as little-endian int32, codebook-major.
+- Provenance: `audio_sha256`, `frames` and `encoder` (reference commit, `codec.pth` digest, dtype, device, peak memory).
+
+Voice files hold a person's voice: keep them out of source control.
+
+## Serve voices
+
+```sh
+tensorfold serve DRAMA3_DIR --voices voices/ --default-voice NAME
+```
+
+- `--voices DIR` reads every regular `NAME.json` file in `DIR` once, at startup.
+  - Names are 1 to 64 characters of `A-Z a-z 0-9 . _ -` and start with a letter or digit. `default` is reserved.
+  - Hidden files, other extensions, directories and symbolic links are skipped.
+  - A file with a bad name, an unknown format, a transcript the reference would refuse, or codes that do not match `codes_sha256` stops the server from starting.
+  - Requests only name voices; no request path reaches the file system.
+- `--default-voice NAME` is used when a request names no voice, or names `default`. Without it, those requests use the model's built-in voice and are unchanged.
+
+## Requests
+
+```json
+{"model": "drama-3", "input": "The next train departs at nine.", "voice": "NAME"}
+```
+
+`references: [{"text": ..., "vq_codes": [[...], ...]}]` sends references inline, as the reference accepts them. A named voice's reference follows the request's own references.
+Refusals carry the reference's messages, in its order.
+Some refusals are the native server's own:
+
+- Reference audio (`audio_path`, `ref_audio`, `audio`, `data`) is refused: encode it with the tool and send `vq_codes`.
+- Unknown reference fields are refused, not dropped.
+
+## Expressiveness
+
+The model card's documented controls are written in the input text:
+
+- Point tags in square brackets, such as `[sighs]` and `[laughs]`, placed where the event should land. The card shows those two and lists no full vocabulary.
+- Speaker tags. Only `<|speaker:0|>` is served, as in the reference.
+
+The prompt builder treats point tags as ordinary text, so they reach the model unchanged.
+Pacing also follows the reference clip and the punctuation.
diff --git a/tools/zig/drama_voice.py b/tools/zig/drama_voice.py
new file mode 100644
index 00000000..b406ec99
--- /dev/null
+++ b/tools/zig/drama_voice.py
@@ -0,0 +1,89 @@
+"""Encode a clip and its transcript into a Drama 3 voice file with the pinned reference's encoder."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+FORMAT = "drama3-voice/1"
+# The reference's max_reference_audio_seconds default.
+MAX_SECONDS = 60.0
+NUM_CODEBOOKS = 10
+CODEBOOK_SIZE = 4096
+
+
+def sha256(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def codes_sha256(rows: list[list[int]]) -> str:
+    """The digest the native loader checks: the [codebooks, frames] grid as little-endian int32, codebook-major."""
+    return sha256(b"".join(code.to_bytes(4, "little", signed=True) for row in rows for code in row))
+
+
+def encode(reference: Path, checkpoint: Path, audio: Path, device: str) -> tuple[list[list[int]], dict]:
+    sys.path.insert(0, str(reference))
+    import torch
+    from sglang_omni.models.fishaudio_s2_pro.stages import FishReferenceEncodeHook, FishReferenceInput, load_codec
+
+    codec = load_codec(str(checkpoint), device)
+    on_cuda = torch.device(device).type == "cuda"
+    hook = FishReferenceEncodeHook(
+        codec=codec,
+        checkpoint_id=str(checkpoint / "codec.pth"),
+        device=device,
+        autocast_dtype=torch.bfloat16 if on_cuda else None,
+        max_reference_audio_seconds=MAX_SECONDS,
+    )
+    if on_cuda:
+        torch.cuda.reset_peak_memory_stats()
+    codes = hook.encode_one(FishReferenceInput("path", str(audio)))
+    if codes.dtype not in (torch.int32, torch.int64) or codes.ndim != 2 or codes.shape[0] != NUM_CODEBOOKS:
+        raise SystemExit(f"the codec returned {codes.dtype} {tuple(codes.shape)}, not [{NUM_CODEBOOKS}, frames]")
+    if codes.numel() == 0 or codes.min() < 0 or codes.max() >= CODEBOOK_SIZE:
+        raise SystemExit(f"the codec returned codes outside [0, {CODEBOOK_SIZE})")
+    encoder = {
+        "reference_commit": subprocess.run(["git", "-C", str(reference), "rev-parse", "HEAD"], capture_output=True, text=True, check=True).stdout.strip(),
+        "codec_sha256": sha256((checkpoint / "codec.pth").read_bytes()),
+        "sample_rate": int(codec.sample_rate),
+        "frame_length": int(codec.frame_length),
+        "dtype": "bfloat16" if on_cuda else "float32",
+        "device": torch.cuda.get_device_name() if on_cuda else "cpu",
+        "peak_device_bytes": int(torch.cuda.max_memory_allocated()) if on_cuda else 0,
+    }
+    return codes.tolist(), encoder
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--reference", type=Path, required=True, help="the pinned sglang-omni checkout")
+    parser.add_argument("--checkpoint", type=Path, required=True, help="the Drama 3 checkpoint holding codec.pth")
+    parser.add_argument("--audio", type=Path, required=True, help="the reference clip, at most 60 s")
+    parser.add_argument("--text", type=Path, required=True, help="the clip's exact transcript (UTF-8; outer white space dropped)")
+    parser.add_argument("--out", type=Path, required=True, help="the voice file; its stem is the voice's name")
+    parser.add_argument("--device", default="cuda")
+    args = parser.parse_args()
+    audio = args.audio.read_bytes()
+    transcript = args.text.read_text(encoding="utf-8").strip()
+    if not transcript:
+        raise SystemExit(f"{args.text} holds no transcript")
+    rows, encoder = encode(args.reference, args.checkpoint, args.audio, args.device)
+    voice = {
+        "format": FORMAT,
+        "text": transcript,
+        "codes_sha256": codes_sha256(rows),
+        "frames": len(rows[0]),
+        "audio_sha256": sha256(audio),
+        "encoder": encoder,
+        "vq_codes": rows,
+    }
+    args.out.write_text(json.dumps(voice, ensure_ascii=False) + "\n", encoding="utf-8")
+    print(json.dumps({key: value for key, value in voice.items() if key != "vq_codes"}, ensure_ascii=False))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
