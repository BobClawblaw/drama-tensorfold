new file mode 100644
index 00000000..943fd63a
--- /dev/null
+++ b/zig/src/server/speech_long.zig
@@ -0,0 +1,192 @@
+//! /v1/audio/speech with --long-form: a long input spoken segment by segment, each hearing the audio of those before.
+const std = @import("std");
+const api = @import("engine_api");
+const errors = @import("errors.zig");
+const speech = @import("speech.zig");
+const drama_prompt = @import("drama_prompt.zig");
+const drama_long = @import("drama_long.zig");
+const log = @import("log.zig");
+const clock = @import("clock.zig");
+const Mailbox = @import("mailbox.zig").Mailbox;
+const Server = @import("server.zig").Server;
+const Conn = @import("http_conn.zig").Conn;
+const Cx = errors.Cx;
+const Reference = drama_prompt.Reference;
+const Codes = drama_prompt.Codes;
+
+/// A long-form reply's segments, the references each hears first, and how many earlier segments it hears after them.
+pub const Long = struct { segments: []const []const u8, references: []const Reference, history: u8 };
+
+/// The stream's trailers: the finish reason when clipped, and where the segments start.
+const trailer = "X-Finish-Reason, X-Long-Form-Segments";
+
+/// The input's segments when it has two or more, each refused now as a whole input would be; null: one synthesis.
+pub fn plan(srv: *Server, cx: *Cx, sp: api.SpeechInfo, input: []const u8, references: []const Reference, options: drama_long.Options) errors.Refused!?Long {
+    if ((std.unicode.utf8CountCodepoints(input) catch unreachable) <= options.chars) return null;
+    const segments = try drama_long.split(cx.a, input, options.chars);
+    if (segments.len <= 1) return null;
+    if (segments.len > drama_long.max_segments)
+        return cx.fail(.request, drama_prompt.error_prefix ++ " a long-form input in {d} segments of at most {d} characters exceeds the maximum of {d} segments", .{ segments.len, options.chars, drama_long.max_segments });
+    for (segments) |segment| {
+        if (try drama_prompt.problem(cx.a, segment)) |message| return cx.refuse(message);
+        const rows = speech.encode(srv, cx.a, segment, references) catch |e| return switch (e) {
+            error.OutOfMemory => error.OutOfMemory,
+            error.Template => cx.other("the tokenizer cannot encode this prompt"),
+        };
+        if (rows.tokens.len > sp.max_prompt_tokens)
+            return cx.fail(.request, drama_prompt.error_prefix ++ " a prompt of {d} rows exceeds the maximum allowed length of {d} rows", .{ rows.tokens.len, sp.max_prompt_tokens });
+    }
+    return .{ .segments = segments, .references = references, .history = options.history };
+}
+
+/// Speaks every segment into one reply: a WAV or PCM body, or a PCM stream from the first segment's first audio.
+pub fn synthesize(srv: *Server, c: *Conn, cx: *Cx, id: []const u8, sp: api.SpeechInfo, long: Long, format: speech.Format, stream: bool, received: i96) void {
+    if (sp.frame_length == 0 or sp.max_frames == 0 or sp.sample_rate == 0 or sp.sample_rate > std.math.maxInt(u32) / 2)
+        return speech.fail(c, cx, id, .server, "the engine advertises no usable speech output");
+    const pcm = srv.gpa.alloc(f32, drama_long.max_frames * @as(usize, sp.frame_length)) catch return speech.fail(c, cx, id, .server, "out of memory");
+    defer srv.gpa.free(pcm);
+    const generated = srv.gpa.alloc(Codes, drama_long.max_frames) catch return speech.fail(c, cx, id, .server, "out of memory");
+    defer srv.gpa.free(generated);
+    if (srv.keepalive) |k| k.begin();
+    defer if (srv.keepalive) |k| k.end();
+    var r: Reply = .{ .srv = srv, .c = c, .cx = cx, .id = id, .sp = sp, .long = long, .stream = stream, .received = received, .pcm = pcm, .generated = generated };
+    for (0..long.segments.len) |i| {
+        if (r.frames == drama_long.max_frames) {
+            r.reason = .length;
+            break;
+        }
+        if (!r.speak(i)) return;
+        // a clipped segment's audio would be the next one's carry-over: the reply ends with it
+        if (r.reason == .length) break;
+    }
+    r.finish(format);
+}
+
+const Reply = struct {
+    srv: *Server,
+    c: *Conn,
+    cx: *Cx,
+    id: []const u8,
+    sp: api.SpeechInfo,
+    long: Long,
+    stream: bool,
+    received: i96,
+    pcm: []f32,
+    generated: []Codes,
+    heard: std.ArrayList(Reference) = .empty,
+    starts: std.ArrayList(usize) = .empty,
+    frames: usize = 0,
+    rows: usize = 0,
+    reason: api.Reason = .stop,
+    open: bool = false,
+    first_ready: i96 = 0,
+
+    /// Segment `i`'s prompt: its references, then the latest segments heard while it fits (bare, `plan` checked it).
+    fn prompt(r: *Reply, i: usize) !drama_prompt.Rows {
+        var keep: usize = @min(r.long.history, r.heard.items.len);
+        while (true) : (keep -= 1) {
+            const rows = try speech.encode(r.srv, r.cx.a, r.long.segments[i], try drama_long.carried(r.cx.a, r.long.references, r.heard.items, keep));
+            if (rows.tokens.len <= r.sp.max_prompt_tokens or keep == 0) return rows;
+        }
+    }
+
+    /// Synthesizes segment `i` after the frames so far; false when the reply has ended (refused, cut short, or left).
+    fn speak(r: *Reply, i: usize) bool {
+        const fl: usize = r.sp.frame_length;
+        const room = @min(r.sp.max_frames, drama_long.max_frames - r.frames);
+        const rows = r.prompt(i) catch |e| return r.end(.other, if (e == error.OutOfMemory) "out of memory" else "the tokenizer cannot encode this prompt");
+        var result: api.SpeechResult = .{};
+        const request: api.SpeechRequest = .{
+            .prompt = rows.tokens,
+            .codes = rows.codes,
+            .generated = r.generated[r.frames..][0..room],
+            .pcm = r.pcm[r.frames * fl ..][0 .. room * fl],
+            .result = &result,
+            .seed = api.seedFor(rows.tokens, r.srv.config.seed_salt),
+            .max_frames = @intCast(room),
+            .temperature = drama_prompt.temperature,
+            .top_p = drama_prompt.top_p,
+            .top_k = drama_prompt.top_k,
+            .stream = r.stream,
+        };
+        var box: Mailbox = .{ .io = r.srv.io, .gpa = r.srv.gpa };
+        defer box.deinit();
+        const engine_id = r.srv.next_id.fetchAdd(1, .monotonic);
+        r.submit(&request, &box, engine_id, i > 0) catch |e| {
+            const refused = speech.submitFailure(e);
+            return r.end(refused.kind, refused.message);
+        };
+        // The engine holds `request` and the buffers it names until finished: no path below returns before it arrives.
+        r.rows += rows.tokens.len;
+        if (r.stream) {
+            const sent = speech.streamAudio(r.srv, r.c, r.sp, &box, engine_id, request.pcm, if (r.open) null else trailer) orelse return r.gone();
+            if (!r.open and sent.samples > 0) {
+                r.open = true;
+                r.first_ready = sent.first_ready;
+            }
+            const mismatch: ?[]const u8 = if (result.samples != sent.samples) "the finished synthesis does not match the audio it published" else null;
+            if (speech.why(&box, result.samples, request.pcm.len) orelse mismatch) |message| return r.end(.server, message);
+        } else {
+            if (speech.settle(r.srv, r.c, &box, engine_id, null) == null) return r.gone();
+            if (speech.why(&box, result.samples, request.pcm.len)) |message| return r.end(.server, message);
+        }
+        const frames = result.samples / fl;
+        r.starts.append(r.cx.a, r.frames * fl) catch return r.end(.server, "out of memory");
+        r.heard.append(r.cx.a, .{ .text = r.long.segments[i], .frames = r.generated[r.frames..][0..frames] }) catch return r.end(.server, "out of memory");
+        r.frames += frames;
+        if (box.reason == .length) r.reason = .length;
+        return true;
+    }
+
+    /// Submits, waiting out another request's synthesis after the first segment so a reply is not cut between segments.
+    fn submit(r: *Reply, request: *const api.SpeechRequest, box: *Mailbox, engine_id: api.Id, wait: bool) api.SpeechSubmitError!void {
+        while (true) {
+            r.srv.engine.submitSpeech(engine_id, request, .{ .ctx = box, .event = Mailbox.onEvent }) catch |e| {
+                if (e != error.Busy or !wait or r.c.peerGone()) return e;
+                std.Io.sleep(r.srv.io, .fromMilliseconds(20), .awake) catch {};
+                continue;
+            };
+            return;
+        }
+    }
+
+    /// An error reply before any audio; after a stream's first chunk, no terminator, so the body is incomplete.
+    fn end(r: *Reply, kind: errors.Kind, message: []const u8) bool {
+        if (!r.open) {
+            speech.fail(r.c, r.cx, r.id, kind, message);
+            return false;
+        }
+        r.c.close = true;
+        log.line("speech {s} long-form stream ended incomplete after segments={d} samples={d}: {s}", .{ r.id, r.starts.items.len, r.frames * r.sp.frame_length, message });
+        return false;
+    }
+
+    fn gone(r: *Reply) bool {
+        speech.left(r.srv, r.c, r.id, r.rows, r.received);
+        return false;
+    }
+
+    /// The whole body with the segments header, or the stream's terminating chunk with its trailers.
+    fn finish(r: *Reply, format: speech.Format) void {
+        const samples = r.frames * r.sp.frame_length;
+        const segments = drama_long.segmentsHeader(r.cx.a, r.starts.items) catch return speech.fail(r.c, r.cx, r.id, .server, "out of memory");
+        if (r.stream) {
+            const reason = if (r.reason == .length) "X-Finish-Reason: length\r\n" else "";
+            const last = std.fmt.allocPrint(r.cx.a, "0\r\n{s}X-Long-Form-Segments: {s}\r\n\r\n", .{ reason, segments }) catch "0\r\n\r\n";
+            r.c.writeAll(last) catch {
+                r.c.close = true;
+                return;
+            };
+        } else {
+            const data = speech.quantizeInPlace(r.pcm[0..samples]) catch return speech.fail(r.c, r.cx, r.id, .server, "the synthesized audio has non-finite samples");
+            if (data.len > std.math.maxInt(u32) - 36) return speech.fail(r.c, r.cx, r.id, .server, "the synthesized audio is too long for one reply");
+            speech.sendAudio(r.c, format, r.sp.sample_rate, data, r.reason, segments) catch {
+                r.c.close = true;
+                return;
+            };
+        }
+        log.line("speech {s} long_form segments={d}/{d} prompt={d} samples={d} format={s} stream={} finish={s} seconds={d:.2}", .{
+            r.id, r.starts.items.len, r.long.segments.len, r.rows, samples, @tagName(format), r.stream, @tagName(r.reason), clock.seconds(clock.nowNs(r.srv.io) - r.received),
+        });
+    }
+};
diff --git a/zig/src/server/speech_long_test.zig b/zig/src/server/speech_long_test.zig
new file mode 100644
index 00000000..d30adc1d
--- /dev/null
+++ b/zig/src/server/speech_long_test.zig
@@ -0,0 +1,275 @@
+//! Long-form speech on the wire, against an engine that scripts each segment's frames and finish reason.
+const std = @import("std");
+const api = @import("engine_api");
+const server = @import("root.zig");
+const drama_prompt = @import("drama_prompt.zig");
+const drama_long = @import("drama_long.zig");
+const harness = @import("speech_stream_test.zig");
+const Served = harness.Served;
+
+const gpa = std.testing.allocator;
+const frame = 4;
+
+const Turn = struct { frames: usize, reason: api.Reason = .stop };
+
+/// One synthesis a turn, run inside submit: each segment's PCM is its turn number / 16, its codes turn * 100 + frame.
+const Turns = struct {
+    turns: []const Turn,
+    max_prompt: u32 = 4096,
+    seen: usize = 0,
+    arena: std.heap.ArenaAllocator = .init(gpa),
+    prompts: std.ArrayList([]const u32) = .empty,
+    codes: std.ArrayList([]const drama_prompt.Codes) = .empty,
+    seeds: std.ArrayList(u64) = .empty,
+    limits: std.ArrayList(u32) = .empty,
+    generated: std.ArrayList(usize) = .empty,
+
+    fn engine(t: *Turns) api.Engine {
+        return .{ .ctx = t, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory, .submit_speech = speech } };
+    }
+    fn info(ctx: *anyopaque) api.Info {
+        const t: *Turns = @ptrCast(@alignCast(ctx));
+        return .{ .text_generation = false, .speech = .{ .sample_rate = 44100, .frame_length = frame, .max_frames = 1024, .max_prompt_tokens = t.max_prompt } };
+    }
+    fn speech(ctx: *anyopaque, id: api.Id, request: *const api.SpeechRequest, sink: api.Sink) api.SpeechSubmitError!void {
+        const t: *Turns = @ptrCast(@alignCast(ctx));
+        if (t.seen == t.turns.len) return error.InvalidRequest;
+        const turn = t.turns[t.seen];
+        t.seen += 1;
+        const a = t.arena.allocator();
+        t.prompts.append(a, a.dupe(u32, request.prompt) catch unreachable) catch unreachable;
+        t.codes.append(a, a.dupe(drama_prompt.Codes, request.codes) catch unreachable) catch unreachable;
+        t.seeds.append(a, request.seed) catch unreachable;
+        t.limits.append(a, request.max_frames) catch unreachable;
+        t.generated.append(a, request.generated.len) catch unreachable;
+        const frames = @min(turn.frames, request.max_frames);
+        @memset(request.pcm[0 .. frames * frame], @as(f32, @floatFromInt(t.seen)) / 16);
+        if (request.generated.len > 0) for (request.generated[0..frames], 0..) |*codes, f| {
+            codes.* = @splat(@intCast(t.seen * 100 + f));
+        };
+        if (request.stream and frames > 0) sink.event(sink.ctx, id, &.{ .audio = frames * frame });
+        const reason: api.Reason = if (turn.reason == .stop and frames == request.max_frames) .length else turn.reason;
+        if (reason == .stop or reason == .length) request.result.samples = frames * frame;
+        sink.event(sink.ctx, id, &.{ .finished = .{ .reason = reason, .message = if (reason == .failed) "scripted failure" else "" } });
+    }
+    fn cancel(_: *anyopaque, _: api.Id) void {}
+    fn submit(_: *anyopaque, _: api.Id, _: *const api.Request, _: api.Sink) api.SubmitError!void {
+        return error.Unsupported;
+    }
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+    fn deinit(t: *Turns) void {
+        t.arena.deinit();
+    }
+};
+
+fn config(long_form: ?drama_long.Options) server.Config {
+    return .{ .served_name = "m", .model_ids = &.{"m"}, .long_form = long_form };
+}
+
+/// `n` sentences of 18 characters: with 20-character segments, one a segment.
+fn sentences(a: std.mem.Allocator, n: usize) ![]const u8 {
+    var out: std.ArrayList(u8) = .empty;
+    for (0..n) |i| try out.print(a, "{s}Sentence {d:0>2} is ok.", .{ if (i == 0) "" else " ", i });
+    return out.items;
+}
+
+fn body(a: std.mem.Allocator, input: []const u8, stream: bool) ![]const u8 {
+    return std.fmt.allocPrint(a, "{{\"model\":\"m\",\"input\":\"{s}\",\"response_format\":\"pcm\",\"stream\":{}}}", .{ input, stream });
+}
+
+/// Served once, the route joined; the reply head and the bytes after it.
+fn serve(t: *Turns, cfg: server.Config, request: []const u8) !struct { s: *Served, head: []const u8 } {
+    const s = try gpa.create(Served);
+    try s.startWith(t.engine(), cfg, "HTTP/1.1", request, 2000);
+    const head = try s.readHead();
+    s.route.join();
+    return .{ .s = s, .head = head };
+}
+
+fn done(s: *Served) void {
+    s.deinit();
+    gpa.destroy(s);
+}
+
+/// The PCM16 bytes of `frames` frames of turn `n`'s value.
+fn turnPcm(out: *std.ArrayList(u8), a: std.mem.Allocator, n: usize, frames: usize) !void {
+    const q: i16 = @intFromFloat(@as(f32, @floatFromInt(n)) / 16 * 32767.0);
+    for (0..frames * frame) |_| try out.appendSlice(a, &std.mem.toBytes(std.mem.nativeToLittle(i16, q)));
+}
+
+/// Segment `i`'s expected prompt: the earlier segments' text and scripted codes as references, latest last.
+fn expected(a: std.mem.Allocator, text: *harness.Bytes, segments: []const []const u8, frames: []const usize, i: usize, keep: usize) !drama_prompt.Rows {
+    if (keep == 0) return .{ .tokens = try drama_prompt.encode(a, text.text(), segments[i]), .codes = &.{} };
+    var heard: std.ArrayList(drama_prompt.Reference) = .empty;
+    for (i - keep..i) |j| {
+        const codes = try a.alloc(drama_prompt.Codes, frames[j]);
+        for (codes, 0..) |*c, f| c.* = @splat(@intCast((j + 1) * 100 + f));
+        try heard.append(a, .{ .text = segments[j], .frames = codes });
+    }
+    return drama_prompt.encodeReferenced(a, text.text(), segments[i], heard.items);
+}
+
+test "long-form off: a long input is one synthesis, and an input of one segment is that same synthesis with it on" {
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var text: harness.Bytes = .{};
+    for ([_][]const u8{ try sentences(a, 3), "Short enough." }) |input| {
+        var replies: [2][]const u8 = undefined;
+        var prompts: [2][]const u32 = undefined;
+        for ([_]?drama_long.Options{ null, .{ .chars = 300 } }, 0..) |lf, k| {
+            var t: Turns = .{ .turns = &.{.{ .frames = 5 }} };
+            defer t.deinit();
+            const r = try serve(&t, config(lf), try body(a, input, false));
+            defer done(r.s);
+            try std.testing.expectEqual(@as(usize, 1), t.seen);
+            try std.testing.expect(std.mem.indexOf(u8, r.head, "X-Long-Form-Segments") == null);
+            try std.testing.expectEqual(@as(usize, 0), t.generated.items[0]);
+            try std.testing.expectEqual(api.seedFor(t.prompts.items[0], 0), t.seeds.items[0]);
+            prompts[k] = try a.dupe(u32, t.prompts.items[0]);
+            replies[k] = try std.mem.concat(a, u8, &.{ r.head[std.mem.indexOf(u8, r.head, "Content-Type").?..], try r.s.readRest() });
+        }
+        try std.testing.expectEqualSlices(u32, try drama_prompt.encode(a, text.text(), input), prompts[0]);
+        try std.testing.expectEqualSlices(u32, prompts[0], prompts[1]);
+        try std.testing.expectEqualStrings(replies[0], replies[1]);
+    }
+}
+
+test "segments are spoken in order, each hearing the one before, their PCM joined with no gap" {
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var text: harness.Bytes = .{};
+    const input = try sentences(a, 3);
+    const segments = try drama_long.split(a, input, 20);
+    const frames = [_]usize{ 5, 3, 7 };
+    var t: Turns = .{ .turns = &.{ .{ .frames = 5 }, .{ .frames = 3 }, .{ .frames = 7 } } };
+    defer t.deinit();
+    const r = try serve(&t, config(.{ .chars = 20 }), try body(a, input, false));
+    defer done(r.s);
+    try std.testing.expect(std.mem.indexOf(u8, r.head, "HTTP/1.1 200") != null);
+    try std.testing.expect(std.mem.indexOf(u8, r.head, "X-Finish-Reason: stop\r\nX-Long-Form-Segments: 3;20,32\r\n") != null);
+    var want: std.ArrayList(u8) = .empty;
+    for (frames, 1..) |n, turn| try turnPcm(&want, a, turn, n);
+    try std.testing.expectEqualSlices(u8, want.items, try r.s.readRest());
+    try std.testing.expectEqual(@as(usize, 3), t.seen);
+    for (0..3) |i| {
+        const rows = try expected(a, &text, segments, &frames, i, @min(i, 1));
+        try std.testing.expectEqualSlices(u32, rows.tokens, t.prompts.items[i]);
+        try std.testing.expectEqualSlices(drama_prompt.Codes, rows.codes, t.codes.items[i]);
+        try std.testing.expectEqual(api.seedFor(rows.tokens, 0), t.seeds.items[i]);
+        try std.testing.expect(t.generated.items[i] >= t.limits.items[i]);
+    }
+}
+
+test "history 2 hears two earlier segments, dropping the oldest when the prompt would not fit" {
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var text: harness.Bytes = .{};
+    const input = try sentences(a, 3);
+    const segments = try drama_long.split(a, input, 20);
+    const frames = [_]usize{ 5, 3, 7 };
+    const two = try expected(a, &text, segments, &frames, 2, 2);
+    const one = try expected(a, &text, segments, &frames, 2, 1);
+    for ([_]u32{ 4096, @intCast(two.tokens.len - 1) }, [_]drama_prompt.Rows{ two, one }) |max_prompt, want| {
+        var t: Turns = .{ .turns = &.{ .{ .frames = 5 }, .{ .frames = 3 }, .{ .frames = 7 } }, .max_prompt = max_prompt };
+        defer t.deinit();
+        const r = try serve(&t, config(.{ .chars = 20, .history = 2 }), try body(a, input, false));
+        defer done(r.s);
+        try std.testing.expectEqual(@as(usize, 3), t.seen);
+        try std.testing.expectEqualSlices(u32, want.tokens, t.prompts.items[2]);
+    }
+}
+
+test "a clipped segment ends the reply with length; later segments are not spoken" {
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var t: Turns = .{ .turns = &.{ .{ .frames = 5 }, .{ .frames = 3, .reason = .length }, .{ .frames = 7 } } };
+    defer t.deinit();
+    const r = try serve(&t, config(.{ .chars = 20 }), try body(a, try sentences(a, 3), false));
+    defer done(r.s);
+    try std.testing.expectEqual(@as(usize, 2), t.seen);
+    try std.testing.expect(std.mem.indexOf(u8, r.head, "X-Finish-Reason: length\r\nX-Long-Form-Segments: 2;20\r\n") != null);
+    try std.testing.expectEqual(@as(usize, 2 * frame * 8), (try r.s.readRest()).len);
+}
+
+test "the frame budget: each segment gets what is left, and a reply that spends it ends with length" {
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const thousand: Turn = .{ .frames = 1000 };
+    const cases = [_]struct { turns: []const Turn, seen: usize, last_limit: u32 }{
+        .{ .turns = &.{ thousand, thousand, thousand, thousand, thousand, thousand, thousand }, .seen = 6, .last_limit = 1000 },
+        .{ .turns = &.{ thousand, thousand, thousand, thousand, thousand, .{ .frames = 1500 }, thousand }, .seen = 6, .last_limit = 1000 },
+    };
+    for (cases) |case| {
+        var t: Turns = .{ .turns = case.turns };
+        defer t.deinit();
+        const r = try serve(&t, config(.{ .chars = 20 }), try body(a, try sentences(a, 7), false));
+        defer done(r.s);
+        try std.testing.expectEqual(case.seen, t.seen);
+        try std.testing.expectEqual(@as(u32, 1024), t.limits.items[0]);
+        try std.testing.expectEqual(case.last_limit, t.limits.items[t.seen - 1]);
+        try std.testing.expect(std.mem.indexOf(u8, r.head, "X-Finish-Reason: length\r\n") != null);
+        try std.testing.expectEqual(@as(usize, 2 * frame * drama_long.max_frames), (try r.s.readRest()).len);
+    }
+}
+
+test "more than 12 segments are refused before any synthesis" {
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var t: Turns = .{ .turns = &.{} };
+    defer t.deinit();
+    const r = try serve(&t, config(.{ .chars = 20 }), try body(a, try sentences(a, 13), false));
+    defer done(r.s);
+    try std.testing.expect(std.mem.indexOf(u8, r.head, " 400 ") != null);
+    try std.testing.expect(std.mem.indexOf(u8, try r.s.readRest(), "Drama 3 request: a long-form input in 13 segments of at most 20 characters exceeds the maximum of 12 segments") != null);
+    try std.testing.expectEqual(@as(usize, 0), t.seen);
+}
+
+test "a long-form stream sends each segment as it is made, then the trailers" {
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]api.Reason{ .stop, .length }) |last| {
+        var t: Turns = .{ .turns = &.{ .{ .frames = 5 }, .{ .frames = 3, .reason = last } } };
+        defer t.deinit();
+        const r = try serve(&t, config(.{ .chars = 20 }), try body(a, try sentences(a, 2), true));
+        defer done(r.s);
+        try std.testing.expect(std.mem.indexOf(u8, r.head, "Trailer: X-Finish-Reason, X-Long-Form-Segments\r\n") != null);
+        const rest = try r.s.readRest();
+        var want: std.ArrayList(u8) = .empty;
+        try want.print(a, "{x}\r\n", .{2 * frame * 5});
+        try turnPcm(&want, a, 1, 5);
+        try want.print(a, "\r\n{x}\r\n", .{2 * frame * 3});
+        try turnPcm(&want, a, 2, 3);
+        try want.print(a, "\r\n0\r\n{s}X-Long-Form-Segments: 2;20\r\n\r\n", .{if (last == .length) "X-Finish-Reason: length\r\n" else ""});
+        try std.testing.expectEqualSlices(u8, want.items, rest);
+    }
+}
+
+test "a failure after the first segment ends a stream incomplete and a whole reply with an error" {
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_]bool{ true, false }) |stream| {
+        var t: Turns = .{ .turns = &.{ .{ .frames = 5 }, .{ .frames = 0, .reason = .failed } } };
+        defer t.deinit();
+        const r = try serve(&t, config(.{ .chars = 20 }), try body(a, try sentences(a, 2), stream));
+        defer done(r.s);
+        const rest = try r.s.readRest();
+        if (stream) {
+            try std.testing.expect(std.mem.indexOf(u8, r.head, "HTTP/1.1 200") != null and std.mem.indexOf(u8, rest, "\r\n0\r\n") == null);
+        } else {
+            try std.testing.expect(std.mem.indexOf(u8, r.head, "HTTP/1.1 500") != null and std.mem.indexOf(u8, rest, "scripted failure") != null);
+        }
+    }
+}
