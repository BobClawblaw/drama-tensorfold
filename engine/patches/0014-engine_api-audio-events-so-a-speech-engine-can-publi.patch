             h.stream.synchronize() catch {}; // no device work outlives the request it served
             if (e == error.Cancelled) return h.finish(job, .cancelled, stats, "");
             std.log.warn("drama: synthesis {d} failed: {s}", .{ job.id, @errorName(e) });
